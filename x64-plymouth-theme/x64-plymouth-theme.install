post_install() {
    plymouth-set-default-theme x64-lios 2>/dev/null || true
    echo "==> X64 LIOS Plymouth theme configured as default."
    echo "==> Run 'sudo mkinitcpio -P' to update your initramfs."
}

post_upgrade() {
    post_install
}

post_remove() {
    if [ "$(plymouth-set-default-theme 2>/dev/null)" = "x64-lios" ]; then
        plymouth-set-default-theme bgrt 2>/dev/null || true
    fi
}

