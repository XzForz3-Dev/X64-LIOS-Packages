+/// Recursive helper for clearSelections()
+static void
+clearSelections( const QStringList& unselectNames, PackageTreeItem* item )
+{
+    for ( int i = 0; i < item->childCount(); i++ )
+    {
+        auto* child = item->child( i );
+        clearSelections( unselectNames, child );
+    }
+    if ( item->isGroup() && unselectNames.contains( item->name() ) )
+    {
+        item->setSelected( Qt::CheckState::Unchecked );
+    }
+}
