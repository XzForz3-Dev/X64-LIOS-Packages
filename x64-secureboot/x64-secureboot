def detect_language():
    lang = os.environ.get('LANG', 'es').split('_')[0].lower()
    return lang if lang in TRANSLATIONS else 'es'

CURRENT_LANG = detect_language()

def tr(key):
    return TRANSLATIONS.get(CURRENT_LANG, TRANSLATIONS['es']).get(key, key)

