def detect_language():
    # 1. Check CLI argument --lang <code>
    if '--lang' in sys.argv:
        try:
            idx = sys.argv.index('--lang')
            code = sys.argv[idx + 1].lower()
            if code in TRANSLATIONS:
                return code
        except Exception:
            pass

    # 2. Check X64_LANG environment variable
    if 'X64_LANG' in os.environ:
        code = os.environ['X64_LANG'].lower().strip()
        if code in TRANSLATIONS:
            return code

    # 3. Check ~/.config/x64-hello/lang.conf
    try:
        cfg = os.path.expanduser('~/.config/x64-hello/lang.conf')
        if os.path.exists(cfg):
            with open(cfg, 'r', encoding='utf-8') as f:
                code = f.read().strip().lower()
                if code in TRANSLATIONS:
                    return code
    except Exception:
        pass

    # 4. Check system locale (LANG, LC_ALL, LC_MESSAGES)
    for env_var in ('LC_ALL', 'LC_MESSAGES', 'LANG'):
        raw = os.environ.get(env_var, '')
        if raw:
            code = raw.split('.')[0].split('_')[0].lower()
            if code in TRANSLATIONS:
                return code

    # 5. Default fallback to English
    return 'en'

CURRENT_LANG = detect_language()

def tr(key):
    lang_dict = TRANSLATIONS.get(CURRENT_LANG, TRANSLATIONS['en'])
    return lang_dict.get(key, TRANSLATIONS['en'].get(key, key))

