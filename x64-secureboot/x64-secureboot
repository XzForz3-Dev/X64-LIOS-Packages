        self.step3 = StepCard("03", tr('step3_title'), tr('step3_desc'), tr('btn_enroll_keys'), lambda: self.run_action('enroll-keys'))

        layout.addWidget(self.step1)
        layout.addWidget(self.step2)
        layout.addWidget(self.step3)

        # BIOS Guide helper button row
        guide_box = QHBoxLayout()
        guide_box.addStretch()
        btn_guide = QPushButton(f"💡 {tr('btn_bios_guide')}")
        btn_guide.setStyleSheet("""
            QPushButton {
                background: transparent;
                color: #ff5555;
                font-weight: bold;
                border: 1px dashed #ff3333;
                border-radius: 6px;
                padding: 6px 16px;
                font-size: 11.5px;
            }
            QPushButton:hover {
                background: #201010;
                color: #ffffff;
            }
        """)
        btn_guide.clicked.connect(self.show_bios_guide)
        guide_box.addWidget(btn_guide)
        layout.addLayout(guide_box)

        # Log viewer area
        log_header = QHBoxLayout()
        lbl_log = QLabel(tr('log_title'))
        lbl_log.setStyleSheet("color: #cc0000; font-size: 11px; font-weight: bold; letter-spacing: 0.8px;")
        log_header.addWidget(lbl_log)
        log_header.addStretch()

        btn_clear = QPushButton(tr('btn_clear_log'))
        btn_clear.setStyleSheet("""
            QPushButton {
                background: transparent;
                color: #707085;
                font-size: 11px;
                border: none;
                padding: 2px 6px;
            }
            QPushButton:hover {
                color: #ffffff;
            }
        """)
        btn_clear.clicked.connect(self.clear_log)
        log_header.addWidget(btn_clear)
        layout.addLayout(log_header)

        self.log_view = QPlainTextEdit()
        self.log_view.setReadOnly(True)
        self.log_view.setStyleSheet("""
            QPlainTextEdit {
                background-color: #060608;
                border: 1px solid #1f1f2a;
                border-radius: 6px;
                color: #b0e0b0;
                font-family: 'JetBrains Mono', 'Fira Code', 'Monospace';
                font-size: 11.5px;
                padding: 8px;
            }
        """)
        self.log_view.setMaximumHeight(140)
        layout.addWidget(self.log_view)

    def log(self, text):
        self.log_view.appendPlainText(text)
        self.log_view.verticalScrollBar().setValue(self.log_view.verticalScrollBar().maximum())

    def clear_log(self):
        self.log_view.clear()

    def show_bios_guide(self):
        dlg = BiosGuideDialog(self)
        dlg.exec()

    def refresh_status(self):
        self.log(tr('log_querying'))
        cmd = [self.helper_path, "status"]
        try:
            res = subprocess.run(cmd, capture_output=True, text=True, timeout=5)
            if res.returncode == 0:
                data = json.loads(res.stdout)
                self.update_telemetry(data)
            else:
                self.log(tr('log_query_fail').format(err=res.stderr.strip()))
        except Exception as e:
            self.log(tr('log_query_error').format(err=str(e)))

    def update_telemetry(self, data):
        # 1. Firmware Mode
        if data.get('uefi', False):
            self.card_uefi.set_value(tr('state_uefi_ok'), '#10b981')
        else:
            self.card_uefi.set_value(tr('state_uefi_legacy'), '#888899')

        # 2. sbctl installed check
        installed = data.get('sbctl_installed', False)
        self.warn_banner.setVisible(not installed)
        self.step1.action_btn.setEnabled(installed)
        self.step2.action_btn.setEnabled(installed)
        self.step3.action_btn.setEnabled(installed)

        # 3. Keys Created
        keys_ok = data.get('keys_created', False)
        if keys_ok:
            self.card_keys.set_value(tr('state_keys_ready'), '#10b981')
            self.step1.set_badge(tr('badge_keys_ready'), True)
            self.step1.action_btn.setText(tr('btn_recreate_keys'))
        else:
            self.card_keys.set_value(tr('state_keys_missing'), '#f59e0b')
            self.step1.set_badge(tr('badge_keys_pending'), False)
            self.step1.action_btn.setText(tr('btn_create_keys'))

        # 4. Signed Files
        total = data.get('total_files', 0)
        signed = data.get('signed_files', 0)
        if total > 0 and signed == total:
            self.step2.set_badge(tr('badge_signed_all').format(signed=signed, total=total), True)
        elif total > 0:
            self.step2.set_badge(tr('badge_signed_partial').format(signed=signed, total=total), False)
        else:
            self.step2.set_badge(tr('badge_signed_none'), False)

        # 5. BIOS Secure Boot State
        sb_state = data.get('secure_boot_state', 'disabled')
        if sb_state == 'setup_mode':
            self.card_sb.set_value(tr('state_sb_setup'), '#f59e0b')
            self.step3.set_badge(tr('badge_sb_ready_enroll'), True)
            self.step3.set_button_style("success")
        elif sb_state == 'enabled':
            self.card_sb.set_value(tr('state_sb_enabled'), '#10b981')
            self.step3.set_badge(tr('badge_sb_active_ok'), True)
            self.step3.set_button_style("success")
        elif sb_state == 'legacy':
            self.card_sb.set_value(tr('state_sb_legacy'), '#888899')
            self.step3.set_badge(tr('badge_sb_legacy'), False)
        else:
            self.card_sb.set_value(tr('state_sb_disabled'), '#ef4444')
            self.step3.set_badge(tr('badge_sb_need_setup'), False)

    def run_action(self, action_name):
        self.log(f"\n{tr('log_executing').format(action=action_name)}")
        self.set_buttons_enabled(False)

        self.proc = QProcess(self)
        self.proc.readyReadStandardOutput.connect(self.on_stdout)
        self.proc.readyReadStandardError.connect(self.on_stderr)
        self.proc.finished.connect(lambda exit_code, status: self.on_finished(exit_code, action_name))

        # Run via pkexec
        self.proc.start("pkexec", [self.helper_path, action_name])

    def on_stdout(self):
        data = self.proc.readAllStandardOutput().data().decode('utf-8', errors='replace')
        self.log(data.strip())

    def on_stderr(self):
        data = self.proc.readAllStandardError().data().decode('utf-8', errors='replace')
        self.log(data.strip())

    def on_finished(self, exit_code, action_name):
        self.set_buttons_enabled(True)
        if exit_code == 0:
            self.log(tr('log_success').format(action=action_name))
        else:
            self.log(tr('log_fail').format(action=action_name, code=exit_code))
        self.refresh_status()

    def set_buttons_enabled(self, enabled):
        self.step1.action_btn.setEnabled(enabled)
        self.step2.action_btn.setEnabled(enabled)
        self.step3.action_btn.setEnabled(enabled)

def main():
    app = QApplication(sys.argv)
    app.setStyle("Fusion")
    icon = QIcon(render_svg('shield', 64))
    app.setWindowIcon(icon)
    win = X64SecureBootWindow()
    win.setWindowIcon(icon)
    win.show()
    sys.exit(app.exec())

if __name__ == '__main__':
    main()
