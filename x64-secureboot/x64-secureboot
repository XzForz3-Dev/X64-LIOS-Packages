    def show_bios_guide(self):
        dlg = BiosGuideDialog(self)
        dlg.exec()

    def refresh_status(self):
        self.log("[i] Consultando telemetría de firmware y Secure Boot...")
        cmd = [self.helper_path, "status"]
        try:
            res = subprocess.run(cmd, capture_output=True, text=True, timeout=5)
            if res.returncode == 0:
                data = json.loads(res.stdout)
                self.update_telemetry(data)
            else:
                self.log(f"[!] Fallo al consultar estado: {res.stderr}")
        except Exception as e:
            self.log(f"[!] Error ejecutando helper: {e}")

    def update_telemetry(self, data):
        # 1. Firmware Mode
        if data.get('uefi', False):
            self.card_uefi.set_value(tr('state_uefi_ok'), '#10b981')
        else:
            self.card_uefi.set_value(tr('state_uefi_legacy'), '#888899')

        # 2. sbctl installed check
        installed = data.get('sbctl_installed', False)
        self.warn_banner.setVisible(not installed)
        self.step1.action_btn.setEnabled(installed)
        self.step2.action_btn.setEnabled(installed)
        self.step3.action_btn.setEnabled(installed)

        # 3. Keys Created
        keys_ok = data.get('keys_created', False)
        if keys_ok:
            self.card_keys.set_value(tr('state_keys_ready'), '#10b981')
            self.step1.set_badge("✓ Claves listas", True)
            self.step1.action_btn.setText(tr('btn_recreate_keys'))
        else:
            self.card_keys.set_value(tr('state_keys_missing'), '#f59e0b')
            self.step1.set_badge("Pendiente", False)
            self.step1.action_btn.setText(tr('btn_create_keys'))

        # 4. Signed Files
        total = data.get('total_files', 0)
        signed = data.get('signed_files', 0)
        if total > 0 and signed == total:
            self.step2.set_badge(f"✓ {signed}/{total} archivos firmados", True)
        elif total > 0:
            self.step2.set_badge(f"⚠ {signed}/{total} firmados", False)
        else:
            self.step2.set_badge("Sin archivos analizados", False)

        # 5. BIOS Secure Boot State
        sb_state = data.get('secure_boot_state', 'disabled')
        if sb_state == 'setup_mode':
            self.card_sb.set_value(tr('state_sb_setup'), '#f59e0b')
            self.step3.set_badge("Listo para enrolar (Setup Mode)", True)
            self.step3.set_button_style("success")
        elif sb_state == 'enabled':
            self.card_sb.set_value(tr('state_sb_enabled'), '#10b981')
            self.step3.set_badge("✓ Claves enroladas y activo", True)
            self.step3.set_button_style("success")
        elif sb_state == 'legacy':
            self.card_sb.set_value(tr('state_sb_legacy'), '#888899')
            self.step3.set_badge("No disponible en Legacy", False)
        else:
            self.card_sb.set_value(tr('state_sb_disabled'), '#ef4444')
            self.step3.set_badge("Requiere Setup Mode", False)

    def run_action(self, action_name):
        self.log(f"\n>>> Ejecutando acción: {action_name}...")
        self.set_buttons_enabled(False)

        self.proc = QProcess(self)
        self.proc.readyReadStandardOutput.connect(self.on_stdout)
        self.proc.readyReadStandardError.connect(self.on_stderr)
        self.proc.finished.connect(lambda exit_code, status: self.on_finished(exit_code, action_name))

        # Run via pkexec
        self.proc.start("pkexec", [self.helper_path, action_name])

    def on_stdout(self):
        data = self.proc.readAllStandardOutput().data().decode('utf-8', errors='replace')
        self.log(data.strip())

    def on_stderr(self):
        data = self.proc.readAllStandardError().data().decode('utf-8', errors='replace')
        self.log(data.strip())

    def on_finished(self, exit_code, action_name):
        self.set_buttons_enabled(True)
        if exit_code == 0:
            self.log(f"✓ Acción '{action_name}' finalizada correctamente.")
        else:
            self.log(f"[!] Acción '{action_name}' terminó con código: {exit_code}")
        self.refresh_status()

    def set_buttons_enabled(self, enabled):
        self.step1.action_btn.setEnabled(enabled)
        self.step2.action_btn.setEnabled(enabled)
        self.step3.action_btn.setEnabled(enabled)

def main():
    app = QApplication(sys.argv)
    app.setStyle("Fusion")
    icon = QIcon(render_svg('shield', 64))
    app.setWindowIcon(icon)
    win = X64SecureBootWindow()
    win.setWindowIcon(icon)
    win.show()
    sys.exit(app.exec())

if __name__ == '__main__':
    main()
