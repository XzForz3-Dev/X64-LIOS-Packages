pkgname=x64-grub-theme
pkgver=1.0.0
pkgrel=7
pkgdesc="Official X64 LIOS GRUB Bootloader Theme (Dark Glass + Crimson Bar + Terminus Fonts)"
arch=('any')
license=('GPL')
depends=()
install=x64-grub-theme.install

package() {
    mkdir -p "${pkgdir}/usr/share/grub/themes/x64"
    mkdir -p "${pkgdir}/boot/grub/themes/x64"

    cp -r "${startdir}/assets/"* "${pkgdir}/usr/share/grub/themes/x64/"
    cp -r "${startdir}/assets/"* "${pkgdir}/boot/grub/themes/x64/"
}

