            '86503514e0196dbe88dfb2c9640ff26db6044fc8c9ade3cff3bb608fca9c5578')

package() {
    # Instalar colección oficial de fondos de pantalla de X64 LIOS
    mkdir -p "${pkgdir}/usr/share/backgrounds/x64-lios"
    cp "${srcdir}/01-monolith.jpg" "${pkgdir}/usr/share/backgrounds/x64-lios/"
    cp "${srcdir}/02-v3-carbon.jpg" "${pkgdir}/usr/share/backgrounds/x64-lios/"
    cp "${srcdir}/03-v2-shield.jpg" "${pkgdir}/usr/share/backgrounds/x64-lios/"
    cp "${srcdir}/04-hybrid-plate.jpg" "${pkgdir}/usr/share/backgrounds/x64-lios/"
    cp "${srcdir}/05-faceted-armor.jpg" "${pkgdir}/usr/share/backgrounds/x64-lios/"
    cp "${srcdir}/06-stealth-dark.jpg" "${pkgdir}/usr/share/backgrounds/x64-lios/"

    # Enlaces simbólicos de compatibilidad para rutas históricas
    ln -sf 03-v2-shield.jpg "${pkgdir}/usr/share/backgrounds/x64-lios/x64-lios-v2.jpg"
    ln -sf 02-v3-carbon.jpg "${pkgdir}/usr/share/backgrounds/x64-lios/x64-lios-v3.jpg"

    # Función auxiliar para instalar un paquete KPackage oficial de Wallpaper de KDE Plasma
    install_wallpaper_kpackage() {
        local pkg_id="$1"
        local display_name="$2"
        local image_file="$3"
        local thumb_file="$4"

        local wp_dir="${pkgdir}/usr/share/wallpapers/${pkg_id}"
        mkdir -p "${wp_dir}/contents/images"

        cat << EOF > "${wp_dir}/metadata.json"
{
    "KPlugin": {
        "Authors": [
            {
                "Email": "info@x64lios.com",
                "Name": "X64 Studios"
            }
        ],
        "Id": "${pkg_id}",
        "License": "GPLv3",
        "Name": "${display_name}",
        "Version": "2.0"
    }
}
EOF

        cp "${srcdir}/${thumb_file}" "${wp_dir}/contents/screenshot.png"
        cp "${srcdir}/${image_file}" "${wp_dir}/contents/images/2752x1536.jpg"
        ln -sf 2752x1536.jpg "${wp_dir}/contents/images/1920x1080.jpg"
        ln -sf 2752x1536.jpg "${wp_dir}/contents/images/2560x1440.jpg"
        ln -sf 2752x1536.jpg "${wp_dir}/contents/images/3840x2160.jpg"
        ln -sf 2752x1536.jpg "${wp_dir}/contents/images/5120x2880.jpg"
    }

    # Instalar los 6 Fondos Soberanos de X64 LIOS como paquetes KPackage nativos de KDE Plasma
    install_wallpaper_kpackage "X64-LIOS"            "X64 LIOS 01 - Stealth Monolith" "01-monolith.jpg" "screenshot-01.png"
    install_wallpaper_kpackage "X64-LIOS-02-Carbon"   "X64 LIOS 02 - Carbon Fiber"    "02-v3-carbon.jpg" "screenshot-02.png"
    install_wallpaper_kpackage "X64-LIOS-03-Shield"   "X64 LIOS 03 - Sovereign Shield" "03-v2-shield.jpg" "screenshot-03.png"
    install_wallpaper_kpackage "X64-LIOS-04-Hybrid"   "X64 LIOS 04 - Hybrid Plate"    "04-hybrid-plate.jpg" "screenshot-04.png"
    install_wallpaper_kpackage "X64-LIOS-05-Armor"    "X64 LIOS 05 - Faceted Armor"   "05-faceted-armor.jpg" "screenshot-05.png"
    install_wallpaper_kpackage "X64-LIOS-06-Stealth"  "X64 LIOS 06 - Deep Stealth"    "06-stealth-dark.jpg" "screenshot-06.png"

    # Instalar logo
    mkdir -p "${pkgdir}/usr/share/pixmaps"
    cp "${srcdir}/x64-logo.png" "${pkgdir}/usr/share/pixmaps/x64-logo.png"

    # Instalar layout y script de look-and-feel en ruta segura
    mkdir -p "${pkgdir}/usr/share/x64-lios"
    cp "${srcdir}/x64-layout.js" "${pkgdir}/usr/share/x64-lios/x64-layout.js"
    cp "${srcdir}/set-default-wallpaper.sh" "${pkgdir}/usr/share/x64-lios/set-default-wallpaper.sh"
    chmod 755 "${pkgdir}/usr/share/x64-lios/set-default-wallpaper.sh"

    # Instalar hook oficial de ALPM para mantener X64-LIOS al actualizar plasma-workspace
    mkdir -p "${pkgdir}/usr/share/libalpm/hooks"
    cp "${srcdir}/x64-kde-wallpaper-defaults.hook" "${pkgdir}/usr/share/libalpm/hooks/x64-kde-wallpaper-defaults.hook"

    # Instalar inicializador activo en /usr/bin
    mkdir -p "${pkgdir}/usr/bin"
    cp "${srcdir}/x64-theme-init.sh" "${pkgdir}/usr/bin/x64-theme-init"
    chmod 755 "${pkgdir}/usr/bin/x64-theme-init"

    # Instalar configuraciones maestras en /etc/skel para nuevos usuarios / Calamares
    mkdir -p "${pkgdir}/etc/skel/.config/kdedefaults"
    mkdir -p "${pkgdir}/etc/skel/.config/gtk-3.0"
    mkdir -p "${pkgdir}/etc/skel/.config/gtk-4.0"

    cp "${srcdir}/plasmashellrc" "${pkgdir}/etc/skel/.config/plasmashellrc"
    cp "${srcdir}/plasma-org.kde.plasma.desktop-appletsrc" "${pkgdir}/etc/skel/.config/plasma-org.kde.plasma.desktop-appletsrc"
    cp "${srcdir}/kdeglobals" "${pkgdir}/etc/skel/.config/kdeglobals"
    cp "${srcdir}/kdeglobals" "${pkgdir}/etc/skel/.config/kdedefaults/kdeglobals"
    cp "${srcdir}/kwinrc" "${pkgdir}/etc/skel/.config/kwinrc"
    cp "${srcdir}/kwinrc" "${pkgdir}/etc/skel/.config/kdedefaults/kwinrc"
    cp "${srcdir}/gtk3-settings.ini" "${pkgdir}/etc/skel/.config/gtk-3.0/settings.ini"
    cp "${srcdir}/gtk4-settings.ini" "${pkgdir}/etc/skel/.config/gtk-4.0/settings.ini"

    # Configuración de fallback del sistema en /etc/xdg
    mkdir -p "${pkgdir}/etc/xdg"
    cp "${srcdir}/plasma-org.kde.plasma.desktop-appletsrc" "${pkgdir}/etc/xdg/plasma-org.kde.plasma.desktop-appletsrc"
    cp "${srcdir}/plasmarc" "${pkgdir}/etc/xdg/plasmarc"
    cp "${srcdir}/plasmarc" "${pkgdir}/etc/skel/.config/plasmarc"
    cp "${srcdir}/plasmarc" "${pkgdir}/etc/skel/.config/kdedefaults/plasmarc"

    # Configuración de kscreenlockerrc (Pantalla de bloqueo oficial -> 05-faceted-armor.jpg)
    cp "${srcdir}/kscreenlockerrc" "${pkgdir}/etc/xdg/kscreenlockerrc"
    cp "${srcdir}/kscreenlockerrc" "${pkgdir}/etc/skel/.config/kscreenlockerrc"
    cp "${srcdir}/kscreenlockerrc" "${pkgdir}/etc/skel/.config/kdedefaults/kscreenlockerrc"

    # Desactivar indexador Baloo (cero sobrecarga de disco/CPU para gaming)
    cp "${srcdir}/baloofilerc" "${pkgdir}/etc/skel/.config/baloofilerc"
    cp "${srcdir}/baloofilerc" "${pkgdir}/etc/xdg/baloofilerc"

    # Configuración de sesión limpia (cero ventanas previas restauradas, arranque impoluto)
    cp "${srcdir}/ksmserverrc" "${pkgdir}/etc/xdg/ksmserverrc"
    cp "${srcdir}/ksmserverrc" "${pkgdir}/etc/skel/.config/ksmserverrc"
    cp "${srcdir}/ksmserverrc" "${pkgdir}/etc/skel/.config/kdedefaults/ksmserverrc"

    # Desactivar demonios de fondo redundantes en autostart (DiscoverNotifier y KDE Connect)
    mkdir -p "${pkgdir}/etc/skel/.config/autostart"
    cp "${srcdir}/org.kde.discover.notifier.desktop" "${pkgdir}/etc/skel/.config/autostart/org.kde.discover.notifier.desktop"
    cp "${srcdir}/org.kde.kdeconnect.daemon.desktop" "${pkgdir}/etc/skel/.config/autostart/org.kde.kdeconnect.daemon.desktop"

    # Inicializador activo y dinámico sin timers ciegos en autostart
    mkdir -p "${pkgdir}/etc/xdg/autostart"
    cat << 'SCRIPT' > "${pkgdir}/etc/xdg/autostart/x64-theme-init.desktop"
[Desktop Entry]
Type=Application
Name=X64 LIOS Theme Initializer
Exec=/usr/bin/x64-theme-init
X-KDE-autostart-phase=2
SCRIPT

    # Enlace de compatibilidad qdbus -> qdbus6
    ln -sf /usr/bin/qdbus6 "${pkgdir}/usr/bin/qdbus"

    # Configurar SDDM para que use el wallpaper v2
    mkdir -p "${pkgdir}/usr/share/sddm/themes/breeze"
    cat << 'SDDMCONF' > "${pkgdir}/usr/share/sddm/themes/breeze/theme.conf.user"
[General]
background=/usr/share/backgrounds/x64-lios/x64-lios-v2.jpg
SDDMCONF
}
