pkgname=x64-kde-settings
pkgver=1.0.0
pkgrel=19
pkgdesc="Official X64 LIOS KDE Plasma 6 Desktop Configuration, Wallpapers and SDDM Theme"
arch=('any')
license=('GPL')
install='x64-kde-settings.install'
depends=('plasma-desktop' 'breeze' 'breeze-icons' 'breeze-gtk' 'xdg-user-dirs' 'sddm')
source=('01-monolith.jpg'
        '02-v3-carbon.jpg'
        '03-v2-shield.jpg'
        '04-hybrid-plate.jpg'
        '05-faceted-armor.jpg'
        '06-stealth-dark.jpg'
        'screenshot-01.png'
        'screenshot-02.png'
        'screenshot-03.png'
        'screenshot-04.png'
        'screenshot-05.png'
        'screenshot-06.png'
        'x64-logo.png'
        'x64-layout.js'
        'plasmashellrc'
        'plasma-org.kde.plasma.desktop-appletsrc'
        'kdeglobals'
        'kwinrc'
        'gtk3-settings.ini'
        'gtk4-settings.ini'
        'baloofilerc'
        'ksmserverrc'
        'org.kde.discover.notifier.desktop'
        'org.kde.kdeconnect.daemon.desktop'
        'plasmarc'
        'kscreenlockerrc'
        'x64-theme-init.sh'
        'set-default-wallpaper.sh'
        'x64-kde-wallpaper-defaults.hook')
sha256sums=('5212eb679eafcc0bda672c2fa19e5fc337d0cb2736b14c0e216fc73d2a0a692d'
