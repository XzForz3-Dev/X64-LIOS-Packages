pkgname=x64-kde-settings
pkgver=1.0.0
pkgrel=10
pkgdesc="Official X64 LIOS KDE Plasma 6 Desktop Configuration, Wallpapers and SDDM Theme"
arch=('any')
license=('GPL')
install='x64-kde-settings.install'
depends=('plasma-desktop' 'sddm')
source=('x64-lios-v2.jpg'
        'x64-lios-v3.jpg'
        'x64-logo.png'
        'x64-layout.js'
        'plasmashellrc'
        'plasma-org.kde.plasma.desktop-appletsrc'
        'kdeglobals'
        'kwinrc'
        'gtk3-settings.ini'
        'gtk4-settings.ini'
        'baloofilerc'
        'org.kde.discover.notifier.desktop'
        'org.kde.kdeconnect.daemon.desktop')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
    # Instalar fondos de pantalla
    mkdir -p "${pkgdir}/usr/share/backgrounds/x64-lios"
    cp "${srcdir}/x64-lios-v2.jpg" "${pkgdir}/usr/share/backgrounds/x64-lios/"
    cp "${srcdir}/x64-lios-v3.jpg" "${pkgdir}/usr/share/backgrounds/x64-lios/"
    
    # Instalar logo
    mkdir -p "${pkgdir}/usr/share/pixmaps"
    cp "${srcdir}/x64-logo.png" "${pkgdir}/usr/share/pixmaps/x64-logo.png"

    # Instalar layout en ruta segura
    mkdir -p "${pkgdir}/usr/share/x64-lios"
    cp "${srcdir}/x64-layout.js" "${pkgdir}/usr/share/x64-lios/x64-layout.js"

    # Instalar configuraciones maestras en /etc/skel para nuevos usuarios / Calamares
    mkdir -p "${pkgdir}/etc/skel/.config/kdedefaults"
    mkdir -p "${pkgdir}/etc/skel/.config/gtk-3.0"
    mkdir -p "${pkgdir}/etc/skel/.config/gtk-4.0"

    cp "${srcdir}/plasmashellrc" "${pkgdir}/etc/skel/.config/plasmashellrc"
    cp "${srcdir}/plasma-org.kde.plasma.desktop-appletsrc" "${pkgdir}/etc/skel/.config/plasma-org.kde.plasma.desktop-appletsrc"
    cp "${srcdir}/kdeglobals" "${pkgdir}/etc/skel/.config/kdeglobals"
    cp "${srcdir}/kdeglobals" "${pkgdir}/etc/skel/.config/kdedefaults/kdeglobals"
    cp "${srcdir}/kwinrc" "${pkgdir}/etc/skel/.config/kwinrc"
    cp "${srcdir}/kwinrc" "${pkgdir}/etc/skel/.config/kdedefaults/kwinrc"
    cp "${srcdir}/gtk3-settings.ini" "${pkgdir}/etc/skel/.config/gtk-3.0/settings.ini"
    cp "${srcdir}/gtk4-settings.ini" "${pkgdir}/etc/skel/.config/gtk-4.0/settings.ini"

    # Desactivar indexador Baloo (cero sobrecarga de disco/CPU para gaming)
    cp "${srcdir}/baloofilerc" "${pkgdir}/etc/skel/.config/baloofilerc"
    mkdir -p "${pkgdir}/etc/xdg"
    cp "${srcdir}/baloofilerc" "${pkgdir}/etc/xdg/baloofilerc"

    # Desactivar demonios de fondo redundantes en autostart (DiscoverNotifier y KDE Connect)
    mkdir -p "${pkgdir}/etc/skel/.config/autostart"
    cp "${srcdir}/org.kde.discover.notifier.desktop" "${pkgdir}/etc/skel/.config/autostart/org.kde.discover.notifier.desktop"
    cp "${srcdir}/org.kde.kdeconnect.daemon.desktop" "${pkgdir}/etc/skel/.config/autostart/org.kde.kdeconnect.daemon.desktop"

    # Crear script de auto-arranque para aplicar el wallpaper oficial en Plasma
    mkdir -p "${pkgdir}/etc/xdg/autostart"
    cat << 'SCRIPT' > "${pkgdir}/etc/xdg/autostart/x64-theme-init.desktop"
[Desktop Entry]
Type=Application
Name=X64 LIOS Theme Initializer
Exec=sh -c '(for i in $(seq 1 20); do if qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.dumpCurrentLayoutMainScript >/dev/null 2>&1; then break; fi; sleep 0.5; done; plasma-apply-wallpaperimage /usr/share/backgrounds/x64-lios/x64-lios-v3.jpg) &'
X-KDE-autostart-phase=1
SCRIPT

    # Enlace de compatibilidad qdbus -> qdbus6
    mkdir -p "${pkgdir}/usr/bin"
    ln -sf /usr/bin/qdbus6 "${pkgdir}/usr/bin/qdbus"

    # Configurar SDDM para que use el wallpaper v2
    mkdir -p "${pkgdir}/usr/share/sddm/themes/breeze"
    cat << 'SDDMCONF' > "${pkgdir}/usr/share/sddm/themes/breeze/theme.conf.user"
[General]
background=/usr/share/backgrounds/x64-lios/x64-lios-v2.jpg
SDDMCONF
}
