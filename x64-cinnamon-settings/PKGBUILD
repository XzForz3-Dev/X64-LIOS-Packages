pkgname=x64-cinnamon-settings
pkgver=1.0.0
pkgrel=4
pkgdesc="Configuracion oficial de X64 LIOS para escritorio Cinnamon y LightDM Slick Greeter"
arch=('any')
license=('GPL')
install='x64-cinnamon-settings.install'
depends=('cinnamon' 'lightdm' 'lightdm-slick-greeter' 'papirus-icon-theme' 'glib2')
source=('cinnamon-login.jpg'
        'cinnamon-desktop.jpg'
        '60-slick-greeter.conf'
        'slick-greeter.conf'
        'zzz_x64.cinnamon.gschema.override'
        'x64-logo.png'
        'menu-0.json')
sha256sums=('SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP')

package() {
    # 1. Fondos oficiales X64 LIOS para Login Slick Greeter y Escritorio Cinnamon
    install -d "${pkgdir}/usr/share/backgrounds/x64-lios"
    install -m644 "${srcdir}/cinnamon-login.jpg" "${pkgdir}/usr/share/backgrounds/x64-lios/cinnamon-login.jpg"
    install -m644 "${srcdir}/cinnamon-desktop.jpg" "${pkgdir}/usr/share/backgrounds/x64-lios/cinnamon-desktop.jpg"

    # 2. Drop-in de LightDM para forzar slick-greeter (evita pantalla negra en boot)
    install -d "${pkgdir}/etc/lightdm/lightdm.conf.d"
    install -m644 "${srcdir}/60-slick-greeter.conf" "${pkgdir}/etc/lightdm/lightdm.conf.d/60-slick-greeter.conf"

    # 3. Configuracion de Slick Greeter (fondo a medida y tema oscuro)
    install -d "${pkgdir}/etc/lightdm"
    install -m644 "${srcdir}/slick-greeter.conf" "${pkgdir}/etc/lightdm/slick-greeter.conf"

    # 4. GSettings Overrides para Cinnamon (tema oscuro, iconos y fondo Monolith por defecto)
    install -d "${pkgdir}/usr/share/glib-2.0/schemas"
    install -m644 "${srcdir}/zzz_x64.cinnamon.gschema.override" \
        "${pkgdir}/usr/share/glib-2.0/schemas/zzz_x64.cinnamon.gschema.override"

    # 5. Icono oficial X64 para Menu de Aplicaciones Cinnamon
    install -d "${pkgdir}/usr/share/pixmaps"
    install -m644 "${srcdir}/x64-logo.png" "${pkgdir}/usr/share/pixmaps/x64-logo.png"
    install -d "${pkgdir}/usr/share/icons/hicolor/512x512/apps"
    install -m644 "${srcdir}/x64-logo.png" "${pkgdir}/usr/share/icons/hicolor/512x512/apps/x64-logo.png"

    # 6. Template de spices Cinnamon para menu con emblema X oficial
    install -d "${pkgdir}/etc/skel/.config/cinnamon/spices/menu@cinnamon.org"
    install -m644 "${srcdir}/menu-0.json" "${pkgdir}/etc/skel/.config/cinnamon/spices/menu@cinnamon.org/0.json"
}
