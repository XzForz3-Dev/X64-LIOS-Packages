pkgname=x64-cinnamon-settings
pkgver=1.0.0
pkgrel=7
pkgdesc="Configuracion oficial de X64 LIOS para escritorio Cinnamon y LightDM Slick Greeter"
arch=('any')
license=('GPL')
install='x64-cinnamon-settings.install'
depends=(
    'cinnamon'
    'lightdm'
    'lightdm-slick-greeter'
    'papirus-icon-theme'
    'adw-gtk-theme'
    'gnome-screenshot'
    'gnome-terminal'
    'glib2'
    'kitty'
    'ttf-jetbrains-mono-nerd'
)
source=(
    'cinnamon-login.jpg'
    'cinnamon-desktop.jpg'
    '60-slick-greeter.conf'
    'slick-greeter.conf'
    'zzz_x64.cinnamon.gschema.override'
    'x64-logo.png'
    'default-avatar.png'
    'chromium-flags.conf'
    'menu-0.json'
    'grouped-window-list-2.json'
)
sha256sums=(
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
)

package() {
    # 1. Fondos oficiales X64 LIOS para Login Slick Greeter y Escritorio Cinnamon (con alias estandar)
    install -d "${pkgdir}/usr/share/backgrounds/x64-lios"
    install -m644 "${srcdir}/cinnamon-login.jpg" "${pkgdir}/usr/share/backgrounds/x64-lios/cinnamon-login.jpg"
    install -m644 "${srcdir}/cinnamon-desktop.jpg" "${pkgdir}/usr/share/backgrounds/x64-lios/cinnamon-desktop.jpg"
    ln -sf cinnamon-desktop.jpg "${pkgdir}/usr/share/backgrounds/x64-lios/01-monolith.jpg"
    ln -sf cinnamon-login.jpg "${pkgdir}/usr/share/backgrounds/x64-lios/07-slick-greeter-dock.jpg"

    # Chromium Flags (Ozone auto + gnome-libsecret)
    install -Dm644 "${srcdir}/chromium-flags.conf" "${pkgdir}/etc/chromium-flags.conf"

    # 2. Drop-in de LightDM para forzar slick-greeter (evita pantalla negra en boot)
    install -d "${pkgdir}/etc/lightdm/lightdm.conf.d"
    install -m644 "${srcdir}/60-slick-greeter.conf" "${pkgdir}/etc/lightdm/lightdm.conf.d/60-slick-greeter.conf"

    # 3. Configuracion de Slick Greeter (fondo a medida y tema oscuro)
    install -d "${pkgdir}/etc/lightdm"
    install -m644 "${srcdir}/slick-greeter.conf" "${pkgdir}/etc/lightdm/slick-greeter.conf"

    # 4. GSettings Overrides para Cinnamon (tema oscuro, atajos Super+Return/Super+Shift+S, energia DPMS sin S3)
    install -d "${pkgdir}/usr/share/glib-2.0/schemas"
    install -m644 "${srcdir}/zzz_x64.cinnamon.gschema.override" \
        "${pkgdir}/usr/share/glib-2.0/schemas/zzz_x64.cinnamon.gschema.override"

    # 5. Icono oficial X64 para Menu de Aplicaciones Cinnamon y Avatar por defecto
    install -d "${pkgdir}/usr/share/pixmaps"
    install -m644 "${srcdir}/x64-logo.png" "${pkgdir}/usr/share/pixmaps/x64-logo.png"
    install -m644 "${srcdir}/default-avatar.png" "${pkgdir}/usr/share/pixmaps/default-avatar.png"
    install -d "${pkgdir}/usr/share/icons/hicolor/512x512/apps"
    install -m644 "${srcdir}/x64-logo.png" "${pkgdir}/usr/share/icons/hicolor/512x512/apps/x64-logo.png"
    install -d "${pkgdir}/etc/skel"
    install -m644 "${srcdir}/default-avatar.png" "${pkgdir}/etc/skel/.face"
    install -m644 "${srcdir}/default-avatar.png" "${pkgdir}/etc/skel/.face.icon"

    # 6. Compatibilidad GTK3 Adwaita-dark -> adw-gtk3-dark y enlaces de icono Antigravity IDE
    install -d "${pkgdir}/usr/share/themes"
    ln -sf adw-gtk3-dark "${pkgdir}/usr/share/themes/Adwaita-dark"
    for size in 16x16 22x22 24x24 32x32 48x48 64x64; do
        install -d "${pkgdir}/usr/share/icons/Papirus/${size}/apps"
        ln -sf antigravity.svg "${pkgdir}/usr/share/icons/Papirus/${size}/apps/antigravity-ide.svg"
    done
    install -d "${pkgdir}/usr/share/icons/hicolor/scalable/apps"
    ln -sf /usr/share/icons/Papirus/64x64/apps/antigravity.svg "${pkgdir}/usr/share/icons/hicolor/scalable/apps/antigravity-ide.svg"

    # 7. Template de spices Cinnamon para menu con emblema X oficial
    install -d "${pkgdir}/etc/skel/.config/cinnamon/spices/menu@cinnamon.org"
    install -m644 "${srcdir}/menu-0.json" "${pkgdir}/etc/skel/.config/cinnamon/spices/menu@cinnamon.org/0.json"

    # 8. Template de spices Cinnamon para panel con pines oficiales (X64 Hello, Chromium, Kitty, Nemo)
    install -d "${pkgdir}/etc/skel/.config/cinnamon/spices/grouped-window-list@cinnamon.org"
    install -m644 "${srcdir}/grouped-window-list-2.json" "${pkgdir}/etc/skel/.config/cinnamon/spices/grouped-window-list@cinnamon.org/2.json"
}
