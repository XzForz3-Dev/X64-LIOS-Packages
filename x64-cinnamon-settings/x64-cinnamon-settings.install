post_install() {
    glib-compile-schemas /usr/share/glib-2.0/schemas 2>/dev/null || true
    gtk-update-icon-cache -f -t /usr/share/icons/hicolor 2>/dev/null || true
    gtk-update-icon-cache -f /usr/share/icons/Papirus 2>/dev/null || true
    gtk-update-icon-cache -f /usr/share/icons/Papirus-Dark 2>/dev/null || true

    # Auto-desbloqueo transparente de gnome-keyring en LightDM
    for pam_file in /etc/pam.d/lightdm /etc/pam.d/lightdm-autologin /etc/pam.d/login; do
        if [ -f "$pam_file" ]; then
            if ! grep -q "pam_gnome_keyring.so" "$pam_file"; then
                sed -i '/auth.*include.*system-local-login/a -auth      optional     pam_gnome_keyring.so' "$pam_file" 2>/dev/null || true
                sed -i '/session.*include.*system-local-login/a -session   optional     pam_gnome_keyring.so auto_start' "$pam_file" 2>/dev/null || true
                if grep -q "^password.*include.*system-local-login" "$pam_file"; then
                    sed -i '/password.*include.*system-local-login/a -password  optional     pam_gnome_keyring.so' "$pam_file" 2>/dev/null || true
                fi
            fi
        fi
    done

    # Ocultar utilidades redundantes o de desarrollo Qt en el Menu de Aplicaciones de Cinnamon
    if [ -f /usr/share/applications/fcitx5-configtool.desktop ]; then
        sed -i 's/^NotShowIn=.*/NotShowIn=KDE;GNOME;COSMIC;X-Cinnamon;/' /usr/share/applications/fcitx5-configtool.desktop 2>/dev/null || true
    fi
    if [ -f /usr/share/applications/nm-connection-editor.desktop ]; then
        if grep -q "^NotShowIn=" /usr/share/applications/nm-connection-editor.desktop; then
            sed -i 's/^NotShowIn=.*/NotShowIn=GNOME;COSMIC;KDE;X-Cinnamon;/' /usr/share/applications/nm-connection-editor.desktop 2>/dev/null || true
        else
            echo "NotShowIn=GNOME;COSMIC;KDE;X-Cinnamon;" >> /usr/share/applications/nm-connection-editor.desktop
        fi
    fi
    if [ -f /usr/share/applications/org.gnome.Screenshot.desktop ]; then
        if grep -q "^NotShowIn=" /usr/share/applications/org.gnome.Screenshot.desktop; then
            sed -i 's/^NotShowIn=.*/NotShowIn=X-Cinnamon;Cinnamon;/' /usr/share/applications/org.gnome.Screenshot.desktop 2>/dev/null || true
        else
            echo "NotShowIn=X-Cinnamon;Cinnamon;" >> /usr/share/applications/org.gnome.Screenshot.desktop
        fi
    fi
    for qt_app in assistant designer linguist qdbusviewer qv4l2 qvidcap; do
        if [ -f "/usr/share/applications/${qt_app}.desktop" ]; then
            if ! grep -q "NoDisplay" "/usr/share/applications/${qt_app}.desktop"; then
                echo "NoDisplay=true" >> "/usr/share/applications/${qt_app}.desktop"
            fi
        fi
    done

    # Limpiar variables residuales de KDE en /etc/environment si existen
    if [ -f /etc/environment ]; then
        sed -i '/^QT_QPA_PLATFORMTHEME=kde$/d; /^KDE_SESSION_VERSION=6$/d' /etc/environment 2>/dev/null || true
    fi

    # Propagar configuracion del boton de inicio y panel a los usuarios existentes
    for user_dir in /home/*; do
        if [ -d "$user_dir" ]; then
            u=$(basename "$user_dir")
            g=$(id -gn "$u" 2>/dev/null || echo "$u")

            # 1. Menu oficial con boton X
            target_menu="$user_dir/.config/cinnamon/spices/menu@cinnamon.org"
            mkdir -p "$target_menu"
            if [ -f /etc/skel/.config/cinnamon/spices/menu@cinnamon.org/0.json ]; then
                cp -f /etc/skel/.config/cinnamon/spices/menu@cinnamon.org/0.json "$target_menu/0.json"
            fi

            # 2. Panel con lanzadores oficiales (X64 Hello, Chromium, Kitty, Nemo)
            target_panel="$user_dir/.config/cinnamon/spices/grouped-window-list@cinnamon.org"
            mkdir -p "$target_panel"
            if [ -f /etc/skel/.config/cinnamon/spices/grouped-window-list@cinnamon.org/2.json ]; then
                cp -f /etc/skel/.config/cinnamon/spices/grouped-window-list@cinnamon.org/2.json "$target_panel/2.json"
            fi

            # 2.0 Liberar atajo <Shift><Super>s del applet de sonido (sound@cinnamon.org) en perfiles existentes
            target_sound="$user_dir/.config/cinnamon/spices/sound@cinnamon.org"
            if [ -d "$target_sound" ]; then
                python3 -c '
import glob, json, sys
for path in glob.glob(sys.argv[1] + "/*.json"):
    try:
        with open(path, "r", encoding="utf-8") as f:
            data = json.load(f)
        ko = data.get("keyOpen")
        if isinstance(ko, dict):
            val = str(ko.get("value", ""))
            low = val.lower()
            if "<super>" in low and "<shift>" in low and low.endswith("s"):
                ko["value"] = ""
                with open(path, "w", encoding="utf-8") as f:
                    json.dump(data, f, indent=4, ensure_ascii=False)
    except Exception:
        pass
' "$target_sound" 2>/dev/null || true
            fi

            # 2.1 Limpiar residuos GTK3/GTK4 de KDE/COSMIC/Xfce y portales heredados, y aplicar acento Carmesi X64
            rm -rf "$user_dir/.config/gtk-3.0/assets" "$user_dir/.config/gtk-3.0/colors.css" "$user_dir/.config/gtk-3.0/window_decorations.css" "$user_dir/.config/gtk-3.0/gtk.css" "$user_dir/.config/gtk-3.0/gtk.css.bak" 2>/dev/null || true
            rm -rf "$user_dir/.config/gtk-4.0/assets" "$user_dir/.config/gtk-4.0/colors.css" "$user_dir/.config/gtk-4.0/window_decorations.css" "$user_dir/.config/gtk-4.0/cosmic" "$user_dir/.config/gtk-4.0/gtk.css" "$user_dir/.config/gtk-4.0/gtk.css.bak" 2>/dev/null || true
            mkdir -p "$user_dir/.config/gtk-3.0" "$user_dir/.config/gtk-4.0"
            if [ -f /etc/skel/.config/gtk-3.0/gtk.css ]; then
                cp -f /etc/skel/.config/gtk-3.0/gtk.css "$user_dir/.config/gtk-3.0/gtk.css"
                chown "$u:$g" "$user_dir/.config/gtk-3.0/gtk.css" 2>/dev/null || true
            fi
            if [ -f /etc/skel/.config/gtk-4.0/gtk.css ]; then
                cp -f /etc/skel/.config/gtk-4.0/gtk.css "$user_dir/.config/gtk-4.0/gtk.css"
                chown "$u:$g" "$user_dir/.config/gtk-4.0/gtk.css" 2>/dev/null || true
            fi
            rm -f "$user_dir/.gtkrc-2.0" "$user_dir/.config/xdg-desktop-portal/hyprland-portals.conf" 2>/dev/null || true
            rmdir "$user_dir/.config/xdg-desktop-portal" 2>/dev/null || true
            for gset in "$user_dir/.config/gtk-3.0/settings.ini" "$user_dir/.config/gtk-4.0/settings.ini"; do
                if [ -f "$gset" ]; then
                    sed -i 's/gtk-cursor-theme-name=breeze_cursors/gtk-cursor-theme-name=Adwaita/g' "$gset" 2>/dev/null || true
                fi
            done
            if [ -f "$user_dir/.config/mimeapps.list" ]; then
                sed -i 's/google-chrome\.desktop/chromium.desktop/g' "$user_dir/.config/mimeapps.list" 2>/dev/null || true
                sed -i '/HEY\.desktop/d; /superwhisper-url\.desktop/d' "$user_dir/.config/mimeapps.list" 2>/dev/null || true
            fi

            # 3. Avatar neutral oficial si no existe uno personalizado
            if [ -f "$user_dir/.face" ] && cmp -s "$user_dir/.face" /usr/share/pixmaps/x64-logo.png; then
                cp -f /etc/skel/.face "$user_dir/.face"
                cp -f /etc/skel/.face.icon "$user_dir/.face.icon"
            elif [ ! -f "$user_dir/.face" ] && [ -f /etc/skel/.face ]; then
                cp -f /etc/skel/.face "$user_dir/.face"
                cp -f /etc/skel/.face.icon "$user_dir/.face.icon"
            fi
            chown "$u:$g" "$user_dir/.face" "$user_dir/.face.icon" 2>/dev/null || true

            if [ -d "/var/lib/AccountsService/users" ]; then
                mkdir -p /var/lib/AccountsService/icons
                cp -f /usr/share/pixmaps/default-avatar.png /var/lib/AccountsService/icons/"$u" 2>/dev/null || true
                cat << ACC_EOF > /var/lib/AccountsService/users/"$u" 2>/dev/null || true
[User]
Icon=/var/lib/AccountsService/icons/${u}
Session=cinnamon
XSession=cinnamon
ACC_EOF
            fi

            chown -R "$u:$g" "$user_dir/.config/cinnamon" 2>/dev/null || true

            # 4. Inyectar dconf y notificar a Cinnamon vivo para usuarios existentes (siempre via /bin/bash aunque el shell del usuario sea Fish)
            uid=$(id -u "$u" 2>/dev/null || true)
            runuser -u "$u" -- /bin/bash -s "$uid" "$user_dir" <<'EOF_DCONF' 2>/dev/null || true
uid="$1"
user_dir="$2"
export HOME="$user_dir"
if [ -n "$uid" ] && [ -S "/run/user/$uid/bus" ]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus"
    DCONF_CMD="dconf"
    for sj in "$user_dir/.config/cinnamon/spices/sound@cinnamon.org"/*.json; do
        [ -f "$sj" ] || continue
        inst_id=$(basename "$sj" .json)
        gdbus call --session --dest org.Cinnamon --object-path /org/Cinnamon --method org.Cinnamon.updateSetting "sound@cinnamon.org" "$inst_id" "keyOpen" "'\"\"'" >/dev/null 2>&1 || true
    done
else
    DCONF_CMD="dbus-run-session -- dconf"
fi
$DCONF_CMD write /org/cinnamon/desktop/background/picture-uri "'file:///usr/share/backgrounds/x64-lios/cinnamon-desktop.jpg'" 2>/dev/null || true
$DCONF_CMD write /org/cinnamon/desktop/background/picture-options "'zoom'" 2>/dev/null || true
$DCONF_CMD write /org/cinnamon/desktop/interface/gtk-theme "'adw-gtk3-dark'" 2>/dev/null || true
$DCONF_CMD write /org/cinnamon/desktop/interface/icon-theme "'Papirus-Dark'" 2>/dev/null || true
$DCONF_CMD write /org/cinnamon/desktop/wm/preferences/theme "'adw-gtk3-dark'" 2>/dev/null || true
$DCONF_CMD write /org/cinnamon/desktop/wm/preferences/button-layout "':minimize,maximize,close'" 2>/dev/null || true
$DCONF_CMD write /org/cinnamon/theme/name "'X64-Stealth'" 2>/dev/null || true
$DCONF_CMD write /org/x/apps/portal/color-scheme "'prefer-dark'" 2>/dev/null || true
$DCONF_CMD write /org/gnome/desktop/interface/gtk-theme "'adw-gtk3-dark'" 2>/dev/null || true
$DCONF_CMD write /org/gnome/desktop/interface/color-scheme "'prefer-dark'" 2>/dev/null || true
$DCONF_CMD write /org/gnome/desktop/interface/icon-theme "'Papirus-Dark'" 2>/dev/null || true
$DCONF_CMD write /org/cinnamon/desktop/default-applications/terminal/exec "'kitty'" 2>/dev/null || true
$DCONF_CMD write /org/cinnamon/desktop/default-applications/terminal/exec-arg "'-e'" 2>/dev/null || true
$DCONF_CMD write /org/cinnamon/desktop/keybindings/media-keys/terminal "['<Primary><Alt>t', '<Super>Return']" 2>/dev/null || true
# Liberar <Shift><Super>s y <Control><Shift>s de media-keys (ActionMode.NORMAL) para usar Custom Keybindings (ActionMode.NORMAL | POPUP)
$DCONF_CMD write /org/cinnamon/desktop/keybindings/media-keys/area-screenshot "['<Shift>Print']" 2>/dev/null || true
$DCONF_CMD write /org/cinnamon/desktop/keybindings/media-keys/area-screenshot-clip "['<Control><Shift>Print']" 2>/dev/null || true
# Registrar atajos soberanos de captura freeze-frame (funcionan incluso con el Menu de Aplicaciones abierto)
$DCONF_CMD write /org/cinnamon/desktop/keybindings/custom-keybindings/custom-x64-area-screenshot/name "'X64 Captura de Area'" 2>/dev/null || true
$DCONF_CMD write /org/cinnamon/desktop/keybindings/custom-keybindings/custom-x64-area-screenshot/command "'/usr/bin/x64-cinnamon-screenshot --area'" 2>/dev/null || true
$DCONF_CMD write /org/cinnamon/desktop/keybindings/custom-keybindings/custom-x64-area-screenshot/binding "['<Shift><Super>s']" 2>/dev/null || true
$DCONF_CMD write /org/cinnamon/desktop/keybindings/custom-keybindings/custom-x64-area-screenshot-clip/name "'X64 Captura de Area (Portapapeles)'" 2>/dev/null || true
$DCONF_CMD write /org/cinnamon/desktop/keybindings/custom-keybindings/custom-x64-area-screenshot-clip/command "'/usr/bin/x64-cinnamon-screenshot --area --clipboard'" 2>/dev/null || true
$DCONF_CMD write /org/cinnamon/desktop/keybindings/custom-keybindings/custom-x64-area-screenshot-clip/binding "['<Control><Shift>s']" 2>/dev/null || true
if [ "$DCONF_CMD" = "dconf" ]; then
    sleep 0.2
fi
MERGED_CUSTOM=$(python3 -c '
import ast, subprocess
try:
    raw = subprocess.check_output(["dconf", "read", "/org/cinnamon/desktop/keybindings/custom-list"], text=True).strip()
    items = [x for x in (ast.literal_eval(raw) if raw and raw.startswith("[") else []) if x != "__dummy__"]
except Exception:
    items = []
for k in ("custom-x64-area-screenshot", "custom-x64-area-screenshot-clip"):
    if k not in items:
        items.append(k)
print(repr(items))
' 2>/dev/null || echo "['custom-x64-area-screenshot', 'custom-x64-area-screenshot-clip']")
if [ "$DCONF_CMD" = "dconf" ]; then
    $DCONF_CMD write /org/cinnamon/desktop/keybindings/custom-list "['__dummy__']" 2>/dev/null || true
    sleep 0.15
fi
$DCONF_CMD write /org/cinnamon/desktop/keybindings/custom-list "$MERGED_CUSTOM" 2>/dev/null || true
$DCONF_CMD write /org/cinnamon/settings-daemon/plugins/power/sleep-inactive-ac-timeout 0 2>/dev/null || true
$DCONF_CMD write /org/cinnamon/settings-daemon/plugins/power/sleep-inactive-ac-type "'nothing'" 2>/dev/null || true
$DCONF_CMD write /org/cinnamon/settings-daemon/plugins/power/sleep-inactive-battery-timeout 0 2>/dev/null || true
$DCONF_CMD write /org/cinnamon/settings-daemon/plugins/power/sleep-inactive-battery-type "'nothing'" 2>/dev/null || true
$DCONF_CMD write /org/cinnamon/settings-daemon/plugins/power/idle-dim-ac false 2>/dev/null || true
$DCONF_CMD write /org/gnome/terminal/legacy/default-show-menubar false 2>/dev/null || true
$DCONF_CMD write /org/gnome/terminal/legacy/theme-variant "'dark'" 2>/dev/null || true
P='/org/gnome/terminal/legacy/profiles:/:b1dcc9dd-5262-4d8d-a863-c897e6d979b9/'
$DCONF_CMD write "${P}use-system-font" false 2>/dev/null || true
$DCONF_CMD write "${P}font" "'JetBrainsMono Nerd Font 11'" 2>/dev/null || true
$DCONF_CMD write "${P}use-theme-colors" false 2>/dev/null || true
$DCONF_CMD write "${P}background-color" "'#08080a'" 2>/dev/null || true
$DCONF_CMD write "${P}foreground-color" "'#c0c0c0'" 2>/dev/null || true
$DCONF_CMD write "${P}bold-color-same-as-fg" true 2>/dev/null || true
$DCONF_CMD write "${P}cursor-colors-set" true 2>/dev/null || true
$DCONF_CMD write "${P}cursor-background-color" "'#ff2b2b'" 2>/dev/null || true
$DCONF_CMD write "${P}cursor-foreground-color" "'#ffffff'" 2>/dev/null || true
$DCONF_CMD write "${P}default-size-columns" 105 2>/dev/null || true
$DCONF_CMD write "${P}default-size-rows" 28 2>/dev/null || true
$DCONF_CMD write "${P}palette" "['#1c1c1c', '#ff2b2b', '#40e0d0', '#f5c211', '#1e90ff', '#ff00ff', '#00ffff', '#a8a8a8', '#4d4d4d', '#ff4d4d', '#40e0d0', '#f5c211', '#1e90ff', '#ff00ff', '#00ffff', '#ffffff']" 2>/dev/null || true
if [ "$DCONF_CMD" = "dconf" ]; then
    gdbus call --session --dest org.Cinnamon --object-path /org/Cinnamon --method org.Cinnamon.ReloadTheme >/dev/null 2>&1 || true
    gdbus call --session --dest org.Cinnamon --object-path /org/Cinnamon --method org.Cinnamon.ReloadXlet "menu@cinnamon.org" "APPLET" >/dev/null 2>&1 || true
    pkill -x nemo-desktop 2>/dev/null || true
fi
EOF_DCONF
        fi
    done
}

post_upgrade() {
    post_install
}

post_remove() {
    glib-compile-schemas /usr/share/glib-2.0/schemas 2>/dev/null || true
    gtk-update-icon-cache -f -t /usr/share/icons/hicolor 2>/dev/null || true
}
