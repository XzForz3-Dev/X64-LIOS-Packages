# -----------------------------------------------------------------------------
# 13. DYNAMIC KEYBOARD LAYOUT ENGINE & SYSTEM SYNC
# -----------------------------------------------------------------------------
keymap_to_code() {
    local km="$1"
    local km_l
    km_l=$(echo "$km" | tr '[:upper:]' '[:lower:]')
    case "$km_l" in
        *latin*|*latam*) echo "LA" ;;
        *span*|*español*|*"(es)"*|es) echo "ES" ;;
        *russ*|*русск*|*"(ru)"*|ru) echo "RU" ;;
        *"united kingdom"*|*"(uk)"*|uk|gb) echo "UK" ;;
        *germ*|*deutsch*|*"(de)"*|de) echo "DE" ;;
        *fren*|*français*|*francais*|*"(fr)"*|fr) echo "FR" ;;
        *ital*|*"(it)"*|it) echo "IT" ;;
        *port*|*"(pt)"*|pt) echo "PT" ;;
        *engl*|*"united states"*|*"(us)"*|us) echo "US" ;;
        *) echo "${km:0:2}" | tr '[:lower:]' '[:upper:]' ;;
    esac
}

_kb_primary_info() {
    local sig="$1"
    HYPRLAND_INSTANCE_SIGNATURE="$sig" hyprctl devices -j 2>/dev/null | jq -r '
        def is_pseudo:
            (.name // "" | test("video-bus|power-button|sleep-button|lid-switch|hotkey|wmi|acpi|audio|dac|headset|headphone|microphone|speaker|consumer-control|system-control|wireless-radio|webcam|camera|mouse|touchpad|trackpoint|pointer|button$"; "i"));
        def kb_rank:
            [
                (if .main then 0 else 1 end),
                (if (.name // "" | test("keyboard|kbd"; "i")) then 0 else 1 end)
            ];
        (.keyboards // []) as $all
        | ($all | map(select((.active_keymap // "") != ""))) as $valid
        | ($valid | map(select(is_pseudo | not))) as $real
        | (if ($real | length) > 0 then $real else $valid end)
        | sort_by(kb_rank)
        | .[0] // {active_keymap: "Spanish", active_layout_index: 0, layout: "es,us"}
        | [
            (.active_keymap // "Spanish"),
            ((.active_layout_index // 0) | tostring),
            (.layout // "es,us")
          ]
        | @tsv
    ' 2>/dev/null || printf 'Spanish\t0\tes,us\n'
}

cmd_keyboard() {
    local sub="${1:-get}"
    local uid_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
    local sig="${HYPRLAND_INSTANCE_SIGNATURE:-}"
    if [ -z "$sig" ] && [ -d "${uid_dir}/hypr" ]; then
        sig=$(ls -t "${uid_dir}/hypr/" 2>/dev/null | head -n1)
    fi

    case "$sub" in
        detect-system)
            local layout=""
            if command -v localectl >/dev/null 2>&1; then
                layout=$(localectl status 2>/dev/null | awk -F': ' '/X11 Layout/{print $2}' | tr -d ' ')
                if [ -z "$layout" ] || [ "$layout" = "n/a" ]; then
                    layout=$(localectl status 2>/dev/null | awk -F': ' '/VC Keymap/{print $2}' | tr -d ' ')
                fi
            fi
            if [ -z "$layout" ] || [ "$layout" = "n/a" ]; then
                [ -f /etc/vconsole.conf ] && layout=$(grep '^KEYMAP=' /etc/vconsole.conf | cut -d= -f2 | tr -d '"'\'' ')
            fi
            if [ -z "$layout" ] || [ "$layout" = "n/a" ]; then
                local raw_lang="${LC_ALL:-${LANG:-en_US.UTF-8}}"
                if [[ "$raw_lang" =~ ^es ]]; then
                    layout="es"
                else
                    layout="us"
                fi
            fi
            echo "${layout:-es}"
            ;;
        get)
            local kb_info keymap
            kb_info=$(_kb_primary_info "$sig")
            keymap=$(printf '%s\n' "$kb_info" | cut -f1)
            keymap_to_code "${keymap:-Spanish}"
            ;;
        next|toggle)
            # Compute deterministic target index from the real physical keyboard so
            # switchxkblayout re-synchronizes every keyboard device (fixing phase desync
            # caused by Alt+Shift or virtual HID devices like USB audio DACs).
            local kb_info cur_idx layout_str count next_idx
            kb_info=$(_kb_primary_info "$sig")
            cur_idx=$(printf '%s\n' "$kb_info" | cut -f2)
            layout_str=$(printf '%s\n' "$kb_info" | cut -f3)
            [[ "$cur_idx" =~ ^[0-9]+$ ]] || cur_idx=0
            if [ -n "$layout_str" ]; then
                count=$(printf '%s\n' "$layout_str" | awk -F',' '{print NF}')
            else
                count=2
            fi
            [ "${count:-0}" -lt 2 ] && count=2
            next_idx=$(( (cur_idx + 1) % count ))
            HYPRLAND_INSTANCE_SIGNATURE="$sig" hyprctl switchxkblayout all "$next_idx" >/dev/null 2>&1 || true
            cmd_keyboard get
            ;;
        set)
            local target_idx="${2:-0}"
            HYPRLAND_INSTANCE_SIGNATURE="$sig" hyprctl switchxkblayout all "$target_idx" >/dev/null 2>&1 || true
            cmd_keyboard get
            ;;
        sync)
            local sys_layout
            sys_layout=$(cmd_keyboard detect-system)
            [ -z "$sys_layout" ] && sys_layout="es"

            local pair="es,us"
            if [ "$sys_layout" = "us" ]; then
                pair="us,es"
            elif [ "$sys_layout" = "latam" ]; then
                pair="latam,us"
            else
                pair="${sys_layout},us"
            fi

            local changed=0
            local hypr_conf="${HOME}/.config/hypr/hyprland.conf"
            if [ -f "$hypr_conf" ]; then
                local curr_conf
                curr_conf=$(grep -E '^[[:space:]]*kb_layout[[:space:]]*=' "$hypr_conf" | head -n1 | awk -F'=' '{print $2}' | tr -d ' ' 2>/dev/null || echo "")
                if [ "$curr_conf" != "$pair" ]; then
                    sed -i "s/^[[:space:]]*kb_layout[[:space:]]*=.*/    kb_layout = ${pair}/" "$hypr_conf" 2>/dev/null || true
                    changed=1
                fi
            fi

            local hypr_lua="${HOME}/.config/hypr/hyprland.lua"
            if [ -f "$hypr_lua" ]; then
                local curr_lua
                curr_lua=$(grep -E '^[[:space:]]*kb_layout[[:space:]]*=' "$hypr_lua" | head -n1 | awk -F'=' '{print $2}' | sed 's/,[[:space:]]*$//' | tr -d ' "' 2>/dev/null || echo "")
                if [ "$curr_lua" != "$pair" ]; then
                    sed -i "s/^[[:space:]]*kb_layout[[:space:]]*=.*/        kb_layout  = \"${pair}\",/" "$hypr_lua" 2>/dev/null || true
                    changed=1
                fi
            fi

            if [ "$changed" -eq 1 ] && [ -n "$sig" ]; then
                HYPRLAND_INSTANCE_SIGNATURE="$sig" hyprctl reload >/dev/null 2>&1 || true
            fi
            cmd_keyboard get
            ;;
    esac
}

cmd_audio() {
    local sub="${1:-status}"

    case "$sub" in
        data|status)
            python3 -c '
import json, subprocess, os

def_sink = subprocess.run(["pactl", "get-default-sink"], capture_output=True, text=True).stdout.strip()
def_source = subprocess.run(["pactl", "get-default-source"], capture_output=True, text=True).stdout.strip()

try:
    sinks_raw = json.loads(subprocess.run(["pactl", "-f", "json", "list", "sinks"], capture_output=True, text=True).stdout or "[]")
except Exception:
    sinks_raw = []

try:
    sources_raw = json.loads(subprocess.run(["pactl", "-f", "json", "list", "sources"], capture_output=True, text=True).stdout or "[]")
except Exception:
    sources_raw = []

try:
    streams_raw = json.loads(subprocess.run(["pactl", "-f", "json", "list", "sink-inputs"], capture_output=True, text=True).stdout or "[]")
except Exception:
    streams_raw = []

overdrive_file = os.path.expanduser("~/.config/x64/audio_overdrive")
overdrive = os.path.exists(overdrive_file)

sinks = []
for s in sinks_raw:
    name = s.get("name", "")
    desc = s.get("description", "")
    vol_dict = s.get("volume", {})
    fl = vol_dict.get("front-left", {})
    val_pct_str = fl.get("value_percent", "0%").replace("%", "")
    try:
        vol_pct = int(val_pct_str)
    except Exception:
        vol_pct = 0
    is_def = (name == def_sink)
    icon = "󰓃"
    form = s.get("properties", {}).get("device.form_factor", "")
    bus = s.get("properties", {}).get("device.bus", "")
    if "hdmi" in name.lower() or "hdmi" in desc.lower():
        icon = "󰍹"
    elif "usb" in bus or "dac" in desc.lower():
        icon = "󰓋"
    elif "blue" in bus or "head" in desc.lower():
        icon = "󰋋"

    sinks.append({
        "index": s.get("index"),
        "name": name,
        "description": desc,
        "volume": vol_pct,
        "muted": s.get("mute", False),
        "isDefault": is_def,
        "icon": icon
    })

sources = []
for s in sources_raw:
    name = s.get("name", "")
    if name.endswith(".monitor"):
        continue
    desc = s.get("description", "")
    vol_dict = s.get("volume", {})
    fl = vol_dict.get("front-left", {})
    val_pct_str = fl.get("value_percent", "0%").replace("%", "")
    try:
        vol_pct = int(val_pct_str)
    except Exception:
        vol_pct = 0
    is_def = (name == def_source)
    icon = "󰍬"
    if "webcam" in desc.lower() or "cam" in desc.lower():
        icon = "󰖟"
    elif "head" in desc.lower():
        icon = "󰋎"

    sources.append({
        "index": s.get("index"),
        "name": name,
        "description": desc,
        "volume": vol_pct,
        "muted": s.get("mute", False),
        "isDefault": is_def,
        "icon": icon
    })

streams = []
for st in streams_raw:
    props = st.get("properties", {})
    app_name = props.get("application.name", "") or props.get("media.name", "App")
    icon_name = props.get("application.icon_name", "") or props.get("application.binary", "audio")
    vol_dict = st.get("volume", {})
    fl = vol_dict.get("front-left", {})
    val_pct_str = fl.get("value_percent", "0%").replace("%", "")
    try:
        vol_pct = int(val_pct_str)
    except Exception:
        vol_pct = 0

    streams.append({
        "index": st.get("index"),
        "name": app_name,
        "icon": icon_name,
        "volume": vol_pct,
        "muted": st.get("mute", False)
    })

data = {
    "sinks": sinks,
    "sources": sources,
    "streams": streams,
    "overdrive": overdrive
}
print(json.dumps(data))
'
            ;;
        set-sink)
            local target="${2:-}"
            [ -n "$target" ] && pactl set-default-sink "$target" >/dev/null 2>&1 || true
            ;;
        set-source)
            local target="${2:-}"
            [ -n "$target" ] && pactl set-default-source "$target" >/dev/null 2>&1 || true
            ;;
        set-sink-volume)
            local target="${2:-@DEFAULT_SINK@}"
            local vol="${3:-100}"
            pactl set-sink-volume "$target" "${vol}%" >/dev/null 2>&1 || true
            ;;
        set-source-volume)
            local target="${2:-@DEFAULT_SOURCE@}"
            local vol="${3:-100}"
            pactl set-source-volume "$target" "${vol}%" >/dev/null 2>&1 || true
            ;;
        toggle-sink-mute)
            local target="${2:-@DEFAULT_SINK@}"
            pactl set-sink-mute "$target" toggle >/dev/null 2>&1 || true
            ;;
        toggle-source-mute)
            local target="${2:-@DEFAULT_SOURCE@}"
            pactl set-source-mute "$target" toggle >/dev/null 2>&1 || true
            ;;
        set-stream-volume)
            local idx="${2:-}"
            local vol="${3:-100}"
            [ -n "$idx" ] && pactl set-sink-input-volume "$idx" "${vol}%" >/dev/null 2>&1 || true
            ;;
        toggle-stream-mute)
            local idx="${2:-}"
            [ -n "$idx" ] && pactl set-sink-input-mute "$idx" toggle >/dev/null 2>&1 || true
            ;;
        toggle-overdrive)
            local overdrive_file="${HOME}/.config/x64/audio_overdrive"
            mkdir -p "$(dirname "$overdrive_file")"
            if [ -f "$overdrive_file" ]; then
                rm -f "$overdrive_file"
                echo "false"
            else
                touch "$overdrive_file"
                echo "true"
            fi
            ;;
        overdrive)
            local overdrive_file="${HOME}/.config/x64/audio_overdrive"
            if [ -f "$overdrive_file" ]; then
                echo "true"
            else
                echo "false"
            fi
            ;;
    esac
}

cmd_launch_shell() {
    # Cleanly stop any prior Quickshell instance
    if pgrep -x quickshell >/dev/null 2>&1; then
        pkill -x quickshell 2>/dev/null || true
        for _ in 1 2 3 4 5 6 7 8; do
            pgrep -x quickshell >/dev/null 2>&1 || break
            sleep 0.05
        done
        pkill -9 -x quickshell 2>/dev/null || true
    fi

    local use_sw=0
    if [ -f "${HOME}/.config/hypr/quickshell_software" ]; then
        use_sw=1
    elif command -v systemd-detect-virt >/dev/null 2>&1 && systemd-detect-virt -q 2>/dev/null; then
        use_sw=1
    elif grep -qiE "QEMU|VirtualBox|KVM|VMware|Bochs" /sys/class/dmi/id/product_name /sys/class/dmi/id/sys_vendor 2>/dev/null; then
        use_sw=1
    elif ! ls /dev/dri/renderD* >/dev/null 2>&1; then
        use_sw=1
    fi

    local qs_log="${STATE_DIR}/quickshell.log"
    if [ "$use_sw" -eq 1 ]; then
        echo "software" > "${STATE_DIR}/shell_backend"
        setsid -f env -u GTK_THEME QT_QPA_PLATFORMTHEME=gtk3 KDE_SESSION_VERSION=6 QT_QUICK_BACKEND=software quickshell -n >"$qs_log" 2>&1 </dev/null
        return 0
    fi

    # Bare-metal GPU-accelerated launch with automatic fallback to software if EGL/RHI crashes
    echo "gpu" > "${STATE_DIR}/shell_backend"
    setsid -f env -u GTK_THEME -u QT_QUICK_BACKEND QT_QPA_PLATFORMTHEME=gtk3 KDE_SESSION_VERSION=6 quickshell -n >"$qs_log" 2>&1 </dev/null
    sleep 1.5
    if ! pgrep -u "$UID_NUM" -x quickshell >/dev/null 2>&1; then
        echo "software-fallback" > "${STATE_DIR}/shell_backend"
        setsid -f env -u GTK_THEME QT_QPA_PLATFORMTHEME=gtk3 KDE_SESSION_VERSION=6 QT_QUICK_BACKEND=software quickshell -n >>"$qs_log" 2>&1 </dev/null
    fi
}

cmd_scheduler() {
    local action="${1:-toggle}"
    if ! command -v scxctl >/dev/null 2>&1; then
        if [ "$IS_ES" -eq 1 ]; then
            notify-send -a "Gaming X64" "Planificador X64" "scxctl no está instalado en el sistema" 2>/dev/null || true
        else
            notify-send -a "X64 Gaming" "X64 Scheduler" "scxctl is not installed on this system" 2>/dev/null || true
        fi
        return 1
    fi

    local cur_state="disabled"
    [ -r /sys/kernel/sched_ext/state ] && read -r cur_state < /sys/kernel/sched_ext/state 2>/dev/null || true

    local target="$action"
    if [ "$action" = "toggle" ]; then
        if [ "$cur_state" = "enabled" ]; then
            target="bore"
        else
            target="lavd"
        fi
    fi

    local ok=0
    case "$target" in
        bore|stop|off)
            if scxctl stop >/dev/null 2>&1; then
                ok=1
            fi
            ;;
        lavd|scx_lavd|on)
            if [ "$cur_state" = "enabled" ]; then
                if scxctl switch -s lavd -m gaming >/dev/null 2>&1; then
                    ok=1
                fi
            else
                if scxctl start -s lavd -m gaming >/dev/null 2>&1; then
                    ok=1
                fi
            fi
            ;;
        status|get)
            scxctl get 2>/dev/null || echo "BORE"
            return 0
            ;;
    esac

    if [ "$ok" -eq 1 ]; then
        if [ "$target" = "bore" ] || [ "$target" = "stop" ] || [ "$target" = "off" ]; then
            # Wait briefly for sched_ext BPF ops to detach cleanly before notifying UI
            for _i in $(seq 1 20); do
                _st="disabled"
                [ -r /sys/kernel/sched_ext/state ] && read -r _st < /sys/kernel/sched_ext/state 2>/dev/null || true
                [ "$_st" != "enabled" ] && break
                sleep 0.1
            done
            if [ "$IS_ES" -eq 1 ]; then
                notify-send -a "Gaming X64" "Planificador CPU: BORE" "Cambiado al planificador nativo del kernel (BORE)" 2>/dev/null || true
            else
                notify-send -a "X64 Gaming" "CPU Scheduler: BORE" "Switched to native kernel scheduler (BORE)" 2>/dev/null || true
            fi
        else
            # Wait briefly for eBPF verifier + sched_ext ops to finish attaching
            for _i in $(seq 1 30); do
                _st="disabled"
                [ -r /sys/kernel/sched_ext/state ] && read -r _st < /sys/kernel/sched_ext/state 2>/dev/null || true
                [ "$_st" = "enabled" ] && break
                sleep 0.1
            done
            if [ "$IS_ES" -eq 1 ]; then
                notify-send -a "Gaming X64" "Planificador CPU: scx_lavd" "Activado scx_lavd en modo Gaming (1% Low FPS)" 2>/dev/null || true
            else
                notify-send -a "X64 Gaming" "CPU Scheduler: scx_lavd" "Activated scx_lavd in Gaming mode (1% Low FPS)" 2>/dev/null || true
            fi
        fi
        quickshell ipc call sys refresh >/dev/null 2>&1 || true
        return 0
    fi
    return 1
}

cmd_init() {
    # Synchronize keyboard layout with system settings
    cmd_keyboard sync >/dev/null 2>&1 || true
}

cmd_fullscreen_state() {
    local fs="0" gm="0"
    if hyprctl activeworkspace -j 2>/dev/null | grep -q '"hasfullscreen": true'; then
        fs="1"
    fi

    local auto_en src
    auto_en=$(cat "${STATE_DIR}/auto_gaming" 2>/dev/null || echo "1")
    src=$(cat "${STATE_DIR}/gaming_mode_source" 2>/dev/null || echo "none")

    if [ "$auto_en" = "1" ] || [ "$src" = "auto" ]; then
        if command -v jq >/dev/null 2>&1; then
            gm=$(hyprctl clients -j 2>/dev/null | jq -r '
                any(.[];
                    ((.fullscreen // 0) >= 2) and (
                        ((.class // "") | test("^(steam_app_|gamescope|cs2|dota2|osu!|retroarch|wine|proton|minecraft|factorio|hl2_linux|portal2_linux|tf_linux64|dolphin-emu|pcsx2|rpcs3|ryujinx|cemu|duckstation|flycast|xemu|ppsspp|mgba|melonds)"; "i"))
                        or
                        ((.initialClass // "") | test("^(steam_app_|gamescope|wine|proton)"; "i"))
                    )
                ) | if . then "1" else "0" end
            ' 2>/dev/null || echo "0")
            [ "$gm" = "1" ] || gm="0"
        fi
    fi

    printf '%s|%s\n' "$fs" "$gm"
}

case "${1:-status}" in
    status)           cmd_status ;;
    status-lite)      cmd_status_lite "${2:-}" ;;
    fullscreen-state) cmd_fullscreen_state ;;
