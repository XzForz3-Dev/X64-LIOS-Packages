# 9. X64 AI HUB & DROPDOWN SCRATCHPAD (SUPER + S / SUPER + A)
# -----------------------------------------------------------------------------
get_effective_ai_engine() {
    if [ -s "${STATE_DIR}/ai_engine" ]; then
        cat "${STATE_DIR}/ai_engine" 2>/dev/null | tr -d '[:space:]'
        return 0
    fi
    if [ -s "${HOME}/.config/hypr/ai_engine" ]; then
        local saved
        saved=$(cat "${HOME}/.config/hypr/ai_engine" 2>/dev/null | tr -d '[:space:]')
        if [ -n "$saved" ]; then
            echo "$saved" > "${STATE_DIR}/ai_engine"
            echo "$saved"
            return 0
        fi
    fi
    echo "opencode" > "${STATE_DIR}/ai_engine"
    echo "opencode"
}

spawn_scratchpad_engine() {
    local eng="${1:-opencode}"
    case "$eng" in
        opencode)
            if command -v opencode >/dev/null 2>&1; then
                hyprctl dispatch 'hl.dsp.exec_cmd("kitty --class x64-scratchpad --title \"X64 AI • OpenCode\" -e opencode")' >/dev/null 2>&1 || true
            else
                hyprctl dispatch 'hl.dsp.exec_cmd("kitty --class x64-scratchpad --title \"X64 Scratchpad\"")' >/dev/null 2>&1 || true
            fi
            ;;
        chatgpt)
            hyprctl dispatch 'hl.dsp.exec_cmd("chromium --app=https://chatgpt.com --class=x64-scratchpad")' >/dev/null 2>&1 || true
            ;;
        claude)
            hyprctl dispatch 'hl.dsp.exec_cmd("chromium --app=https://claude.ai --class=x64-scratchpad")' >/dev/null 2>&1 || true
            ;;
        gemini)
            hyprctl dispatch 'hl.dsp.exec_cmd("chromium --app=https://gemini.google.com --class=x64-scratchpad")' >/dev/null 2>&1 || true
            ;;
        deepseek)
            hyprctl dispatch 'hl.dsp.exec_cmd("chromium --app=https://chat.deepseek.com --class=x64-scratchpad")' >/dev/null 2>&1 || true
            ;;
        terminal|*)
            hyprctl dispatch 'hl.dsp.exec_cmd("kitty --class x64-scratchpad --title \"X64 Scratchpad\"")' >/dev/null 2>&1 || true
            ;;
    esac
}

cmd_ai_engine() {
    local sub="${1:-get}"
    local eng="${2:-opencode}"

    if [ "$sub" = "set" ]; then
        case "$eng" in
            opencode|chatgpt|claude|gemini|deepseek|terminal)
                echo "$eng" > "${STATE_DIR}/ai_engine"
                mkdir -p "${HOME}/.config/hypr" 2>/dev/null || true
                echo "$eng" > "${HOME}/.config/hypr/ai_engine" 2>/dev/null || true

                # Close previous scratchpad instance so the new engine spawns cleanly next time
                local prev_pids
                prev_pids=$(hyprctl clients -j 2>/dev/null | jq -r '.[] | select(.class == "x64-scratchpad" or .workspace.name == "special:scratchpad") | .pid' 2>/dev/null || echo "")
                for p in $prev_pids; do
                    [ -n "$p" ] && [ "$p" -gt 1 ] 2>/dev/null && kill -TERM "$p" 2>/dev/null || true
                done

                local label="OpenCode (Modelos Gratis)"
                case "$eng" in
                    chatgpt)  label="ChatGPT Web App" ;;
                    claude)   label="Claude AI Web App" ;;
                    gemini)   label="Google Gemini Web App" ;;
                    deepseek) label="DeepSeek AI Web App" ;;
                    terminal) label="Terminal Kitty" ;;
                esac

                if [ "$IS_ES" -eq 1 ]; then
                    notify_user "Motor Scratchpad: ${label}" "Pulsa SUPER + S o SUPER + A para desplegar" "X64 AI Hub"
                else
                    notify_user "Scratchpad Engine: ${label}" "Press SUPER + S or SUPER + A to toggle" "X64 AI Hub"
                fi
                ;;
        esac
    else
        get_effective_ai_engine
    fi
}

cmd_scratchpad() {
    local eng
    eng=$(get_effective_ai_engine)
    local has_scratch
    has_scratch=$(hyprctl clients -j 2>/dev/null | jq -r '.[] | select(.class == "x64-scratchpad" or .workspace.name == "special:scratchpad") | .address' 2>/dev/null | head -n1)

    if [ -z "$has_scratch" ]; then
        local active_sp
        active_sp=$(hyprctl monitors -j 2>/dev/null | jq -r '.[0].specialWorkspace.name // ""' 2>/dev/null || echo "")
        if [ "$active_sp" != "special:scratchpad" ]; then
            hyprctl dispatch 'hl.dsp.workspace.toggle_special("scratchpad")' >/dev/null 2>&1 || hyprctl dispatch togglespecialworkspace scratchpad >/dev/null 2>&1 || true
        fi
        spawn_scratchpad_engine "$eng"
    else
        hyprctl dispatch 'hl.dsp.workspace.toggle_special("scratchpad")' >/dev/null 2>&1 || hyprctl dispatch togglespecialworkspace scratchpad >/dev/null 2>&1 || true
    fi
}

# -----------------------------------------------------------------------------
# 10. LIVE CINEMATIC MAGNIFIER / ZOOM (SUPER + CTRL + Wheel + Control Center)
# -----------------------------------------------------------------------------
get_effective_zoom_enabled() {
    if [ -s "${STATE_DIR}/zoom_enabled" ]; then
        cat "${STATE_DIR}/zoom_enabled" 2>/dev/null | tr -d '[:space:]'
        return 0
    fi
    if [ -s "${HOME}/.config/hypr/zoom_enabled" ]; then
        local saved
        saved=$(cat "${HOME}/.config/hypr/zoom_enabled" 2>/dev/null | tr -d '[:space:]')
        if [ -n "$saved" ]; then
            echo "$saved" > "${STATE_DIR}/zoom_enabled"
            echo "$saved"
            return 0
        fi
    fi
    echo "0" > "${STATE_DIR}/zoom_enabled"
    echo "0"
}

apply_zoom_factor() {
    local z="${1:-1.0}"
    echo "$z" > "${STATE_DIR}/zoom_factor"
    hyprctl eval "hl.config({ cursor = { zoom_factor = ${z} } })" >/dev/null 2>&1 || \
        hyprctl keyword cursor:zoom_factor "${z}" >/dev/null 2>&1 || true
}

cmd_zoom() {
    local action="${1:-toggle}"
    local en
    en=$(get_effective_zoom_enabled)

    if [ "$action" = "toggle" ]; then
        [ "$en" = "1" ] && action="off" || action="on"
    fi

    case "$action" in
        on)
            echo "1" > "${STATE_DIR}/zoom_enabled"
            mkdir -p "${HOME}/.config/hypr" 2>/dev/null || true
            echo "1" > "${HOME}/.config/hypr/zoom_enabled" 2>/dev/null || true
            [ -f "${STATE_DIR}/zoom_factor" ] || echo "1.0" > "${STATE_DIR}/zoom_factor"
            hyprctl eval "_G.x64_set_zoom_binds(true)" >/dev/null 2>&1 || true
            if [ "$IS_ES" -eq 1 ]; then
                notify_user "Lupa / Zoom Activada" "Usa ALT + Rueda para acercar o alejar" "Lupa X64"
            else
                notify_user "Live Zoom Enabled" "Use ALT + Wheel to zoom in or out" "X64 Magnifier"
            fi
            ;;
        off)
            echo "0" > "${STATE_DIR}/zoom_enabled"
            mkdir -p "${HOME}/.config/hypr" 2>/dev/null || true
            echo "0" > "${HOME}/.config/hypr/zoom_enabled" 2>/dev/null || true
            hyprctl eval "_G.x64_set_zoom_binds(false)" >/dev/null 2>&1 || true
            apply_zoom_factor "1.0"
            if [ "$IS_ES" -eq 1 ]; then
                notify_user "Lupa / Zoom Desactivada" "Vista restaurada a 1.0x" "Lupa X64"
            else
                notify_user "Live Zoom Disabled" "View restored to 1.0x" "X64 Magnifier"
            fi
            ;;
        in)
            [ "$en" != "1" ] && return 0
            local cur new_z
            cur=$(hyprctl getoption cursor:zoom_factor -j 2>/dev/null | jq -r '.float // 1.0' 2>/dev/null || cat "${STATE_DIR}/zoom_factor" 2>/dev/null || echo "1.0")
            new_z=$(awk -v c="${cur:-1.0}" 'BEGIN { n = c + 0.25; if (n > 3.0) n = 3.0; printf "%.2f", n }')
            apply_zoom_factor "$new_z"
            ;;
        out)
            [ "$en" != "1" ] && return 0
            local cur new_z
            cur=$(hyprctl getoption cursor:zoom_factor -j 2>/dev/null | jq -r '.float // 1.0' 2>/dev/null || cat "${STATE_DIR}/zoom_factor" 2>/dev/null || echo "1.0")
            new_z=$(awk -v c="${cur:-1.0}" 'BEGIN { n = c - 0.25; if (n < 1.0) n = 1.0; printf "%.2f", n }')
            apply_zoom_factor "$new_z"
            ;;
        reset)
            apply_zoom_factor "1.0"
            ;;
        get)
            get_effective_zoom_enabled
            ;;
    esac
}

# -----------------------------------------------------------------------------
# 11. GAMING MODE / ZERO LATENCY (SUPER + G)
# Strips compositor overhead (blur, shadows, animations, gaps, rounding),
# locks CPU governor to performance, and optimizes Wayland direct scanout.
# -----------------------------------------------------------------------------
get_effective_gaming_mode() {
    cat "${STATE_DIR}/gaming_mode" 2>/dev/null || echo "0"
}

get_effective_auto_gaming() {
    if [ -s "${STATE_DIR}/auto_gaming" ]; then
        tr -d '[:space:]' < "${STATE_DIR}/auto_gaming" 2>/dev/null
        return 0
    fi
    if [ -s "${HOME}/.config/hypr/auto_gaming" ]; then
        local saved
        saved=$(tr -d '[:space:]' < "${HOME}/.config/hypr/auto_gaming" 2>/dev/null)
        [ "$saved" = "0" ] || saved="1"
        echo "$saved" > "${STATE_DIR}/auto_gaming"
        echo "$saved"
        return 0
    fi
    echo "1" > "${STATE_DIR}/auto_gaming"
    echo "1"
}

cmd_auto_gaming() {
    local action="${1:-toggle}"
    local cur
    cur=$(get_effective_auto_gaming)
    if [ "$action" = "toggle" ]; then
        [ "$cur" = "1" ] && action="off" || action="on"
    fi
    mkdir -p "${HOME}/.config/hypr"
    case "$action" in
        on|1|true)
            echo "1" > "${STATE_DIR}/auto_gaming"
            echo "1" > "${HOME}/.config/hypr/auto_gaming"
            ;;
        off|0|false)
            echo "0" > "${STATE_DIR}/auto_gaming"
            echo "0" > "${HOME}/.config/hypr/auto_gaming"
            ;;
        get)
            echo "$cur"
            return 0
            ;;
    esac
    quickshell ipc call sys refresh >/dev/null 2>&1 || true
}

cmd_gamemode() {
    local action="${1:-toggle}"
    local cur src
    cur=$(get_effective_gaming_mode)
    src=$(cat "${STATE_DIR}/gaming_mode_source" 2>/dev/null || echo "none")

    if [ "$action" = "toggle" ]; then
        [ "$cur" = "1" ] && action="off" || action="on"
    fi

    case "$action" in
        on|auto-on)
            local is_auto=0
            [ "$action" = "auto-on" ] && is_auto=1

            # Idempotent: never overwrite saved power/DND state if already in Gaming Mode
            if [ "$cur" = "1" ]; then
                [ "$is_auto" -eq 0 ] && echo "manual" > "${STATE_DIR}/gaming_mode_source"
                quickshell ipc call sys refresh >/dev/null 2>&1 || true
                return 0
            fi

            echo "1" > "${STATE_DIR}/gaming_mode"
            [ "$is_auto" -eq 1 ] && echo "auto" > "${STATE_DIR}/gaming_mode_source" || echo "manual" > "${STATE_DIR}/gaming_mode_source"

            # Backup current power profile & DND state to restore cleanly later
            local cur_pwr cur_dnd
            cur_pwr=$(get_effective_power_profile)
            cur_dnd=$(cat "${STATE_DIR}/dnd" 2>/dev/null || echo "0")
            echo "${cur_pwr:-balanced}" > "${STATE_DIR}/pre_game_power_profile"
            echo "${cur_dnd:-0}" > "${STATE_DIR}/pre_game_dnd"
            cmd_power set "performance"

            # Disable ALL compositor overhead via native Lua engine (blur, shadows, rounding, inactive opacity, gaps, animations)
            hyprctl eval "hl.config({ decoration = { blur = { enabled = false }, shadow = { enabled = false }, rounding = 0, inactive_opacity = 1.0 }, general = { gaps_in = 0, gaps_out = 0 }, animations = { enabled = false } })" >/dev/null 2>&1 || \
            hyprctl --batch "\
                keyword decoration:blur:enabled 0;\
                keyword decoration:shadow:enabled 0;\
                keyword decoration:inactive_opacity 1.0;\
                keyword animations:enabled 0;\
                keyword general:gaps_in 0;\
                keyword general:gaps_out 0;\
                keyword decoration:rounding 0" >/dev/null 2>&1 || true

            # Notify BEFORE enabling DND so confirmation displays if user was not already in DND
            if [ "$IS_ES" -eq 1 ]; then
                if [ "$is_auto" -eq 1 ]; then
                    notify_user "Auto-Gaming: Activado" "Juego detectado • Sin blur/sombras • CPU Max • DND ON" "Gaming X64"
                else
                    notify_user "Modo Gaming: Activado" "Rendimiento máximo • Sin blur/sombras • DND ON" "Gaming X64"
                fi
            else
                if [ "$is_auto" -eq 1 ]; then
                    notify_user "Auto-Gaming: Enabled" "Game detected • No blur/shadows • Max CPU • DND ON" "X64 Gaming"
                else
                    notify_user "Gaming Mode: Enabled" "Maximum performance • No blur/shadows • DND ON" "X64 Gaming"
                fi
            fi

            # Silence subsequent popups during gameplay & freeze any live video wallpapers (0% GPU/CPU)
            echo "1" > "${STATE_DIR}/dnd"
            command -v x64-theme >/dev/null 2>&1 && x64-theme pause-video on >/dev/null 2>&1 || true
            quickshell ipc call sys refresh >/dev/null 2>&1 || true
            ;;
        off|auto-off)
            # Never disable a manually enabled Gaming Mode when an auto-detected game closes
            if [ "$action" = "auto-off" ] && [ "$src" != "auto" ]; then
                return 0
            fi
            if [ "$cur" != "1" ]; then
                echo "0" > "${STATE_DIR}/gaming_mode"
                echo "none" > "${STATE_DIR}/gaming_mode_source"
                return 0
            fi

            local was_auto=0
            [ "$action" = "auto-off" ] && was_auto=1

            echo "0" > "${STATE_DIR}/gaming_mode"
            echo "none" > "${STATE_DIR}/gaming_mode_source"

            local prev_pwr prev_dnd
            prev_pwr=$(cat "${STATE_DIR}/pre_game_power_profile" 2>/dev/null || echo "balanced")
            [ -z "$prev_pwr" ] && prev_pwr="balanced"
            rm -f "${STATE_DIR}/pre_game_power_profile"
            cmd_power set "$prev_pwr"

            prev_dnd=$(cat "${STATE_DIR}/pre_game_dnd" 2>/dev/null || echo "0")
            [ "$prev_dnd" = "1" ] || prev_dnd="0"
            rm -f "${STATE_DIR}/pre_game_dnd"
            echo "$prev_dnd" > "${STATE_DIR}/dnd"

            # Restore Obsidian & Crimson visual effects via native Lua engine (with legacy keyword fallback)
            hyprctl eval "hl.config({ decoration = { blur = { enabled = true }, shadow = { enabled = true }, rounding = 10, inactive_opacity = 0.96 }, general = { gaps_in = 5, gaps_out = 10 }, animations = { enabled = true } })" >/dev/null 2>&1 || \
            hyprctl --batch "\
                keyword decoration:blur:enabled 1;\
                keyword decoration:shadow:enabled 1;\
                keyword decoration:inactive_opacity 0.96;\
                keyword animations:enabled 1;\
                keyword general:gaps_in 5;\
                keyword general:gaps_out 10;\
                keyword decoration:rounding 10" >/dev/null 2>&1 || true

            command -v x64-theme >/dev/null 2>&1 && x64-theme pause-video off >/dev/null 2>&1 || true
            quickshell ipc call sys refresh >/dev/null 2>&1 || true

            if [ "$IS_ES" -eq 1 ]; then
                if [ "$was_auto" -eq 1 ]; then
                    notify_user "Auto-Gaming: Desactivado" "Escritorio, efectos visuales y DND restaurados" "Gaming X64"
                else
                    notify_user "Modo Gaming: Desactivado" "Efectos visuales, perfil de energía y DND restaurados" "Gaming X64"
                fi
            else
                if [ "$was_auto" -eq 1 ]; then
                    notify_user "Auto-Gaming: Disabled" "Desktop visuals, power profile and DND restored" "X64 Gaming"
                else
                    notify_user "Gaming Mode: Disabled" "Visual effects, power profile and DND restored" "X64 Gaming"
                fi
            fi
            ;;
        get)
            get_effective_gaming_mode
            ;;
    esac
}

# -----------------------------------------------------------------------------
# 11. CLIPBOARD HISTORY (CLIPHIST ENGINE)
# -----------------------------------------------------------------------------
cmd_clipboard() {
    local action="${1:-toggle}"
    case "$action" in
        toggle|open|close|reload)
            quickshell ipc call clipboard "$action" 2>/dev/null || true
            ;;
        paste)
            local item_id="$2"
            if [ -n "$item_id" ] && command -v cliphist >/dev/null 2>&1 && command -v wl-copy >/dev/null 2>&1; then
                cliphist decode "$item_id" 2>/dev/null | wl-copy
            fi
            ;;
        delete)
            local query="$2"
            if [ -n "$query" ] && command -v cliphist >/dev/null 2>&1; then
                cliphist delete-query "$query" 2>/dev/null || true
                quickshell ipc call clipboard reload 2>/dev/null || true
            fi
            ;;
        clear|wipe)
            if command -v cliphist >/dev/null 2>&1; then
                cliphist wipe 2>/dev/null || true
                quickshell ipc call clipboard reload 2>/dev/null || true
                if [ "$IS_ES" -eq 1 ]; then
                    notify_user "Portapapeles Limpiado" "El historial se ha vaciado por completo" "Portapapeles X64"
                else
                    notify_user "Clipboard Cleared" "History has been completely wiped" "X64 Clipboard"
                fi
            fi
            ;;
        start-watch)
            if command -v cliphist >/dev/null 2>&1 && command -v wl-paste >/dev/null 2>&1; then
                pgrep -f "wl-paste --type text --watch cliphist" >/dev/null 2>&1 || (wl-paste --type text --watch cliphist store >/dev/null 2>&1 &)
                pgrep -f "wl-paste --type image --watch cliphist" >/dev/null 2>&1 || (wl-paste --type image --watch cliphist store >/dev/null 2>&1 &)
            fi
            ;;
    esac
}

