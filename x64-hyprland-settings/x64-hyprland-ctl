cmd_screenshot_worker() {
    local mode="${1:-full}"
    local pic_base
    pic_base="$(xdg-user-dir PICTURES 2>/dev/null)"
    [ -z "$pic_base" ] && pic_base="${HOME}/Pictures"
    local pic_dir="${pic_base}/Screenshots"
    mkdir -p "${pic_dir}"
    local out_file="${pic_dir}/X64-Shot-$(date +%Y%m%d-%H%M%S).png"

    if [ "$mode" = "region" ]; then
        # Native Freeze-Frame capture in tmpfs RAM across all active monitors (~30ms)
        rm -f "${STATE_DIR}"/freeze-*.png 2>/dev/null || true
        quickshell ipc call filter hide >/dev/null 2>&1 || true
        sleep 0.04

        local -a mons=()
        mapfile -t mons < <(hyprctl monitors -j 2>/dev/null | jq -r '.[].name' 2>/dev/null || true)
        local pids=()
        local m
        for m in "${mons[@]}"; do
            [ -n "$m" ] || continue
            grim -l 0 -o "$m" "${STATE_DIR}/freeze-${m}.png" >/dev/null 2>&1 &
            pids+=($!)
        done
        for p in "${pids[@]}"; do
            wait "$p" 2>/dev/null || true
        done
        quickshell ipc call filter show >/dev/null 2>&1 || true

        local stamp
        stamp=$(date +%s%N)
        if [ "${#mons[@]}" -gt 0 ] && [ -s "${STATE_DIR}/freeze-${mons[0]}.png" ] \
            && quickshell ipc call screenshot start "${STATE_DIR}" "${stamp}" >/dev/null 2>&1; then
            return 0
        fi

        # Graceful fallback to slurp if Quickshell overlay is unavailable
        rm -f "${STATE_DIR}"/freeze-*.png 2>/dev/null || true
        local acc="#ff2b2b"
        if [ -r "${HOME}/.config/x64-theme/palette.json" ]; then
            acc=$(jq -r '.accent // "#ff2b2b"' "${HOME}/.config/x64-theme/palette.json" 2>/dev/null || echo "#ff2b2b")
        fi
        local geom
        geom=$(slurp -b '#08080a88' -c "${acc}ff" -s "${acc}18" -w 2 2>/dev/null || echo "")
        quickshell ipc call popups unlock >/dev/null 2>&1 || true
        [ -z "$geom" ] && return 0
        quickshell ipc call filter hide >/dev/null 2>&1 || true
        sleep 0.04
        if grim -g "$geom" "$out_file"; then
            quickshell ipc call filter show >/dev/null 2>&1 || true
            setsid -f sh -c 'wl-copy < "$1"' _ "$out_file" >/dev/null 2>&1 < /dev/null
            if [ "$IS_ES" -eq 1 ]; then
                _notify_screenshot "$out_file" "Recorte Guardado" "Copiado al portapapeles • $(basename "$out_file")"
            else
                _notify_screenshot "$out_file" "Snapshot Saved" "Copied to clipboard • $(basename "$out_file")"
            fi
        else
            quickshell ipc call filter show >/dev/null 2>&1 || true
        fi
    else
        sleep 0.15
        quickshell ipc call filter hide >/dev/null 2>&1 || true
        sleep 0.04
        if grim "$out_file"; then
            quickshell ipc call popups unlock >/dev/null 2>&1 || true
            quickshell ipc call filter show >/dev/null 2>&1 || true
            setsid -f sh -c 'wl-copy < "$1"' _ "$out_file" >/dev/null 2>&1 < /dev/null
            if [ "$IS_ES" -eq 1 ]; then
                _notify_screenshot "$out_file" "Captura de Pantalla" "Copiada al portapapeles • $(basename "$out_file")"
            else
                _notify_screenshot "$out_file" "Screenshot Captured" "Copied to clipboard • $(basename "$out_file")"
            fi
        else
            quickshell ipc call popups unlock >/dev/null 2>&1 || true
            quickshell ipc call filter show >/dev/null 2>&1 || true
        fi
    fi
}

