    if [ ! -f "$freeze_file" ]; then
        rm -f "${STATE_DIR}"/freeze-*.png 2>/dev/null || true
        return 1
    fi

    local ok=0
    if [ "$nx" = "0" ] && [ "$ny" = "0" ] && [ "$nw" = "1" ] && [ "$nh" = "1" ]; then
        if python3 - "$freeze_file" "$out_file" <<'PYEOF'
import sys
from PIL import Image
im = Image.open(sys.argv[1])
im.save(sys.argv[2], "PNG", optimize=False, compress_level=4)
PYEOF
        then
            ok=1
        elif cp -f "$freeze_file" "$out_file"; then
            ok=1
        fi
    else
        if python3 - "$freeze_file" "$out_file" "$nx" "$ny" "$nw" "$nh" <<'PYEOF'
import sys
from PIL import Image
src, dst = sys.argv[1], sys.argv[2]
nx, ny, nw, nh = float(sys.argv[3]), float(sys.argv[4]), float(sys.argv[5]), float(sys.argv[6])
im = Image.open(src)
w, h = im.size
x1 = max(0, min(w - 1, int(round(nx * w))))
y1 = max(0, min(h - 1, int(round(ny * h))))
x2 = max(x1 + 1, min(w, int(round((nx + nw) * w))))
y2 = max(y1 + 1, min(h, int(round((ny + nh) * h))))
im.crop((x1, y1, x2, y2)).save(dst, "PNG", optimize=False, compress_level=4)
PYEOF
        then
            ok=1
        fi
    fi

    rm -f "${STATE_DIR}"/freeze-*.png 2>/dev/null || true

    if [ "$ok" -eq 1 ] && [ -s "$out_file" ]; then
        setsid -f sh -c 'wl-copy < "$1"' _ "$out_file" >/dev/null 2>&1 < /dev/null
        if [ "$IS_ES" -eq 1 ]; then
            _notify_screenshot "$out_file" "Recorte Guardado" "Copiado al portapapeles • $(basename "$out_file")"
        else
            _notify_screenshot "$out_file" "Snapshot Saved" "Copied to clipboard • $(basename "$out_file")"
        fi
        return 0
    fi
    return 1
}

