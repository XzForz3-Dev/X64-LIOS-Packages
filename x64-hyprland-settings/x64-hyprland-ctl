get_cpu_temp() {
    local fallback_cpu_pct="${1:-0}"
    local tz_path=""
    if [ -s "${STATE_DIR}/cpu_temp_path" ]; then
        tz_path=$(cat "${STATE_DIR}/cpu_temp_path" 2>/dev/null || echo "")
        [ -r "$tz_path" ] || tz_path=""
    fi

    if [ -z "$tz_path" ]; then
        # Prioritize accurate CPU package sensors (Intel coretemp/x86_pkg_temp, AMD k10temp/zenpower)
        for hm in /sys/class/hwmon/hwmon*; do
            [ -r "${hm}/name" ] || continue
            local hname
            hname=$(cat "${hm}/name" 2>/dev/null || echo "")
            case "$hname" in
                coretemp|k10temp|zenpower|cpu_thermal|thinkpad)
                    if [ -r "${hm}/temp1_input" ]; then
                        tz_path="${hm}/temp1_input"
                        break
                    fi
                    ;;
            esac
        done
        if [ -z "$tz_path" ]; then
            for tz in /sys/class/thermal/thermal_zone*; do
                [ -r "${tz}/type" ] && [ -r "${tz}/temp" ] || continue
                local ttype
                ttype=$(cat "${tz}/type" 2>/dev/null || echo "")
                case "$ttype" in
                    x86_pkg_temp|TCPU|cpu-thermal)
                        tz_path="${tz}/temp"
                        break
                        ;;
                esac
            done
        fi
        if [ -z "$tz_path" ]; then
            for tz in /sys/class/thermal/thermal_zone*/temp /sys/class/hwmon/hwmon*/temp1_input; do
                if [ -r "$tz" ]; then
                    local raw_check
                    raw_check=$(cat "$tz" 2>/dev/null || echo "")
                    if [ -n "$raw_check" ] && [ "$raw_check" -gt 1000 ] 2>/dev/null; then
                        tz_path="$tz"
                        break
                    fi
                fi
            done
        fi
        [ -n "$tz_path" ] && echo "$tz_path" > "${STATE_DIR}/cpu_temp_path"
    fi

    if [ -n "$tz_path" ] && [ -r "$tz_path" ]; then
        local raw_t
        raw_t=$(cat "$tz_path" 2>/dev/null || echo "")
        if [ -n "$raw_t" ] && [ "$raw_t" -gt 1000 ] 2>/dev/null; then
            echo $(( raw_t / 1000 ))
            return 0
        fi
    fi
    # Smart thermal model for virtualized environments without hwmon passthrough
    echo $(( 38 + (fallback_cpu_pct * 35) / 100 ))
}

collect_gpu_telemetry() {
    local ttl="${1:-0}"
    local cache_file="${STATE_DIR}/gpu_cache"
    local now_s
    now_s=$(date +%s)

    gpu_count=0
    gpu_primary_temp=0
    gpu_primary_util=0
    gpus_json="[]"

    if [ "$ttl" -gt 0 ] && [ -s "$cache_file" ]; then
        local cache_ts=0
        # shellcheck disable=SC1090
        source "$cache_file" 2>/dev/null || true
        if [ $(( now_s - cache_ts )) -lt "$ttl" ] && [ -n "${gpus_json:-}" ]; then
            return 0
        fi
        gpu_count=0
        gpu_primary_temp=0
        gpu_primary_util=0
        gpus_json="[]"
    fi

    # 1. NVIDIA (nvidia-smi — Single & Multi-GPU / SLI aware)
    if command -v nvidia-smi >/dev/null 2>&1; then
        local smi_out
        smi_out=$(nvidia-smi --query-gpu=index,name,temperature.gpu,utilization.gpu,memory.used,memory.total --format=csv,noheader,nounits 2>/dev/null)
        if [ -n "$smi_out" ]; then
            gpus_json=$(echo "$smi_out" | awk -F', ' 'BEGIN{printf "["} {
                if (NR>1) printf ",";
                idx=$1; name=$2; temp=$3; util=$4; vram_u=$5; vram_t=$6;
                vram_pct = (vram_t > 0) ? int((vram_u * 100) / vram_t) : 0;
                if (vram_u >= 1024) vram_u_str = sprintf("%.1f GB", vram_u / 1024);
                else vram_u_str = sprintf("%d MB", vram_u);
                vram_t_str = sprintf("%.1f GB", vram_t / 1024);
                gsub(/"/,"",name);
                printf "{\"index\":%d,\"name\":\"%s\",\"temp\":%d,\"util\":%d,\"vramUsed\":\"%s\",\"vramTotal\":\"%s\",\"vramPct\":%d}", idx, name, temp, util, vram_u_str, vram_t_str, vram_pct;
            } END{printf "]"}')
            gpu_count=$(echo "$smi_out" | wc -l)
            gpu_primary_temp=$(echo "$smi_out" | head -n1 | awk -F', ' '{print $3}')
            gpu_primary_util=$(echo "$smi_out" | head -n1 | awk -F', ' '{print $4}')
        fi
    fi

    # 2. AMD / Intel DRM Native Sysfs Fallback (0 external tools required)
    if [ "${gpu_count:-0}" -eq 0 ]; then
        local idx=0
        local json_acc="["
        for card in /sys/class/drm/card[0-9]*; do
            local cname
            cname=$(basename "$card")
            [[ "$cname" =~ ^card[0-9]+$ ]] || continue
            local dev="${card}/device"
            [ -r "${dev}/vendor" ] || continue
            local vendor
            vendor=$(cat "${dev}/vendor" 2>/dev/null || echo "")
            local label=""
            case "$vendor" in
                0x1002) label="AMD Radeon GPU" ;;
                0x8086) label="Intel Graphics" ;;
                *) continue ;;
            esac

            # Skip virtual / non-telemetry cards unless temp or busy sensor exists
            local g_util=0 g_temp=0 has_metric=0
            if [ -r "${dev}/gpu_busy_percent" ]; then
                g_util=$(cat "${dev}/gpu_busy_percent" 2>/dev/null || echo 0)
                has_metric=1
            fi
            for hwm in "${dev}"/hwmon/hwmon*/temp1_input; do
                if [ -r "$hwm" ]; then
                    local raw_gt
                    raw_gt=$(cat "$hwm" 2>/dev/null || echo 0)
                    if [ "$raw_gt" -gt 1000 ] 2>/dev/null; then
                        g_temp=$(( raw_gt / 1000 ))
                        has_metric=1
                        break
                    fi
                fi
            done
            [ "$has_metric" -eq 0 ] && continue

            local vram_u_str="0 MB" vram_t_str="0.0 GB" vram_pct=0
            if [ -r "${dev}/mem_info_vram_used" ] && [ -r "${dev}/mem_info_vram_total" ]; then
                local vu_b vt_b
                vu_b=$(cat "${dev}/mem_info_vram_used" 2>/dev/null || echo 0)
                vt_b=$(cat "${dev}/mem_info_vram_total" 2>/dev/null || echo 0)
                if [ "$vt_b" -gt 0 ] 2>/dev/null; then
                    vram_pct=$(( (vu_b * 100) / vt_b ))
                    local vu_m=$(( vu_b / 1048576 ))
                    if [ "$vu_m" -ge 1024 ]; then
                        vram_u_str=$(awk -v m="$vu_m" 'BEGIN{printf "%.1f GB", m/1024}')
                    else
                        vram_u_str="${vu_m} MB"
                    fi
                    vram_t_str=$(awk -v b="$vt_b" 'BEGIN{printf "%.1f GB", b/1073741824}')
                fi
            fi

            # Cache human-readable PCI GPU name once per card
            local name_cache="${STATE_DIR}/gpu_name_${cname}"
            if [ -s "$name_cache" ]; then
                label=$(cat "$name_cache" 2>/dev/null || echo "$label")
            elif command -v lspci >/dev/null 2>&1 && [ -r "${dev}/uevent" ]; then
                local pci_slot
                pci_slot=$(awk -F'=' '/^PCI_SLOT_NAME=/{print $2; exit}' "${dev}/uevent" 2>/dev/null)
                if [ -n "$pci_slot" ]; then
                    local pci_desc
                    pci_desc=$(lspci -s "$pci_slot" 2>/dev/null | sed 's/^[^:]*: //; s/Advanced Micro Devices, Inc. \[AMD\/ATI\] /AMD /; s/Intel Corporation /Intel /; s/ (rev .*//; s/"//g')
                    [ -n "$pci_desc" ] && label="$pci_desc"
                fi
                echo "$label" > "$name_cache"
            fi

            [ "$idx" -gt 0 ] && json_acc="${json_acc},"
            json_acc="${json_acc}{\"index\":${idx},\"name\":\"${label}\",\"temp\":${g_temp},\"util\":${g_util},\"vramUsed\":\"${vram_u_str}\",\"vramTotal\":\"${vram_t_str}\",\"vramPct\":${vram_pct}}"
            if [ "$idx" -eq 0 ]; then
                gpu_primary_temp="$g_temp"
                gpu_primary_util="$g_util"
            fi
            idx=$(( idx + 1 ))
        done
        if [ "$idx" -gt 0 ]; then
            gpu_count="$idx"
            gpus_json="${json_acc}]"
        fi
    fi

    printf 'cache_ts=%s\ngpu_count=%d\ngpu_primary_temp=%d\ngpu_primary_util=%d\ngpus_json=%q\n' \
        "$now_s" "${gpu_count:-0}" "${gpu_primary_temp:-0}" "${gpu_primary_util:-0}" "$gpus_json" > "${cache_file}.tmp.$$" && \
        mv -f "${cache_file}.tmp.$$" "$cache_file"
}

cmd_status_lite() {
    local skip_gpu=0
    [ "${1:-}" = "--no-gpu" ] && skip_gpu=1

    # 1. CPU Delta % (Pure bash builtins, zero awk; atomic state writes + anti-spike guard)
    local cpu_pct=0
    [ -f "${STATE_DIR}/cpu_pct_last" ] && cpu_pct=$(cat "${STATE_DIR}/cpu_pct_last" 2>/dev/null || echo 0)
    local _lbl user nice sys idle iowait irq softirq steal _rest
    if read -r _lbl user nice sys idle iowait irq softirq steal _rest < /proc/stat 2>/dev/null; then
        local total=$(( ${user:-0} + ${nice:-0} + ${sys:-0} + ${idle:-0} + ${iowait:-0} + ${irq:-0} + ${softirq:-0} + ${steal:-0} ))
        local idle_all=$(( ${idle:-0} + ${iowait:-0} ))
        if [ -f "${STATE_DIR}/cpu_stat" ]; then
            local prev_total="" prev_idle=""
            read -r prev_total prev_idle < "${STATE_DIR}/cpu_stat" 2>/dev/null || true
            if [ -n "$prev_total" ] && [ -n "$prev_idle" ]; then
                local diff_total=$(( total - prev_total ))
                local diff_idle=$(( idle_all - prev_idle ))
                if [ "$diff_total" -ge 80 ]; then
                    cpu_pct=$(( (100 * (diff_total - diff_idle)) / diff_total ))
                    [ "$cpu_pct" -lt 0 ] && cpu_pct=0
                    [ "$cpu_pct" -gt 100 ] && cpu_pct=100
                    printf '%s %s\n' "${total}" "${idle_all}" > "${STATE_DIR}/cpu_stat.tmp.$$" && mv -f "${STATE_DIR}/cpu_stat.tmp.$$" "${STATE_DIR}/cpu_stat"
                    printf '%s\n' "${cpu_pct}" > "${STATE_DIR}/cpu_pct_last.tmp.$$" && mv -f "${STATE_DIR}/cpu_pct_last.tmp.$$" "${STATE_DIR}/cpu_pct_last"
                fi
            else
                printf '%s %s\n' "${total}" "${idle_all}" > "${STATE_DIR}/cpu_stat.tmp.$$" && mv -f "${STATE_DIR}/cpu_stat.tmp.$$" "${STATE_DIR}/cpu_stat"
            fi
        else
            printf '%s %s\n' "${total}" "${idle_all}" > "${STATE_DIR}/cpu_stat.tmp.$$" && mv -f "${STATE_DIR}/cpu_stat.tmp.$$" "${STATE_DIR}/cpu_stat"
        fi
    fi

    # 2. RAM Used (GB)
    local ram_used="0.0"
    ram_used=$(awk '/^MemTotal:/{mt=$2} /^MemAvailable:/{ma=$2} END{if(mt>0) printf "%.1f", (mt-ma)/1048576; else print "0.0"}' /proc/meminfo 2>/dev/null)

    # 3. CPU Temp (cached sensor path)
    local temp_c
    temp_c=$(get_cpu_temp "$cpu_pct")

    # 4. Local toggle & state files (zero external commands)
    local caf_val nl_val dnd_val br_val pwr_prof ai_eng zoom_en zoom_fac game_en auto_game_en
    caf_val=$(cat "${STATE_DIR}/caffeine" 2>/dev/null || echo "0")
    nl_val=$(cat "${STATE_DIR}/nightlight" 2>/dev/null || echo "0")
    dnd_val=$(cat "${STATE_DIR}/dnd" 2>/dev/null || echo "0")
    br_val=$(cat "${STATE_DIR}/brightness" 2>/dev/null || echo "100")
    pwr_prof=$(cat "${STATE_DIR}/power_profile" 2>/dev/null || echo "balanced")
    ai_eng=$(cat "${STATE_DIR}/ai_engine" 2>/dev/null || echo "opencode")
    zoom_en=$(cat "${STATE_DIR}/zoom_enabled" 2>/dev/null || echo "0")
    zoom_fac=$(cat "${STATE_DIR}/zoom_factor" 2>/dev/null || echo "1.0")
    game_en=$(cat "${STATE_DIR}/gaming_mode" 2>/dev/null || echo "0")
    auto_game_en=$(cat "${STATE_DIR}/auto_gaming" 2>/dev/null || echo "1")

    # 5. Recording timer
    local rec_active="false" rec_time="00:00"
    if [ -f "${STATE_DIR}/record.start" ] && is_recorder_running; then
        rec_active="true"
        local start_s now_s elapsed
        start_s=$(cat "${STATE_DIR}/record.start" 2>/dev/null || date +%s)
        now_s=$(date +%s)
        elapsed=$(( now_s - start_s ))
        [ "$elapsed" -lt 0 ] && elapsed=0
        rec_time=$(printf "%02d:%02d" $(( elapsed / 60 )) $(( elapsed % 60 )))
    fi

    # 6. Smart Battery
    local has_bat="false" bat_pct=100 bat_status="AC"
    for bat_dir in /sys/class/power_supply/BAT*; do
        if [ -d "$bat_dir" ]; then
            bat_pct=$(cat "${bat_dir}/capacity" 2>/dev/null || echo 0)
            bat_status=$(cat "${bat_dir}/status" 2>/dev/null || echo "Discharging")
            if [ "$bat_pct" -eq 0 ] 2>/dev/null && [ "$bat_status" = "Not charging" ]; then
                has_bat="false"
                bat_pct=100
                bat_status="AC"
            else
                has_bat="true"
                break
            fi
        fi
    done

    # 7. GPU summary (6s TTL cache in normal desktop; skipped completely with --no-gpu)
    local gpu_count=-1 gpu_primary_temp=-1 gpu_primary_util=-1 gpus_json=""
    if [ "$skip_gpu" -eq 0 ]; then
        collect_gpu_telemetry 6
    fi

    if [ "$skip_gpu" -eq 1 ]; then
        printf '{"cpu":%d,"ramUsed":"%s","temp":%d,"caffeine":%s,"nightlight":%s,"dnd":%s,"recording":%s,"recTime":"%s","hasBattery":%s,"batPct":%d,"batStatus":"%s","powerProfile":"%s","brightness":%d,"aiEngine":"%s","zoomEnabled":%s,"zoomFactor":"%s","gamingMode":%s,"autoGaming":%s}\n' \
            "$cpu_pct" "$ram_used" "$temp_c" \
            "$([ "$caf_val" = "1" ] && echo true || echo false)" \
            "$([ "$nl_val" = "1" ] && echo true || echo false)" \
            "$([ "$dnd_val" = "1" ] && echo true || echo false)" \
            "$rec_active" "$rec_time" \
            "$has_bat" "$bat_pct" "$bat_status" "$pwr_prof" "$br_val" "$ai_eng" \
            "$([ "$zoom_en" = "1" ] && echo true || echo false)" "$zoom_fac" \
            "$([ "$game_en" = "1" ] && echo true || echo false)" \
            "$([ "$auto_game_en" = "1" ] && echo true || echo false)"
    else
        printf '{"cpu":%d,"ramUsed":"%s","temp":%d,"caffeine":%s,"nightlight":%s,"dnd":%s,"recording":%s,"recTime":"%s","hasBattery":%s,"batPct":%d,"batStatus":"%s","powerProfile":"%s","brightness":%d,"aiEngine":"%s","zoomEnabled":%s,"zoomFactor":"%s","gamingMode":%s,"autoGaming":%s,"gpuCount":%d,"gpuTemp":%d,"gpuUtil":%d}\n' \
            "$cpu_pct" "$ram_used" "$temp_c" \
            "$([ "$caf_val" = "1" ] && echo true || echo false)" \
            "$([ "$nl_val" = "1" ] && echo true || echo false)" \
            "$([ "$dnd_val" = "1" ] && echo true || echo false)" \
            "$rec_active" "$rec_time" \
            "$has_bat" "$bat_pct" "$bat_status" "$pwr_prof" "$br_val" "$ai_eng" \
            "$([ "$zoom_en" = "1" ] && echo true || echo false)" "$zoom_fac" \
            "$([ "$game_en" = "1" ] && echo true || echo false)" \
            "$([ "$auto_game_en" = "1" ] && echo true || echo false)" \
            "${gpu_count:-0}" "${gpu_primary_temp:-0}" "${gpu_primary_util:-0}"
    fi
}

cmd_status() {
