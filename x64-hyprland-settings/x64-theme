print(f"{gtk_theme_name}\t{icon_theme_name}\t{gtk_accent_name}\t{'1' if icon_changed else '0'}")
PYEOF
    ) || return 0

    local gtk_theme_name icon_theme_name gtk_accent_name icon_changed
    IFS=$'\t' read -r gtk_theme_name icon_theme_name gtk_accent_name icon_changed <<< "$out_vars"

    if [ -n "$expected_gen" ] && [ -f "$gen_file" ]; then
        [ "$(cat "$gen_file" 2>/dev/null)" = "$expected_gen" ] || return 0
    fi

    # Live reload Kitty instances
    pkill -u "$UID_NUM" -USR1 -x kitty 2>/dev/null || true

    # Live reload running btop instances
    pkill -u "$UID_NUM" -USR2 -x btop 2>/dev/null || true

    # Update xsettingsd if user runs it
    if [ -f "${HOME}/.config/xsettingsd/xsettingsd.conf" ]; then
        sed -i "s|Net/ThemeName .*|Net/ThemeName \"${gtk_theme_name}\"|" "${HOME}/.config/xsettingsd/xsettingsd.conf" 2>/dev/null || true
        sed -i "s|Net/IconThemeName .*|Net/IconThemeName \"${icon_theme_name}\"|" "${HOME}/.config/xsettingsd/xsettingsd.conf" 2>/dev/null || true
        pkill -u "$UID_NUM" -HUP -x xsettingsd 2>/dev/null || true
    fi

    # Clear stale KF6 icon cache & recycle idle thumbnail kioworkers BEFORE broadcasting icon theme
    # switch so folder previews (directorythumbnail) regenerate with the new folder color immediately.
    if [ "$icon_changed" = "1" ]; then
        rm -f "${HOME}/.cache/icon-cache.kcache" 2>/dev/null || true
        local kw_pid kw_cmd
        while IFS= read -r kw_pid; do
            [ -n "$kw_pid" ] || continue
            kw_cmd=$(tr '\0' ' ' < "/proc/${kw_pid}/cmdline" 2>/dev/null || true)
            case "$kw_cmd" in
                *thumbnail*) kill -TERM "$kw_pid" 2>/dev/null || true ;;
            esac
        done < <(pgrep -u "$UID_NUM" -x kioworker 2>/dev/null || true)
    fi

    # Discover running KDE/KF6 apps once (Dolphin, Ark, Gwenview, Kate, etc.)
    local -a kde_svcs=()
    if command -v busctl >/dev/null 2>&1; then
        mapfile -t kde_svcs < <(busctl --user list --no-pager 2>/dev/null | awk '/^org\.kde\.(dolphin|ark|gwenview|kate|kwrite|okular|konsole|kcalc|spectacle)-/{print $1}')
    fi

    # Live reload GTK3 + Qt6 (via libqgtk3.so) and GTK4/Libadwaita portal hints.
    # When KF6 apps are running, a brief color-scheme toggle (prefer-light -> 120ms -> prefer-dark)
    # guarantees dconf/QGtk3Theme delivers colorSchemeChanged without coalescing, so KColorSchemeManager
    # reloads ~/.local/share/color-schemes/BreezeDark.colors natively (zero light flash on KF6 because
    # BreezeLight.colors mirrors the active dark palette, and DolphinView::eventFilter clears QPixmapCache!).
    if command -v gsettings >/dev/null 2>&1; then
        [ -n "$gtk_accent_name" ] && gsettings set org.gnome.desktop.interface accent-color "$gtk_accent_name" 2>/dev/null || true
        [ -n "$gtk_theme_name" ] && gsettings set org.gnome.desktop.interface gtk-theme "$gtk_theme_name" 2>/dev/null || true
        [ -n "$icon_theme_name" ] && gsettings set org.gnome.desktop.interface icon-theme "$icon_theme_name" 2>/dev/null || true
        if [ "${#kde_svcs[@]}" -gt 0 ]; then
            sleep 0.05
            gsettings set org.gnome.desktop.interface color-scheme 'prefer-light' 2>/dev/null || true
            sleep 0.12
            gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark' 2>/dev/null || true
        else
            gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark' 2>/dev/null || true
        fi
    fi

    # Allow libqgtk3.so + KColorSchemeManager (~100ms) to finish propagating QPalette & QIcon::themeName()
    sleep 0.10

    # Live reload Qt/KDE apps (Dolphin, Ark, Gwenview, Kate, etc.)
    if command -v gdbus >/dev/null 2>&1; then
        gdbus emit --session --object-path /kdeglobals --signal org.kde.kconfig.notify.ConfigChanged \
            "@a{saay} {'General': [b'AccentColor', b'ColorScheme', b'LastUsedCustomAccentColor'], 'Icons': [b'Theme'], 'KDE': [b'widgetStyle'], 'Colors:Window': [b'BackgroundNormal', b'ForegroundNormal', b'DecorationFocus'], 'Colors:View': [b'BackgroundNormal', b'BackgroundAlternate', b'ForegroundNormal', b'ForegroundInactive', b'DecorationFocus'], 'Colors:Selection': [b'BackgroundNormal', b'ForegroundNormal'], 'Colors:Button': [b'BackgroundNormal', b'ForegroundNormal', b'DecorationFocus'], 'Colors:Header': [b'BackgroundNormal', b'ForegroundNormal']}" \
            >/dev/null 2>&1 || true
        gdbus emit --session --object-path /BreezeStyle --signal org.kde.Breeze.Style.reparseConfiguration >/dev/null 2>&1 || true
    fi
    if command -v dbus-send >/dev/null 2>&1; then
        dbus-send --session --type=signal /KGlobalSettings org.kde.KGlobalSettings.notifyChange int32:0 int32:0 >/dev/null 2>&1 || true
        dbus-send --session --type=signal /KGlobalSettings org.kde.KGlobalSettings.notifyChange int32:2 int32:0 >/dev/null 2>&1 || true
        if [ "$icon_changed" = "1" ]; then
            dbus-send --session --type=signal /KGlobalSettings org.kde.KGlobalSettings.notifyChange int32:4 int32:0 >/dev/null 2>&1 || true
            for grp in 0 1 2 3 4 5; do
                dbus-send --session --type=signal /KIconLoader org.kde.KIconLoader.iconChanged "int32:${grp}" >/dev/null 2>&1 || true
            done
        fi
    fi

    # Refresh open Dolphin views after KIconLoader finishes reconfiguring (avoids 1-step folder icon lag)
    if [ "${#kde_svcs[@]}" -gt 0 ] && command -v gdbus >/dev/null 2>&1; then
        local svc win_path cur_qss
        if [ "$icon_changed" = "1" ]; then
            sleep 0.14
        fi
        for svc in "${kde_svcs[@]}"; do
            [ -n "$svc" ] || continue
            # Clear legacy kde-live.qss if an app was opened prior to native BreezeDark reload
            cur_qss=$(gdbus call --session --timeout=1 --dest "$svc" --object-path /MainApplication \
                --method org.freedesktop.DBus.Properties.Get org.qtproject.Qt.QApplication styleSheet 2>/dev/null || true)
            case "$cur_qss" in
                *"QAbstractScrollArea QWidget"*|*"QGraphicsView QWidget"*)
                    gdbus call --session --timeout=1 --dest "$svc" --object-path /MainApplication \
                        --method org.qtproject.Qt.QApplication.setStyleSheet "" >/dev/null 2>&1 || true
                    ;;
            esac
            if [ "$icon_changed" = "1" ]; then
                case "$svc" in
                    org.kde.dolphin-*)
                        while IFS= read -r win_path; do
                            [ -n "$win_path" ] || continue
                            gdbus call --session --timeout=1 --dest "$svc" --object-path "$win_path" \
                                --method org.qtproject.Qt.QAction.trigger >/dev/null 2>&1 || true
                        done < <(busctl --user tree --list "$svc" 2>/dev/null | grep -E '^/dolphin/Dolphin_[0-9]+/actions/view_redisplay$' || echo '/dolphin/Dolphin_1/actions/view_redisplay')
                        ;;
                esac
            fi
        done
    fi
}

dispatch_system_retheme() {
    local gen_file="${RUNTIME_DIR}/retheme.gen"
    local gen
    gen=$(( $(cat "$gen_file" 2>/dev/null || echo 0) + 1 ))
    printf '%s\n' "$gen" > "${gen_file}.tmp.$$" && mv -f "${gen_file}.tmp.$$" "$gen_file"

    local self_bin="${BASH_SOURCE[0]}"
    [ -x "$self_bin" ] || self_bin="/usr/bin/x64-theme"
    setsid "$self_bin" _retheme-worker "$gen" >"${RUNTIME_DIR}/retheme.log" 2>&1 </dev/null 9>&- &
    disown "$!" 2>/dev/null || true
}

notify_quickshell_reload() {
    local pid cmd
    while IFS= read -r pid; do
        [ -n "$pid" ] || continue
        cmd=$(tr '\0' ' ' < "/proc/${pid}/cmdline" 2>/dev/null || true)
        case "$cmd" in
            *"quickshell -n"*|*"/shell.qml"*)
                quickshell ipc --pid "$pid" call theme reload >/dev/null 2>&1 && return 0
                ;;
        esac
    done < <(pgrep -u "$UID_NUM" -x quickshell 2>/dev/null || true)
    quickshell ipc call theme reload >/dev/null 2>&1 || true
}

sync_shell_and_wallpapers() {
    write_palette_from_state
    # Notify Quickshell FIRST so Wallpaper.qml displays/transitions the poster cleanly before mpvpaper starts/stops
    notify_quickshell_reload
    write_hyprlock_theme
    reconcile_live_wallpapers
}

sync_full_theme() {
    write_palette_from_state
    notify_quickshell_reload
    apply_hyprland_borders
    write_hyprlock_theme
    reconcile_live_wallpapers
    dispatch_system_retheme
}

cmd_apply() {
    ensure_state_file
    local target_id="${1:-}"
    shift || true

    if [ -z "$target_id" ]; then
        target_id=$(jq -r '.theme // "x64-lios-crimson"' "$STATE_FILE")
    fi

    local tdir
    if ! tdir=$(resolve_theme_dir "$target_id"); then
        echo "ERR: theme not found: $target_id" >&2
        return 1
    fi

    local accent_ov bg_arg video_arg trans_arg mon_arg="ALL"
    accent_ov=$(jq -r '.accentOverride // ""' "$STATE_FILE")
    bg_arg=""
    video_arg=$(jq -r 'if .videoEnabled == true then "true" else "false" end' "$STATE_FILE")
    trans_arg=$(jq -r '.transition // "wave"' "$STATE_FILE")
    local reset_accent=0

    local prev_theme
    prev_theme=$(jq -r '.theme // ""' "$STATE_FILE")
    [ "$prev_theme" != "$target_id" ] && accent_ov=""

    while [ $# -gt 0 ]; do
        case "$1" in
            --accent)
                shift
                if [ "${1:-}" = "none" ] || [ "${1:-}" = "reset" ] || [ -z "${1:-}" ]; then
                    accent_ov=""
                    reset_accent=1
                elif valid_hex "${1:-}"; then
                    accent_ov="$1"
                fi
                ;;
            --bg)
                shift
                [ -f "${1:-}" ] && bg_arg="$1"
                ;;
            --monitor)
                shift
                [ -n "${1:-}" ] && mon_arg="$1"
                ;;
            --video)
                shift
                case "${1:-}" in
                    on|1|true)   video_arg="true" ;;
                    off|0|false) video_arg="false" ;;
                esac
                ;;
            --transition)
                shift
                case "${1:-}" in
                    fade|zoom|wave) trans_arg="$1" ;;
                esac
                ;;
        esac
        shift || true
    done
    [ "$reset_accent" -eq 1 ] && accent_ov=""

    if [ -z "$bg_arg" ]; then
        local m_json def_bg
        m_json=$(toml_to_json "${tdir}/theme.toml")
        def_bg=$(printf '%s' "$m_json" | jq -r '.default_background // ""')
        if [ -n "$def_bg" ] && [ -f "${tdir}/backgrounds/${def_bg}" ]; then
            bg_arg="${tdir}/backgrounds/${def_bg}"
        else
            bg_arg=$(find "${tdir}/backgrounds" -maxdepth 1 -type f 2>/dev/null | sort | head -n1)
        fi
        [ -z "$bg_arg" ] && [ -f "${tdir}/preview.jpg" ] && bg_arg="${tdir}/preview.jpg"
        [ -z "$bg_arg" ] && bg_arg="$FALLBACK_BG"
    fi

    if [ "$mon_arg" = "ALL" ] || [ -z "$mon_arg" ]; then
        jq --arg t "$target_id" \
           --arg acc "$accent_ov" \
           --arg bg "$bg_arg" \
           --argjson vid "$video_arg" \
           --arg tr "$trans_arg" \
           '.theme = $t | .accentOverride = $acc | .background = $bg | .perMonitorBg = {} | .videoEnabled = $vid | .transition = $tr' \
           "$STATE_FILE" > "${STATE_FILE}.tmp.$$" && mv -f "${STATE_FILE}.tmp.$$" "$STATE_FILE"
    elif valid_monitor_name "$mon_arg"; then
        jq --arg t "$target_id" \
           --arg acc "$accent_ov" \
           --arg mon "$mon_arg" \
           --arg bg "$bg_arg" \
           --argjson vid "$video_arg" \
           --arg tr "$trans_arg" \
           '.theme = $t | .accentOverride = $acc | .perMonitorBg = ((.perMonitorBg // {}) + {($mon): $bg}) | .videoEnabled = $vid | .transition = $tr' \
           "$STATE_FILE" > "${STATE_FILE}.tmp.$$" && mv -f "${STATE_FILE}.tmp.$$" "$STATE_FILE"
    fi

    sync_full_theme
    printf '%s\n' "$target_id"
}

cmd_set_bg() {
    ensure_state_file
    local bg_path="${1:-}"
    shift || true
    if [ -z "$bg_path" ] || [ ! -f "$bg_path" ]; then
        echo "ERR: background file not found: $bg_path" >&2
        return 1
    fi

    local mon_arg="ALL"
    while [ $# -gt 0 ]; do
        case "$1" in
            --monitor)
                shift
                [ -n "${1:-}" ] && mon_arg="$1"
                ;;
        esac
        shift || true
    done

    if [ "$mon_arg" = "ALL" ] || [ -z "$mon_arg" ]; then
        jq --arg bg "$bg_path" '.background = $bg | .perMonitorBg = {}' \
            "$STATE_FILE" > "${STATE_FILE}.tmp.$$" && mv -f "${STATE_FILE}.tmp.$$" "$STATE_FILE"
    elif valid_monitor_name "$mon_arg"; then
        jq --arg mon "$mon_arg" --arg bg "$bg_path" \
            '.perMonitorBg = ((.perMonitorBg // {}) + {($mon): $bg})' \
            "$STATE_FILE" > "${STATE_FILE}.tmp.$$" && mv -f "${STATE_FILE}.tmp.$$" "$STATE_FILE"
    else
        echo "ERR: invalid monitor name: $mon_arg" >&2
        return 1
    fi

    sync_shell_and_wallpapers
    printf '%s\n' "$bg_path"
}

cmd_set_video() {
    ensure_state_file
    local action="${1:-toggle}"
    local cur
    cur=$(jq -r 'if .videoEnabled == true then "true" else "false" end' "$STATE_FILE")
    local next="$cur"
    case "$action" in
        on|1|true)   next="true" ;;
        off|0|false) next="false" ;;
        toggle)      [ "$cur" = "true" ] && next="false" || next="true" ;;
        get)         printf '%s\n' "$cur"; return 0 ;;
    esac

    jq --argjson v "$next" '.videoEnabled = $v' "$STATE_FILE" > "${STATE_FILE}.tmp.$$" && mv -f "${STATE_FILE}.tmp.$$" "$STATE_FILE"
    sync_shell_and_wallpapers
    printf '%s\n' "$next"
}

cmd_set_battery_poster() {
    ensure_state_file
    local action="${1:-toggle}"
    local cur
    cur=$(jq -r 'if .batteryPoster == false then "false" else "true" end' "$STATE_FILE")
    local next="$cur"
    case "$action" in
        on|1|true)   next="true" ;;
        off|0|false) next="false" ;;
        toggle)      [ "$cur" = "true" ] && next="false" || next="true" ;;
        get)         printf '%s\n' "$cur"; return 0 ;;
    esac

    jq --argjson v "$next" '.batteryPoster = $v' "$STATE_FILE" > "${STATE_FILE}.tmp.$$" && mv -f "${STATE_FILE}.tmp.$$" "$STATE_FILE"
    sync_shell_and_wallpapers
    printf '%s\n' "$next"
}

cmd_set_transition() {
    ensure_state_file
    local tr="${1:-wave}"
    case "$tr" in
        fade|zoom|wave) ;;
        *) echo "ERR: transition must be fade|zoom|wave" >&2; return 1 ;;
    esac
    jq --arg t "$tr" '.transition = $t' "$STATE_FILE" > "${STATE_FILE}.tmp.$$" && mv -f "${STATE_FILE}.tmp.$$" "$STATE_FILE"
    write_palette_from_state
    notify_quickshell_reload
    printf '%s\n' "$tr"
}

cmd_set_accent() {
    ensure_state_file
    local cur_theme
    cur_theme=$(jq -r '.theme // "x64-lios-crimson"' "$STATE_FILE")
    local arg="${1:-reset}"
    local acc=""
    if [ "$arg" != "reset" ] && [ "$arg" != "none" ] && valid_hex "$arg"; then
        acc="$arg"
    fi
    jq --arg a "$acc" '.accentOverride = $a' "$STATE_FILE" > "${STATE_FILE}.tmp.$$" && mv -f "${STATE_FILE}.tmp.$$" "$STATE_FILE"
    write_palette_from_state
    notify_quickshell_reload
    apply_hyprland_borders
    write_hyprlock_theme
    dispatch_system_retheme
    printf '%s\n' "${acc:-default}"
}

cmd_thumbs() {
    local filter="${1:---all}"
    local id tdir f count=0
    while IFS= read -r id; do
        [ -n "$id" ] || continue
        if [ "$filter" != "--all" ] && [ "$filter" != "$id" ]; then
            continue
        fi
        tdir=$(resolve_theme_dir "$id") || continue
        for d in "${tdir}/backgrounds" "${USER_THEMES_DIR}/backgrounds/${id}"; do
            [ -d "$d" ] || continue
            while IFS= read -r -d '' f; do
                if is_video_file "$f"; then
                    ensure_thumb_for "$f" 1 >/dev/null
                    ensure_poster_for "$f" >/dev/null
                    count=$(( count + 1 ))
                elif is_image_file "$f"; then
                    ensure_thumb_for "$f" 1 >/dev/null
                    count=$(( count + 1 ))
                fi
            done < <(find "$d" -maxdepth 1 -type f -print0 2>/dev/null)
        done
    done < <(discover_theme_ids)
    printf '{"generated":%d,"cacheDir":"%s"}\n' "$count" "$CACHE_DIR"
}

cmd_restore() {
    ensure_state_file
    sync_full_theme
}

cmd_retheme() {
    cmd_init
    apply_hyprland_borders
    write_hyprlock_theme
    run_system_retheme_sync ""
}

cmd_init() {
    ensure_state_file
    if [ ! -s "$PALETTE_FILE" ] || ! jq -e '.theme | type == "string"' "$PALETTE_FILE" >/dev/null 2>&1; then
        write_palette_from_state
    fi
}

cmd_current() {
    cmd_init
    cat "$PALETTE_FILE"
}

cmd_random() {
    ensure_state_file
    local cur
    cur=$(jq -r '.theme // ""' "$STATE_FILE")
    local -a ids=()
    local id
    while IFS= read -r id; do
        [ -n "$id" ] && [ "$id" != "$cur" ] && ids+=("$id")
    done < <(discover_theme_ids)
    if [ "${#ids[@]}" -eq 0 ]; then
        ids=("$DEFAULT_THEME")
    fi
    local pick="${ids[$(( RANDOM % ${#ids[@]} ))]}"
    cmd_apply "$pick"
}

with_mutation_lock() {
    local lock_file="${RUNTIME_DIR}/x64-theme.lock"
    exec 9>"$lock_file"
    flock -w 8 9 || true
    "$@"
    local rc=$?
    flock -u 9 2>/dev/null || true
    exec 9>&- 2>/dev/null || true
    return "$rc"
}

case "${1:-current}" in
    list)           cmd_list ;;
    apply)          shift; with_mutation_lock cmd_apply "$@" ;;
    random)         with_mutation_lock cmd_random ;;
    set-bg)         shift; with_mutation_lock cmd_set_bg "$@" ;;
    video)          shift; with_mutation_lock cmd_set_video "${1:-toggle}" ;;
    battery-poster) shift; with_mutation_lock cmd_set_battery_poster "${1:-toggle}" ;;
    transition)     shift; with_mutation_lock cmd_set_transition "${1:-wave}" ;;
    pause-video)    shift; cmd_pause_video "${1:-on}" ;;
    set-accent)     shift; with_mutation_lock cmd_set_accent "${1:-reset}" ;;
    thumbs)         shift; cmd_thumbs "${1:---all}" ;;
    restore)        with_mutation_lock cmd_restore ;;
    retheme)        with_mutation_lock cmd_retheme ;;
    _retheme-worker) shift; run_system_retheme_sync "${1:-}" ;;
    init)           cmd_init ;;
    current)        cmd_current ;;
    *)
        echo "Usage: x64-theme {list|apply|set-bg|video|battery-poster|transition|pause-video|set-accent|thumbs|restore|retheme|current|init}" >&2
        exit 1
        ;;
esac
