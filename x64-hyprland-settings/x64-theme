# ------------------------------------------------------------------------------
# SYSTEM RETHEMING ENGINE (Sub-phase 3.1-D)
# Syncs: Hyprland borders, Hyprlock, Kitty, btop, Papirus Folders (A/B overlay),
#        Qt/KDE (kdeglobals + D-Bus), GTK3 (A/B live CSS) & GTK4/Libadwaita.
# ------------------------------------------------------------------------------
apply_hyprland_borders() {
    [ -s "$PALETTE_FILE" ] || return 0
    local -a hv=()
    mapfile -t hv < <(
        jq -r '
            (.accent // "#ff2b2b"),
            (.accentHover // "#ff4d4d"),
            (.bgElevated // "#1a1d26"),
            (.accentOverride // ""),
            (.hyprlandActiveBorder // ""),
            (.hyprlandInactiveBorder // "")
        ' "$PALETTE_FILE"
    )
    local acc="${hv[0]:-#ff2b2b}" acc_hov="${hv[1]:-#ff4d4d}" bg_el="${hv[2]:-#1a1d26}"
    local acc_ov="${hv[3]:-}" raw_act="${hv[4]:-}" raw_inact="${hv[5]:-}"

    local c1 c2 inact
    if [ -z "$acc_ov" ] && [ -n "$raw_act" ]; then
        read -r c1 c2 _ <<< "$raw_act"
        [ -z "${c1:-}" ] && c1=$(hex_to_hypr_rgba "$acc" "ee")
        [ -z "${c2:-}" ] && c2=$(hex_to_hypr_rgba "$acc_hov" "ee")
    else
        c1=$(hex_to_hypr_rgba "$acc" "ee")
        c2=$(hex_to_hypr_rgba "$acc_hov" "ee")
    fi

    if [ -z "$acc_ov" ] && [ -n "$raw_inact" ]; then
        inact="$raw_inact"
    else
        inact=$(hex_to_hypr_rgba "$bg_el" "aa")
    fi

    local hypr_dir="${HOME}/.config/hypr"
    mkdir -p "$hypr_dir"

    cat > "${hypr_dir}/theme.lua.tmp.$$" <<EOF
-- Auto-generated by x64-theme (X64 Theme Studio)
-- Preserved across package updates; personal overrides belong in ~/.config/hypr/custom.lua
hl.config({
    general = {
        col = {
            active_border   = { colors = { "${c1}", "${c2}" }, angle = 45 },
            inactive_border = "${inact}",
        },
    },
})
EOF
    mv -f "${hypr_dir}/theme.lua.tmp.$$" "${hypr_dir}/theme.lua"

    cat > "${hypr_dir}/theme.conf.tmp.$$" <<EOF
# Auto-generated by x64-theme (X64 Theme Studio)
general {
    col.active_border = ${c1} ${c2} 45deg
    col.inactive_border = ${inact}
}
EOF
    mv -f "${hypr_dir}/theme.conf.tmp.$$" "${hypr_dir}/theme.conf"

    if command -v hyprctl >/dev/null 2>&1 && [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
        hyprctl eval "hl.config({ general = { col = { active_border = { colors = { \"${c1}\", \"${c2}\" }, angle = 45 }, inactive_border = \"${inact}\" } } })" >/dev/null 2>&1 || \
            hyprctl --batch "keyword general:col.active_border ${c1} ${c2} 45deg; keyword general:col.inactive_border ${inact}" >/dev/null 2>&1 || true
    fi
}

