run_system_retheme_sync() {
    local expected_gen="${1:-}"
    local gen_file="${RUNTIME_DIR}/retheme.gen"
    [ -s "$PALETTE_FILE" ] || return 0

    if [ -n "$expected_gen" ] && [ -f "$gen_file" ]; then
        [ "$(cat "$gen_file" 2>/dev/null)" = "$expected_gen" ] || return 0
    fi

    # Single atomic Python pass writes Kitty, btop, Papirus user overlay (A/B),
    # GTK3/4 CSS + A/B wrappers + settings.ini, and Qt/KDE kdeglobals + color-scheme (~35ms total).
    local out_vars
    out_vars=$(python3 - "$PALETTE_FILE" "$CONF_DIR" "$RUNTIME_DIR" <<'PYEOF'
import json
import os
import re
import sys

palette_path = sys.argv[1]
conf_dir = sys.argv[2]
runtime_dir = sys.argv[3]
home = os.path.expanduser("~")

with open(palette_path, "r", encoding="utf-8") as f:
    p = json.load(f)

def atomic_write(path, content):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f"{path}.tmp.{os.getpid()}"
    with open(tmp, "w", encoding="utf-8") as fh:
        fh.write(content)
    os.replace(tmp, path)

def hex_rgb_tuple(h, default=(255, 43, 43)):
    h = (h or "").strip().lstrip("#")
    if len(h) != 6:
        return default
    try:
        return (int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16))
    except ValueError:
        return default

def hex_rgb_csv(h, default="255,43,43"):
    r, g, b = hex_rgb_tuple(h)
    return f"{r},{g},{b}"

def mix_hex(c1, c2, t):
    r1, g1, b1 = hex_rgb_tuple(c1, (11, 12, 16))
    r2, g2, b2 = hex_rgb_tuple(c2, (255, 255, 255))
    r = max(0, min(255, int(round(r1 + (r2 - r1) * t))))
    g = max(0, min(255, int(round(g1 + (g2 - g1) * t))))
    b = max(0, min(255, int(round(b1 + (b2 - b1) * t))))
    return f"#{r:02x}{g:02x}{b:02x}"

bg_dark = p.get("bgDark", "#0b0c10")
dark_bg = p.get("darkBackground", bg_dark)
bg_card = p.get("bgCard", "#13151c")
bg_elev = p.get("bgElevated", "#1a1d26")
bg_hover = p.get("bgHover", "#222530")
bg_active = p.get("bgActive", "#2c303e")
selection = p.get("selection", mix_hex(bg_dark, p.get("accent", "#ff2b2b"), 0.22))
accent = p.get("accent", "#ff2b2b")
accent_hover = p.get("accentHover", "#ff4747")
accent_deep = p.get("accentDeep", mix_hex(accent, "#000000", 0.30))
accent_fg = p.get("accentFg", "#ffffff")
fg = p.get("textPrimary", "#ebe8e3")
fg2 = p.get("textSecondary", "#8e909a")
muted = p.get("textMuted", "#565863")
status_ok = p.get("statusOk", "#34d399")
status_warn = p.get("statusWarn", "#f5a524")
cols = p.get("colors", {})
c_red = cols.get("red", "#ff2b2b")
c_yellow = cols.get("yellow", "#f5a524")
c_orange = cols.get("orange", "#ff7b00")
c_green = cols.get("green", "#34d399")
c_cyan = cols.get("cyan", "#06b6d4")
c_blue = cols.get("blue", "#3b82f6")
c_magenta = cols.get("magenta", "#a855f7")
b_red = cols.get("bright_red", "#ff4d4d")
b_yellow = cols.get("bright_yellow", "#fde047")
b_green = cols.get("bright_green", "#34d399")
b_cyan = cols.get("bright_cyan", "#22d3ee")
b_blue = cols.get("bright_blue", "#60a5fa")
b_magenta = cols.get("bright_magenta", "#d8b4fe")
