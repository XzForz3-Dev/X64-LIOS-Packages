#!/usr/bin/env bash
# ==============================================================================
# X64 LIOS - Sovereign Theme & Wallpaper Engine (x64-theme)
# Compatible with Omarchy colors.toml + X64 theme.toml metadata.
# Manages live palette state, GPU static/video wallpapers (Wallpaper.qml +
# mpvpaper NVDEC), automatic fullscreen/gaming/battery pausing, and thumbnails.
# ==============================================================================

set -u
export LC_ALL=C.UTF-8
export LC_NUMERIC=C

UID_NUM=$(id -u)
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/${UID_NUM}}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=${XDG_RUNTIME_DIR}/bus}"

if [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && [ -d "${XDG_RUNTIME_DIR}/hypr" ]; then
    export HYPRLAND_INSTANCE_SIGNATURE=$(ls -t "${XDG_RUNTIME_DIR}/hypr/" 2>/dev/null | head -n1)
fi
if [ -z "${WAYLAND_DISPLAY:-}" ]; then
    for sock in "${XDG_RUNTIME_DIR}"/wayland-*; do
        if [ -S "$sock" ]; then
            export WAYLAND_DISPLAY=$(basename "$sock")
            break
        fi
    done
fi

SYS_THEMES_DIR="/usr/share/x64-themes"
USER_THEMES_DIR="${HOME}/.config/x64-themes"
CONF_DIR="${HOME}/.config/x64-theme"
STATE_FILE="${CONF_DIR}/state.json"
PALETTE_FILE="${CONF_DIR}/palette.json"
RUNTIME_DIR="${XDG_RUNTIME_DIR}/x64-theme"
CACHE_DIR="${HOME}/.cache/x64-theme/thumbs"
FALLBACK_BG="/usr/share/backgrounds/x64-lios/01-monolith.jpg"
DEFAULT_THEME="x64-lios-crimson"

mkdir -p "$CONF_DIR" "$CACHE_DIR" "$RUNTIME_DIR"

valid_hex() {
    [[ "${1:-}" =~ ^#[0-9A-Fa-f]{6}$ ]]
}

valid_theme_id() {
    [[ "${1:-}" =~ ^[A-Za-z0-9._-]+$ ]]
}

valid_monitor_name() {
    [[ "${1:-}" =~ ^[A-Za-z0-9._-]+$ ]]
}

is_video_file() {
    case "${1,,}" in
        *.mp4|*.webm|*.mkv|*.mov) return 0 ;;
        *) return 1 ;;
    esac
}

is_image_file() {
    case "${1,,}" in
        *.jpg|*.jpeg|*.png|*.webp) return 0 ;;
        *) return 1 ;;
    esac
}

is_on_battery_discharging() {
    for bat_dir in /sys/class/power_supply/BAT*; do
        [ -d "$bat_dir" ] || continue
        local cap st
        cap=$(cat "${bat_dir}/capacity" 2>/dev/null || echo 0)
        st=$(cat "${bat_dir}/status" 2>/dev/null || echo "")
        if [ "$st" = "Discharging" ] && [ "${cap:-0}" -gt 0 ] 2>/dev/null; then
            return 0
        fi
    done
    return 1
}

is_gaming_or_fullscreen_paused() {
    local gm
    gm=$(cat "${XDG_RUNTIME_DIR}/x64-shell/gaming_mode" 2>/dev/null || echo "0")
    [ "$gm" = "1" ] && return 0
    if hyprctl activeworkspace -j 2>/dev/null | grep -q '"hasfullscreen": true'; then
        return 0
    fi
    return 1
}

resolve_theme_dir() {
    local id="$1"
    valid_theme_id "$id" || return 1
    if [ -f "${USER_THEMES_DIR}/${id}/colors.toml" ]; then
        printf '%s' "${USER_THEMES_DIR}/${id}"
        return 0
    fi
    if [ -f "${SYS_THEMES_DIR}/${id}/colors.toml" ]; then
        printf '%s' "${SYS_THEMES_DIR}/${id}"
        return 0
    fi
    return 1
}

toml_to_json() {
    local f="$1"
    if [ ! -r "$f" ]; then
        printf '{}'
        return 0
    fi
    awk '
        /^[[:space:]]*#/ || /^[[:space:]]*$/ { next }
        /^[[:space:]]*\[/ { next }
        match($0, /^[[:space:]]*([A-Za-z0-9_-]+)[[:space:]]*=[[:space:]]*(.*)$/, m) {
            k = m[1];
            v = m[2];
            sub(/[[:space:]]*$/, "", v);
            if (substr(v, 1, 1) == "\"") {
                if (match(v, /^"([^"]*)"/, q)) {
                    val = q[1];
                    gsub(/\\/, "\\\\", val);
                    gsub(/"/, "\\\"", val);
                    items[k] = "\"" val "\"";
                }
            } else if (substr(v, 1, 1) == "\x27") {
                if (match(v, /^\x27([^\x27]*)\x27/, q)) {
                    val = q[1];
                    gsub(/\\/, "\\\\", val);
                    gsub(/"/, "\\\"", val);
                    items[k] = "\"" val "\"";
                }
            } else {
                sub(/[[:space:]]*#.*$/, "", v);
                if (v ~ /^-?[0-9]+(\.[0-9]+)?$/ || v == "true" || v == "false") {
                    items[k] = v;
                } else {
                    gsub(/"/, "\\\"", v);
                    items[k] = "\"" v "\"";
                }
            }
        }
        END {
            printf "{";
            first = 1;
            for (k in items) {
                if (!first) printf ",";
                printf "\"%s\":%s", k, items[k];
                first = 0;
            }
            printf "}";
        }
    ' "$f"
}

thumb_path_for() {
    local src="$1"
    local stat_sig hash
    stat_sig=$(stat -c '%s_%Y' "$src" 2>/dev/null || echo "0_0")
    hash=$(printf '%s|%s' "$src" "$stat_sig" | sha1sum | awk '{print $1}')
    printf '%s/%s.jpg' "$CACHE_DIR" "$hash"
}

poster_path_for() {
    local src="$1"
    local stat_sig hash
    stat_sig=$(stat -c '%s_%Y' "$src" 2>/dev/null || echo "0_0")
    hash=$(printf '%s|%s|poster' "$src" "$stat_sig" | sha1sum | awk '{print $1}')
    printf '%s/%s.jpg' "$CACHE_DIR" "$hash"
}

ensure_thumb_for() {
    local src="$1"
    local generate="${2:-0}"
    local out
    out=$(thumb_path_for "$src")
    if [ -s "$out" ]; then
        printf '%s' "$out"
        return 0
    fi
    if [ "$generate" -eq 1 ] && command -v ffmpeg >/dev/null 2>&1; then
        local tmp="${out}.tmp.$$.jpg"
        if is_video_file "$src"; then
            ffmpeg -nostdin -loglevel error -ss 1 -i "$src" -frames:v 1 -vf "scale=480:-2:flags=lanczos" -q:v 4 "$tmp" 2>/dev/null || \
                ffmpeg -nostdin -loglevel error -i "$src" -frames:v 1 -vf "scale=480:-2:flags=lanczos" -q:v 4 "$tmp" 2>/dev/null || true
        else
            ffmpeg -nostdin -loglevel error -i "$src" -frames:v 1 -vf "scale=480:-2:flags=lanczos" -q:v 4 "$tmp" 2>/dev/null || true
        fi
        if [ -s "$tmp" ]; then
            mv -f "$tmp" "$out"
            printf '%s' "$out"
            return 0
        fi
        rm -f "$tmp"
    fi
    if is_image_file "$src"; then
        printf '%s' "$src"
    else
        printf ''
    fi
}

# Full-HD poster frame for crisp video fallback & battery/static poster display
ensure_poster_for() {
    local src="$1"
    if ! is_video_file "$src"; then
        printf '%s' "$src"
        return 0
    fi
    local out
    out=$(poster_path_for "$src")
    if [ -s "$out" ]; then
        printf '%s' "$out"
        return 0
    fi
    if command -v ffmpeg >/dev/null 2>&1; then
        local tmp="${out}.tmp.$$.jpg"
        ffmpeg -nostdin -loglevel error -ss 1 -i "$src" -frames:v 1 -vf "scale='min(1920,iw)':-2:flags=lanczos" -q:v 2 "$tmp" 2>/dev/null || \
            ffmpeg -nostdin -loglevel error -i "$src" -frames:v 1 -vf "scale='min(1920,iw)':-2:flags=lanczos" -q:v 2 "$tmp" 2>/dev/null || true
        if [ -s "$tmp" ]; then
            mv -f "$tmp" "$out"
            printf '%s' "$out"
            return 0
        fi
        rm -f "$tmp"
    fi
    ensure_thumb_for "$src" 1
}

mix_hex() {
    awk -v c1="$1" -v c2="$2" -v t="$3" 'BEGIN {
        gsub(/^#/, "", c1); gsub(/^#/, "", c2);
        r1 = strtonum("0x" substr(c1,1,2)); g1 = strtonum("0x" substr(c1,3,2)); b1 = strtonum("0x" substr(c1,5,2));
        r2 = strtonum("0x" substr(c2,1,2)); g2 = strtonum("0x" substr(c2,3,2)); b2 = strtonum("0x" substr(c2,5,2));
        r = int(r1 + (r2 - r1) * t + 0.5);
        g = int(g1 + (g2 - g1) * t + 0.5);
        b = int(b1 + (b2 - b1) * t + 0.5);
        if (r<0) r=0; if (r>255) r=255;
        if (g<0) g=0; if (g>255) g=255;
        if (b<0) b=0; if (b>255) b=255;
        printf "#%02x%02x%02x", r, g, b;
    }'
}

contrast_fg_for() {
    awk -v c="$1" 'BEGIN {
        gsub(/^#/, "", c);
        r = strtonum("0x" substr(c,1,2)) / 255.0;
        g = strtonum("0x" substr(c,3,2)) / 255.0;
        b = strtonum("0x" substr(c,5,2)) / 255.0;
        rl = (r <= 0.03928) ? (r / 12.92) : ((r + 0.055) / 1.055) ^ 2.4;
        gl = (g <= 0.03928) ? (g / 12.92) : ((g + 0.055) / 1.055) ^ 2.4;
        bl = (b <= 0.03928) ? (b / 12.92) : ((b + 0.055) / 1.055) ^ 2.4;
        lum = 0.2126 * rl + 0.7152 * gl + 0.0722 * bl;
        printf "%s", (lum > 0.38 ? "#0a0b10" : "#ffffff");
    }'
}

nearest_papirus_color() {
    awk -v c="$1" 'BEGIN {
        gsub(/^#/, "", c);
        r = strtonum("0x" substr(c,1,2));
        g = strtonum("0x" substr(c,3,2));
        b = strtonum("0x" substr(c,5,2));
        n = split("red:229,57,53 carmine:163,0,52 deeporange:255,87,34 orange:245,158,11 yellow:250,204,21 green:34,197,94 teal:20,184,166 cyan:6,182,212 blue:59,130,246 indigo:99,102,241 violet:168,85,247 magenta:236,72,153 pink:244,114,182 white:235,235,235 grey:142,142,147 black:56,56,64", arr, " ");
        best = "red"; best_d = 1e18;
        for (i = 1; i <= n; i++) {
            split(arr[i], kv, ":");
            split(kv[2], rgb, ",");
            dr = r - rgb[1]; dg = g - rgb[2]; db = b - rgb[3];
            d = 2*dr*dr + 4*dg*dg + 3*db*db;
            if (d < best_d) { best_d = d; best = kv[1]; }
        }
        printf "%s", best;
    }'
}

nearest_gtk_accent_name() {
    awk -v c="$1" 'BEGIN {
        gsub(/^#/, "", c);
        r = strtonum("0x" substr(c,1,2));
        g = strtonum("0x" substr(c,3,2));
        b = strtonum("0x" substr(c,5,2));
        mx = (r > g ? (r > b ? r : b) : (g > b ? g : b));
        mn = (r < g ? (r < b ? r : b) : (g < b ? g : b));
        if ((mx - mn) < 28) { printf "slate"; exit; }
        n = split("red:237,51,59 orange:245,158,11 yellow:246,211,45 green:46,194,126 teal:6,182,212 blue:53,132,228 purple:168,85,247 pink:255,113,206 slate:142,142,152", arr, " ");
        best = "red"; best_d = 1e18;
        for (i = 1; i <= n; i++) {
            split(arr[i], kv, ":");
            split(kv[2], rgb, ",");
            dr = r - rgb[1]; dg = g - rgb[2]; db = b - rgb[3];
            d = 2*dr*dr + 4*dg*dg + 3*db*db;
            if (d < best_d) { best_d = d; best = kv[1]; }
        }
        printf "%s", best;
    }'
}

hex_to_hypr_rgba() {
    local hex="${1#\#}"
    local alpha="${2:-ee}"
    printf 'rgba(%s%s)' "${hex,,}" "$alpha"
}

hex_to_rgb_space() {
    awk -v c="$1" 'BEGIN {
        gsub(/^#/, "", c);
        printf "%d, %d, %d", strtonum("0x" substr(c,1,2)), strtonum("0x" substr(c,3,2)), strtonum("0x" substr(c,5,2));
    }'
}

ensure_state_file() {
    if [ ! -s "$STATE_FILE" ] || ! jq -e '.theme | type == "string"' "$STATE_FILE" >/dev/null 2>&1; then
        printf '{"theme":"%s","accentOverride":"","background":"%s","videoEnabled":false,"batteryPoster":true,"transition":"wave","perMonitorBg":{}}\n' \
            "$DEFAULT_THEME" "$FALLBACK_BG" > "${STATE_FILE}.tmp.$$" && mv -f "${STATE_FILE}.tmp.$$" "$STATE_FILE"
    fi
}

# ------------------------------------------------------------------------------
# VIDEO WALLPAPER ENGINE (mpvpaper per monitor + IPC pause/resume)
# ------------------------------------------------------------------------------
stop_mpv_for_monitor() {
    local mon="$1"
    local pid_f="${RUNTIME_DIR}/mpv-${mon}.pid"
    local sock_f="${RUNTIME_DIR}/mpv-${mon}.sock"
    local src_f="${RUNTIME_DIR}/mpv-${mon}.src"
    if [ -f "$pid_f" ]; then
        local pid
        pid=$(cat "$pid_f" 2>/dev/null || echo "")
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            kill "$pid" 2>/dev/null || true
            for _ in 1 2 3 4 5; do
                kill -0 "$pid" 2>/dev/null || break
                sleep 0.04
            done
            kill -9 "$pid" 2>/dev/null || true
        fi
    fi
    rm -f "$pid_f" "$sock_f" "$src_f"
}

stop_all_mpv() {
    local pf
    for pf in "${RUNTIME_DIR}"/mpv-*.pid; do
        [ -f "$pf" ] || continue
        local mon
        mon=$(basename "$pf" .pid)
        mon="${mon#mpv-}"
        stop_mpv_for_monitor "$mon"
    done
    # Sweep any stray unmanaged mpvpaper belonging to this user
    pkill -u "$UID_NUM" -x mpvpaper 2>/dev/null || true
    rm -f "${RUNTIME_DIR}"/mpv-*.sock "${RUNTIME_DIR}"/mpv-*.src "${RUNTIME_DIR}"/mpv-*.pid
}

start_mpv_for_monitor() {
    local mon="$1"
    local vid="$2"
    valid_monitor_name "$mon" || return 1
    [ -f "$vid" ] || return 1
    command -v mpvpaper >/dev/null 2>&1 || return 1

    local pid_f="${RUNTIME_DIR}/mpv-${mon}.pid"
    local sock_f="${RUNTIME_DIR}/mpv-${mon}.sock"
    local src_f="${RUNTIME_DIR}/mpv-${mon}.src"

    # Skip restart if exact same video is already playing cleanly on this monitor
    if [ -f "$pid_f" ] && [ -f "$src_f" ] && [ -S "$sock_f" ]; then
        local cur_pid cur_src
        cur_pid=$(cat "$pid_f" 2>/dev/null || echo "")
        cur_src=$(cat "$src_f" 2>/dev/null || echo "")
        if [ -n "$cur_pid" ] && kill -0 "$cur_pid" 2>/dev/null \
           && grep -q "mpvpaper" "/proc/${cur_pid}/comm" 2>/dev/null \
           && [ "$cur_src" = "$vid" ]; then
            return 0
        fi
    fi

    stop_mpv_for_monitor "$mon"

    local hwdec="auto-safe"
    if command -v systemd-detect-virt >/dev/null 2>&1 && systemd-detect-virt -q 2>/dev/null; then
        hwdec="no"
    fi

    local extra_pause=""
    if is_gaming_or_fullscreen_paused; then
        extra_pause=" pause=yes"
    fi

    local opts="no-config load-scripts=no no-audio loop panscan=1.0 hwdec=${hwdec} vd-lavc-threads=2 input-ipc-server=${sock_f}${extra_pause}"
    local log_f="${RUNTIME_DIR}/mpv-${mon}.log"
    setsid mpvpaper -p -a full -l background -o "$opts" "$mon" "$vid" >"$log_f" 2>&1 </dev/null 9>&- &
    local mpid=$!
    disown "$mpid" 2>/dev/null || true
    printf '%s\n' "$mpid" > "$pid_f"
    printf '%s\n' "$vid" > "$src_f"
}

cmd_pause_video() {
    local mode="${1:-on}"
    local val="true"
    [ "$mode" = "off" ] || [ "$mode" = "0" ] || [ "$mode" = "resume" ] && val="false"

    command -v socat >/dev/null 2>&1 || return 0
    local sock
    for sock in "${RUNTIME_DIR}"/mpv-*.sock; do
        [ -S "$sock" ] || continue
        printf '{"command":["set_property","pause",%s]}\n' "$val" | socat -t 0.2 - "UNIX-CONNECT:${sock}" >/dev/null 2>&1 || true
    done
}

# Reconcile live wallpaper daemons (kills swaybg, starts/stops mpvpaper per monitor)
reconcile_live_wallpapers() {
    ensure_state_file
    # Wallpaper.qml owns static backgrounds & video posters; swaybg must never block mpvpaper
    pkill -u "$UID_NUM" -x swaybg 2>/dev/null || true

    local video_en bat_poster global_bg
    video_en=$(jq -r 'if .videoEnabled == true then "1" else "0" end' "$STATE_FILE")
    bat_poster=$(jq -r 'if .batteryPoster == false then "0" else "1" end' "$STATE_FILE")
    global_bg=$(jq -r '.background // ""' "$STATE_FILE")

    if [ "$video_en" != "1" ]; then
        stop_all_mpv
        return 0
    fi
    if [ "$bat_poster" = "1" ] && is_on_battery_discharging; then
        stop_all_mpv
        return 0
    fi

    local mons=()
    while IFS= read -r m; do
        [ -n "$m" ] && mons+=("$m")
    done < <(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.disabled != true) | .name' 2>/dev/null)

    # Stop mpvpaper on any disconnected monitor
    local pf mname
    for pf in "${RUNTIME_DIR}"/mpv-*.pid; do
        [ -f "$pf" ] || continue
        mname=$(basename "$pf" .pid)
        mname="${mname#mpv-}"
        local still_connected=0
        for cm in "${mons[@]}"; do
            [ "$cm" = "$mname" ] && still_connected=1 && break
        done
        [ "$still_connected" -eq 0 ] && stop_mpv_for_monitor "$mname"
    done

    local m bg
    for m in "${mons[@]}"; do
        bg=$(jq -r --arg mon "$m" '.perMonitorBg[$mon] // .background // ""' "$STATE_FILE")
        [ -z "$bg" ] && bg="$global_bg"
        if [ -n "$bg" ] && [ -f "$bg" ] && is_video_file "$bg"; then
            start_mpv_for_monitor "$m" "$bg"
        else
            stop_mpv_for_monitor "$m"
        fi
    done
}

collect_theme_backgrounds_json() {
    local id="$1"
    local tdir="$2"
    local gen_thumbs="${3:-0}"
    local preview_fallback="${4:-}"
    local entries=()
    local f name is_vid th

    local dirs=("${tdir}/backgrounds" "${USER_THEMES_DIR}/backgrounds/${id}")
    for d in "${dirs[@]}"; do
        [ -d "$d" ] || continue
        while IFS= read -r -d '' f; do
            if is_video_file "$f"; then
                is_vid="true"
            elif is_image_file "$f"; then
                is_vid="false"
            else
                continue
            fi
            name=$(basename "$f")
            th=$(ensure_thumb_for "$f" "$gen_thumbs")
            [ -z "$th" ] && th="$preview_fallback"
            entries+=("$(jq -cn --arg p "$f" --arg n "$name" --argjson v "$is_vid" --arg t "$th" '{path:$p,name:$n,isVideo:$v,thumb:$t}')")
        done < <(find "$d" -maxdepth 1 -type f -print0 2>/dev/null | sort -z)
    done

    if [ "${#entries[@]}" -eq 0 ]; then
        printf '[]'
    else
        printf '%s\n' "${entries[@]}" | jq -cs '.'
    fi
}

build_theme_record_json() {
    local id="$1"
    local tdir="$2"
    local is_user="$3"
    local gen_thumbs="${4:-0}"

    local c_json m_json
    c_json=$(toml_to_json "${tdir}/colors.toml")
    m_json=$(toml_to_json "${tdir}/theme.toml")

    local preview=""
    for cand in "${tdir}/preview.jpg" "${tdir}/preview.png" "${tdir}/preview.webp"; do
        if [ -f "$cand" ]; then
            preview="$cand"
            break
        fi
    done

    local bgs_json
    bgs_json=$(collect_theme_backgrounds_json "$id" "$tdir" "$gen_thumbs" "$preview")

    if [ -z "$preview" ]; then
        preview=$(printf '%s' "$bgs_json" | jq -r '.[0].thumb // .[0].path // ""')
    fi
    [ -z "$preview" ] && [ -f "$FALLBACK_BG" ] && preview="$FALLBACK_BG"

    jq -cn \
        --arg id "$id" \
        --arg dir "$tdir" \
        --argjson isUser "$is_user" \
        --arg preview "$preview" \
        --argjson colors "$c_json" \
        --argjson meta "$m_json" \
        --argjson bgs "$bgs_json" '
        ($colors.accent // "#ff2b2b") as $acc |
        ($colors.background // "#0b0c10") as $bg |
        ($colors.dark_background // $bg) as $dbg |
        ($colors.lighter_background // "#1a1d26") as $lbg |
        ($colors.foreground // "#ebe8e3") as $fg |
        ($colors.dark_foreground // "#8e909a") as $dfg |
        ($colors.muted // "#565863") as $mut |
        ($colors.selection // $lbg) as $sel |
        {
            id: $id,
            name: ($meta.name // ($id | gsub("[-_]"; " "))),
            author: ($meta.author // "X64 Studios"),
            description: ($meta.description // ""),
            order: ($meta.order // 99),
            mode: ($meta.mode // $colors.mode // "dark"),
            papirusColor: ($meta.papirus_color // "red"),
            defaultBackground: ($meta.default_background // ""),
            isUser: $isUser,
            dir: $dir,
            preview: $preview,
            hasVideo: (any($bgs[]; .isVideo == true)),
            bgCount: ($bgs | length),
            swatches: [
                $bg, $lbg, $acc,
                ($colors.red // $acc),
                ($colors.orange // $colors.yellow // "#f5a524"),
                ($colors.green // "#34d399"),
                ($colors.cyan // $colors.blue // "#06b6d4"),
                ($colors.magenta // $fg)
            ],
            palette: {
                accent: $acc,
                background: $bg,
                dark_background: $dbg,
                lighter_background: $lbg,
                selection: $sel,
                foreground: $fg,
                dark_foreground: $dfg,
                muted: $mut,
                red: ($colors.red // "#ff2b2b"),
                yellow: ($colors.yellow // "#f5a524"),
                orange: ($colors.orange // "#ff7b00"),
                green: ($colors.green // "#34d399"),
                cyan: ($colors.cyan // "#06b6d4"),
                blue: ($colors.blue // "#3b82f6"),
                magenta: ($colors.magenta // "#a855f7"),
                bright_red: ($colors.bright_red // "#ff4d4d"),
                bright_yellow: ($colors.bright_yellow // "#fde047"),
                bright_green: ($colors.bright_green // "#34d399"),
                bright_cyan: ($colors.bright_cyan // "#22d3ee"),
                bright_blue: ($colors.bright_blue // "#60a5fa"),
                bright_magenta: ($colors.bright_magenta // "#d8b4fe"),
                hyprland_active_border: ($colors.hyprland_active_border // ""),
                hyprland_inactive_border: ($colors.hyprland_inactive_border // "")
            },
            backgrounds: $bgs
        }
    '
}

discover_theme_ids() {
    local -A seen=()
    local d id
    for base in "$USER_THEMES_DIR" "$SYS_THEMES_DIR"; do
        [ -d "$base" ] || continue
        for d in "$base"/*/; do
            [ -f "${d}colors.toml" ] || continue
            id=$(basename "$d")
            valid_theme_id "$id" || continue
            if [ -z "${seen[$id]:-}" ]; then
                seen[$id]=1
                printf '%s\n' "$id"
            fi
        done
    done | sort
}

collect_user_backgrounds_json() {
    local user_dir=""
    if [ -d "${HOME}/Imágenes/Wallpapers" ]; then
        user_dir="${HOME}/Imágenes/Wallpapers"
    elif [ -d "${HOME}/Pictures/Wallpapers" ]; then
        user_dir="${HOME}/Pictures/Wallpapers"
    elif [ -d "${HOME}/Imágenes" ]; then
        user_dir="${HOME}/Imágenes/Wallpapers"
    else
        user_dir="${HOME}/Pictures/Wallpapers"
    fi

    local dirs=("$user_dir" "${HOME}/Imágenes/Wallpapers" "${HOME}/Pictures/Wallpapers" "${USER_THEMES_DIR}/backgrounds")
    local -A seen_dirs=()
    local entries=()
    local d f name is_vid th
    for d in "${dirs[@]}"; do
        [ -d "$d" ] || continue
        local rd
        rd=$(realpath "$d" 2>/dev/null || echo "$d")
        [ -n "${seen_dirs[$rd]:-}" ] && continue
        seen_dirs[$rd]=1
        while IFS= read -r -d '' f; do
            if is_video_file "$f"; then
                is_vid="true"
            elif is_image_file "$f"; then
                is_vid="false"
            else
                continue
            fi
            name=$(basename "$f")
            th=$(ensure_thumb_for "$f" 0)
            entries+=("$(jq -cn --arg p "$f" --arg n "$name" --argjson v "$is_vid" --arg t "$th" '{path:$p,name:$n,isVideo:$v,thumb:$t}')")
        done < <(find "$d" -maxdepth 1 -type f -print0 2>/dev/null | sort -z)
    done

    local bgs="[]"
    if [ "${#entries[@]}" -gt 0 ]; then
        bgs=$(printf '%s\n' "${entries[@]}" | jq -cs '.')
    fi
    jq -cn --arg dir "$user_dir" --argjson bgs "$bgs" '{dir:$dir, items:$bgs}'
}

cmd_list() {
    ensure_state_file
    local items=()
    local id tdir is_user
    while IFS= read -r id; do
        [ -n "$id" ] || continue
        if [ -f "${USER_THEMES_DIR}/${id}/colors.toml" ]; then
            tdir="${USER_THEMES_DIR}/${id}"
            is_user="true"
        else
            tdir="${SYS_THEMES_DIR}/${id}"
            is_user="false"
        fi
        items+=("$(build_theme_record_json "$id" "$tdir" "$is_user" 0)")
    done < <(discover_theme_ids)

    local themes_arr="[]"
    if [ "${#items[@]}" -gt 0 ]; then
        themes_arr=$(printf '%s\n' "${items[@]}" | jq -cs 'sort_by(.order, .name)')
    fi

    local user_bgs
    user_bgs=$(collect_user_backgrounds_json)

    jq -cn --slurpfile st "$STATE_FILE" --argjson themes "$themes_arr" --argjson ubgs "$user_bgs" '
        ($st[0] // {}) as $s |
        {
            activeTheme: ($s.theme // "x64-lios-crimson"),
            accentOverride: ($s.accentOverride // ""),
            activeBackground: ($s.background // ""),
            perMonitorBg: ($s.perMonitorBg // {}),
            videoEnabled: ($s.videoEnabled // false),
            batteryPoster: (if $s.batteryPoster == false then false else true end),
            transition: ($s.transition // "wave"),
            userBgDir: $ubgs.dir,
            userBackgrounds: $ubgs.items,
            themes: $themes
        }
    '
}

build_per_monitor_bg_resolved_json() {
    local preview_fallback="$1"
    local video_en="$2"
    local bat_poster="$3"
    local on_bat="false"
    if [ "$bat_poster" = "true" ] && is_on_battery_discharging; then
        on_bat="true"
    fi

    local map_json="{}"
    local mon path poster is_vid live_vid
    while IFS=$'\t' read -r mon path; do
        [ -n "$mon" ] && [ -n "$path" ] && [ -f "$path" ] || continue
        if is_video_file "$path"; then
            is_vid="true"
            poster=$(ensure_poster_for "$path")
            [ -z "$poster" ] && poster="$preview_fallback"
            if [ "$video_en" = "true" ] && [ "$on_bat" = "false" ]; then
                live_vid="true"
            else
                live_vid="false"
            fi
        else
            is_vid="false"
            poster="$path"
            live_vid="false"
        fi
        map_json=$(printf '%s' "$map_json" | jq -c \
            --arg m "$mon" --arg p "$path" --arg po "$poster" \
            --argjson iv "$is_vid" --argjson lv "$live_vid" \
            '.[$m] = {path:$p, poster:$po, isVideo:$iv, liveVideo:$lv}')
    done < <(jq -r '.perMonitorBg // {} | to_entries[] | [.key, .value] | @tsv' "$STATE_FILE" 2>/dev/null)

    printf '%s' "$map_json"
}

