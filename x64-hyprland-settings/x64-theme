# 3. PAPIRUS USER-SPACE OVERLAY (~/.local/share/icons/Papirus-Dark-X64-{A,B})
# Zero sudo, ~15ms, flips A<->B only when folder color actually changes.
# ------------------------------------------------------------------
icons_root = os.path.join(home, ".local", "share", "icons")
sys_papirus = "/usr/share/icons/Papirus-Dark"
icon_slot = slots.get("iconSlot", "A")
last_papirus_color = slots.get("lastPapirusColor", "")
icon_changed = False

if os.path.isdir(sys_papirus):
    slot_a_idx = os.path.join(icons_root, "Papirus-Dark-X64-A", "index.theme")
    slot_b_idx = os.path.join(icons_root, "Papirus-Dark-X64-B", "index.theme")
    need_rebuild = (
        (last_papirus_color != papirus_color)
        or (not os.path.isfile(slot_a_idx))
        or (not os.path.isfile(slot_b_idx))
    )
    if need_rebuild:
        if last_papirus_color and last_papirus_color != papirus_color:
            icon_slot = "B" if icon_slot == "A" else "A"

        color_pat = re.compile(
            r'^(folder|user)-(adwaita|black|blue|bluegrey|breeze|brown|carmine|cyan|'
            r'darkcyan|deeporange|green|grey|indigo|magenta|nordic|orange|palebrown|'
            r'paleorange|pink|red|teal|violet|white|yaru|yellow)(-.*)?\.svg$'
        )
        sizes = ["16x16", "22x22", "24x24", "32x32", "48x48", "64x64", "96x96", "128x128"]

        # Precompute symlink plan once, then materialize BOTH slots (A & B) so:
        # 1) GTK3 & Qt6 see the A<->B theme name flip (instant cache invalidation)
        # 2) Already-open KF6/Dolphin windows pinned to either A or B ALSO get the new color live!
        per_size_links = []
        valid_dirs = []
        valid_scaled = []
        for sz in sizes:
            src_places = os.path.join(sys_papirus, sz, "places")
            if not os.path.isdir(src_places):
                continue
            entries = os.listdir(src_places)
            primary_links = []
            recolored_names = set()
            for name in entries:
                full = os.path.join(src_places, name)
                if not os.path.islink(full):
                    continue
                tgt = os.readlink(full)
                m = color_pat.match(tgt)
                if not m:
                    continue
                prefix, _old_col, suffix = m.group(1), m.group(2), (m.group(3) or "")
                cand = os.path.join(src_places, f"{prefix}-{papirus_color}{suffix}.svg")
                if not os.path.exists(cand):
                    cand = os.path.join(src_places, f"folder-{papirus_color}{suffix}.svg")
                if not os.path.exists(cand):
                    cand = os.path.join(src_places, f"{prefix}-{papirus_color}.svg")
                if os.path.exists(cand):
                    primary_links.append((name, os.path.realpath(cand)))
                    recolored_names.add(name)

            alias_links = []
            for _ in range(2):
                added = False
                for name in entries:
                    if name in recolored_names:
                        continue
                    full = os.path.join(src_places, name)
                    if not os.path.islink(full):
                        continue
                    tgt = os.readlink(full)
                    if tgt in recolored_names:
                        alias_links.append((name, tgt))
                        recolored_names.add(name)
                        added = True
                if not added:
                    break

            if recolored_names:
                per_size_links.append((sz, primary_links + alias_links))
                valid_dirs.append(f"{sz}/places")
                if sz in ("16x16", "22x22", "24x24", "32x32", "48x48", "64x64"):
                    valid_scaled.append(f"{sz}@2x/places")

        for slot_lbl in ("A", "B"):
            target_theme_name = f"Papirus-Dark-X64-{slot_lbl}"
            target_dir = os.path.join(icons_root, target_theme_name)
            os.makedirs(target_dir, exist_ok=True)
            for sz, links in per_size_links:
                dst_places = os.path.join(target_dir, sz, "places")
                os.makedirs(dst_places, exist_ok=True)
                for existing in os.listdir(dst_places):
                    ep = os.path.join(dst_places, existing)
                    if os.path.islink(ep) or os.path.isfile(ep):
                        try:
                            os.unlink(ep)
                        except OSError:
                            pass
                for name, link_tgt in links:
                    os.symlink(link_tgt, os.path.join(dst_places, name))
                if sz in ("16x16", "22x22", "24x24", "32x32", "48x48", "64x64"):
                    sz2x = os.path.join(target_dir, f"{sz}@2x")
                    if not os.path.lexists(sz2x):
                        os.symlink(sz, sz2x)

            idx_lines = [
                "[Icon Theme]",
                f"Name={target_theme_name}",
                f"Comment=X64 Theme Studio Papirus Overlay ({papirus_color})",
                "Inherits=Papirus-Dark,breeze-dark,hicolor",
                "Example=folder",
                "FollowsColorScheme=true",
                f"Directories={','.join(valid_dirs)}",
                f"ScaledDirectories={','.join(valid_scaled)}",
                "",
            ]
            for d in valid_dirs:
                sz_num = d.split("x", 1)[0]
                idx_lines.extend([
                    f"[{d}]",
                    "Context=Places",
                    f"Size={sz_num}",
                    "Type=Fixed",
                    "",
                ])
            for d in valid_scaled:
                sz_num = d.split("x", 1)[0]
                idx_lines.extend([
                    f"[{d}]",
                    "Context=Places",
                    f"Size={sz_num}",
                    "Scale=2",
                    "Type=Fixed",
                    "",
                ])
            atomic_write(os.path.join(target_dir, "index.theme"), "\n".join(idx_lines))
        icon_changed = True
    icon_theme_name = f"Papirus-Dark-X64-{icon_slot}"
else:
