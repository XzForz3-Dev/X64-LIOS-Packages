sync_user_configs() {
    local mode="${1:-install}"

    for user_dir in /home/*; do
        if [ -d "$user_dir" ]; then
            u=$(basename "$user_dir")
            g=$(id -gn "$u" 2>/dev/null || echo "$u")

            target_hypr="$user_dir/.config/hypr"
            target_qs="$user_dir/.config/quickshell"
            mkdir -p "$target_hypr"
            mkdir -p "$target_qs"

            # 1. Hyprland Configurations (~/.config/hypr)
            if [ -d /etc/skel/.config/hypr ]; then
                # If user disabled hyprland.lua to use their own hyprland.conf, respect their choice on upgrades
                if [ "$mode" = "upgrade" ] && [ ! -f "$target_hypr/hyprland.lua" ] && [ -f "$target_hypr/hyprland.conf" ]; then
                    cp -f /etc/skel/.config/hypr/hyprland.lua "$target_hypr/hyprland.lua.pacnew" 2>/dev/null || true
                else
                    cp -f /etc/skel/.config/hypr/hyprland.lua "$target_hypr/hyprland.lua" 2>/dev/null || true
                    cp -f /etc/skel/.config/hypr/hyprlock.conf "$target_hypr/hyprlock.conf" 2>/dev/null || true
                    if [ ! -f "$target_hypr/hyprland.conf" ] || grep -q "X64 LIOS - Official Hyprland Desktop Configuration" "$target_hypr/hyprland.conf" 2>/dev/null; then
                        cp -f /etc/skel/.config/hypr/hyprland.conf "$target_hypr/hyprland.conf" 2>/dev/null || true
                    fi
                fi

                # NEVER overwrite custom.lua if it already exists
                if [ ! -f "$target_hypr/custom.lua" ]; then
                    cp -f /etc/skel/.config/hypr/custom.lua "$target_hypr/custom.lua" 2>/dev/null || true
                fi
            fi

            # 2. Quickshell QML Shell (~/.config/quickshell)
            if [ -d /etc/skel/.config/quickshell ]; then
                # If user customized Theme.qml (modified accent color), preserve their custom theme
                local preserve_theme=0
                if [ "$mode" = "upgrade" ] && [ -f "$target_qs/Theme.qml" ]; then
                    if ! grep -q 'accent: "#ff2b2b"' "$target_qs/Theme.qml" 2>/dev/null; then
                        preserve_theme=1
                        cp -f "$target_qs/Theme.qml" "$target_qs/Theme.qml.user_keep" 2>/dev/null || true
                    fi
                fi

                cp -rf /etc/skel/.config/quickshell/* "$target_qs/" 2>/dev/null || true

                if [ "$preserve_theme" -eq 1 ] && [ -f "$target_qs/Theme.qml.user_keep" ]; then
                    cp -f /etc/skel/.config/quickshell/Theme.qml "$target_qs/Theme.qml.pacnew" 2>/dev/null || true
                    mv -f "$target_qs/Theme.qml.user_keep" "$target_qs/Theme.qml" 2>/dev/null || true
                fi
            fi

            # 3. KDE & Qt6 Global Theme (~/.config/kdeglobals)
            if [ -f /etc/skel/.config/kdeglobals ]; then
                cp -f /etc/skel/.config/kdeglobals "$user_dir/.config/kdeglobals" 2>/dev/null || true
                chown "$u:$g" "$user_dir/.config/kdeglobals" 2>/dev/null || true
            fi

            chown -R "$u:$g" "$target_hypr" "$target_qs" 2>/dev/null || true
        fi
    done

    # 4. Enforce Crimson Red Papirus Folders Globally
    if [ -x /usr/bin/papirus-folders ]; then
        /usr/bin/papirus-folders -C red -t Papirus-Dark 2>/dev/null || true
    fi
}

setup_cpufreq_permissions() {
    mkdir -p /etc/tmpfiles.d 2>/dev/null || true
    cat << 'EOF' > /etc/tmpfiles.d/x64-cpufreq.conf
z /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor 0666 root root - -
z /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference 0666 root root - -
z /sys/devices/system/cpu/intel_pstate/no_turbo 0666 root root - -
z /sys/devices/system/cpu/cpufreq/boost 0666 root root - -
z /sys/firmware/acpi/platform_profile 0666 root root - -
EOF
    chmod 0666 /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor 2>/dev/null || true
    chmod 0666 /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference 2>/dev/null || true
    chmod 0666 /sys/devices/system/cpu/intel_pstate/no_turbo 2>/dev/null || true
    chmod 0666 /sys/devices/system/cpu/cpufreq/boost 2>/dev/null || true
    chmod 0666 /sys/firmware/acpi/platform_profile 2>/dev/null || true
}

post_install() {
    setup_cpufreq_permissions
    sync_user_configs "install"
}

post_upgrade() {
    setup_cpufreq_permissions
    sync_user_configs "upgrade"
}
