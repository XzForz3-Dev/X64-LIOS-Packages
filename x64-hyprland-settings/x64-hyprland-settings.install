sync_user_configs() {
    local mode="${1:-install}"

    # Detect system keyboard layout from localectl / vconsole
    local sys_layout="es"
    if command -v localectl >/dev/null 2>&1; then
        sys_layout=$(localectl status 2>/dev/null | awk -F': ' '/X11 Layout/{print $2}' | tr -d ' ')
        if [ -z "$sys_layout" ] || [ "$sys_layout" = "n/a" ]; then
            sys_layout=$(localectl status 2>/dev/null | awk -F': ' '/VC Keymap/{print $2}' | tr -d ' ')
        fi
    fi
    if [ -z "$sys_layout" ] || [ "$sys_layout" = "n/a" ]; then
        [ -f /etc/vconsole.conf ] && sys_layout=$(grep '^KEYMAP=' /etc/vconsole.conf | cut -d= -f2 | tr -d '"'\'' ')
    fi
    [ -z "$sys_layout" ] && sys_layout="es"

    local pair="es,us"
    if [ "$sys_layout" = "us" ]; then
        pair="us,es"
    elif [ "$sys_layout" = "latam" ]; then
        pair="latam,us"
    else
        pair="${sys_layout},us"
    fi

    if [ -f /etc/skel/.config/hypr/hyprland.conf ]; then
        sed -i "s/^[[:space:]]*kb_layout[[:space:]]*=.*/    kb_layout = ${pair}/" /etc/skel/.config/hypr/hyprland.conf 2>/dev/null || true
    fi
    if [ -f /etc/skel/.config/hypr/hyprland.lua ]; then
        sed -i "s/^[[:space:]]*kb_layout[[:space:]]*=.*/        kb_layout  = \"${pair}\",/" /etc/skel/.config/hypr/hyprland.lua 2>/dev/null || true
    fi

    for user_dir in /home/*; do
        if [ -d "$user_dir" ]; then
            u=$(basename "$user_dir")
            g=$(id -gn "$u" 2>/dev/null || echo "$u")

            target_hypr="$user_dir/.config/hypr"
            target_qs="$user_dir/.config/quickshell"
            mkdir -p "$target_hypr"
            mkdir -p "$target_qs"

            # 1. Hyprland Configurations (~/.config/hypr)
            if [ -d /etc/skel/.config/hypr ]; then
                # If user disabled hyprland.lua to use their own hyprland.conf, respect their choice on upgrades
                if [ "$mode" = "upgrade" ] && [ ! -f "$target_hypr/hyprland.lua" ] && [ -f "$target_hypr/hyprland.conf" ]; then
                    cp -f /etc/skel/.config/hypr/hyprland.lua "$target_hypr/hyprland.lua.pacnew" 2>/dev/null || true
                else
                    cp -f /etc/skel/.config/hypr/hyprland.lua "$target_hypr/hyprland.lua" 2>/dev/null || true
                    cp -f /etc/skel/.config/hypr/hyprlock.conf "$target_hypr/hyprlock.conf" 2>/dev/null || true
                    if [ ! -f "$target_hypr/hyprland.conf" ] || grep -qE "X64 LIOS - (Official Hyprland Desktop Configuration|Hyprland Classic Configuration Fallback)" "$target_hypr/hyprland.conf" 2>/dev/null; then
                        cp -f /etc/skel/.config/hypr/hyprland.conf "$target_hypr/hyprland.conf" 2>/dev/null || true
                    fi
                fi

                # NEVER overwrite custom.lua if it already exists
                if [ ! -f "$target_hypr/custom.lua" ]; then
                    cp -f /etc/skel/.config/hypr/custom.lua "$target_hypr/custom.lua" 2>/dev/null || true
                fi

                # Synchronize keyboard layout with system settings
                if [ -f "$target_hypr/hyprland.conf" ]; then
                    sed -i "s/^[[:space:]]*kb_layout[[:space:]]*=.*/    kb_layout = ${pair}/" "$target_hypr/hyprland.conf" 2>/dev/null || true
                fi
                if [ -f "$target_hypr/hyprland.lua" ]; then
                    sed -i "s/^[[:space:]]*kb_layout[[:space:]]*=.*/        kb_layout  = \"${pair}\",/" "$target_hypr/hyprland.lua" 2>/dev/null || true
                fi
            fi

            # 2. Quickshell QML Shell (~/.config/quickshell)
            # Dynamic theme preferences now persist cleanly in ~/.config/x64-theme/
            if [ -d /etc/skel/.config/quickshell ]; then
                cp -rf /etc/skel/.config/quickshell/* "$target_qs/" 2>/dev/null || true
            fi

            local has_live_theme=0
            [ -s "$user_dir/.config/x64-theme/state.json" ] && has_live_theme=1

            # 3. KDE & Qt6 Global Theme (~/.config/kdeglobals)
            # Preserve user's active X64 Theme Studio palette on upgrades
            if [ -f /etc/skel/.config/kdeglobals ] && [ "$has_live_theme" -eq 0 ]; then
                cp -f /etc/skel/.config/kdeglobals "$user_dir/.config/kdeglobals" 2>/dev/null || true
                chown "$u:$g" "$user_dir/.config/kdeglobals" 2>/dev/null || true
            fi

            # 4. GTK 3 & GTK 4 Global Dark Theme (~/.config/gtk-3.0 and ~/.config/gtk-4.0)
            mkdir -p "$user_dir/.config/gtk-3.0" "$user_dir/.config/gtk-4.0" 2>/dev/null || true
            if [ "$has_live_theme" -eq 0 ]; then
                if [ -f /etc/skel/.config/gtk-3.0/settings.ini ]; then
                    cp -f /etc/skel/.config/gtk-3.0/settings.ini "$user_dir/.config/gtk-3.0/settings.ini" 2>/dev/null || true
                    cp -f /etc/skel/.config/gtk-3.0/gtk.css "$user_dir/.config/gtk-3.0/gtk.css" 2>/dev/null || true
                    chown -R "$u:$g" "$user_dir/.config/gtk-3.0" 2>/dev/null || true
                fi
                if [ -f /etc/skel/.config/gtk-4.0/settings.ini ]; then
                    cp -f /etc/skel/.config/gtk-4.0/settings.ini "$user_dir/.config/gtk-4.0/settings.ini" 2>/dev/null || true
                    cp -f /etc/skel/.config/gtk-4.0/gtk.css "$user_dir/.config/gtk-4.0/gtk.css" 2>/dev/null || true
                    chown -R "$u:$g" "$user_dir/.config/gtk-4.0" 2>/dev/null || true
                fi
                if [ -f "$user_dir/.config/xsettingsd/xsettingsd.conf" ]; then
                    sed -i 's/Net\/ThemeName .*/Net\/ThemeName "adw-gtk3-dark"/' "$user_dir/.config/xsettingsd/xsettingsd.conf" 2>/dev/null || true
                    sed -i 's/Net\/IconThemeName .*/Net\/IconThemeName "Papirus-Dark"/' "$user_dir/.config/xsettingsd/xsettingsd.conf" 2>/dev/null || true
                fi
            fi

            # 5. Enable Hyprland Polkit Agent in systemd user session
            mkdir -p "$user_dir/.config/systemd/user/graphical-session.target.wants" 2>/dev/null || true
            ln -sf /usr/lib/systemd/user/hyprpolkitagent.service "$user_dir/.config/systemd/user/graphical-session.target.wants/hyprpolkitagent.service" 2>/dev/null || true
            chown -R "$u:$g" "$user_dir/.config/systemd" 2>/dev/null || true

            chown -R "$u:$g" "$target_hypr" "$target_qs" 2>/dev/null || true
        fi
    done

    # 5. Enforce Crimson Red Papirus Folders Globally
    if [ -x /usr/bin/papirus-folders ]; then
        /usr/bin/papirus-folders -C red -t Papirus-Dark 2>/dev/null || true
    fi
}

setup_cpufreq_permissions() {
    mkdir -p /etc/tmpfiles.d 2>/dev/null || true
    cat << 'EOF' > /etc/tmpfiles.d/x64-cpufreq.conf
z /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor 0666 root root - -
z /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference 0666 root root - -
z /sys/devices/system/cpu/intel_pstate/no_turbo 0666 root root - -
z /sys/devices/system/cpu/cpufreq/boost 0666 root root - -
z /sys/firmware/acpi/platform_profile 0666 root root - -
EOF
    chmod 0666 /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor 2>/dev/null || true
    chmod 0666 /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference 2>/dev/null || true
    chmod 0666 /sys/devices/system/cpu/intel_pstate/no_turbo 2>/dev/null || true
    chmod 0666 /sys/devices/system/cpu/cpufreq/boost 2>/dev/null || true
    chmod 0666 /sys/firmware/acpi/platform_profile 2>/dev/null || true
}

setup_qt_environment() {
    touch /etc/environment 2>/dev/null || true
    if grep -q "^QT_QPA_PLATFORMTHEME=" /etc/environment 2>/dev/null; then
        sed -i 's|^QT_QPA_PLATFORMTHEME=.*|QT_QPA_PLATFORMTHEME=gtk3|' /etc/environment 2>/dev/null || true
    else
        echo "QT_QPA_PLATFORMTHEME=gtk3" >> /etc/environment
    fi
    if ! grep -q "^KDE_SESSION_VERSION=6" /etc/environment 2>/dev/null; then
        echo "KDE_SESSION_VERSION=6" >> /etc/environment
    fi
    sed -i '/^GTK_THEME=/d' /etc/environment 2>/dev/null || true
}

post_install() {
    setup_cpufreq_permissions
    setup_qt_environment
    sync_user_configs "install"
}

post_upgrade() {
    setup_cpufreq_permissions
    setup_qt_environment
    sync_user_configs "upgrade"
}
