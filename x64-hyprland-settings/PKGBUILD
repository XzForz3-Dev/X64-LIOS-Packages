pkgname=x64-hyprland-settings
pkgver=1.0.0
pkgrel=56
pkgdesc="Official X64 LIOS Hyprland Desktop Settings (Quickshell Qt6 + Native Lua Engine)"
arch=('any')
license=('GPL')
depends=('hyprland' 'hyprlock' 'hypridle' 'hyprpolkitagent' 'hyprpwcenter' 'hyprpicker' 'hyprsunset' 'quickshell' 'swaybg' 'kitty' 'opencode' 'dolphin' 'breeze' 'plasma-integration' 'adw-gtk-theme' 'xdg-terminal-exec' 'ark' 'ffmpegthumbs' 'kdegraphics-thumbnailers' 'loupe' 'papers' 'gnome-text-editor' 'qalculate-gtk' 'blueman' 'gnome-disk-utility' 'papirus-icon-theme' 'ttf-jetbrains-mono-nerd' 'grim' 'slurp' 'wl-clipboard' 'cliphist' 'wf-recorder' 'gpu-screen-recorder' 'brightnessctl' 'libnotify')
install=x64-hyprland-settings.install
source=(
    'hyprland.lua'
    'custom.lua'
    'hyprland.conf'
    'hyprlock.conf'
    '01-monolith.jpg'
    'x64-hyprland-scale'
    'x64-hyprland-ctl'
    'kdeglobals'
    'papirus-folders'
    '10-qt.conf'
    'gtk-settings.ini'
    'gtk.css'
    'chromium-flags.conf'
    '90-x64-polkit.preset'
)
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
    # Install documentation
    mkdir -p "${pkgdir}/usr/share/doc/${pkgname}"
    echo "X64 LIOS Hyprland Desktop Settings (Quickshell Qt6 + Native Lua)" > "${pkgdir}/usr/share/doc/${pkgname}/README"

    # Install monitor scaling & desktop control CLI engines
    install -Dm755 "${srcdir}/x64-hyprland-scale" "${pkgdir}/usr/bin/x64-hyprland-scale"
    install -Dm755 "${srcdir}/x64-hyprland-ctl" "${pkgdir}/usr/bin/x64-hyprland-ctl"
    install -Dm755 "${srcdir}/papirus-folders" "${pkgdir}/usr/bin/papirus-folders"

    # Install skeleton and system-wide default configuration
    install -Dm644 "${srcdir}/hyprland.lua" "${pkgdir}/etc/skel/.config/hypr/hyprland.lua"
    install -Dm644 "${srcdir}/hyprland.lua" "${pkgdir}/etc/xdg/hypr/hyprland.lua"
    install -Dm644 "${srcdir}/custom.lua" "${pkgdir}/etc/skel/.config/hypr/custom.lua"
    install -Dm644 "${srcdir}/custom.lua" "${pkgdir}/etc/xdg/hypr/custom.lua"
    install -Dm644 "${srcdir}/hyprland.conf" "${pkgdir}/etc/skel/.config/hypr/hyprland.conf"
    install -Dm644 "${srcdir}/hyprland.conf" "${pkgdir}/etc/xdg/hypr/hyprland.conf"
    install -Dm644 "${srcdir}/hyprlock.conf" "${pkgdir}/etc/skel/.config/hypr/hyprlock.conf"
    install -Dm644 "${srcdir}/hyprlock.conf" "${pkgdir}/etc/xdg/hypr/hyprlock.conf"
    install -Dm644 "${srcdir}/kdeglobals" "${pkgdir}/etc/skel/.config/kdeglobals"
    install -Dm644 "${srcdir}/kdeglobals" "${pkgdir}/etc/xdg/kdeglobals"
    install -Dm644 "${srcdir}/10-qt.conf" "${pkgdir}/etc/environment.d/10-qt.conf"
    install -Dm644 "${srcdir}/10-qt.conf" "${pkgdir}/usr/lib/environment.d/10-qt.conf"

    # Install GTK 3 & GTK 4 Global Dark Theme (Obsidian & Crimson)
    install -Dm644 "${srcdir}/gtk-settings.ini" "${pkgdir}/etc/gtk-3.0/settings.ini"
    install -Dm644 "${srcdir}/gtk-settings.ini" "${pkgdir}/etc/gtk-4.0/settings.ini"
    install -Dm644 "${srcdir}/gtk-settings.ini" "${pkgdir}/etc/skel/.config/gtk-3.0/settings.ini"
    install -Dm644 "${srcdir}/gtk-settings.ini" "${pkgdir}/etc/skel/.config/gtk-4.0/settings.ini"
    install -Dm644 "${srcdir}/gtk.css" "${pkgdir}/etc/skel/.config/gtk-3.0/gtk.css"
    install -Dm644 "${srcdir}/gtk.css" "${pkgdir}/etc/skel/.config/gtk-4.0/gtk.css"

    # Install Chromium Wayland Hardware Acceleration Flags
    install -Dm644 "${srcdir}/chromium-flags.conf" "${pkgdir}/etc/chromium-flags.conf"

    # Install Systemd User Preset for Polkit Agent & Skeleton Session Wants
    install -Dm644 "${srcdir}/90-x64-polkit.preset" "${pkgdir}/usr/lib/systemd/user-preset/90-x64-polkit.preset"
    mkdir -p "${pkgdir}/etc/skel/.config/systemd/user/graphical-session.target.wants"
    ln -sf /usr/lib/systemd/user/hyprpolkitagent.service "${pkgdir}/etc/skel/.config/systemd/user/graphical-session.target.wants/hyprpolkitagent.service"

    # Install 4K Monolith Wallpaper (opencode.desktop & opencode.svg are provided system-wide by x64-terminal-settings)
    install -Dm644 "${srcdir}/01-monolith.jpg" "${pkgdir}/usr/share/backgrounds/x64-lios/01-monolith.jpg"

    # Install Quickshell Desktop Shell to /usr/share and /etc/skel
    local qs_dir="${pkgdir}/usr/share/x64-hyprland/shell"
    mkdir -p "${qs_dir}"
    cp -r "${startdir}/shell/"* "${qs_dir}/"

    local skel_qs="${pkgdir}/etc/skel/.config/quickshell"
    mkdir -p "${skel_qs}"
    cp -r "${startdir}/shell/"* "${skel_qs}/"
}
