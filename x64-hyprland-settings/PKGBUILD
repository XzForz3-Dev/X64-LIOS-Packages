pkgname=x64-hyprland-settings
pkgver=1.0.0
pkgrel=19
pkgdesc="Official X64 LIOS Hyprland Desktop Settings (Quickshell Qt6 + Native Lua Engine)"
arch=('any')
license=('GPL')
depends=('hyprland' 'hyprlock' 'quickshell' 'swaybg' 'kitty' 'dolphin' 'papirus-icon-theme' 'ttf-jetbrains-mono-nerd' 'grim' 'slurp' 'wl-clipboard' 'wf-recorder' 'brightnessctl' 'hyprsunset' 'libnotify')
install=x64-hyprland-settings.install
source=(
    'hyprland.lua'
    'hyprland.conf'
    'hyprlock.conf'
    '01-monolith.jpg'
    'x64-hyprland-scale'
    'x64-hyprland-ctl'
)
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
    # Install documentation
    mkdir -p "${pkgdir}/usr/share/doc/${pkgname}"
    echo "X64 LIOS Hyprland Desktop Settings (Quickshell Qt6 + Native Lua)" > "${pkgdir}/usr/share/doc/${pkgname}/README"

    # Install monitor scaling & desktop control CLI engines
    install -Dm755 "${srcdir}/x64-hyprland-scale" "${pkgdir}/usr/bin/x64-hyprland-scale"
    install -Dm755 "${srcdir}/x64-hyprland-ctl" "${pkgdir}/usr/bin/x64-hyprland-ctl"

    # Install skeleton and system-wide default configuration
    install -Dm644 "${srcdir}/hyprland.lua" "${pkgdir}/etc/skel/.config/hypr/hyprland.lua"
    install -Dm644 "${srcdir}/hyprland.lua" "${pkgdir}/etc/xdg/hypr/hyprland.lua"
    install -Dm644 "${srcdir}/hyprland.conf" "${pkgdir}/etc/skel/.config/hypr/hyprland.conf"
    install -Dm644 "${srcdir}/hyprland.conf" "${pkgdir}/etc/xdg/hypr/hyprland.conf"
    install -Dm644 "${srcdir}/hyprlock.conf" "${pkgdir}/etc/skel/.config/hypr/hyprlock.conf"
    install -Dm644 "${srcdir}/hyprlock.conf" "${pkgdir}/etc/xdg/hypr/hyprlock.conf"

    # Install 4K Monolith Wallpaper
    install -Dm644 "${srcdir}/01-monolith.jpg" "${pkgdir}/usr/share/backgrounds/x64-lios/01-monolith.jpg"

    # Install Quickshell Desktop Shell to /usr/share and /etc/skel
    local qs_dir="${pkgdir}/usr/share/x64-hyprland/shell"
    mkdir -p "${qs_dir}"
    cp -r "${startdir}/shell/"* "${qs_dir}/"

    local skel_qs="${pkgdir}/etc/skel/.config/quickshell"
    mkdir -p "${skel_qs}"
    cp -r "${startdir}/shell/"* "${skel_qs}/"
}
