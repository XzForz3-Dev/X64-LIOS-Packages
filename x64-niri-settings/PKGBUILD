pkgname=x64-niri-settings
pkgver=1.0.0
pkgrel=2
pkgdesc="Official X64 LIOS Niri Desktop Settings and Integration"
arch=('any')
license=('GPL')
depends=('niri' 'kitty' 'waybar' 'dolphin' 'fuzzel')
source=('config.kdl')
sha256sums=('SKIP')

package() {
    # Install documentation
    mkdir -p "${pkgdir}/usr/share/doc/${pkgname}"
    echo "X64 LIOS Niri Desktop Settings" > "${pkgdir}/usr/share/doc/${pkgname}/README"

    # Install skeleton and system-wide default configuration
    install -Dm644 "${srcdir}/config.kdl" "${pkgdir}/etc/skel/.config/niri/config.kdl"
    install -Dm644 "${srcdir}/config.kdl" "${pkgdir}/etc/xdg/niri/config.kdl"
}
