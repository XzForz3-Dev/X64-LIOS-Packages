pkgname=x64-niri-settings
pkgver=1.0.0
pkgrel=5
pkgdesc="Official X64 LIOS Niri Desktop Settings and Integration with Noctalia Shell"
arch=('any')
license=('GPL')
depends=('niri' 'noctalia' 'kitty' 'nautilus' 'xwayland-satellite' 'wl-clipboard' 'xdg-desktop-portal-gnome')
source=('config.kdl'
        'config.toml')
sha256sums=('SKIP'
            'SKIP')

package() {
    # Install documentation
    mkdir -p "${pkgdir}/usr/share/doc/${pkgname}"
    echo "X64 LIOS Niri Desktop Settings with Noctalia Shell" > "${pkgdir}/usr/share/doc/${pkgname}/README"

    # Install skeleton and system-wide default configuration for Niri
    install -Dm644 "${srcdir}/config.kdl" "${pkgdir}/etc/skel/.config/niri/config.kdl"
    install -Dm644 "${srcdir}/config.kdl" "${pkgdir}/etc/xdg/niri/config.kdl"

    # Install skeleton and system-wide default configuration for Noctalia
    install -Dm644 "${srcdir}/config.toml" "${pkgdir}/etc/skel/.config/noctalia/config.toml"
    install -Dm644 "${srcdir}/config.toml" "${pkgdir}/etc/xdg/noctalia/config.toml"
}
