post_install() {
    for dir in /boot/efi/EFI/refind /boot/efi/EFI/BOOT /boot/EFI/refind; do
        if [ -d "$dir" ]; then
            mkdir -p "$dir/themes"
            cp -rf /usr/share/refind/themes/x64-lios "$dir/themes/" 2>/dev/null || true
        fi
    done
    if [ -d /boot ] && [ -f /usr/share/refind/themes/x64-lios/icons/os_linux.png ]; then
        rm -f /boot/.VolumeIcon.png /.VolumeIcon.png /boot/efi/.VolumeIcon.png 2>/dev/null || true
        for k in /boot/vmlinuz-*; do
            [ -f "$k" ] && cp -f /usr/share/refind/themes/x64-lios/icons/os_linux.png "${k}.png" 2>/dev/null || true
        done
    fi
}

post_upgrade() {
    post_install
}

