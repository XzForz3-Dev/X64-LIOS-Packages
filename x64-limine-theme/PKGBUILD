# Maintainer: X64 Studios <dev@x64lios.com>
pkgname=x64-limine-theme
pkgver=1.0.0
pkgrel=3
pkgdesc="Official X64 LIOS Limine Bootloader Theme"
arch=('any')
url="https://x64lios.com"
license=('GPL3')
install='x64-limine-theme.install'
source=('x64-limine-splash.png')
sha256sums=('SKIP')

package() {
    install -d "${pkgdir}/usr/share/limine"
    install -m644 "${srcdir}/x64-limine-splash.png" "${pkgdir}/usr/share/limine/x64-limine-splash.png"

    install -d "${pkgdir}/usr/share/doc/${pkgname}"
    echo "X64 LIOS Official Limine Theme (Cyber-Terminal HD)" > "${pkgdir}/usr/share/doc/${pkgname}/README"
}
