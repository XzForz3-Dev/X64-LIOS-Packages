    def get_system_telemetry(self):
        cpu_model = tr("Unknown")
        try:
            with open("/proc/cpuinfo") as f:
                for line in f:
                    if "model name" in line:
                        cpu_model = line.split(":")[1].strip()
                        cpu_model = re.sub(r"\(R\)|\(TM\)", "", cpu_model)
                        cpu_model = re.sub(r"\s+", " ", cpu_model).strip()
                        break
        except Exception:
            cpu_model = platform.processor()

        arch_level = "x86-64"
        try:
            res = subprocess.run(["/lib64/ld-linux-x86-64.so.2", "--help"], capture_output=True, text=True)
            if "x86-64-v4 (supported" in res.stdout:
                arch_level = "x86-64-v4 (AVX-512)"
            elif "x86-64-v3 (supported" in res.stdout:
                arch_level = "x86-64-v3 (AVX2)"
            elif "x86-64-v2 (supported" in res.stdout:
                arch_level = "x86-64-v2 (SSE4.2)"
        except Exception:
            pass

        ram_text = "N/A"
        zram_text = tr("ZRAM Inactive")
        try:
            with open("/proc/meminfo") as f:
                mem = {}
                for l in f:
                    p = l.split(":")
                    if len(p) == 2:
                        mem[p[0].strip()] = int(p[1].strip().split()[0])
                tot = mem.get("MemTotal", 0) // 1024
                avail = mem.get("MemAvailable", 0) // 1024
                used = tot - avail
                ram_text = f"{used} MB / {tot} MB"
            if os.path.exists("/dev/zram0"):
                zram_text = tr("ZRAM Active")
        except Exception:
            pass

        gpu_text = tr("Standard GPU")
        try:
            res = subprocess.run(["lspci"], capture_output=True, text=True)
            for line in res.stdout.splitlines():
                if any(k in line.lower() for k in ["vga", "3d", "display"]):
                    p = line.split(": ")[-1]
                    gpu_text = re.sub(r"\(rev ..\)", "", p).strip()
                    if "Virtio" in gpu_text:
                        gpu_text = "Virtio GPU (Acelerada)"
                    break
        except Exception:
            pass

        screen_text = "Wayland Display"
        try:
            env = os.environ.copy()
            if "WAYLAND_DISPLAY" not in env:
                env["WAYLAND_DISPLAY"] = "wayland-1"
            if "XDG_RUNTIME_DIR" not in env:
                env["XDG_RUNTIME_DIR"] = "/run/user/1000"
            res = subprocess.run(["kscreen-doctor", "-o"], capture_output=True, text=True, timeout=1.5, env=env)
            clean = re.sub(r"\x1b\[[0-9;]*m", "", res.stdout)
            for token in clean.split():
                if "*!" in token:
                    clean_tok = token.replace("*!", "").split(":")[-1]
                    p = clean_tok.split("@")
                    if len(p) == 2:
                        screen_text = f"{p[0]} @ {float(p[1]):.0f}Hz"
                        break
        except Exception:
            pass

        return {
            "cpu": cpu_model,
            "arch": arch_level,
            "ram": ram_text,
            "zram": zram_text,
            "gpu": gpu_text,
            "screen": screen_text
        }

