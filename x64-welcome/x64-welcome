    def change_language(self, lang_id):
        if lang_id != _lang_code:
            os.environ["X64_LANG"] = lang_id
            os.execl(sys.executable, sys.executable, *sys.argv)

    def change_page(self, index):
        for i, btn in enumerate(self.nav_buttons):
            if i == index:
                btn.set_active_style()
            else:
                btn.set_inactive_style()
        self.stacked_widget.setCurrentIndex(index)

    def check_internet(self):
        try:
            sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            sock.settimeout(2.5)
            sock.connect(("1.1.1.1", 53))
            sock.close()
            return True
        except Exception:
            return False

    def launch_calamares(self):
        if not self.check_internet():
            msg = QMessageBox(self)
            msg.setWindowTitle(tr("Internet Connection Required"))
            msg.setText(tr("An active internet connection is required to launch the X64 LIOS Installer.\n\nPlease connect to Wi-Fi or plug in an Ethernet cable using the network tray icon before proceeding."))
            msg.setIcon(QMessageBox.Icon.Warning)
            msg.setStyleSheet("""
                QMessageBox {
                    background-color: #121214;
                    border: 1px solid #cc0000;
                    border-radius: 12px;
                }
                QMessageBox QLabel {
                    background: transparent;
                    background-color: transparent;
                    color: #ffffff;
                    font-size: 14px;
                    line-height: 1.5;
                }
                QMessageBox QDialogButtonBox {
                    background: transparent;
                    background-color: transparent;
                }
                QPushButton {
                    background-color: #cc0000;
                    color: #ffffff;
                    font-weight: bold;
                    border-radius: 6px;
                    padding: 8px 24px;
                    min-width: 90px;
                }
                QPushButton:hover {
                    background-color: #ff1a1a;
                }
            """)
            msg.exec()
            return

        os.system(
            "kitty --title 'X64 LIOS Installer Log' bash -c '"
            "echo \":: Sincronizando X64-LIOS-Installer desde GitHub...\"; "
            "rm -rf /tmp/x64-installer-sync; "
            "if git clone --depth 1 https://github.com/XzForz3-Dev/X64-LIOS-Installer.git /tmp/x64-installer-sync 2>/dev/null; then "
            "sudo rm -rf /tmp/x64-installer-sync/.git && sudo cp -rf /tmp/x64-installer-sync/. /etc/calamares/ && rm -rf /tmp/x64-installer-sync; "
