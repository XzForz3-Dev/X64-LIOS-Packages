        super().__init__()
        self.index = index
        self.parent_app = parent_app
        self.setFixedHeight(50)
        self.setCursor(Qt.CursorShape.PointingHandCursor)
        
        hbox = QHBoxLayout()
        hbox.setContentsMargins(15, 0, 15, 0)
        hbox.setSpacing(15)
        
        icon_lbl = QLabel()
        icon = QIcon.fromTheme(icon_name)
        if not icon.isNull():
            icon_lbl.setPixmap(icon.pixmap(22, 22))
        icon_lbl.setStyleSheet("background: transparent; border: none;")
        hbox.addWidget(icon_lbl)
        
        text_lbl = QLabel(title)
        text_lbl.setStyleSheet("color: #888888; font-weight: bold; font-size: 15px; background: transparent; border: none;")
        self.text_lbl = text_lbl 
        hbox.addWidget(text_lbl)
        hbox.addStretch(1)
        
        self.setLayout(hbox)
        self.clicked.connect(self.activate)
        self.set_inactive_style()

    def set_active_style(self):
        self.setStyleSheet("""
            NavButton {
                background-color: rgba(204, 0, 0, 0.15);
