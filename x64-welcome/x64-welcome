                border-radius: 1px;
            }
        """)
        layout.addWidget(self.ram_bar)

        self.setLayout(layout)

    def get_net_status(self):
        try:
            with open("/proc/net/route") as f:
                for line in f:
                    fields = line.strip().split()
                    if len(fields) >= 2 and fields[1] == '00000000':
                        iface = fields[0]
                        if iface.startswith("wl") or "wifi" in iface:
                            return tr("Wi-Fi Active"), "#00e676"
                        else:
                            return tr("Ethernet Active"), "#00e676"
        except Exception:
            pass
        return tr("No Connection"), "#ff5252"

    def update_telemetry(self, used_mb, total_mb):
        if total_mb > 0:
            pct = int((used_mb / total_mb) * 100)
            self.ram_bar.setValue(min(100, max(0, pct)))
            self.lbl_mem.setText(f"{used_mb} / {total_mb} MB")


