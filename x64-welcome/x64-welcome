    def check_internet(self):
        try:
            sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            sock.settimeout(2.5)
            sock.connect(("1.1.1.1", 53))
            sock.close()
            return True
        except Exception:
            return False

