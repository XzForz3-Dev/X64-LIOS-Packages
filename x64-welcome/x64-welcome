class PremiumButton(QPushButton):
    def __init__(self, title, desc, icon_name, url=None, cmd=None):
        super().__init__()
        self.url = url
        self.cmd = cmd
        self.setFixedHeight(85)
        self.setCursor(Qt.CursorShape.PointingHandCursor)
        
        self.setStyleSheet("""
            PremiumButton {
                background-color: rgba(255, 255, 255, 0.03);
                border-radius: 12px;
                border: 1px solid rgba(255, 255, 255, 0.05);
                text-align: left;
            }
            PremiumButton:hover {
                background-color: rgba(255, 255, 255, 0.08);
                border: 1px solid rgba(204, 0, 0, 0.5);
            }
        """)
        
        hbox = QHBoxLayout()
        hbox.setContentsMargins(20, 15, 20, 15)
        hbox.setSpacing(20)
        
        icon_label = QLabel()
        icon = QIcon.fromTheme(icon_name)
        if not icon.isNull():
            pixmap = icon.pixmap(42, 42)
            icon_label.setPixmap(pixmap)
        else:
            icon_label.setText("💠")
            icon_label.setStyleSheet("font-size: 30px; background: transparent; border: none;")
        
        icon_label.setFixedSize(42, 42)
        icon_label.setStyleSheet("background: transparent; border: none;")
        hbox.addWidget(icon_label)
        
        vbox = QVBoxLayout()
        vbox.setContentsMargins(0, 0, 0, 0)
        vbox.setSpacing(3)
        
        lbl_title = QLabel(title)
        lbl_title.setStyleSheet("color: #ffffff; font-weight: bold; font-size: 16px; border: none; background: transparent;")
        vbox.addWidget(lbl_title)
        
        lbl_desc = QLabel(desc)
        lbl_desc.setStyleSheet("color: #aaaaaa; font-size: 13px; border: none; background: transparent;")
        lbl_desc.setWordWrap(True)
        vbox.addWidget(lbl_desc)
        
        hbox.addLayout(vbox)
        self.setLayout(hbox)
        self.clicked.connect(self.action)

    def action(self):
        if self.url:
            webbrowser.open(self.url)
        elif self.cmd:
            if self.cmd == "close":
                self.window().close()
            elif self.cmd == "minimize":
                self.window().showMinimized()
            else:
                os.system(f"{self.cmd} &")

class NavButton(QPushButton):
    def __init__(self, title, icon_name, index, parent_app):
        super().__init__()
        self.index = index
        self.parent_app = parent_app
        self.setFixedHeight(50)
        self.setCursor(Qt.CursorShape.PointingHandCursor)
        
        hbox = QHBoxLayout()
        hbox.setContentsMargins(15, 0, 15, 0)
        hbox.setSpacing(15)
        
        icon_lbl = QLabel()
        icon = QIcon.fromTheme(icon_name)
        if not icon.isNull():
            icon_lbl.setPixmap(icon.pixmap(22, 22))
        icon_lbl.setStyleSheet("background: transparent; border: none;")
        hbox.addWidget(icon_lbl)
        
        text_lbl = QLabel(title)
        text_lbl.setStyleSheet("color: #888888; font-weight: bold; font-size: 15px; background: transparent; border: none;")
        self.text_lbl = text_lbl 
        hbox.addWidget(text_lbl)
        hbox.addStretch(1)
        
        self.setLayout(hbox)
        self.clicked.connect(self.activate)
        self.set_inactive_style()

    def set_active_style(self):
        self.setStyleSheet("""
            NavButton {
                background-color: rgba(204, 0, 0, 0.15);
                border-radius: 8px;
                border: none;
                border-left: 4px solid #cc0000;
                border-top-left-radius: 4px;
                border-bottom-left-radius: 4px;
            }
        """)
        self.text_lbl.setStyleSheet("color: #ffffff; font-weight: bold; font-size: 15px; background: transparent; border: none;")

    def set_inactive_style(self):
        self.setStyleSheet("""
            NavButton {
                background-color: transparent;
                border-radius: 8px;
                border: none;
            }
            NavButton:hover {
                background-color: rgba(255, 255, 255, 0.05);
            }
        """)
        self.text_lbl.setStyleSheet("color: #888888; font-weight: bold; font-size: 15px; background: transparent; border: none;")

    def activate(self):
        self.parent_app.change_page(self.index)


