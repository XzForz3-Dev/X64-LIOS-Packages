class PremiumButton(QPushButton):
    def __init__(self, title, desc, icon_name, url=None, cmd=None, callback=None, height=85):
        super().__init__()
        self.url = url
        self.cmd = cmd
        self.callback = callback
        self.setFixedHeight(height)
        self.setCursor(Qt.CursorShape.PointingHandCursor)
        
        self.setStyleSheet("""
            PremiumButton {
                background-color: rgba(255, 255, 255, 0.03);
                border-radius: 12px;
                border: 1px solid rgba(255, 255, 255, 0.05);
                text-align: left;
            }
            PremiumButton:hover {
                background-color: rgba(255, 255, 255, 0.08);
                border: 1px solid rgba(204, 0, 0, 0.5);
            }
        """)
        
        hbox = QHBoxLayout()
        pad_v = 8 if height < 80 else 13
        pad_h = 16 if height < 80 else 18
        hbox.setContentsMargins(pad_h, pad_v, pad_h, pad_v)
        hbox.setSpacing(14 if height < 80 else 18)
        
        icon_label = QLabel()
        icon = QIcon.fromTheme(icon_name)
        icon_px = 32 if height < 80 else 38
        if not icon.isNull():
            pixmap = icon.pixmap(icon_px, icon_px)
            icon_label.setPixmap(pixmap)
        else:
            icon_label.setText("💠")
            icon_label.setStyleSheet(f"font-size: {icon_px - 8}px; background: transparent; border: none;")
        
        icon_label.setFixedSize(icon_px, icon_px)
        icon_label.setStyleSheet("background: transparent; border: none;")
        hbox.addWidget(icon_label)
        
        vbox = QVBoxLayout()
        vbox.setContentsMargins(0, 0, 0, 0)
        vbox.setSpacing(3)
        
        lbl_title = QLabel(title)
        title_size = 14 if height < 80 else 15
        lbl_title.setStyleSheet(f"color: #ffffff; font-weight: bold; font-size: {title_size}px; border: none; background: transparent;")
        vbox.addWidget(lbl_title)
        
        lbl_desc = QLabel(desc)
        desc_size = 11 if height < 80 else 12
        lbl_desc.setStyleSheet(f"color: #9e9ea7; font-size: {desc_size}px; line-height: 1.35; border: none; background: transparent;")
        lbl_desc.setWordWrap(True)
        vbox.addWidget(lbl_desc)
        
        hbox.addLayout(vbox)
        self.setLayout(hbox)
        self.clicked.connect(self.action)

    def action(self):
        if self.callback:
            self.callback()
        elif self.url:
            webbrowser.open(self.url)
        elif self.cmd:
            if self.cmd == "close":
                self.window().close()
            elif self.cmd == "minimize":
                self.window().showMinimized()
            else:
                os.system(f"QT_QPA_PLATFORMTHEME=kde GTK_THEME=Breeze-Dark {self.cmd} &")

class NavButton(QPushButton):
