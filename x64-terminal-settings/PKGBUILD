package() {
    # Fish shell skel configuration and system-wide conf.d drop-in
    install -d "${pkgdir}/etc/skel/.config/fish"
    install -m644 "${srcdir}/config.fish" "${pkgdir}/etc/skel/.config/fish/config.fish"

    install -d "${pkgdir}/etc/fish/conf.d"
    install -m644 "${srcdir}/99-x64-terminal.fish" "${pkgdir}/etc/fish/conf.d/99-x64-terminal.fish"

    # Starship prompt skel and system-wide configurations (standard and TTY)
    install -d "${pkgdir}/etc/skel/.config"
    install -m644 "${srcdir}/starship.toml" "${pkgdir}/etc/skel/.config/starship.toml"
    install -m644 "${srcdir}/starship-tty.toml" "${pkgdir}/etc/skel/.config/starship-tty.toml"

    install -d "${pkgdir}/etc"
    install -m644 "${srcdir}/starship-tty.toml" "${pkgdir}/etc/starship-tty.toml"

    # Fastfetch skel and system-wide configurations (standard and TTY)
    install -d "${pkgdir}/etc/skel/.config/fastfetch"
    install -m644 "${srcdir}/fastfetch.jsonc" "${pkgdir}/etc/skel/.config/fastfetch/config.jsonc"
    install -m644 "${srcdir}/fastfetch-tty.jsonc" "${pkgdir}/etc/skel/.config/fastfetch/config-tty.jsonc"
    install -m644 "${srcdir}/x64_logo.txt" "${pkgdir}/etc/skel/.config/fastfetch/x64_logo.txt"

    install -d "${pkgdir}/etc/fastfetch"
    install -m644 "${srcdir}/fastfetch.jsonc" "${pkgdir}/etc/fastfetch/config.jsonc"
    install -m644 "${srcdir}/fastfetch-tty.jsonc" "${pkgdir}/etc/fastfetch/config-tty.jsonc"

    install -d "${pkgdir}/usr/share/fastfetch"
    install -m644 "${srcdir}/x64_logo.txt" "${pkgdir}/usr/share/fastfetch/x64_logo.txt"

    # Kitty terminal skel and global XDG configurations
    install -d "${pkgdir}/etc/skel/.config/kitty"
    install -m644 "${srcdir}/kitty.conf" "${pkgdir}/etc/skel/.config/kitty/kitty.conf"

    install -d "${pkgdir}/etc/xdg/kitty"
    install -m644 "${srcdir}/kitty.conf" "${pkgdir}/etc/xdg/kitty/kitty.conf"

    # Fontconfig System-Wide Monospace Override to JetBrainsMono Nerd Font
    install -d "${pkgdir}/etc/fonts/conf.d"
    install -m644 "${srcdir}/99-x64-monospace.conf" "${pkgdir}/etc/fonts/conf.d/99-x64-monospace.conf"

    # COSMIC Terminal Skel Configuration
    install -d "${pkgdir}/etc/skel/.config/cosmic/com.system76.CosmicTerm/v1"
    echo '"JetBrainsMono Nerd Font"' > "${pkgdir}/etc/skel/.config/cosmic/com.system76.CosmicTerm/v1/font_name"

    # Kernel & Network Low-Latency Tuning Profile
    install -d "${pkgdir}/etc/sysctl.d"
    install -m644 "${srcdir}/99-x64-lios-performance.conf" "${pkgdir}/etc/sysctl.d/99-x64-lios-performance.conf"

    # 12 GB Shader Cache & RADV Vulkan ICD Profile
    install -d "${pkgdir}/etc/environment.d"
    install -m644 "${srcdir}/90-x64-gaming-shaders.conf" "${pkgdir}/etc/environment.d/90-x64-gaming-shaders.conf"
    install -d "${pkgdir}/etc/profile.d"
    install -m644 "${srcdir}/x64-gaming-shaders.sh" "${pkgdir}/etc/profile.d/x64-gaming-shaders.sh"

    # PipeWire Low-Latency Anti-Crackling Floor (256/48000 ~5.3ms)
    install -d "${pkgdir}/etc/pipewire/pipewire-pulse.conf.d"
    install -m644 "${srcdir}/99-x64-lowlatency.conf" "${pkgdir}/etc/pipewire/pipewire-pulse.conf.d/99-x64-lowlatency.conf"

    # Background Indexers Idle CPU/IO Priority Overrides
    install -d "${pkgdir}/etc/systemd/system/man-db.service.d"
    install -m644 "${srcdir}/99-x64-idle.conf" "${pkgdir}/etc/systemd/system/man-db.service.d/99-x64-idle.conf"
    install -d "${pkgdir}/etc/systemd/system/plocate-updatedb.service.d"
    install -m644 "${srcdir}/99-x64-idle.conf" "${pkgdir}/etc/systemd/system/plocate-updatedb.service.d/99-x64-idle.conf"

    # Gaming, Proton Esync & Emulator Resource Limits (nofile + memlock infinity)
    install -d "${pkgdir}/etc/security/limits.d"
    install -m644 "${srcdir}/99-x64-gaming-limits.conf" "${pkgdir}/etc/security/limits.d/99-x64-gaming-limits.conf"
    install -d "${pkgdir}/etc/systemd/user.conf.d"
    install -m644 "${srcdir}/99-x64-user-limits.conf" "${pkgdir}/etc/systemd/user.conf.d/99-x64-user-limits.conf"

    # NetworkManager Wi-Fi Power-Save Disable (Eliminate Wireless Ping Jitter)
    install -d "${pkgdir}/etc/NetworkManager/conf.d"
    install -m644 "${srcdir}/99-x64-wifi-powersave.conf" "${pkgdir}/etc/NetworkManager/conf.d/99-x64-wifi-powersave.conf"

    # sched_ext (scx_loader) Low-Latency Gaming Profile & Polkit Rule
    install -d "${pkgdir}/etc/scx_loader"
    install -m644 "${srcdir}/scx_loader.toml" "${pkgdir}/etc/scx_loader/config.toml"
    # Match polkit's ownership/permissions (750 root:polkitd) to avoid pacman "directory permissions differ" warnings
    install -dm750 -o root -g 102 "${pkgdir}/etc/polkit-1/rules.d"
    install -m644 "${srcdir}/50-x64-scx-loader.rules" "${pkgdir}/etc/polkit-1/rules.d/50-x64-scx-loader.rules"

    # Systemd Presets (Ensure systemd-oomd and fwupd-refresh are disabled by default)
    install -d "${pkgdir}/usr/lib/systemd/system-preset"
    install -m644 "${srcdir}/00-x64-lios.preset" "${pkgdir}/usr/lib/systemd/system-preset/00-x64-lios.preset"

    # Neutralize systemd-oomd slice auto-activation (override cachyos-settings drop-ins)
    install -d "${pkgdir}/etc/systemd/system/system.slice.d"
    ln -sf /dev/null "${pkgdir}/etc/systemd/system/system.slice.d/10-oomd-per-slice-defaults.conf"
    install -d "${pkgdir}/etc/systemd/system/user-.slice.d"
    ln -sf /dev/null "${pkgdir}/etc/systemd/system/user-.slice.d/10-oomd-per-slice-defaults.conf"

    # Enforce X64 LIOS identity across filesystem / lsb-release / cachyos-hooks upgrades
    install -d "${pkgdir}/usr/share/libalpm/hooks"
    install -m644 "${srcdir}/99-x64-branding.hook" "${pkgdir}/usr/share/libalpm/hooks/99-x64-branding.hook"

    # Sovereign Console & Server Dashboard
    install -d "${pkgdir}/usr/bin"
    install -m755 "${srcdir}/x64-dashboard" "${pkgdir}/usr/bin/x64-dashboard"

    # Official Pre-Login Issue Banner
    install -d "${pkgdir}/usr/share/x64-lios"
    install -m644 "${srcdir}/issue" "${pkgdir}/usr/share/x64-lios/issue"

    # Official OpenCode AI Desktop Launcher & Icon across all Desktop Environments
    install -Dm644 "${srcdir}/opencode.svg" "${pkgdir}/usr/share/pixmaps/opencode.svg"
    install -Dm644 "${srcdir}/opencode.svg" "${pkgdir}/usr/share/icons/hicolor/scalable/apps/opencode.svg"
    install -Dm644 "${srcdir}/opencode.desktop" "${pkgdir}/usr/share/applications/opencode.desktop"

    # Sudoers Rule: Allow wheel users to control Display Managers and switch VTs from x64-dashboard without password prompt
    install -dm750 "${pkgdir}/etc/sudoers.d"
    install -m440 "${srcdir}/10-x64-display-manager" "${pkgdir}/etc/sudoers.d/10-x64-display-manager"
}

