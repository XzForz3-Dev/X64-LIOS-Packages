# Maintainer: X64 Studios <dev@x64lios.com>
pkgname=x64-terminal-settings
pkgver=1.0.0
pkgrel=71
pkgdesc="Official terminal and shell environment settings for X64 LIOS"
arch=('any')
url="https://x64lios.com"
license=('GPL3')
install='x64-terminal-settings.install'
depends=('fish' 'starship' 'fastfetch' 'ttf-jetbrains-mono-nerd' 'opencode')
optdepends=('kitty: GPU-accelerated terminal emulator'
            'btop: Resource monitor for x64-dashboard')
source=(
    'config.fish'
    'starship.toml'
    'starship-tty.toml'
    'fastfetch.jsonc'
    'fastfetch-tty.jsonc'
    'x64_logo.txt'
    'kitty.conf'
    '99-x64-monospace.conf'
    '99-x64-terminal.fish'
    '99-x64-lios-performance.conf'
    '90-x64-gaming-shaders.conf'
    'x64-gaming-shaders.sh'
    '99-x64-lowlatency.conf'
    '99-x64-idle.conf'
    '99-x64-gaming-limits.conf'
    '99-x64-user-limits.conf'
    '99-x64-wifi-powersave.conf'
    'scx_loader.toml'
    '50-x64-scx-loader.rules'
    '00-x64-lios.preset'
    '99-x64-branding.hook'
    'x64-dashboard'
    'issue'
    'opencode.svg'
    'opencode.desktop'
    '10-x64-display-manager'
)
