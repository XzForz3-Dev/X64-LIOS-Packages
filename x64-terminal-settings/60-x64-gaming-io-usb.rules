# ==============================================================================
# X64 LIOS Linux — Gaming Low-Latency I/O, USB HID & CPU DMA Latency udev Rules
# ==============================================================================

# 1. NVMe & Non-Rotational SATA SSD I/O Scheduler -> ADIOS (ultra-low latency; disk devices only)
ACTION=="add|change", SUBSYSTEM=="block", ENV{DEVTYPE}=="disk", KERNEL=="nvme[0-9]*n[0-9]*", ATTR{queue/rotational}=="0", ATTR{queue/scheduler}="adios"
ACTION=="add|change", SUBSYSTEM=="block", ENV{DEVTYPE}=="disk", KERNEL=="sd[a-z]*", ATTR{queue/rotational}=="0", ATTR{queue/scheduler}="adios"

# 2. Disable USB autosuspend on HID gaming peripherals (mice, keyboards, controllers)
ACTION=="add|bind", SUBSYSTEM=="usb", ATTR{bInterfaceClass}=="03", TEST=="../power/control", ATTR{../power/control}="on"

# 3. Allow wheel/audio groups & active user session (uaccess ACL) to request low CPU DMA latency
KERNEL=="cpu_dma_latency", GROUP="wheel", MODE="0660", TAG+="uaccess"
