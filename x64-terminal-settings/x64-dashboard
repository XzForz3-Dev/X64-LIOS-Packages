#!/usr/bin/env fish
# ==============================================================================
# X64 LIOS - SERVER & RESCUE DASHBOARD (TTY1)
# Centro de Mando Oficial para Instalaciones Server / CLI y Recuperación
# ==============================================================================

function draw_dashboard
    clear
    # Espacio superior para que el logo respire con elegancia
    echo ""
    echo ""

    set -l border "\e[1;31m"
    set -l reset "\e[0m"
    set -l title "\e[1;37m"
    set -l val "\e[0;37m"
    set -l warn "\e[1;33m"
    set -l green "\e[1;32m"
    set -l red "\e[1;31m"
    set -l cyan "\e[1;36m"

    # Telemetría en tiempo real
    set -l os_name (cat /etc/os-release 2>/dev/null | grep "^PRETTY_NAME=" | cut -d '=' -f 2 | tr -d '"')
    test -z "$os_name"; and set os_name "X64 LIOS Linux"
    set -l kernel_ver (uname -r)
    set -l host_node (hostname)
    set -l current_time (date '+%Y-%m-%d %H:%M:%S')
    set -l uptime_str (uptime -p | sed 's/up //')
    set -l ip_addr (ip route get 1.1.1.1 2>/dev/null | awk '{print $7}')
    test -z "$ip_addr"; and set ip_addr "Desconectado"
    set -l mem_used (free -m | awk '/Mem:/ {print $3}')
    set -l mem_total (free -m | awk '/Mem:/ {print $2}')
    set -l ram_str "$mem_used MiB / $mem_total MiB"
    set -l disk_free (df -h / | awk 'NR==2 {print $4}')" libres"

    # Estado de servicios (sin sudo para evitar pedir contraseña)
    set -l ssh_status (systemctl is-active sshd 2>/dev/null)
    set -l ufw_status (systemctl is-active ufw 2>/dev/null)

    set -l ssh_txt (test "$ssh_status" = "active"; and echo "[ ACTIVO ]"; or echo "[ INACTIVO ]")
    set -l ufw_txt (test "$ufw_status" = "active"; and echo "[ ACTIVO ]"; or echo "[ INACTIVO ]")
    set -l ssh_color (test "$ssh_status" = "active"; and echo "\e[1;32m"; or echo "\e[1;30m")
    set -l ufw_color (test "$ufw_status" = "active"; and echo "\e[1;32m"; or echo "\e[1;30m")

    # Logo ASCII Oficial X64 LIOS (Centrado con aire)
    echo -e "$red    ██╗  ██╗ ██████╗ ██╗  ██╗    ██╗     ██╗ ██████╗ ███████╗$reset"
    echo -e "$red    ╚██╗██╔╝██╔════╝ ██║  ██║    ██║     ██║██╔═══██╗██╔════╝$reset"
    echo -e "$red     ╚███╔╝ ███████╗ ███████║    ██║     ██║██║   ██║███████╗$reset"
    echo -e "$red     ██╔██╗ ██╔═══██╗╚════██║    ██║     ██║██║   ██║╚════██║$reset"
    echo -e "$red    ██╔╝ ██╗╚██████╔╝     ██║    ███████╗██║╚██████╔╝███████║$reset"
    echo -e "$red    ╚═╝  ╚═╝ ╚═════╝      ╚═╝    ╚══════╝╚═╝ ╚═════╝ ╚══════╝$reset"
    echo -e "          $title C O N S O L E   //   C E N T R O   D E   M A N D O$reset\n"

    # Sección 1: Telemetría
    echo -e "  $border─────────────────────────────────────────────────────────────────────────────$reset"
    echo -e "   $title TELEMETRÍA DEL SISTEMA$reset"
    echo -e "  $border─────────────────────────────────────────────────────────────────────────────$reset"
    printf "    \e[1;36m%-8s\e[0m \e[0;37m%-24s\e[0m \e[1;36m%-9s\e[0m \e[0;37m%-28s\e[0m\n" "[OS]" "$os_name" "[KERNEL]" "$kernel_ver"
    printf "    \e[1;36m%-8s\e[0m \e[0;37m%-24s\e[0m \e[1;36m%-9s\e[0m \e[0;37m%-28s\e[0m\n" "[HOST]" "$host_node" "[UPTIME]" "$uptime_str"
    printf "    \e[1;36m%-8s\e[0m \e[1;32m%-24s\e[0m \e[1;36m%-9s\e[0m \e[0;37m%-28s\e[0m\n" "[IP]" "$ip_addr" "[HORA]" "$current_time"
    printf "    \e[1;36m%-8s\e[0m \e[0;37m%-24s\e[0m \e[1;36m%-9s\e[0m \e[0;37m%-28s\e[0m\n" "[RAM]" "$ram_str" "[DISCO]" "$disk_free"
    printf "    \e[1;36m%-8s\e[0m $ssh_color%-24s\e[0m \e[1;36m%-9s\e[0m $ufw_color%-28s\e[0m\n" "[SSH]" "$ssh_txt" "[UFW]" "$ufw_txt"

    # Sección 2: Entornos Gráficos
    echo -e "\n  $border─────────────────────────────────────────────────────────────────────────────$reset"
    echo -e "   $title ENTORNO GRÁFICO$reset"
    echo -e "  $border─────────────────────────────────────────────────────────────────────────────$reset"

    set -g desktop_options
    set -g desktop_cmds
    set -l d_idx 1
    set -g has_desktop 0

    if type -q Hyprland
        printf "    \e[1;32m[%s]\e[0m \e[0;37mIniciar %s\e[0m\n" "$d_idx" "Hyprland (X64 Cyberpunk Edition - Wayland)"
        set -a desktop_options $d_idx
        set -a desktop_cmds "exec Hyprland"
        set d_idx (math $d_idx + 1)
        set -g has_desktop 1
    end
    if type -q gnome-shell
        printf "    \e[1;32m[%s]\e[0m \e[0;37mIniciar %s\e[0m\n" "$d_idx" "GNOME (X64 Stealth Edition - Wayland)"
        set -a desktop_options $d_idx
        set -a desktop_cmds "exec dbus-run-session gnome-shell --wayland"
        set d_idx (math $d_idx + 1)
        set -g has_desktop 1
    end
    if type -q startplasma-wayland
        printf "    \e[1;32m[%s]\e[0m \e[0;37mIniciar %s\e[0m\n" "$d_idx" "KDE Plasma 6 (X64 Gaming Edition - Wayland)"
        set -a desktop_options $d_idx
        set -a desktop_cmds "exec dbus-run-session startplasma-wayland"
        set d_idx (math $d_idx + 1)
        set -g has_desktop 1
    end
    if type -q cosmic-session
        printf "    \e[1;32m[%s]\e[0m \e[0;37mIniciar %s\e[0m\n" "$d_idx" "COSMIC Desktop (Rust Next-Gen - Wayland)"
        set -a desktop_options $d_idx
        set -a desktop_cmds "exec dbus-run-session cosmic-session"
        set d_idx (math $d_idx + 1)
        set -g has_desktop 1
    end
    if type -q niri-session
        printf "    \e[1;32m[%s]\e[0m \e[0;37mIniciar %s\e[0m\n" "$d_idx" "Niri (Scroll-infinito - Wayland)"
        set -a desktop_options $d_idx
        set -a desktop_cmds "exec dbus-run-session niri"
        set d_idx (math $d_idx + 1)
        set -g has_desktop 1
    end
    if type -q cinnamon-session
        printf "    \e[1;32m[%s]\e[0m \e[0;37mIniciar %s\e[0m\n" "$d_idx" "Cinnamon (Classic Desktop)"
        set -a desktop_options $d_idx
        set -a desktop_cmds "exec dbus-run-session cinnamon-session"
        set d_idx (math $d_idx + 1)
        set -g has_desktop 1
    end
    if type -q xfce4-session
        printf "    \e[1;32m[%s]\e[0m \e[0;37mIniciar %s\e[0m\n" "$d_idx" "Xfce4 (Ultra Lightweight)"
        set -a desktop_options $d_idx
        set -a desktop_cmds "exec startxfce4"
        set d_idx (math $d_idx + 1)
        set -g has_desktop 1
    end

    if test $has_desktop -eq 0
        echo -e "    \e[1;33m[!]\e[0m \e[0;37mNo hay ningún entorno gráfico instalado (Modo Server / CLI puro).\e[0m"
        echo -e "    \e[1;33m[1]\e[0m \e[1;37mInstalar un Entorno de Escritorio Oficial (Hyprland, GNOME, etc.)\e[0m"
    else
        echo -e "    \e[1;33m[1]\e[0m \e[1;37mInstalar o alternar a otro Entorno de Escritorio adicional\e[0m"
    end

    # Sección 3: Herramientas
    echo -e "\n  $border─────────────────────────────────────────────────────────────────────────────$reset"
    echo -e "   $title HERRAMIENTAS DE SERVIDOR Y MANTENIMIENTO$reset"
    echo -e "  $border─────────────────────────────────────────────────────────────────────────────$reset"
    printf "    \e[1;36m%-4s\e[0m \e[0;37m%-32s\e[0m \e[1;36m%-4s\e[0m \e[0;37m%-30s\e[0m\n" "[2]" "Monitor de Recursos (btop)" "[5]" "Diagnóstico de Red e IPs"
    printf "    \e[1;36m%-4s\e[0m \e[0;37m%-32s\e[0m \e[1;36m%-4s\e[0m \e[0;37m%-30s\e[0m\n" "[3]" "Acceso Remoto SSH y Firewall" "[6]" "Limpieza Profunda de Caché"
    printf "    \e[1;36m%-4s\e[0m \e[0;37m%-32s\e[0m \e[1;36m%-4s\e[0m \e[0;37m%-30s\e[0m\n" "[4]" "Actualizar Sistema (Pacman)" "[7]" "Registro de Errores (Boot)"

    # Sección 4: Control del Sistema
    echo -e "\n  $border─────────────────────────────────────────────────────────────────────────────$reset"
    echo -e "   $title CONTROL DEL SISTEMA$reset"
    echo -e "  $border─────────────────────────────────────────────────────────────────────────────$reset"
    printf "    \e[1;36m%-4s\e[0m \e[0;37m%-32s\e[0m \e[1;36m%-4s\e[0m \e[0;37m%-30s\e[0m\n" "[8]" "Consola Pura (Fish Shell)" "[9]" "Reiniciar el Servidor"
    printf "    \e[1;36m%-4s\e[0m \e[0;37m%-32s\e[0m\n" "[0]" "Apagar el Servidor"
    echo -e "  $border─────────────────────────────────────────────────────────────────────────────$reset"
end

function install_desktop_menu
    clear
    echo ""
    echo ""

    set -l border "\e[1;31m"
    set -l reset "\e[0m"
    set -l title "\e[1;37m"
    set -l val "\e[0;37m"

    echo -e "  $border─────────────────────────────────────────────────────────────────────────────$reset"
    echo -e "   $title X64 LIOS - INSTALADOR DE ENTORNOS DE ESCRITORIO OFICIALES$reset"
    echo -e "  $border─────────────────────────────────────────────────────────────────────────────$reset\n"
    echo -e "  Selecciona el escritorio que deseas descargar e instalar en este equipo:\n"
    echo -e "    \e[1;33m[1]\e[0m $title Hyprland$reset       $val(X64 Cyberpunk Edition - Wayland, animaciones fluidas)$reset"
    echo -e "    \e[1;33m[2]\e[0m $title GNOME$reset          $val(X64 Stealth Edition - Moderno, sobrio y pulido)$reset"
    echo -e "    \e[1;33m[3]\e[0m $title KDE Plasma 6$reset   $val(X64 Gaming Edition - Máximo rendimiento y control)$reset"
    echo -e "    \e[1;33m[4]\e[0m $title COSMIC$reset         $val(Next-Gen Rust Desktop desarrollado por System76)$reset"
    echo -e "    \e[1;33m[5]\e[0m $title Niri$reset           $val(Tiling con scroll infinito horizontal innovador)$reset"
    echo -e "    \e[1;33m[6]\e[0m $title Cinnamon$reset       $val(Entorno tradicional clásico de alta estabilidad)$reset"
    echo -e "    \e[1;33m[7]\e[0m $title Xfce4$reset          $val(Ligero y ultrarrápido con mínimo consumo de RAM)$reset\n"
    echo -e "    \e[1;33m[0]\e[0m Volver al Dashboard Principal"
    echo -e "  $border─────────────────────────────────────────────────────────────────────────────$reset"

    echo -e -n "\n  \e[1;31m> Selecciona un entorno para instalar [1-7, 0]: \e[0m"
    read -l -P "" d_choice
    test $status -ne 0; and return

    switch $d_choice
        case 1
            echo -e "\n  \e[1;32mInstalando Hyprland Oficial de X64 LIOS...\e[0m"
            sudo pacman -S --needed --noconfirm hyprland sddm x64-sddm-theme dolphin kitty waybar rofi-wayland dunst xdg-desktop-portal-hyprland x64-hyprland-settings
            sudo systemctl enable sddm
            echo -e "\n  \e[1;32m¡Hyprland instalado con éxito! SDDM activado.\e[0m"
            read -l -P "  Presiona Enter para continuar..." dummy
        case 2
            echo -e "\n  \e[1;32mInstalando GNOME Oficial de X64 LIOS...\e[0m"
            sudo pacman -S --needed --noconfirm gnome-shell gdm x64-gdm-theme nautilus kitty x64-gnome-settings adw-gtk-theme
            sudo systemctl enable gdm
            echo -e "\n  \e[1;32m¡GNOME instalado con éxito! GDM activado.\e[0m"
            read -l -P "  Presiona Enter para continuar..." dummy
        case 3
            echo -e "\n  \e[1;32mInstalando KDE Plasma 6 Oficial de X64 LIOS...\e[0m"
            sudo pacman -S --needed --noconfirm plasma-meta sddm x64-sddm-theme dolphin konsole x64-plasma-settings
            sudo systemctl enable sddm
            echo -e "\n  \e[1;32m¡KDE Plasma instalado con éxito! SDDM activado.\e[0m"
            read -l -P "  Presiona Enter para continuar..." dummy
        case 4
            echo -e "\n  \e[1;32mInstalando COSMIC Desktop Oficial de X64 LIOS...\e[0m"
            sudo pacman -S --needed --noconfirm cosmic-session cosmic-greeter x64-cosmic-settings
            sudo systemctl enable cosmic-greeter
            echo -e "\n  \e[1;32m¡COSMIC instalado con éxito! Cosmic-greeter activado.\e[0m"
            read -l -P "  Presiona Enter para continuar..." dummy
        case 5
            echo -e "\n  \e[1;32mInstalando Niri Oficial de X64 LIOS...\e[0m"
            sudo pacman -S --needed --noconfirm niri sddm x64-sddm-theme dolphin kitty waybar x64-niri-settings
            sudo systemctl enable sddm
            echo -e "\n  \e[1;32m¡Niri instalado con éxito! SDDM activado.\e[0m"
            read -l -P "  Presiona Enter para continuar..." dummy
        case 6
            echo -e "\n  \e[1;32mInstalando Cinnamon Oficial de X64 LIOS...\e[0m"
            sudo pacman -S --needed --noconfirm cinnamon lightdm x64-cinnamon-settings
            sudo systemctl enable lightdm
            echo -e "\n  \e[1;32m¡Cinnamon instalado con éxito! LightDM activado.\e[0m"
            read -l -P "  Presiona Enter para continuar..." dummy
        case 7
            echo -e "\n  \e[1;32mInstalando Xfce4 Oficial de X64 LIOS...\e[0m"
            sudo pacman -S --needed --noconfirm xfce4 xfce4-goodies lightdm x64-xfce4-settings
            sudo systemctl enable lightdm
            echo -e "\n  \e[1;32m¡Xfce4 instalado con éxito! LightDM activado.\e[0m"
            read -l -P "  Presiona Enter para continuar..." dummy
        case '*'
            return
    end
end

# Loop interactivo del Dashboard
while true
    draw_dashboard
    echo -e -n "\n  \e[1;31m> Selecciona una opción [1-9, 0]: \e[0m"
    read -l -P "" choice
    test $status -ne 0; and break

    switch $choice
        case 8 'c' 'C'
            clear
            echo -e "\e[1;32mSaliendo a la consola de comandos de X64 LIOS (Fish)...\e[0m"
            echo -e "\e[0;37mPara volver a abrir el Centro de Mando en cualquier momento, escribe: \e[1;33mx64-dashboard\e[0m\n"
            break
        case 9 'r' 'R'
            clear
            echo ""
            echo ""
            echo -e "  \e[1;31m─────────────────────────────────────────────────────────────────────────────\e[0m"
            echo -e "   \e[1;37mREINICIAR EL SERVIDOR\e[0m"
            echo -e "  \e[1;31m─────────────────────────────────────────────────────────────────────────────\e[0m\n"
            echo -e "    ¿Estás seguro de que deseas reiniciar el sistema ahora mismo?\n"
            echo -e "    \e[1;33m[1]\e[0m \e[1;37mSí, reiniciar ahora\e[0m"
            echo -e "    \e[1;32m[0]\e[0m \e[1;37mCancelar y volver al Centro de Mando\e[0m\n"
            echo -e "  \e[1;31m─────────────────────────────────────────────────────────────────────────────\e[0m"
            echo -e -n "\n  \e[1;31m> Confirmar [1, 0]: \e[0m"
            read -l -P "" r_choice
            if test "$r_choice" = "1"
                clear
                echo -e "\e[1;33mReiniciando el sistema...\e[0m"
                sudo systemctl reboot
                break
            end
        case 0 'a' 'A'
            clear
            echo ""
            echo ""
            echo -e "  \e[1;31m─────────────────────────────────────────────────────────────────────────────\e[0m"
            echo -e "   \e[1;37mAPAGAR EL SERVIDOR\e[0m"
            echo -e "  \e[1;31m─────────────────────────────────────────────────────────────────────────────\e[0m\n"
            echo -e "    ¿Estás seguro de que deseas apagar este equipo por completo?\n"
            echo -e "    \e[1;31m[1]\e[0m \e[1;37mSí, apagar ahora\e[0m"
            echo -e "    \e[1;32m[0]\e[0m \e[1;37mCancelar y volver al Centro de Mando\e[0m\n"
            echo -e "  \e[1;31m─────────────────────────────────────────────────────────────────────────────\e[0m"
            echo -e -n "\n  \e[1;31m> Confirmar [1, 0]: \e[0m"
            read -l -P "" a_choice
            if test "$a_choice" = "1"
                clear
                echo -e "\e[1;31mApagando el servidor...\e[0m"
                sudo systemctl poweroff
                break
            end
        case 1 'i' 'I'
            if test $has_desktop -eq 0
                install_desktop_menu
            else
                if test (count $desktop_options) -gt 0
                    eval $desktop_cmds[1]
                end
            end
        case 2 'm' 'M'
            if type -q btop
                btop
            else
                top
            end
        case 3 's' 'S'
            clear
            echo ""
            echo ""
            set -l cur_ssh (systemctl is-active sshd 2>/dev/null)
            set -l my_ip (ip route get 1.1.1.1 2>/dev/null | awk '{print $7}')
            test -z "$my_ip"; and set my_ip (ip -4 addr show | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | grep -v '127.0.0.1' | head -n 1)
            test -z "$my_ip"; and set my_ip "Sin conexión de red"

            echo -e "  \e[1;31m─────────────────────────────────────────────────────────────────────────────\e[0m"
            echo -e "   \e[1;37mESTADO DEL ACCESO REMOTO (SSH & FIREWALL)\e[0m"
            echo -e "  \e[1;31m─────────────────────────────────────────────────────────────────────────────\e[0m\n"

            if test "$cur_ssh" = "active"
                echo -e "    Estado del servicio: \e[1;32m[ ACTIVO ]\e[0m"
                echo -e "    Dirección IP local:  \e[1;33m$my_ip\e[0m\n"
                echo -e "    \e[0;37m(Nota informativa: Para entrar a este servidor desde otra PC de tu red,\e[0m"
                echo -e "     \e[0;37mdebes abrir una terminal en esa otra PC y escribir: \e[1;36mssh $USER@$my_ip\e[0m\e[0;37m)\e[0m\n"
                echo -e "    \e[1;33m[1]\e[0m \e[1;37mMantener activo y volver al Centro de Mando\e[0m"
                echo -e "    \e[1;31m[2]\e[0m \e[1;37mDesactivar SSH (Apagar acceso remoto por red)\e[0m\n"
                echo -e "  \e[1;31m─────────────────────────────────────────────────────────────────────────────\e[0m"
                echo -e -n "\n  \e[1;31m> Selecciona una opción [1-2]: \e[0m"
                read -l -P "" ssh_action
                if test "$ssh_action" = "2"
                    sudo systemctl disable --now sshd
                    echo -e "\n  \e[1;31mSSH ha sido desactivado con éxito.\e[0m"
                    read -l -P "  Presiona Enter para volver..." dummy
                end
            else
                echo -e "    Estado del servicio: \e[1;30m[ INACTIVO ]\e[0m\n"
                echo -e "    \e[0;37mEl acceso remoto por red está actualmente apagado.\e[0m\n"
                echo -e "    \e[1;32m[1]\e[0m \e[1;37mActivar SSH y permitir puerto en Firewall\e[0m"
                echo -e "    \e[1;33m[2]\e[0m \e[1;37mDejar inactivo y volver al Centro de Mando\e[0m\n"
                echo -e "  \e[1;31m─────────────────────────────────────────────────────────────────────────────\e[0m"
                echo -e -n "\n  \e[1;31m> Selecciona una opción [1-2]: \e[0m"
                read -l -P "" ssh_action
                if test "$ssh_action" = "1"
                    sudo systemctl enable --now sshd
                    sudo ufw allow 22/tcp
                    sudo ufw reload
                    echo -e "\n  \e[1;32m¡SSH activado con éxito y regla de firewall configurada!\e[0m"
                    echo -e "  Tu IP local es: \e[1;33m$my_ip\e[0m"
                    read -l -P "  Presiona Enter para volver..." dummy
                end
            end
        case 4 'u' 'U'
            clear
            echo ""
            echo ""
            echo -e "  \e[1;31m─────────────────────────────────────────────────────────────────────────────\e[0m"
            echo -e "   \e[1;37mX64 LIOS - ACTUALIZACIÓN DEL SISTEMA\e[0m"
            echo -e "  \e[1;31m─────────────────────────────────────────────────────────────────────────────\e[0m\n"
            echo -e "    Esta herramienta sincronizará los repositorios oficiales de X64 LIOS"
            echo -e "    y actualizará todos los paquetes creando un snapshot previo con Snapper.\n"
            echo -e "    \e[1;32m[1]\e[0m \e[1;37mIniciar actualización completa del sistema\e[0m"
            echo -e "    \e[1;33m[0]\e[0m \e[1;37mVolver al Centro de Mando\e[0m\n"
            echo -e "  \e[1;31m─────────────────────────────────────────────────────────────────────────────\e[0m"
            echo -e -n "\n  \e[1;31m> Selecciona una opción [1, 0]: \e[0m"
            read -l -P "" u_choice
            if test "$u_choice" = "1"
                echo -e "\n    \e[1;36mConectando con repositorios y actualizando paquetes...\e[0m\n"
                sudo pacman -Syu
                echo -e "\n    \e[1;32m¡Actualización completada con éxito!\e[0m"
                read -l -P "  Presiona Enter para volver..." dummy
            end
        case 5 'n' 'N'
            clear
            echo ""
            echo ""
            echo -e "  \e[1;31m─────────────────────────────────────────────────────────────────────────────\e[0m"
            echo -e "   \e[1;37mDIAGNÓSTICO DE RED E INTERFACES\e[0m"
            echo -e "  \e[1;31m─────────────────────────────────────────────────────────────────────────────\e[0m\n"
            ip -br addr | sed 's/^/    /'
            echo -e "\n    \e[1;33mPrueba de conectividad a Internet (Ping 1.1.1.1):\e[0m"
            ping -c 3 1.1.1.1 | sed 's/^/    /'
            echo -e "\n  \e[1;31m─────────────────────────────────────────────────────────────────────────────\e[0m"
            read -l -P "  Presiona Enter para volver..." dummy
        case 6 'l' 'L'
            clear
            echo ""
            echo ""
            echo -e "  \e[1;31m─────────────────────────────────────────────────────────────────────────────\e[0m"
            echo -e "   \e[1;37mLIMPIEZA PROFUNDA DEL SISTEMA\e[0m"
            echo -e "  \e[1;31m─────────────────────────────────────────────────────────────────────────────\e[0m\n"
            echo -e "    Esta operación purgará paquetes parciales corruptos, vaciará la caché"
            echo -e "    antigua de pacman y compactará los registros de journalctl.\n"
            echo -e "    \e[1;33m[1]\e[0m \e[1;37mEjecutar limpieza profunda ahora\e[0m"
            echo -e "    \e[1;32m[0]\e[0m \e[1;37mVolver al Centro de Mando\e[0m\n"
            echo -e "  \e[1;31m─────────────────────────────────────────────────────────────────────────────\e[0m"
            echo -e -n "\n  \e[1;31m> Selecciona una opción [1, 0]: \e[0m"
            read -l -P "" l_choice
            if test "$l_choice" = "1"
                echo -e "\n    \e[1;36m1. Limpiando descargas parciales e incompletas...\e[0m"
                sudo sh -c 'rm -f /var/cache/pacman/pkg/*.part /var/cache/pacman/pkg/*.download 2>/dev/null'
                echo -e "       \e[1;32m[OK] Paquetes temporales limpios.\e[0m\n"

                echo -e "    \e[1;36m2. Purgando caché de paquetes descargados antiguos...\e[0m"
                sudo pacman -Sc --noconfirm | sed 's/^/       /'
                echo ""

                echo -e "    \e[1;36m3. Compactando registros del sistema (journalctl)...\e[0m"
                sudo journalctl --vacuum-time=1w | sed 's/^/       /'

                echo -e "\n    \e[1;32m¡Limpieza finalizada con éxito!\e[0m\n"
                echo -e "  \e[1;31m─────────────────────────────────────────────────────────────────────────────\e[0m"
                read -l -P "  Presiona Enter para volver..." dummy
            end
        case 7 'e' 'E'
            clear
            echo ""
            echo ""
            echo -e "  \e[1;31m─────────────────────────────────────────────────────────────────────────────\e[0m"
            echo -e "   \e[1;37mREGISTRO DE ERRORES DEL SISTEMA (JOURNALCTL)\e[0m"
            echo -e "  \e[1;31m─────────────────────────────────────────────────────────────────────────────\e[0m\n"
            echo -e "    Esta herramienta consulta el registro de fallos críticos del último"
            echo -e "    arranque (prioridad advertencia y error del sistema).\n"
            echo -e "    \e[0;33m[Tip: Usa las flechas para desplazarte y presiona 'q' para salir del visor]\e[0m\n"
            echo -e "    \e[1;36m[1]\e[0m \e[1;37mAbrir visor de registros ahora\e[0m"
            echo -e "    \e[1;33m[0]\e[0m \e[1;37mVolver al Centro de Mando\e[0m\n"
            echo -e "  \e[1;31m─────────────────────────────────────────────────────────────────────────────\e[0m"
            echo -e -n "\n  \e[1;31m> Selecciona una opción [1, 0]: \e[0m"
            read -l -P "" e_choice
            if test "$e_choice" = "1"
                sudo journalctl -p 3 -xb
                echo -e "\n  \e[1;31m─────────────────────────────────────────────────────────────────────────────\e[0m"
                read -l -P "  Presiona Enter para volver..." dummy
            end
        case '*'
            set -l found 0
            if test (count $desktop_options) -gt 0
                for i in (seq (count $desktop_options))
                    if test "$choice" = "$desktop_options[$i]"
                        eval $desktop_cmds[$i]
                        set found 1
                        break
                    end
                end
            end
    end
end
