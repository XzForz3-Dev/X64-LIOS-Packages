        end
        set -l oma_pkgs (pacman -Qq omacalc omacut omasnap omawrite omarchy-nvim omarchy-screensaver omarchy-speedtest omarchy-local-ai owe monologue herdr hype signed superwhisper-bin foot imv gliff asdcontrol cliamp disktree-bin ttfx tobi-try ttf-ia-writer omarchy-keyring aether obsidian localsend pinta moonlight-qt nautilus nautilus-python libreoffice-fresh mise-bin mise folio plain tzupdate ufw-docker yaru-icon-theme google-chrome cmake $oma_extra_hypr 2>/dev/null | sort -u)
        if test (count $oma_pkgs) -gt 0
            sudo pacman -Rcs --noconfirm $oma_pkgs 2>/dev/null; or sudo pacman -Rc --noconfirm $oma_pkgs 2>/dev/null
        end
        if test "$target_id" != "1"
            sudo rm -f /usr/share/wayland-sessions/hyprland.desktop /usr/share/wayland-sessions/hyprland-uwsm.desktop 2>/dev/null
        end

        # 2. Eliminar directorios, wrappers maestros, symlinks en /usr/bin y assets del sistema
        sudo rm -rf /usr/share/omarchy /etc/profile.d/omarchy.sh /usr/share/wayland-sessions/x64-lios-omarchy.desktop /usr/share/wayland-sessions/omarchy.desktop 2>/dev/null
        sudo rm -f /usr/local/bin/omarchy* /usr/bin/omarchy /usr/bin/omarchy-* /usr/local/bin/x64-launch-tiled-terminal /usr/share/bash-completion/completions-fallback/mise.bash 2>/dev/null
        sudo rm -rf /etc/skel/.config/omarchy /etc/skel/.local/state/omarchy /etc/skel/Fondos /etc/skel/Temas /usr/share/fonts/omarchy 2>/dev/null
        sudo rm -rf /etc/mise /var/lib/pacman/sync/omarchy.* 2>/dev/null
        sudo fc-cache -f /usr/share/fonts 2>/dev/null

        # 3. Eliminar servicios systemd y drop-ins
        sudo rm -f /usr/lib/systemd/user/omarchy-*.service /usr/lib/systemd/user/owed.service 2>/dev/null
        sudo rm -rf /usr/lib/systemd/user/owed.service.d /etc/systemd/user/owed.service.d 2>/dev/null
        sudo rm -f /usr/lib/systemd/user/wireplumber.service.d/10-omarchy-camera-access.conf 2>/dev/null
        sudo rm -f /etc/systemd/user.conf.d/20-omarchy-nofile.conf /etc/systemd/oomd.conf.d/10-omarchy.conf /etc/systemd/system.conf.d/20-omarchy-nofile.conf 2>/dev/null
        sudo rm -rf /etc/systemd/system/cups-browsed.service.d/10-omarchy.conf /etc/systemd/system/proc-sys-fs-binfmt_misc.mount.d/10-omarchy-conditions.conf 2>/dev/null
