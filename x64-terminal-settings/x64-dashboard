                else
                    echo -e "   $title SAFETY LOCK: ACTIVE GRAPHICAL TERMINAL DETECTED$reset"
                    echo -e "  $border─────────────────────────────────────────────────────────────────────────────$reset\n"
                    echo -e "    \e[1;31m[!] You are running x64-dashboard inside your current graphical desktop.\e[0m\n"
                    echo -e "    To mutate to another desktop, the system must stop the display manager ($desktop_dms[1])"
                    echo -e "    and uninstall \e[1;37m$desktop_names[1]\e[0m. If we proceed from inside this window:"
                    echo -e "    \e[1;33m• Your terminal window will be terminated abruptly as the compositor stops.\e[0m"
                    echo -e "    \e[1;33m• Pacman will be interrupted mid-install and leave the database locked.\e[0m\n"
                    echo -e "    \e[1;32mSTEPS FOR A 100% SAFE TRANSITION:\e[0m\n"
                    echo -e "    \e[1;36m1.\e[0m Switch to a kernel TTY virtual console: \e[1;37mCtrl + Alt + F3\e[0m (or F2/F4)"
                    echo -e "    \e[1;36m2.\e[0m Log in with your standard Linux user and password."
                    echo -e "    \e[1;36m3.\e[0m Run: \e[1;32mx64-dashboard\e[0m"
                    echo -e "    \e[1;36m4.\e[0m Select \e[1;37m$target_name\e[0m to perform the clean mutation.\n"
                    echo -e "    \e[0;37m(To return to your current desktop session, press \e[1;37mCtrl + Alt + F1\e[0m or \e[1;37mF2\e[0m)\e[0m\n"
                end
                echo -e "  $border─────────────────────────────────────────────────────────────────────────────$reset"
                echo ""
                set -l prompt_safe_back (test $is_es -eq 1; and echo "  Presiona Enter para volver de forma segura..."; or echo "  Press Enter to safely return...")
                read -l -P "$prompt_safe_back" dummy
                return
            end

            clear
            echo ""
            echo ""
            echo -e "  $border─────────────────────────────────────────────────────────────────────────────$reset"
            if test $is_es -eq 1
                echo -e "   $title TRANSICIÓN LIMPIA DE ESCRITORIO (MODO PUREZA X64)$reset"
                echo -e "  $border─────────────────────────────────────────────────────────────────────────────$reset\n"
                echo -e "    \e[1;33m[!] Entorno actual detectado:\e[0m \e[1;37m$desktop_names[1]\e[0m\n"
                echo -e "    Para evitar duplicación de aplicaciones (múltiples exploradores de archivos,"
                echo -e "    centros de control y reproductores) y colisiones de demonios en segundo plano:\n"
                echo -e "    \e[1;31m1.\e[0m Se desinstalará limpiamente \e[1;33m$desktop_names[1]\e[0m y sus dependencias."
                echo -e "    \e[1;32m2.\e[0m Se instalará y configurará \e[1;37m$target_name\e[0m."
                echo -e "    \e[1;36m3.\e[0m Podrás configurar el modo de arranque (Consola TTY o Gráfico).\n"
            else
                echo -e "   $title CLEAN DESKTOP TRANSITION (X64 PURITY MODE)$reset"
                echo -e "  $border─────────────────────────────────────────────────────────────────────────────$reset\n"
                echo -e "    \e[1;33m[!] Current environment detected:\e[0m \e[1;37m$desktop_names[1]\e[0m\n"
                echo -e "    To prevent application bloat (duplicate file managers, control panels,"
                echo -e "    and media players) and background daemon collisions:\n"
                echo -e "    \e[1;31m1.\e[0m Cleanly remove \e[1;33m$desktop_names[1]\e[0m and its dependencies."
                echo -e "    \e[1;32m2.\e[0m Install and configure \e[1;37m$target_name\e[0m."
                echo -e "    \e[1;36m3.\e[0m Configure your boot mode (TTY Console or Graphical).\n"
            end
            echo -e "  $border─────────────────────────────────────────────────────────────────────────────$reset"
            echo ""
            set -l prompt_trans (test $is_es -eq 1; and echo "  \e[1;31m> ¿Proceder con la transición limpia a $target_name? [S/n]: \e[0m"; or echo "  \e[1;31m> Proceed with clean transition to $target_name? [Y/n]: \e[0m")
            read -l -P (echo -e "$prompt_trans") trans_choice
            if test -n "$trans_choice"; and test "$trans_choice" != "s"; and test "$trans_choice" != "S"; and test "$trans_choice" != "y"; and test "$trans_choice" != "Y"
                if test $is_es -eq 1
                    echo -e "\n  \e[1;33m[INFO] Transición cancelada. Tu escritorio actual no ha sido modificado.\e[0m"
                else
                    echo -e "\n  \e[1;33m[INFO] Transition cancelled. Your current desktop was not modified.\e[0m"
                end
                sleep 2
                return
            end

            # Execute previous environment cleanup
            clean_previous_desktops $d_choice
        end
    end

    # Installation of selected desktop suite (1:1 parity with Calamares Master Suites)
    set -l install_ok 0
    switch $d_choice
        case 1
            if test $is_es -eq 1
                echo -e "\n  \e[1;32m[*] Instalando Hyprland Nativo Oficial de X64 LIOS (Suite Cyberpunk)...\e[0m"
            else
                echo -e "\n  \e[1;32m[*] Installing Official X64 LIOS Native Hyprland (Cyberpunk Suite)...\e[0m"
            end
            sudo pacman -Sy --needed --noconfirm --overwrite "*" hyprland sddm x64-sddm-theme dolphin ark ffmpegthumbs kdegraphics-thumbnailers loupe papers gnome-text-editor qalculate-gtk blueman gnome-disk-utility kitty opencode quickshell swaybg hyprlock hypridle hyprpolkitagent hyprpwcenter hyprpicker hyprsunset gpu-screen-recorder cliphist adw-gtk-theme xdg-terminal-exec xdg-desktop-portal-hyprland x64-hyprland-settings chromium
            test $status -eq 0; and set install_ok 1
            if test $install_ok -eq 1
                if test -d $HOME/.config/hypr.x64-native.bak
                    rm -rf $HOME/.config/hypr
                    mv $HOME/.config/hypr.x64-native.bak $HOME/.config/hypr
                else
                    mkdir -p $HOME/.config/hypr
                    if not test -f $HOME/.config/hypr/hyprland.lua; and test -f /etc/xdg/hypr/hyprland.lua
                        cp -f /etc/xdg/hypr/hyprland.lua $HOME/.config/hypr/hyprland.lua
                    end
                    if not test -f $HOME/.config/hypr/custom.lua; and test -f /etc/xdg/hypr/custom.lua
                        cp -f /etc/xdg/hypr/custom.lua $HOME/.config/hypr/custom.lua
                    end
                    if not test -f $HOME/.config/hypr/hyprland.conf; and test -f /etc/xdg/hypr/hyprland.conf
                        cp -f /etc/xdg/hypr/hyprland.conf $HOME/.config/hypr/hyprland.conf
                    end
                    if not test -f $HOME/.config/hypr/hyprlock.conf; and test -f /etc/xdg/hypr/hyprlock.conf
                        cp -f /etc/xdg/hypr/hyprlock.conf $HOME/.config/hypr/hyprlock.conf
                    end
                end
                if test -d $HOME/.config/quickshell.x64-native.bak
                    rm -rf $HOME/.config/quickshell
                    mv $HOME/.config/quickshell.x64-native.bak $HOME/.config/quickshell
                end
                configure_desktop_boot_mode sddm "Hyprland (X64 Cyberpunk Edition)"
            end
        case 2
            if test $is_es -eq 1
                echo -e "\n  \e[1;32m[*] Instalando GNOME Oficial de X64 LIOS (Suite Completa Calamares)...\e[0m"
            else
                echo -e "\n  \e[1;32m[*] Installing Official X64 LIOS GNOME (Full Calamares Suite)...\e[0m"
            end
            sudo pacman -S --needed --noconfirm --overwrite "*" baobab decibels file-roller gdm gnome-backgrounds gnome-bluetooth-3.0 gnome-calculator gnome-color-manager gnome-control-center gnome-disk-utility gnome-keyring gnome-menus gnome-session gnome-settings-daemon gnome-shell gnome-shell-extensions gnome-text-editor gnome-tweaks gnome-user-docs gnome-user-share gvfs gvfs-afc gvfs-dnssd gvfs-goa gvfs-gphoto2 gvfs-mtp gvfs-nfs gvfs-smb loupe mutter nautilus papers resources showtime simple-scan snapshot sushi xdg-user-dirs-gtk x64-gnome-settings adw-gtk-theme kitty chromium
            test $status -eq 0; and set install_ok 1
            if test $install_ok -eq 1
                configure_desktop_boot_mode gdm "GNOME (X64 Stealth Edition)"
            end
        case 3
            if test $is_es -eq 1
                echo -e "\n  \e[1;32m[*] Instalando KDE Plasma 6 Oficial de X64 LIOS (Suite Completa Calamares)...\e[0m"
            else
                echo -e "\n  \e[1;32m[*] Installing Official X64 LIOS KDE Plasma 6 (Full Calamares Suite)...\e[0m"
            end
            sudo pacman -S --needed --noconfirm --overwrite "*" ark bluedevil breeze breeze-icons breeze-gtk discover dolphin ffmpegthumbs filelight flatpak fwupd gwenview haruna kate kcalc kde-gtk-config kdeconnect kdegraphics-thumbnailers kdeplasma-addons kdialog kinfocenter kio-admin kio-fuse konsole kscreen kwallet-pam kwalletmanager okular partitionmanager phonon-qt6-vlc plasma-browser-integration plasma-desktop plasma-disks plasma-firewall plasma-nm plasma-pa plasma-systemmonitor plasma-thunderbolt plasma-vault plasma-workspace-wallpapers powerdevil print-manager sddm sddm-kcm x64-sddm-theme skanpage spectacle tesseract-data-eng xdg-desktop-portal-kde xdg-user-dirs xsettingsd x64-kde-settings chromium
            test $status -eq 0; and set install_ok 1
            if test $install_ok -eq 1
                for f in kdeglobals plasmashellrc plasma-org.kde.plasma.desktop-appletsrc plasmarc kwinrc kscreenlockerrc baloofilerc ksmserverrc
                    if test -f /etc/skel/.config/$f
                        cp -f /etc/skel/.config/$f $HOME/.config/$f 2>/dev/null
                    end
                end
                mkdir -p $HOME/.config/kdedefaults $HOME/.config/gtk-3.0 $HOME/.config/gtk-4.0 2>/dev/null
                for df in kdeglobals kwinrc plasmarc kscreenlockerrc ksmserverrc
                    if test -f /etc/skel/.config/kdedefaults/$df
                        cp -f /etc/skel/.config/kdedefaults/$df $HOME/.config/kdedefaults/$df 2>/dev/null
                    end
                end
                test -f /etc/skel/.config/gtk-3.0/settings.ini; and cp -f /etc/skel/.config/gtk-3.0/settings.ini $HOME/.config/gtk-3.0/settings.ini 2>/dev/null
                test -f /etc/skel/.config/gtk-4.0/settings.ini; and cp -f /etc/skel/.config/gtk-4.0/settings.ini $HOME/.config/gtk-4.0/settings.ini 2>/dev/null
                rm -f $HOME/.config/gtk-3.0/gtk.css $HOME/.config/gtk-4.0/gtk.css $HOME/.cache/icon-cache.kcache $HOME/.cache/ksycoca6* 2>/dev/null
                rm -rf $HOME/.cache/plasmashell 2>/dev/null
                configure_desktop_boot_mode sddm "KDE Plasma 6 (X64 Gaming Edition)"
            end
        case 4
            if test $is_es -eq 1
                echo -e "\n  \e[1;32m[*] Instalando COSMIC Desktop Oficial de X64 LIOS (Suite Completa Calamares)...\e[0m"
            else
                echo -e "\n  \e[1;32m[*] Installing Official X64 LIOS COSMIC Desktop (Full Calamares Suite)...\e[0m"
            end
            sudo pacman -S --needed --noconfirm --overwrite "*" cosmic-session cosmic-greeter cosmic-comp cosmic-panel cosmic-app-library cosmic-applets cosmic-bg cosmic-workspaces cosmic-launcher cosmic-notifications cosmic-osd cosmic-settings cosmic-settings-daemon cosmic-randr cosmic-files cosmic-terminal cosmic-text-editor cosmic-viewer cosmic-player cosmic-monitor cosmic-screenshot cosmic-icon-theme cosmic-wallpapers gnome-keyring xdg-desktop-portal-cosmic xdg-desktop-portal-gtk xorg-xwayland x64-cosmic-settings chromium
            test $status -eq 0; and set install_ok 1
            if test $install_ok -eq 1
                configure_desktop_boot_mode cosmic-greeter "COSMIC Desktop (System76 Rust Edition)"
            end
        case 5
            if test $is_es -eq 1
                echo -e "\n  \e[1;32m[*] Instalando Niri Oficial de X64 LIOS (Suite Completa Noctalia Shell)...\e[0m"
            else
                echo -e "\n  \e[1;32m[*] Installing Official X64 LIOS Niri (Full Noctalia Shell Suite)...\e[0m"
            end
            sudo pacman -S --needed --noconfirm --overwrite "*" niri sddm x64-sddm-theme kitty nautilus noctalia xdg-desktop-portal-gnome x64-niri-settings chromium
            test $status -eq 0; and set install_ok 1
            if test $install_ok -eq 1
                configure_desktop_boot_mode sddm "Niri (X64 Noctalia Shell Edition)"
            end
        case 6
            if test $is_es -eq 1
                echo -e "\n  \e[1;32m[*] Instalando Cinnamon Oficial de X64 LIOS (Suite Completa Calamares)...\e[0m"
            else
                echo -e "\n  \e[1;32m[*] Installing Official X64 LIOS Cinnamon (Full Calamares Suite)...\e[0m"
            end
            sudo pacman -S --needed --noconfirm --overwrite "*" cinnamon cinnamon-translations nemo lightdm lightdm-slick-greeter gnome-keyring gnome-terminal kitty x64-cinnamon-settings chromium
            test $status -eq 0; and set install_ok 1
            if test $install_ok -eq 1
                configure_desktop_boot_mode lightdm "Cinnamon (X64 Classic Edition)"
            end
        case 7
            if test $is_es -eq 1
                echo -e "\n  \e[1;32m[*] Instalando Xfce4 Oficial de X64 LIOS (Suite Completa Calamares)...\e[0m"
            else
                echo -e "\n  \e[1;32m[*] Installing Official X64 LIOS Xfce4 (Full Calamares Suite)...\e[0m"
            end
            sudo pacman -S --needed --noconfirm --overwrite "*" xfce4 xfce4-goodies labwc xorg-xwayland lightdm lightdm-slick-greeter thunar file-roller ristretto network-manager-applet x64-xfce4-settings chromium
            test $status -eq 0; and set install_ok 1
            if test $install_ok -eq 1
                configure_desktop_boot_mode lightdm "Xfce4 (X64 Ultra-Lightweight Edition)"
            end
        case 8
            if test $is_es -eq 1
                echo -e "\n  \e[1;32m[*] Instalando X64 LIOS + Omarchy (Flagship Shell Basecamp)...\e[0m"
            else
                echo -e "\n  \e[1;32m[*] Installing X64 LIOS + Omarchy (Flagship Basecamp Shell)...\e[0m"
            end
            if not test -d /usr/share/omarchy
                if test $is_es -eq 1
                    echo -e "  \e[1;36m-> Desplegando repositorio X64 LIOS + Omarchy (/usr/share/omarchy)...\e[0m"
                else
                    echo -e "  \e[1;36m-> Deploying X64 LIOS + Omarchy repository (/usr/share/omarchy)...\e[0m"
                end
                sudo git clone --depth 1 -b main https://github.com/XzForz3-Dev/X64-LIOS-Omarchy.git /usr/share/omarchy
                sudo git config --system --add safe.directory /usr/share/omarchy 2>/dev/null
            else
                sudo git config --system --add safe.directory /usr/share/omarchy 2>/dev/null
                sudo git -C /usr/share/omarchy pull origin main 2>/dev/null
            end
            # Ejecutar el motor de instalación y configuración oficial de Omarchy
            sudo python3 /usr/share/omarchy/bin/x64-omarchy-setup.py --user $USER --theme "x64-lios-crimson"
            test $status -eq 0; and set install_ok 1
            if test $install_ok -eq 1
                configure_desktop_boot_mode sddm "X64 LIOS + Omarchy (Flagship Shell)"
            end
        case 9
            if test $is_es -eq 1
                echo -e "\n  \e[1;32m[*] Configurando Sistema en Modo No Desktop (Consola TTY Pura)...\e[0m"
            else
                echo -e "\n  \e[1;32m[*] Configuring System in No Desktop Mode (Pure TTY Console)...\e[0m"
            end
            sudo systemctl disable sddm gdm lightdm cosmic-greeter 2>/dev/null
            sudo systemctl set-default multi-user.target 2>/dev/null
            set install_ok 1
            if test $is_es -eq 1
                echo -e "  \e[1;32m[OK] Todos los gestores gráficos han sido deshabilitados.\e[0m"
                echo -e "  \e[1;32m[OK] Target configurado en multi-user.target (Consola TTY).\e[0m\n"
                read -l -P (echo -e "  \e[1;31m¿Deseas reiniciar ahora para entrar en consola TTY? [s/N]: \e[0m") r_ans
            else
                echo -e "  \e[1;32m[OK] All graphical display managers have been disabled.\e[0m"
                echo -e "  \e[1;32m[OK] Target configured to multi-user.target (TTY Console).\e[0m\n"
                read -l -P (echo -e "  \e[1;31mDo you want to reboot now into TTY console? [y/N]: \e[0m") r_ans
            end
            if test "$r_ans" = "s"; or test "$r_ans" = "S"; or test "$r_ans" = "y"; or test "$r_ans" = "Y"
                sudo reboot
            end
        case '*'
            return
    end

    if test $install_ok -ne 1
        if test $is_es -eq 1
            echo -e "\n  \e[1;31m[ERROR] La instalación del entorno falló o fue interrumpida.\e[0m"
