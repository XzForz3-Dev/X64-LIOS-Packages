            echo -e "    \e[1;36m[2]\e[0m Reconfigurar modo de arranque (Consola TTY vs Inicio Gráfico)"
            echo -e "    \e[1;31m[0]\e[0m Cancelar y volver al Dashboard\n"
        else
            echo -e "   $title NOTICE: ENVIRONMENT ALREADY ACTIVE ON SYSTEM$reset"
            echo -e "  $border─────────────────────────────────────────────────────────────────────────────$reset\n"
            echo -e "    \e[1;32m$target_name is already your current active desktop!\e[0m\n"
            echo -e "    Would you like to reinstall or repair its official components?\n"
            echo -e "    \e[1;33m[1]\e[0m Reinstall / Repair $target_name packages"
            echo -e "    \e[1;36m[2]\e[0m Reconfigure boot mode (TTY Console vs Graphical Login)"
            echo -e "    \e[1;31m[0]\e[0m Cancel and return to Dashboard\n"
        end
        echo -e "  $border─────────────────────────────────────────────────────────────────────────────$reset"
        echo ""
        set -l prompt_same (test $is_es -eq 1; and echo "  \e[1;31m> Opción [1, 2, 0]: \e[0m"; or echo "  \e[1;31m> Option [1, 2, 0]: \e[0m")
        read -l -P (echo -e "$prompt_same") same_choice
        if test "$same_choice" = "2"
            configure_desktop_boot_mode $target_dm "$target_name"
            return
        else if test "$same_choice" != "1"
            return
        end
    else
        # If another desktop is installed, execute Clean Transition Protocol
        if test $has_desktop -gt 0
            # Safety Lock: Detect if running inside an active local graphical terminal window
            if is_graphical_session
