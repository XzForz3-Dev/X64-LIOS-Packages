#!/usr/bin/env fish
# ==============================================================================
# X64 LIOS - SERVER & RESCUE DASHBOARD (TTY1)
# Centro de Mando Oficial para Instalaciones Server / CLI y Recuperación
# ==============================================================================

function draw_dashboard
    clear
    # Espacio superior para que el logo respire con elegancia
    echo ""
    echo ""

    set -l border "\e[1;31m"
    set -l reset "\e[0m"
    set -l title "\e[1;37m"
    set -l val "\e[0;37m"
    set -l warn "\e[1;33m"
    set -l green "\e[1;32m"
    set -l red "\e[1;31m"
    set -l cyan "\e[1;36m"

    # Telemetría en tiempo real
    set -l os_name (cat /etc/os-release 2>/dev/null | grep "^PRETTY_NAME=" | cut -d '=' -f 2 | tr -d '"')
    test -z "$os_name"; and set os_name "X64 LIOS Linux"
    set -l kernel_ver (uname -r)
    set -l host_node (hostname)
    set -l current_time (date '+%Y-%m-%d %H:%M:%S')
    set -l uptime_str (uptime -p | sed 's/up //')
    set -l ip_addr (ip route get 1.1.1.1 2>/dev/null | awk '{print $7}')
    test -z "$ip_addr"; and set ip_addr "Desconectado"
    set -l mem_used (free -m | awk '/Mem:/ {print $3}')
    set -l mem_total (free -m | awk '/Mem:/ {print $2}')
    set -l ram_str "$mem_used MiB / $mem_total MiB"
    set -l disk_free (df -h / | awk 'NR==2 {print $4}')" libres"

    # Estado de servicios (sin sudo para evitar pedir contraseña)
    set -l ssh_status (systemctl is-active sshd 2>/dev/null)
    set -l ufw_status (systemctl is-active ufw 2>/dev/null)

    set -l ssh_txt (test "$ssh_status" = "active"; and echo "[ ACTIVO ]"; or echo "[ INACTIVO ]")
    set -l ufw_txt (test "$ufw_status" = "active"; and echo "[ ACTIVO ]"; or echo "[ INACTIVO ]")
    set -l ssh_color (test "$ssh_status" = "active"; and echo "\e[1;32m"; or echo "\e[1;30m")
    set -l ufw_color (test "$ufw_status" = "active"; and echo "\e[1;32m"; or echo "\e[1;30m")

    # Logo ASCII Oficial X64 LIOS (Centrado con aire)
    echo -e "$red    ██╗  ██╗ ██████╗ ██╗  ██╗    ██╗     ██╗ ██████╗ ███████╗$reset"
    echo -e "$red    ╚██╗██╔╝██╔════╝ ██║  ██║    ██║     ██║██╔═══██╗██╔════╝$reset"
    echo -e "$red     ╚███╔╝ ███████╗ ███████║    ██║     ██║██║   ██║███████╗$reset"
    echo -e "$red     ██╔██╗ ██╔═══██╗╚════██║    ██║     ██║██║   ██║╚════██║$reset"
    echo -e "$red    ██╔╝ ██╗╚██████╔╝     ██║    ███████╗██║╚██████╔╝███████║$reset"
    echo -e "$red    ╚═╝  ╚═╝ ╚═════╝      ╚═╝    ╚══════╝╚═╝ ╚═════╝ ╚══════╝$reset"
    echo -e "          $title C O N S O L E   //   C E N T R O   D E   M A N D O$reset\n"

    # Sección 1: Telemetría
    echo -e "  $border─────────────────────────────────────────────────────────────────────────────$reset"
    echo -e "   $title TELEMETRÍA DEL SISTEMA$reset"
    echo -e "  $border─────────────────────────────────────────────────────────────────────────────$reset"
    printf "    \e[1;36m%-8s\e[0m \e[0;37m%-24s\e[0m \e[1;36m%-9s\e[0m \e[0;37m%-28s\e[0m\n" "[OS]" "$os_name" "[KERNEL]" "$kernel_ver"
    printf "    \e[1;36m%-8s\e[0m \e[0;37m%-24s\e[0m \e[1;36m%-9s\e[0m \e[0;37m%-28s\e[0m\n" "[HOST]" "$host_node" "[UPTIME]" "$uptime_str"
    printf "    \e[1;36m%-8s\e[0m \e[1;32m%-24s\e[0m \e[1;36m%-9s\e[0m \e[0;37m%-28s\e[0m\n" "[IP]" "$ip_addr" "[HORA]" "$current_time"
    printf "    \e[1;36m%-8s\e[0m \e[0;37m%-24s\e[0m \e[1;36m%-9s\e[0m \e[0;37m%-28s\e[0m\n" "[RAM]" "$ram_str" "[DISCO]" "$disk_free"
    printf "    \e[1;36m%-8s\e[0m $ssh_color%-24s\e[0m \e[1;36m%-9s\e[0m $ufw_color%-28s\e[0m\n" "[SSH]" "$ssh_txt" "[UFW]" "$ufw_txt"

    # Sección 2: Entornos Gráficos
    echo -e "\n  $border─────────────────────────────────────────────────────────────────────────────$reset"
    echo -e "   $title ENTORNO GRÁFICO$reset"
    echo -e "  $border─────────────────────────────────────────────────────────────────────────────$reset"

    set -g desktop_names
    set -g desktop_dms

    if type -q Hyprland
        set -a desktop_names "Hyprland (X64 Cyberpunk Edition - Wayland)"
        set -a desktop_dms "sddm"
    end
    if type -q gnome-shell
        set -a desktop_names "GNOME (X64 Stealth Edition - Wayland)"
        set -a desktop_dms "gdm"
    end
    if type -q startplasma-wayland
        set -a desktop_names "KDE Plasma 6 (X64 Gaming Edition - Wayland)"
        set -a desktop_dms "sddm"
    end
    if type -q cosmic-session
        set -a desktop_names "COSMIC Desktop (Rust Next-Gen - Wayland)"
        set -a desktop_dms "cosmic-greeter"
    end
    if type -q niri-session
        set -a desktop_names "Niri (Scroll-infinito - Wayland)"
        set -a desktop_dms "sddm"
    end
    if type -q cinnamon-session
        set -a desktop_names "Cinnamon (Classic Desktop)"
        set -a desktop_dms "lightdm"
    end
    if type -q xfce4-session
        set -a desktop_names "Xfce4 (Ultra Lightweight)"
        set -a desktop_dms "lightdm"
    end

    set -g has_desktop (count $desktop_names)

    if test $has_desktop -eq 0
        echo -e "    \e[1;33m[!]\e[0m \e[0;37mNo hay ningún entorno gráfico instalado (Modo Server / CLI puro).\e[0m"
        echo -e "    \e[1;33m[1]\e[0m \e[1;37mInstalar un Entorno de Escritorio Oficial (Hyprland, GNOME, etc.)\e[0m"
    else
        set -l dm_active (systemctl is-active $desktop_dms[1] 2>/dev/null)
        if test "$dm_active" = "active"
            printf "    \e[1;32m[1]\e[0m \e[0;37mDetener Servicio Gráfico (\e[1;32m%s ACTIVO\e[0m\e[0;37m)\e[0m\n" "$desktop_dms[1]"
            echo -e "    \e[1;36m[G]\e[0m \e[1;37mConmutar a la Pantalla Gráfica (VT2)\e[0m"
        else
            printf "    \e[1;32m[1]\e[0m \e[0;37mIniciar %s\e[0m\n" "$desktop_names[1]"
        end
        echo -e "    \e[1;33m[I]\e[0m \e[1;37mInstalar o alternar a otro Entorno de Escritorio adicional\e[0m"
    end

    # Sección 3: Herramientas
    echo -e "\n  $border─────────────────────────────────────────────────────────────────────────────$reset"
    echo -e "   $title HERRAMIENTAS DE SERVIDOR Y MANTENIMIENTO$reset"
    echo -e "  $border─────────────────────────────────────────────────────────────────────────────$reset"
    printf "    \e[1;36m%-4s\e[0m \e[0;37m%-32s\e[0m \e[1;36m%-4s\e[0m \e[0;37m%-30s\e[0m\n" "[2]" "Monitor de Recursos (btop)" "[5]" "Diagnóstico de Red e IPs"
    printf "    \e[1;36m%-4s\e[0m \e[0;37m%-32s\e[0m \e[1;36m%-4s\e[0m \e[0;37m%-30s\e[0m\n" "[3]" "Acceso Remoto SSH y Firewall" "[6]" "Limpieza Profunda de Caché"
    printf "    \e[1;36m%-4s\e[0m \e[0;37m%-32s\e[0m \e[1;36m%-4s\e[0m \e[0;37m%-30s\e[0m\n" "[4]" "Actualizar Sistema (Pacman)" "[7]" "Registro de Errores (Boot)"

    # Sección 4: Control del Sistema
    echo -e "\n  $border─────────────────────────────────────────────────────────────────────────────$reset"
    echo -e "   $title CONTROL DEL SISTEMA$reset"
    echo -e "  $border─────────────────────────────────────────────────────────────────────────────$reset"
    printf "    \e[1;36m%-4s\e[0m \e[0;37m%-32s\e[0m \e[1;36m%-4s\e[0m \e[0;37m%-30s\e[0m\n" "[8]" "Consola Pura (Fish Shell)" "[9]" "Reiniciar el Servidor"
    printf "    \e[1;36m%-4s\e[0m \e[0;37m%-32s\e[0m\n" "[0]" "Apagar el Servidor"
    echo -e "  $border─────────────────────────────────────────────────────────────────────────────$reset"
end

function configure_desktop_boot_mode -a dm_service desktop_name
    clear
    echo ""
    echo ""

    set -l border "\e[1;31m"
    set -l reset "\e[0m"
    set -l title "\e[1;37m"

    echo -e "  $border─────────────────────────────────────────────────────────────────────────────$reset"
    echo -e "   $title CONFIGURACIÓN DE ARRANQUE DEL SISTEMA$reset"
    echo -e "  $border─────────────────────────────────────────────────────────────────────────────$reset\n"
    echo -e "    \e[1;32m¡$desktop_name instalado con éxito!\e[0m\n"
    echo -e "    ¿Cómo deseas que arranque este equipo a partir de ahora?\n"
    echo -e "    \e[1;33m[1]\e[0m \e[1;37mModo Servidor / Consola (Recomendado)\e[0m"
    echo -e "        \e[0;37mArrancar siempre en el Centro de Mando TTY1 e iniciar el escritorio bajo demanda.\e[0m\n"
    echo -e "    \e[1;36m[2]\e[0m \e[1;37mModo Escritorio Completo (PC de uso diario)\e[0m"
    echo -e "        \e[0;37mArrancar automáticamente en la pantalla gráfica de inicio de sesión ($dm_service).\e[0m\n"
    echo -e "  $border─────────────────────────────────────────────────────────────────────────────$reset"

    echo -e -n "\n  \e[1;31m> Selecciona el modo de arranque [1, 2]: \e[0m"
    read -l -P "" boot_choice

    if test "$boot_choice" = "2"
        sudo systemctl enable $dm_service
        sudo systemctl set-default graphical.target
        echo -e "\n    \e[1;32m[OK] Modo Escritorio Automático activado ($dm_service habilitado al inicio).\e[0m"
    else
        sudo systemctl disable $dm_service 2>/dev/null
        sudo systemctl set-default multi-user.target 2>/dev/null
        echo -e "\n    \e[1;33m[OK] Modo Servidor / Consola preservado (TTY1 por defecto).\e[0m"
        echo -e "    \e[0;37mPodrás iniciar tu escritorio desde la opción [1] del Centro de Mando.\e[0m"
    end
    echo -e "\n  $border─────────────────────────────────────────────────────────────────────────────$reset"
    read -l -P "  Presiona Enter para volver..." dummy
end

function clean_previous_desktops -a target_id
    echo -e "\n  \e[1;33m[*] Retirando entorno anterior para mantener la pureza del sistema...\e[0m"

    # Detener y desactivar display managers anteriores
    sudo systemctl stop sddm gdm lightdm cosmic-greeter 2>/dev/null
    sudo systemctl disable sddm gdm lightdm cosmic-greeter 2>/dev/null

    # Retirar paquetes del entorno previo con cascada recursiva segura (-Rcs)
    if test "$target_id" != "1"; and type -q Hyprland
        echo -e "  \e[0;37m-> Desinstalando Hyprland y componentes (Waybar, Rofi, Dolphin)...\e[0m"
        set -l hypr_pkgs (pacman -Qq x64-hyprland-settings hyprland waybar rofi rofi-wayland dunst xdg-desktop-portal-hyprland dolphin hyprcursor hyprgraphics hyprland-guiutils hyprlang hyprtoolkit hyprutils hyprwire aquamarine 2>/dev/null | sort -u)
        if test (count $hypr_pkgs) -gt 0
            sudo pacman -Rcs --noconfirm $hypr_pkgs 2>/dev/null; or sudo pacman -Rc --noconfirm $hypr_pkgs 2>/dev/null
        end
    end

    if test "$target_id" != "2"; and type -q gnome-shell
        echo -e "  \e[0;37m-> Desinstalando suite completa de GNOME...\e[0m"
        set -l gnome_pkgs (pacman -Qq x64-gnome-settings gnome-shell gdm gnome-session gnome-control-center gnome-tweaks gnome-shell-extensions nautilus loupe papers showtime decibels simple-scan snapshot sushi baobab file-roller gnome-calculator gnome-text-editor gnome-disk-utility gnome-backgrounds gnome-user-docs gnome-user-share gnome-color-manager gnome-bluetooth-3.0 mutter gnome-menus resources gvfs gvfs-afc gvfs-dnssd gvfs-goa gvfs-gphoto2 gvfs-mtp gvfs-nfs gvfs-smb adw-gtk-theme 2>/dev/null | sort -u)
        if test (count $gnome_pkgs) -gt 0
            sudo pacman -Rcs --noconfirm $gnome_pkgs 2>/dev/null; or sudo pacman -Rc --noconfirm $gnome_pkgs 2>/dev/null
        end
        sudo rm -f /usr/share/gnome-shell/gnome-shell-theme.gresource* 2>/dev/null
    end

    if test "$target_id" != "3"; and type -q startplasma-wayland
        echo -e "  \e[0;37m-> Desinstalando suite completa de KDE Plasma 6...\e[0m"
        set -l kde_pkgs (pacman -Qq x64-kde-settings plasma-desktop plasma-workspace plasma-systemmonitor plasma-nm plasma-pa plasma-disks plasma-firewall plasma-vault plasma-thunderbolt plasma-browser-integration plasma-workspace-wallpapers sddm-kcm dolphin konsole ark discover filelight gwenview haruna kate kcalc okular partitionmanager skanpage spectacle bluedevil kdeconnect kinfocenter kscreen kwalletmanager print-manager kde-gtk-config kdeplasma-addons ffmpegthumbs kdegraphics-thumbnailers kdegraphics-mobipocket kdialog kio-admin kio-fuse kwallet kwallet-pam phonon-qt6-vlc phonon-qt6 breeze-gtk xsettingsd 2>/dev/null | sort -u)
        if test (count $kde_pkgs) -gt 0
            sudo pacman -Rcs --noconfirm $kde_pkgs 2>/dev/null; or sudo pacman -Rc --noconfirm $kde_pkgs 2>/dev/null
        end
    end

    if test "$target_id" != "4"; and type -q cosmic-session
        echo -e "  \e[0;37m-> Desinstalando suite completa de COSMIC Desktop...\e[0m"
        set -l cosmic_pkgs (pacman -Qq x64-cosmic-settings cosmic-session cosmic-greeter cosmic-comp cosmic-panel cosmic-app-library cosmic-applets cosmic-bg cosmic-workspaces cosmic-launcher cosmic-notifications cosmic-osd cosmic-settings cosmic-settings-daemon cosmic-randr cosmic-files cosmic-terminal cosmic-text-editor cosmic-viewer cosmic-player cosmic-monitor cosmic-screenshot cosmic-icon-theme cosmic-wallpapers xdg-desktop-portal-cosmic 2>/dev/null | sort -u)
        if test (count $cosmic_pkgs) -gt 0
            sudo pacman -Rcs --noconfirm $cosmic_pkgs 2>/dev/null; or sudo pacman -Rc --noconfirm $cosmic_pkgs 2>/dev/null
        end
    end

    if test "$target_id" != "5"; and type -q niri-session
        echo -e "  \e[0;37m-> Desinstalando Niri y componentes...\e[0m"
        set -l niri_pkgs (pacman -Qq x64-niri-settings niri noctalia nautilus dolphin fuzzel waybar 2>/dev/null | sort -u)
        if test (count $niri_pkgs) -gt 0
            sudo pacman -Rcs --noconfirm $niri_pkgs 2>/dev/null; or sudo pacman -Rc --noconfirm $niri_pkgs 2>/dev/null
        end
    end

    if test "$target_id" != "6"; and type -q cinnamon-session
        echo -e "  \e[0;37m-> Desinstalando suite completa de Cinnamon...\e[0m"
        set -l cin_pkgs (pacman -Qq x64-cinnamon-settings cinnamon cinnamon-translations nemo lightdm-slick-greeter gnome-terminal 2>/dev/null | sort -u)
        if test (count $cin_pkgs) -gt 0
            sudo pacman -Rcs --noconfirm $cin_pkgs 2>/dev/null; or sudo pacman -Rc --noconfirm $cin_pkgs 2>/dev/null
        end
    end

    if test "$target_id" != "7"; and type -q xfce4-session
        echo -e "  \e[0;37m-> Desinstalando suite completa de Xfce4...\e[0m"
        set -l xfce_pkgs (pacman -Qq x64-xfce4-settings xfce4 xfce4-goodies xfce4-session xfce4-panel thunar ristretto file-roller lightdm-slick-greeter lightdm-gtk-greeter labwc 2>/dev/null | sort -u)
        if test (count $xfce_pkgs) -gt 0
            sudo pacman -Rcs --noconfirm $xfce_pkgs 2>/dev/null; or sudo pacman -Rc --noconfirm $xfce_pkgs 2>/dev/null
        end
    end

    echo -e "  \e[1;32m[OK] Limpieza de entorno anterior completada con éxito.\e[0m"
end

function install_desktop_menu
    clear
    echo ""
    echo ""

    set -l border "\e[1;31m"
    set -l reset "\e[0m"
    set -l title "\e[1;37m"
    set -l val "\e[0;37m"

    set -l hypr_tag ""
    set -l gnome_tag ""
    set -l kde_tag ""
    set -l cosmic_tag ""
    set -l niri_tag ""
    set -l cinnamon_tag ""
    set -l xfce_tag ""

    type -q Hyprland; and set hypr_tag " \e[1;32m[ACTIVO]\e[0m"
    type -q gnome-shell; and set gnome_tag " \e[1;32m[ACTIVO]\e[0m"
    type -q startplasma-wayland; and set kde_tag " \e[1;32m[ACTIVO]\e[0m"
    type -q cosmic-session; and set cosmic_tag " \e[1;32m[ACTIVO]\e[0m"
    type -q niri-session; and set niri_tag " \e[1;32m[ACTIVO]\e[0m"
    type -q cinnamon-session; and set cinnamon_tag " \e[1;32m[ACTIVO]\e[0m"
    type -q xfce4-session; and set xfce_tag " \e[1;32m[ACTIVO]\e[0m"

    echo -e "  $border─────────────────────────────────────────────────────────────────────────────$reset"
    echo -e "   $title X64 LIOS - GESTIÓN Y MUTACIÓN DE ENTORNOS DE ESCRITORIO$reset"
    echo -e "  $border─────────────────────────────────────────────────────────────────────────────$reset\n"
    echo -e "  Selecciona el escritorio oficial que deseas configurar en este equipo:\n"
    echo -e "    \e[1;33m[1]\e[0m $title Hyprland$reset       $val(X64 Cyberpunk Edition - Wayland, animaciones fluidas)$reset$hypr_tag"
    echo -e "    \e[1;33m[2]\e[0m $title GNOME$reset          $val(X64 Stealth Edition - Moderno, sobrio y pulido)$reset$gnome_tag"
    echo -e "    \e[1;33m[3]\e[0m $title KDE Plasma 6$reset   $val(X64 Gaming Edition - Máximo rendimiento y control)$reset$kde_tag"
    echo -e "    \e[1;33m[4]\e[0m $title COSMIC$reset         $val(Next-Gen Rust Desktop desarrollado por System76)$reset$cosmic_tag"
    echo -e "    \e[1;33m[5]\e[0m $title Niri$reset           $val(Tiling con scroll infinito horizontal innovador)$reset$niri_tag"
    echo -e "    \e[1;33m[6]\e[0m $title Cinnamon$reset       $val(Entorno tradicional clásico de alta estabilidad)$reset$cinnamon_tag"
    echo -e "    \e[1;33m[7]\e[0m $title Xfce4$reset          $val(Ligero y ultrarrápido con mínimo consumo de RAM)$reset$xfce_tag"
    echo -e "    \e[1;33m[8]\e[0m $title No Desktop$reset     $val(Modo Servidor / TTY puro sin entorno gráfico)$reset\n"
    echo -e "    \e[1;33m[0]\e[0m Volver al Dashboard Principal"
    echo -e "  $border─────────────────────────────────────────────────────────────────────────────$reset"

    echo -e -n "\n  \e[1;31m> Selecciona una opción [1-8, 0]: \e[0m"
    read -l -P "" d_choice
    test $status -ne 0; and return

    if test "$d_choice" = "0"; or test -z "$d_choice"
        return
    end

    # Nombres de entornos
    set -l target_name ""
    set -l target_dm ""
    switch $d_choice
        case 1
            set target_name "Hyprland (X64 Cyberpunk Edition)"
            set target_dm "sddm"
        case 2
            set target_name "GNOME (X64 Stealth Edition)"
            set target_dm "gdm"
        case 3
            set target_name "KDE Plasma 6 (X64 Gaming Edition)"
            set target_dm "sddm"
        case 4
            set target_name "COSMIC Desktop (System76 Rust Edition)"
            set target_dm "cosmic-greeter"
        case 5
            set target_name "Niri (X64 Scroll-Infinito Edition)"
            set target_dm "sddm"
        case 6
            set target_name "Cinnamon (X64 Classic Edition)"
            set target_dm "lightdm"
        case 7
            set target_name "Xfce4 (X64 Ultra-Lightweight Edition)"
            set target_dm "lightdm"
        case 8
            set target_name "No Desktop (Modo Servidor / Consola TTY Pura)"
            set target_dm "none"
        case '*'
            return
    end

    # Comprobar si el usuario seleccionó el mismo escritorio que ya tiene
    set -l is_current 0
    if test "$d_choice" = "1"; and type -q Hyprland; set is_current 1; end
    if test "$d_choice" = "2"; and type -q gnome-shell; set is_current 1; end
    if test "$d_choice" = "3"; and type -q startplasma-wayland; set is_current 1; end
    if test "$d_choice" = "4"; and type -q cosmic-session; set is_current 1; end
    if test "$d_choice" = "5"; and type -q niri-session; set is_current 1; end
    if test "$d_choice" = "6"; and type -q cinnamon-session; set is_current 1; end
    if test "$d_choice" = "7"; and type -q xfce4-session; set is_current 1; end
    if test "$d_choice" = "8"; and test $has_desktop -eq 0; set is_current 1; end

    if test $is_current -eq 1
        clear
        echo ""
        echo ""
        echo -e "  $border─────────────────────────────────────────────────────────────────────────────$reset"
        echo -e "   $title AVISO: ENTORNO YA ACTIVO EN EL SISTEMA$reset"
        echo -e "  $border─────────────────────────────────────────────────────────────────────────────$reset\n"
        echo -e "    \e[1;32m¡$target_name ya es tu escritorio activo actual!\e[0m\n"
        echo -e "    ¿Deseas reinstalar o reparar sus componentes oficiales?\n"
        echo -e "    \e[1;33m[1]\e[0m Reinstalar / Reparar paquetes de $target_name"
        echo -e "    \e[1;36m[2]\e[0m Reconfigurar modo de arranque (Consola TTY vs Inicio Gráfico)"
        echo -e "    \e[1;31m[0]\e[0m Cancelar y volver al Dashboard\n"
        echo -e "  $border─────────────────────────────────────────────────────────────────────────────$reset"
        echo -e -n "\n  \e[1;31m> Opción [1, 2, 0]: \e[0m"
        read -l -P "" same_choice
        if test "$same_choice" = "2"
            configure_desktop_boot_mode $target_dm "$target_name"
            return
        else if test "$same_choice" != "1"
            return
        end
    else
        # Si tiene otro escritorio instalado, ejecutar protocolo de Transición Limpia (Opción 1)
        if test $has_desktop -gt 0
            clear
            echo ""
            echo ""
            echo -e "  $border─────────────────────────────────────────────────────────────────────────────$reset"
            echo -e "   $title TRANSICIÓN LIMPIA DE ESCRITORIO (MODO PUREZA X64)$reset"
            echo -e "  $border─────────────────────────────────────────────────────────────────────────────$reset\n"
            echo -e "    \e[1;33m[!] Entorno actual detectado:\e[0m \e[1;37m$desktop_names[1]\e[0m\n"
            echo -e "    Para evitar duplicación de aplicaciones (múltiples exploradores de archivos,"
            echo -e "    centros de control y reproductores) y colisiones de demonios en segundo plano:\n"
            echo -e "    \e[1;31m1.\e[0m Se desinstalará limpiamente \e[1;33m$desktop_names[1]\e[0m y sus dependencias."
            echo -e "    \e[1;32m2.\e[0m Se instalará y configurará \e[1;37m$target_name\e[0m."
            echo -e "    \e[1;36m3.\e[0m Podrás configurar el modo de arranque (Consola TTY o Gráfico).\n"
            echo -e "  $border─────────────────────────────────────────────────────────────────────────────$reset"
            echo -e -n "\n  \e[1;31m> ¿Proceder con la transición limpia a $target_name? [S/n]: \e[0m"
            read -l -P "" trans_choice
            if test -n "$trans_choice"; and test "$trans_choice" != "s"; and test "$trans_choice" != "S"
                echo -e "\n  \e[1;33m[INFO] Transición cancelada. Tu escritorio actual no ha sido modificado.\e[0m"
                sleep 2
                return
            end

            # Ejecutar limpieza del entorno previo
            clean_previous_desktops $d_choice
        end
    end

    # Instalación del entorno seleccionado (Paridad 1:1 con Suites Maestras de Calamares)
    set -l install_ok 0
    switch $d_choice
        case 1
            echo -e "\n  \e[1;32m[*] Instalando Hyprland Oficial de X64 LIOS (Suite Completa Calamares)...\e[0m"
            sudo pacman -S --needed --noconfirm --overwrite "*" hyprland sddm x64-sddm-theme dolphin kitty waybar rofi-wayland dunst xdg-desktop-portal-hyprland x64-hyprland-settings
            test $status -eq 0; and set install_ok 1
            if test $install_ok -eq 1
                configure_desktop_boot_mode sddm "Hyprland (X64 Cyberpunk Edition)"
            end
        case 2
            echo -e "\n  \e[1;32m[*] Instalando GNOME Oficial de X64 LIOS (Suite Completa Calamares)...\e[0m"
            sudo pacman -S --needed --noconfirm --overwrite "*" baobab decibels file-roller gdm gnome-backgrounds gnome-bluetooth-3.0 gnome-calculator gnome-color-manager gnome-control-center gnome-disk-utility gnome-keyring gnome-menus gnome-session gnome-settings-daemon gnome-shell gnome-shell-extensions gnome-text-editor gnome-tweaks gnome-user-docs gnome-user-share gvfs gvfs-afc gvfs-dnssd gvfs-goa gvfs-gphoto2 gvfs-mtp gvfs-nfs gvfs-smb loupe mutter nautilus papers resources showtime simple-scan snapshot sushi xdg-user-dirs-gtk x64-gnome-settings adw-gtk-theme kitty
            test $status -eq 0; and set install_ok 1
            if test $install_ok -eq 1
                configure_desktop_boot_mode gdm "GNOME (X64 Stealth Edition)"
            end
        case 3
            echo -e "\n  \e[1;32m[*] Instalando KDE Plasma 6 Oficial de X64 LIOS (Suite Completa Calamares)...\e[0m"
            sudo pacman -S --needed --noconfirm --overwrite "*" ark bluedevil breeze-gtk discover dolphin ffmpegthumbs filelight flatpak fwupd gwenview haruna kate kcalc kde-gtk-config kdeconnect kdegraphics-thumbnailers kdeplasma-addons kdialog kinfocenter kio-admin kio-fuse konsole kscreen kwallet-pam kwalletmanager okular partitionmanager phonon-qt6-vlc plasma-browser-integration plasma-desktop plasma-disks plasma-firewall plasma-nm plasma-pa plasma-systemmonitor plasma-thunderbolt plasma-vault plasma-workspace-wallpapers powerdevil print-manager sddm sddm-kcm x64-sddm-theme skanpage spectacle tesseract-data-eng xsettingsd x64-kde-settings
            test $status -eq 0; and set install_ok 1
            if test $install_ok -eq 1
                configure_desktop_boot_mode sddm "KDE Plasma 6 (X64 Gaming Edition)"
            end
        case 4
            echo -e "\n  \e[1;32m[*] Instalando COSMIC Desktop Oficial de X64 LIOS (Suite Completa Calamares)...\e[0m"
            sudo pacman -S --needed --noconfirm --overwrite "*" cosmic-session cosmic-greeter cosmic-comp cosmic-panel cosmic-app-library cosmic-applets cosmic-bg cosmic-workspaces cosmic-launcher cosmic-notifications cosmic-osd cosmic-settings cosmic-settings-daemon cosmic-randr cosmic-files cosmic-terminal cosmic-text-editor cosmic-viewer cosmic-player cosmic-monitor cosmic-screenshot cosmic-icon-theme cosmic-wallpapers gnome-keyring xdg-desktop-portal-cosmic xdg-desktop-portal-gtk xorg-xwayland x64-cosmic-settings
            test $status -eq 0; and set install_ok 1
            if test $install_ok -eq 1
                configure_desktop_boot_mode cosmic-greeter "COSMIC Desktop (System76 Rust Edition)"
            end
        case 5
            echo -e "\n  \e[1;32m[*] Instalando Niri Oficial de X64 LIOS (Suite Completa Noctalia Shell)...\e[0m"
            sudo pacman -S --needed --noconfirm --overwrite "*" niri sddm x64-sddm-theme kitty nautilus noctalia xdg-desktop-portal-gnome x64-niri-settings
            test $status -eq 0; and set install_ok 1
            if test $install_ok -eq 1
                configure_desktop_boot_mode sddm "Niri (X64 Noctalia Shell Edition)"
            end
        case 6
            echo -e "\n  \e[1;32m[*] Instalando Cinnamon Oficial de X64 LIOS (Suite Completa Calamares)...\e[0m"
            sudo pacman -S --needed --noconfirm --overwrite "*" cinnamon cinnamon-translations nemo lightdm lightdm-slick-greeter gnome-keyring gnome-terminal x64-cinnamon-settings
            test $status -eq 0; and set install_ok 1
            if test $install_ok -eq 1
                configure_desktop_boot_mode lightdm "Cinnamon (X64 Classic Edition)"
            end
        case 7
            echo -e "\n  \e[1;32m[*] Instalando Xfce4 Oficial de X64 LIOS (Suite Completa Calamares)...\e[0m"
            sudo pacman -S --needed --noconfirm --overwrite "*" xfce4 xfce4-goodies labwc xorg-xwayland lightdm lightdm-slick-greeter thunar file-roller ristretto network-manager-applet x64-xfce4-settings
            test $status -eq 0; and set install_ok 1
            if test $install_ok -eq 1
                configure_desktop_boot_mode lightdm "Xfce4 (X64 Ultra-Lightweight Edition)"
            end
        case 8
            echo -e "\n  \e[1;32m[*] Configurando Sistema en Modo No Desktop (Consola TTY Pura)...\e[0m"
            sudo systemctl disable sddm gdm lightdm cosmic-greeter 2>/dev/null
            sudo systemctl set-default multi-user.target 2>/dev/null
            set install_ok 1
            echo -e "  \e[1;32m[OK] Todos los gestores gráficos han sido deshabilitados.\e[0m"
            echo -e "  \e[1;32m[OK] Target configurado en multi-user.target (Consola TTY).\e[0m\n"
