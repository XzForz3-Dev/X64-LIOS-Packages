    end
    echo -e "  $border─────────────────────────────────────────────────────────────────────────────$reset"

    echo ""
    set -l prompt_choice (test $is_es -eq 1; and echo "  \e[1;31m> Selecciona una opción [1-9, 0]: \e[0m"; or echo "  \e[1;31m> Select an option [1-9, 0]: \e[0m")
    read -l -P (echo -e "$prompt_choice") d_choice
    test $status -ne 0; and return

    if test "$d_choice" = "0"; or test -z "$d_choice"
        return
    end

    # Environment names
    set -l target_name ""
    set -l target_dm ""
    switch $d_choice
        case 1
            set target_name "Hyprland (X64 Cyberpunk Edition)"
            set target_dm "sddm"
        case 2
            set target_name "GNOME (X64 Stealth Edition)"
            set target_dm "gdm"
        case 3
            set target_name "KDE Plasma 6 (X64 Gaming Edition)"
            set target_dm "sddm"
        case 4
            set target_name "COSMIC Desktop (System76 Rust Edition)"
            set target_dm "cosmic-greeter"
        case 5
            set target_name (test $is_es -eq 1; and echo "Niri (X64 Scroll-Infinito Edition)"; or echo "Niri (X64 Infinite-Scroll Edition)")
            set target_dm "sddm"
        case 6
            set target_name "Cinnamon (X64 Classic Edition)"
            set target_dm "lightdm"
        case 7
            set target_name "Xfce4 (X64 Ultra-Lightweight Edition)"
            set target_dm "lightdm"
