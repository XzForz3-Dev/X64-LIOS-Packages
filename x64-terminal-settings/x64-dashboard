    end

    # Stop and disable previous display managers
    sudo systemctl stop sddm gdm lightdm cosmic-greeter 2>/dev/null
    sudo systemctl disable sddm gdm lightdm cosmic-greeter 2>/dev/null

    # Remove packages from previous desktop with safe recursive cascade (-Rcs)
    if test "$target_id" != "1"; and test (count (pacman -Qq x64-hyprland-settings hyprland 2>/dev/null)) -gt 0
        if test $is_es -eq 1
            echo -e "  \e[0;37m-> Desinstalando Hyprland Nativo y componentes...\e[0m"
