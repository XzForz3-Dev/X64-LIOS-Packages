    # Check if target is already current desktop
    set -l is_current 0
    if test "$d_choice" = "1"; and test (count (pacman -Qq x64-hyprland-settings 2>/dev/null)) -gt 0; set is_current 1; end
    if test "$d_choice" = "2"; and type -q gnome-shell; set is_current 1; end
    if test "$d_choice" = "3"; and is_kde_installed; set is_current 1; end
    if test "$d_choice" = "4"; and type -q cosmic-session; set is_current 1; end
    if test "$d_choice" = "5"; and type -q niri-session; set is_current 1; end
    if test "$d_choice" = "6"; and type -q cinnamon-session; set is_current 1; end
    if test "$d_choice" = "7"; and type -q xfce4-session; set is_current 1; end
    if test "$d_choice" = "8"; and test -d /usr/share/omarchy; set is_current 1; end
    if test "$d_choice" = "9"; and test $has_desktop -eq 0; set is_current 1; end

    if test $is_current -eq 1
        clear
        echo ""
        echo ""
        echo -e "  $border─────────────────────────────────────────────────────────────────────────────$reset"
        if test $is_es -eq 1
