    test (count (pacman -Qq omacalc omacut omasnap omawrite omarchy-nvim omarchy-speedtest omarchy-keyring owe monologue herdr hype signed superwhisper-bin gliff mise-bin mise folio plain hyprland-preview-share-picker qtengine tzupdate ufw-docker yaru-icon-theme google-chrome cmake 2>/dev/null)) -gt 0; and set has_omarchy 1

    if test "$target_id" != "8"; and test $has_omarchy -eq 1
