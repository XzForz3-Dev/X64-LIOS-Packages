                    echo -e "  $border─────────────────────────────────────────────────────────────────────────────$reset\n"
                    echo -e "    \e[1;31m[!] Estás ejecutando x64-dashboard dentro de tu entorno gráfico actual.\e[0m\n"
                    echo -e "    Para mutar de escritorio, el sistema debe detener el gestor de pantalla ($desktop_dms[1])"
                    echo -e "    y retirar los componentes de \e[1;37m$desktop_names[1]\e[0m. Si procedemos desde aquí:"
                    echo -e "    \e[1;33m• Tu ventana de terminal se cerrará abruptamente al detenerse el compositor.\e[0m"
                    echo -e "    \e[1;33m• Pacman quedará interrumpido en mitad de la instalación con la base bloqueada.\e[0m\n"
                    echo -e "    \e[1;32mPASOS PARA MUTAR DE FORMA 100% SEGURA:\e[0m\n"
