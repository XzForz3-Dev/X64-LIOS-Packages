        if test "$target_id" = "8"
            set -l hypr_pkgs (pacman -Qq x64-hyprland-settings papirus-icon-theme 2>/dev/null | sort -u)
            if test (count $hypr_pkgs) -gt 0
                sudo pacman -Rcs --noconfirm $hypr_pkgs 2>/dev/null; or sudo pacman -Rc --noconfirm $hypr_pkgs 2>/dev/null
            end
        else
            set -l hypr_pkgs (pacman -Qq x64-hyprland-settings hyprland uwsm quickshell swaybg hyprlock hypridle hyprpolkitagent hyprpwcenter hyprpicker hyprsunset gpu-screen-recorder wf-recorder grim slurp cliphist xdg-desktop-portal-hyprland papirus-icon-theme blueman qalculate-gtk loupe papers gnome-text-editor gnome-disk-utility adw-gtk-theme xdg-terminal-exec hyprland-preview-share-picker qtengine 2>/dev/null | sort -u)
