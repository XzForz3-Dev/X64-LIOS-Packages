            read -l -P "" r_ans
            if test "$r_ans" = "s"; or test "$r_ans" = "S"
                sudo reboot
            end
        case '*'
            return
    end

    if test $install_ok -ne 1
        echo -e "\n  \e[1;31m[ERROR] La instalación del entorno falló o fue interrumpida.\e[0m"
        read -l -P "  Presiona Enter para volver..." dummy
    end

    # Sincronizar configuraciones oficiales de /etc/skel al directorio del usuario activo
    if test -d /etc/skel/.config
        cp -rn /etc/skel/.config/* $HOME/.config/ 2>/dev/null
    end
end

# Loop interactivo del Dashboard
while true
    draw_dashboard
    echo -e -n "\n  \e[1;31m> Selecciona una opción [1-9, 0]: \e[0m"
    read -l -P "" choice
    test $status -ne 0; and break

    switch $choice
        case 8 'c' 'C'
            clear
            if test -f /etc/fastfetch/config-tty.jsonc
                fastfetch --config /etc/fastfetch/config-tty.jsonc
            else
                fastfetch 2>/dev/null
            end
            echo ""
            echo -e "  \e[0;37m(Escribe \e[1;33mx64-dashboard\e[0m \e[0;37men cualquier momento para volver al Centro de Mando)\e[0m\n"
            break
        case 9 'r' 'R'
            clear
            echo ""
            echo ""
            echo -e "  \e[1;31m─────────────────────────────────────────────────────────────────────────────\e[0m"
            echo -e "   \e[1;37mREINICIAR EL SERVIDOR\e[0m"
            echo -e "  \e[1;31m─────────────────────────────────────────────────────────────────────────────\e[0m\n"
            echo -e "    ¿Estás seguro de que deseas reiniciar el sistema ahora mismo?\n"
            echo -e "    \e[1;33m[1]\e[0m \e[1;37mSí, reiniciar ahora\e[0m"
            echo -e "    \e[1;32m[0]\e[0m \e[1;37mCancelar y volver al Centro de Mando\e[0m\n"
            echo -e "  \e[1;31m─────────────────────────────────────────────────────────────────────────────\e[0m"
            echo -e -n "\n  \e[1;31m> Confirmar [1, 0]: \e[0m"
            read -l -P "" r_choice
            if test "$r_choice" = "1"
                clear
                echo -e "\e[1;33mReiniciando el sistema...\e[0m"
                sudo systemctl reboot
                break
            end
        case 0 'a' 'A'
            clear
            echo ""
            echo ""
            echo -e "  \e[1;31m─────────────────────────────────────────────────────────────────────────────\e[0m"
            echo -e "   \e[1;37mAPAGAR EL SERVIDOR\e[0m"
            echo -e "  \e[1;31m─────────────────────────────────────────────────────────────────────────────\e[0m\n"
            echo -e "    ¿Estás seguro de que deseas apagar este equipo por completo?\n"
            echo -e "    \e[1;31m[1]\e[0m \e[1;37mSí, apagar ahora\e[0m"
            echo -e "    \e[1;32m[0]\e[0m \e[1;37mCancelar y volver al Centro de Mando\e[0m\n"
            echo -e "  \e[1;31m─────────────────────────────────────────────────────────────────────────────\e[0m"
            echo -e -n "\n  \e[1;31m> Confirmar [1, 0]: \e[0m"
            read -l -P "" a_choice
            if test "$a_choice" = "1"
                clear
                echo -e "\e[1;31mApagando el servidor...\e[0m"
                sudo systemctl poweroff
                break
            end
        case 'i' 'I'
            install_desktop_menu
        case 'g' 'G'
            if test $has_desktop -gt 0
                sudo chvt 2 2>/dev/null
            end
        case 1
            if test $has_desktop -eq 0
                install_desktop_menu
            else
                set -l dm_active (systemctl is-active $desktop_dms[1] 2>/dev/null)
                if test "$dm_active" = "active"
                    clear
                    echo ""
                    echo ""
                    echo -e "  \e[1;31m─────────────────────────────────────────────────────────────────────────────\e[0m"
                    echo -e "   \e[1;37mDETENER ENTORNO GRÁFICO ($desktop_dms[1])\e[0m"
                    echo -e "  \e[1;31m─────────────────────────────────────────────────────────────────────────────\e[0m\n"
                    echo -e "    El servicio gráfico \e[1;32m$desktop_dms[1]\e[0m está actualmente en ejecución.\n"
                    echo -e "    \e[1;31m[1]\e[0m Detener servicio gráfico y liberar memoria RAM"
                    echo -e "    \e[1;36m[2]\e[0m Conmutar de vuelta a la pantalla gráfica (VT2)"
                    echo -e "    \e[1;33m[0]\e[0m Volver al Centro de Mando\n"
                    echo -e "  \e[1;31m─────────────────────────────────────────────────────────────────────────────\e[0m"
                    echo -e -n "\n  \e[1;31m> Opción [1, 2, 0]: \e[0m"
                    read -l -P "" dm_stop_choice
                    if test "$dm_stop_choice" = "1"
                        echo -e "\n  \e[1;33mDeteniendo $desktop_dms[1]...\e[0m"
                        sudo systemctl stop $desktop_dms[1]
                        echo -e "  \e[1;32m[OK] Servicio detenido y memoria liberada.\e[0m"
                        sleep 1
                    else if test "$dm_stop_choice" = "2"
                        sudo chvt 2 2>/dev/null
                    end
                else
                    clear
                    echo ""
                    echo ""
                    echo -e "  \e[1;31m─────────────────────────────────────────────────────────────────────────────\e[0m"
                    echo -e "   \e[1;37mINICIANDO ENTORNO GRÁFICO OFICIAL\e[0m"
                    echo -e "  \e[1;31m─────────────────────────────────────────────────────────────────────────────\e[0m\n"
                    echo -e "    \e[1;32m[*] Entorno:\e[0m  \e[1;37m$desktop_names[1]\e[0m"
                    echo -e "    \e[1;36m[*] Gestor:\e[0m   \e[1;37m$desktop_dms[1]\e[0m (Pantalla de acceso X64 LIOS)\n"
                    echo -e "    \e[0;37mEl sistema iniciará el gestor de pantalla con integración completa de\e[0m"
                    echo -e "    \e[0;37mseguridad PAM, D-Bus de sesión y aceleración gráfica en unos segundos.\e[0m\n"
                    echo -e "    \e[1;33m[Tip]\e[0m \e[0;37mPara volver a este Centro de Mando en cualquier momento:\e[0m"
                    echo -e "          \e[1;37mPresiona Ctrl + Alt + F1\e[0m\n"
                    echo -e "  \e[1;31m─────────────────────────────────────────────────────────────────────────────\e[0m"
                    echo -e -n "\n  \e[1;32mIniciando $desktop_dms[1]...\e[0m\n"
                    sudo systemctl start $desktop_dms[1]
                    sleep 2
                end
            end
        case 2 'm' 'M'
            if type -q btop
                btop
            else
                top
            end
        case 3 's' 'S'
            clear
            echo ""
            echo ""
            set -l cur_ssh (systemctl is-active sshd 2>/dev/null)
            set -l my_ip (ip route get 1.1.1.1 2>/dev/null | awk '{print $7}')
            test -z "$my_ip"; and set my_ip (ip -4 addr show | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | grep -v '127.0.0.1' | head -n 1)
            test -z "$my_ip"; and set my_ip "Sin conexión de red"

            echo -e "  \e[1;31m─────────────────────────────────────────────────────────────────────────────\e[0m"
            echo -e "   \e[1;37mESTADO DEL ACCESO REMOTO (SSH & FIREWALL)\e[0m"
            echo -e "  \e[1;31m─────────────────────────────────────────────────────────────────────────────\e[0m\n"

            if test "$cur_ssh" = "active"
                echo -e "    Estado del servicio: \e[1;32m[ ACTIVO ]\e[0m"
                echo -e "    Dirección IP local:  \e[1;33m$my_ip\e[0m\n"
                echo -e "    \e[0;37m(Nota informativa: Para entrar a este servidor desde otra PC de tu red,\e[0m"
                echo -e "     \e[0;37mdebes abrir una terminal en esa otra PC y escribir: \e[1;36mssh $USER@$my_ip\e[0m\e[0;37m)\e[0m\n"
                echo -e "    \e[1;33m[1]\e[0m \e[1;37mMantener activo y volver al Centro de Mando\e[0m"
                echo -e "    \e[1;31m[2]\e[0m \e[1;37mDesactivar SSH (Apagar acceso remoto por red)\e[0m\n"
                echo -e "  \e[1;31m─────────────────────────────────────────────────────────────────────────────\e[0m"
                echo -e -n "\n  \e[1;31m> Selecciona una opción [1-2]: \e[0m"
                read -l -P "" ssh_action
                if test "$ssh_action" = "2"
                    sudo systemctl disable --now sshd
                    echo -e "\n  \e[1;31mSSH ha sido desactivado con éxito.\e[0m"
                    read -l -P "  Presiona Enter para volver..." dummy
                end
            else
                echo -e "    Estado del servicio: \e[1;30m[ INACTIVO ]\e[0m\n"
                echo -e "    \e[0;37mEl acceso remoto por red está actualmente apagado.\e[0m\n"
                echo -e "    \e[1;32m[1]\e[0m \e[1;37mActivar SSH y permitir puerto en Firewall\e[0m"
                echo -e "    \e[1;33m[2]\e[0m \e[1;37mDejar inactivo y volver al Centro de Mando\e[0m\n"
                echo -e "  \e[1;31m─────────────────────────────────────────────────────────────────────────────\e[0m"
                echo -e -n "\n  \e[1;31m> Selecciona una opción [1-2]: \e[0m"
                read -l -P "" ssh_action
                if test "$ssh_action" = "1"
                    sudo systemctl enable --now sshd
                    sudo ufw allow 22/tcp
                    sudo ufw reload
                    echo -e "\n  \e[1;32m¡SSH activado con éxito y regla de firewall configurada!\e[0m"
                    echo -e "  Tu IP local es: \e[1;33m$my_ip\e[0m"
                    read -l -P "  Presiona Enter para volver..." dummy
                end
            end
        case 4 'u' 'U'
            clear
            echo ""
            echo ""
            echo -e "  \e[1;31m─────────────────────────────────────────────────────────────────────────────\e[0m"
            echo -e "   \e[1;37mX64 LIOS - ACTUALIZACIÓN DEL SISTEMA\e[0m"
            echo -e "  \e[1;31m─────────────────────────────────────────────────────────────────────────────\e[0m\n"
            echo -e "    Esta herramienta sincronizará los repositorios oficiales de X64 LIOS"
            echo -e "    y actualizará todos los paquetes creando un snapshot previo con Snapper.\n"
            echo -e "    \e[1;32m[1]\e[0m \e[1;37mIniciar actualización completa del sistema\e[0m"
            echo -e "    \e[1;33m[0]\e[0m \e[1;37mVolver al Centro de Mando\e[0m\n"
            echo -e "  \e[1;31m─────────────────────────────────────────────────────────────────────────────\e[0m"
            echo -e -n "\n  \e[1;31m> Selecciona una opción [1, 0]: \e[0m"
            read -l -P "" u_choice
            if test "$u_choice" = "1"
                echo -e "\n    \e[1;36mConectando con repositorios y actualizando paquetes...\e[0m\n"
                sudo pacman -Syu
                echo -e "\n    \e[1;32m¡Actualización completada con éxito!\e[0m"
                read -l -P "  Presiona Enter para volver..." dummy
            end
        case 5 'n' 'N'
            clear
            echo ""
            echo ""
            echo -e "  \e[1;31m─────────────────────────────────────────────────────────────────────────────\e[0m"
            echo -e "   \e[1;37mDIAGNÓSTICO DE RED E INTERFACES\e[0m"
            echo -e "  \e[1;31m─────────────────────────────────────────────────────────────────────────────\e[0m\n"
            ip -br addr | sed 's/^/    /'
            echo -e "\n    \e[1;33mPrueba de conectividad a Internet (Ping 1.1.1.1):\e[0m"
            ping -c 3 1.1.1.1 | sed 's/^/    /'
            echo -e "\n  \e[1;31m─────────────────────────────────────────────────────────────────────────────\e[0m"
            read -l -P "  Presiona Enter para volver..." dummy
        case 6 'l' 'L'
            clear
            echo ""
            echo ""
            echo -e "  \e[1;31m─────────────────────────────────────────────────────────────────────────────\e[0m"
            echo -e "   \e[1;37mLIMPIEZA PROFUNDA DEL SISTEMA\e[0m"
            echo -e "  \e[1;31m─────────────────────────────────────────────────────────────────────────────\e[0m\n"
            echo -e "    Esta operación purgará paquetes parciales corruptos, vaciará la caché"
            echo -e "    antigua de pacman y compactará los registros de journalctl.\n"
            echo -e "    \e[1;33m[1]\e[0m \e[1;37mEjecutar limpieza profunda ahora\e[0m"
            echo -e "    \e[1;32m[0]\e[0m \e[1;37mVolver al Centro de Mando\e[0m\n"
            echo -e "  \e[1;31m─────────────────────────────────────────────────────────────────────────────\e[0m"
            echo -e -n "\n  \e[1;31m> Selecciona una opción [1, 0]: \e[0m"
            read -l -P "" l_choice
            if test "$l_choice" = "1"
                echo -e "\n    \e[1;36m1. Limpiando descargas parciales e incompletas...\e[0m"
                sudo sh -c 'rm -f /var/cache/pacman/pkg/*.part /var/cache/pacman/pkg/*.download 2>/dev/null'
                echo -e "       \e[1;32m[OK] Paquetes temporales limpios.\e[0m\n"

                echo -e "    \e[1;36m2. Purgando caché de paquetes descargados antiguos...\e[0m"
                sudo pacman -Sc --noconfirm | sed 's/^/       /'
                echo ""

                echo -e "    \e[1;36m3. Compactando registros del sistema (journalctl)...\e[0m"
                sudo journalctl --vacuum-time=1w | sed 's/^/       /'

                echo -e "\n    \e[1;32m¡Limpieza finalizada con éxito!\e[0m\n"
                echo -e "  \e[1;31m─────────────────────────────────────────────────────────────────────────────\e[0m"
                read -l -P "  Presiona Enter para volver..." dummy
            end
        case 7 'e' 'E'
            clear
            echo ""
            echo ""
            echo -e "  \e[1;31m─────────────────────────────────────────────────────────────────────────────\e[0m"
            echo -e "   \e[1;37mREGISTRO DE ERRORES DEL SISTEMA (JOURNALCTL)\e[0m"
            echo -e "  \e[1;31m─────────────────────────────────────────────────────────────────────────────\e[0m\n"
            echo -e "    Esta herramienta consulta el registro de fallos críticos del último"
            echo -e "    arranque (prioridad advertencia y error del sistema).\n"
            echo -e "    \e[0;33m[Tip: Usa las flechas para desplazarte y presiona 'q' para salir del visor]\e[0m\n"
            echo -e "    \e[1;36m[1]\e[0m \e[1;37mAbrir visor de registros ahora\e[0m"
            echo -e "    \e[1;33m[0]\e[0m \e[1;37mVolver al Centro de Mando\e[0m\n"
            echo -e "  \e[1;31m─────────────────────────────────────────────────────────────────────────────\e[0m"
            echo -e -n "\n  \e[1;31m> Selecciona una opción [1, 0]: \e[0m"
            read -l -P "" e_choice
            if test "$e_choice" = "1"
                sudo journalctl -p 3 -xb
                echo -e "\n  \e[1;31m─────────────────────────────────────────────────────────────────────────────\e[0m"
                read -l -P "  Presiona Enter para volver..." dummy
            end
        case '*'
            # Opción no reconocida, continuar ciclo
            continue
    end
end
