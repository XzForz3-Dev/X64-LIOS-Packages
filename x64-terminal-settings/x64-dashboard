        else
            echo -e "  \e[0;37m-> Purging packages, webapps, and configurations of X64 LIOS + Omarchy...\e[0m"
        end
        # 1. Purgar paquetes específicos y suite de aplicaciones de Omarchy (incluyendo mise y hyprland si no vamos a Hyprland nativo)
