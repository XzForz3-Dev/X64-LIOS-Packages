        sudo rm -f /etc/systemd/logind.conf.d/20-inhibit-delay.conf 2>/dev/null
        sudo rm -f /usr/lib/systemd/system-sleep/force-igpu /usr/lib/systemd/system-sleep/fprintd-resume /usr/lib/systemd/system-sleep/keyboard-backlight /usr/lib/systemd/system-sleep/unmount-fuse 2>/dev/null
        sudo systemctl daemon-reload 2>/dev/null

        # 4. Eliminar sudoers, tmpfiles, sysctl, udev, modprobe, pam y hooks
        sudo rm -f /etc/pam.d/omarchy-* 2>/dev/null
        sudo rm -f /etc/sudoers.d/omarchy-* /etc/sudoers.d/zz-asdcontrol 2>/dev/null
        sudo rm -f /etc/tmpfiles.d/omarchy-*.conf 2>/dev/null
        sudo rm -f /usr/share/libalpm/hooks/05-omarchy-passwordless-revoke.hook 2>/dev/null
        sudo rm -f /etc/modprobe.d/omarchy-usb-autosuspend.conf 2>/dev/null
        sudo rm -f /etc/sysctl.d/90-omarchy-*.conf /etc/sysctl.d/99-omarchy-sysctl.conf 2>/dev/null
        sudo rm -f /etc/udev/rules.d/60-omarchy-*.rules 2>/dev/null

        # 5. Limpiar /etc/environment y repositorio [omarchy] en /etc/pacman.conf
        sudo sed -i '/OMARCHY_PATH/d' /etc/environment 2>/dev/null
        sudo python3 -c "
import re
try:
    with open('/etc/pacman.conf', 'r') as f:
        c = f.read()
    c = re.sub(r'\[omarchy\]\s*\n(?:(?!\[).*\n)*', '', c)
    with open('/etc/pacman.conf', 'w') as f:
        f.write(c)
except Exception:
    pass
" 2>/dev/null

        # 6. Limpiar /etc/skel/.config/hypr de módulos Lua residuales de Omarchy
        sudo rm -f /etc/skel/.config/hypr/autostart.lua /etc/skel/.config/hypr/bindings.lua /etc/skel/.config/hypr/input.lua /etc/skel/.config/hypr/looknfeel.lua /etc/skel/.config/hypr/monitors.lua /etc/skel/.config/hypr/xdph.conf /etc/skel/.config/hypr/.luarc.json /etc/skel/.config/hypr/hyprsunset.conf 2>/dev/null

        # 7. Limpiar en los directorios de usuario (/home/*) las WebApps, configs, shims, skills y temas
