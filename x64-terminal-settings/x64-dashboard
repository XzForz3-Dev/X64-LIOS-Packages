# Regional localization detection (Default: en_US, Fallback: es_* when $LANG =~ ^es)
set -g is_es 0
if string match -qr '^es' "$LANG"; or string match -qr '^es' "$LC_ALL"; or string match -qr '^es' "$LC_MESSAGES"
    set -g is_es 1
end

# Detection helper: KDE Plasma 6 desktop environment
# (plasma-workspace provides plasmashell and startplasma-wayland for portals, but only plasma-desktop provides the actual full desktop environment)
function is_kde_installed
    test -d /usr/share/plasma/shells/org.kde.plasma.desktop; or pacman -Q plasma-desktop >/dev/null 2>&1
end

# Detection helper: Active graphical desktop session (Kitty, Konsole, Gnome-Terminal, etc.)
# Returns 0 (true) if running inside a local graphical terminal window (Wayland or X11 without SSH),
# where stopping the display manager or removing active GUI packages would abruptly abort the process.
function is_graphical_session
    if test -n "$SSH_CLIENT"; or test -n "$SSH_TTY"
        return 1
    end
    test -n "$WAYLAND_DISPLAY"; or test -n "$DISPLAY"
end

# Dynamic Detection Helper: Determine the active virtual terminal (VT) of the graphical desktop
function get_graphical_vt
    # 1. Query loginctl for active graphical sessions (Wayland or X11)
    for s in (loginctl list-sessions --no-legend 2>/dev/null | awk '{print $1}')
        set -l s_type (loginctl show-session $s -p Type --value 2>/dev/null)
        set -l s_vt (loginctl show-session $s -p VTNr --value 2>/dev/null)
        if test "$s_type" = "wayland"; or test "$s_type" = "x11"
            if test -n "$s_vt"; and test "$s_vt" -gt 0
                echo $s_vt
                return 0
            end
        end
    end
    # 2. Inspect active graphical processes for assigned tty (startplasma-wayland, Xorg, etc.)
    set -l p_tty (ps -eo tty,args 2>/dev/null | grep -E 'startplasma|kwin|gnome-shell|Xorg' | grep -oE 'tty[0-9]+' | head -n 1 | tr -d 'tty')
    if test -n "$p_tty"; and test "$p_tty" -gt 0
        echo $p_tty
        return 0
    end
    # 3. Fallback to VT1 (standard Wayland user session on Arch Linux)
    echo 1
end

function draw_dashboard
    clear
    # Breathing room for header
    echo ""
    echo ""

    set -l border "\e[1;31m"
    set -l reset "\e[0m"
    set -l title "\e[1;37m"
    set -l val "\e[0;37m"
    set -l warn "\e[1;33m"
    set -l green "\e[1;32m"
    set -l red "\e[1;31m"
    set -l cyan "\e[1;36m"

    # Real-time telemetry
    set -l os_name (cat /etc/os-release 2>/dev/null | grep "^PRETTY_NAME=" | cut -d '=' -f 2 | tr -d '"')
    test -z "$os_name"; and set os_name "X64 LIOS Linux"
    set -l kernel_ver (uname -r)
    set -l host_node (hostname)
    set -l current_time (date '+%Y-%m-%d %H:%M:%S')
    set -l uptime_str (uptime -p | sed 's/up //')
    set -l ip_addr (ip route get 1.1.1.1 2>/dev/null | awk '{print $7}')
    if test -z "$ip_addr"
        set ip_addr (test $is_es -eq 1; and echo "Desconectado"; or echo "Disconnected")
    end
    set -l mem_used (free -m | awk '/Mem:/ {print $3}')
    set -l mem_total (free -m | awk '/Mem:/ {print $2}')
    set -l ram_str "$mem_used MiB / $mem_total MiB"
    set -l disk_free (df -h / | awk 'NR==2 {print $4}')(test $is_es -eq 1; and echo " libres"; or echo " free")

    # Service status
    set -l ssh_status (systemctl is-active sshd 2>/dev/null)
    set -l ufw_status (systemctl is-active ufw 2>/dev/null)

    set -l active_tag (test $is_es -eq 1; and echo "[ ACTIVO ]"; or echo "[ ACTIVE ]")
    set -l inactive_tag (test $is_es -eq 1; and echo "[ INACTIVO ]"; or echo "[ INACTIVE ]")
    set -l ssh_txt (test "$ssh_status" = "active"; and echo "$active_tag"; or echo "$inactive_tag")
    set -l ufw_txt (test "$ufw_status" = "active"; and echo "$active_tag"; or echo "$inactive_tag")
    set -l ssh_color (test "$ssh_status" = "active"; and echo "\e[1;32m"; or echo "\e[1;30m")
    set -l ufw_color (test "$ufw_status" = "active"; and echo "\e[1;32m"; or echo "\e[1;30m")

    # Official X64 LIOS ASCII Logo
    echo -e "$red    ██╗  ██╗ ██████╗ ██╗  ██╗    ██╗     ██╗ ██████╗ ███████╗$reset"
    echo -e "$red    ╚██╗██╔╝██╔════╝ ██║  ██║    ██║     ██║██╔═══██╗██╔════╝$reset"
    echo -e "$red     ╚███╔╝ ███████╗ ███████║    ██║     ██║██║   ██║███████╗$reset"
    echo -e "$red     ██╔██╗ ██╔═══██╗╚════██║    ██║     ██║██║   ██║╚════██║$reset"
    echo -e "$red    ██╔╝ ██╗╚██████╔╝     ██║    ███████╗██║╚██████╔╝███████║$reset"
    echo -e "$red    ╚═╝  ╚═╝ ╚═════╝      ╚═╝    ╚══════╝╚═╝ ╚═════╝ ╚══════╝$reset"
    if test $is_es -eq 1
        echo -e "          $title C O N S O L E   //   C E N T R O   D E   M A N D O$reset\n"
    else
        echo -e "          $title C O N S O L E   //   C O N T R O L   C E N T E R$reset\n"
    end

    # Section 1: System Telemetry
    echo -e "  $border─────────────────────────────────────────────────────────────────────────────$reset"
    if test $is_es -eq 1
        echo -e "   $title TELEMETRÍA DEL SISTEMA$reset"
    else
        echo -e "   $title SYSTEM TELEMETRY$reset"
    end
    echo -e "  $border─────────────────────────────────────────────────────────────────────────────$reset"
    set -l lbl_time (test $is_es -eq 1; and echo "[HORA]"; or echo "[TIME]")
    set -l lbl_disk (test $is_es -eq 1; and echo "[DISCO]"; or echo "[DISK]")

    printf "    \e[1;36m%-8s\e[0m \e[0;37m%-24s\e[0m \e[1;36m%-9s\e[0m \e[0;37m%-28s\e[0m\n" "[OS]" "$os_name" "[KERNEL]" "$kernel_ver"
    printf "    \e[1;36m%-8s\e[0m \e[0;37m%-24s\e[0m \e[1;36m%-9s\e[0m \e[0;37m%-28s\e[0m\n" "[HOST]" "$host_node" "[UPTIME]" "$uptime_str"
    printf "    \e[1;36m%-8s\e[0m \e[1;32m%-24s\e[0m \e[1;36m%-9s\e[0m \e[0;37m%-28s\e[0m\n" "[IP]" "$ip_addr" "$lbl_time" "$current_time"
    printf "    \e[1;36m%-8s\e[0m \e[0;37m%-24s\e[0m \e[1;36m%-9s\e[0m \e[0;37m%-28s\e[0m\n" "[RAM]" "$ram_str" "$lbl_disk" "$disk_free"
    printf "    \e[1;36m%-8s\e[0m $ssh_color%-24s\e[0m \e[1;36m%-9s\e[0m $ufw_color%-28s\e[0m\n" "[SSH]" "$ssh_txt" "[UFW]" "$ufw_txt"

    # Section 2: Graphical Environment
    set -g desktop_names
    set -g desktop_dms

    if test (count (pacman -Qq x64-hyprland-settings 2>/dev/null)) -gt 0
        set -a desktop_names "Hyprland (X64 Cyberpunk Edition - Wayland)"
        set -a desktop_dms "sddm"
    end
    if test -d /usr/share/omarchy
        set -a desktop_names "X64 LIOS + Omarchy (Flagship Shell - Wayland)"
        set -a desktop_dms "sddm"
    end
    if type -q gnome-shell
        set -a desktop_names "GNOME (X64 Stealth Edition - Wayland)"
        set -a desktop_dms "gdm"
    end
    if is_kde_installed
        set -a desktop_names "KDE Plasma 6 (X64 Gaming Edition - Wayland)"
        set -a desktop_dms "sddm"
    end
    if type -q cosmic-session
        set -a desktop_names "COSMIC Desktop (Rust Next-Gen - Wayland)"
        set -a desktop_dms "cosmic-greeter"
    end
    if type -q niri-session
        set -a desktop_names (test $is_es -eq 1; and echo "Niri (Scroll-infinito - Wayland)"; or echo "Niri (Infinite Scroll - Wayland)")
        set -a desktop_dms "sddm"
    end
    if type -q cinnamon-session
        set -a desktop_names "Cinnamon (Classic Desktop)"
        set -a desktop_dms "lightdm"
    end
    if type -q xfce4-session
        set -a desktop_names "Xfce4 (Ultra Lightweight)"
        set -a desktop_dms "lightdm"
    end

    # Prioritize currently running graphical session to index 1
    set -l active_de_idx 0
    if pgrep -x plasmashell >/dev/null 2>&1; or pgrep -x kwin_wayland >/dev/null 2>&1
        for i in (seq (count $desktop_names))
            if string match -q "*KDE*" "$desktop_names[$i]"
                set active_de_idx $i
                break
            end
        end
    else if pgrep -x gnome-shell >/dev/null 2>&1
        for i in (seq (count $desktop_names))
            if string match -q "*GNOME*" "$desktop_names[$i]"
                set active_de_idx $i
                break
            end
        end
    else if pgrep -x cosmic-comp >/dev/null 2>&1; or pgrep -x cosmic-session >/dev/null 2>&1
        for i in (seq (count $desktop_names))
            if string match -q "*COSMIC*" "$desktop_names[$i]"
                set active_de_idx $i
                break
            end
        end
    else if pgrep -x niri >/dev/null 2>&1
        for i in (seq (count $desktop_names))
            if string match -q "*Niri*" "$desktop_names[$i]"
                set active_de_idx $i
                break
            end
        end
    else if pgrep -f cinnamon-session >/dev/null 2>&1; or pgrep -x cinnamon >/dev/null 2>&1
        for i in (seq (count $desktop_names))
            if string match -q "*Cinnamon*" "$desktop_names[$i]"
                set active_de_idx $i
                break
            end
        end
    else if pgrep -x xfce4-session >/dev/null 2>&1
        for i in (seq (count $desktop_names))
            if string match -q "*Xfce4*" "$desktop_names[$i]"
                set active_de_idx $i
                break
            end
        end
    else if pgrep -xi Hyprland >/dev/null 2>&1
        for i in (seq (count $desktop_names))
            if test -d /usr/share/omarchy; and string match -q "*Omarchy*" "$desktop_names[$i]"
                set active_de_idx $i
                break
            else if string match -q "*Hyprland*" "$desktop_names[$i]"
                set active_de_idx $i
                break
            end
        end
    end

    if test $active_de_idx -gt 1
        set -l top_name $desktop_names[$active_de_idx]
        set -l top_dm $desktop_dms[$active_de_idx]
        set -e desktop_names[$active_de_idx]
        set -e desktop_dms[$active_de_idx]
        set -p desktop_names "$top_name"
        set -p desktop_dms "$top_dm"
    end

    set -g has_desktop (count $desktop_names)
    set -l dm_active ""
    set -l short_de ""
    if test $has_desktop -gt 0
        set dm_active (systemctl is-active $desktop_dms[1] 2>/dev/null)
        set short_de (string match -r '^[^(]+' "$desktop_names[1]" | string trim)
    end

    echo -e "\n  $border─────────────────────────────────────────────────────────────────────────────$reset"
    if test $is_es -eq 1
        if test "$dm_active" = "active"
            echo -e "   $title ENTORNO GRÁFICO: \e[1;37m$short_de\e[0m \e[1;32m[EN EJECUCIÓN ●]\e[0m$reset"
        else
            echo -e "   $title ENTORNO GRÁFICO$reset"
        end
    else
        if test "$dm_active" = "active"
            echo -e "   $title GRAPHICAL ENVIRONMENT: \e[1;37m$short_de\e[0m \e[1;32m[RUNNING ●]\e[0m$reset"
        else
            echo -e "   $title GRAPHICAL ENVIRONMENT$reset"
        end
    end
    echo -e "  $border─────────────────────────────────────────────────────────────────────────────$reset"

    if test $has_desktop -eq 0
        if test $is_es -eq 1
            echo -e "    \e[1;33m[!]\e[0m \e[0;37mNo hay ningún entorno gráfico instalado (Modo Server / CLI puro).\e[0m"
            echo -e "    \e[1;33m[1]\e[0m \e[1;37mInstalar un Entorno de Escritorio Oficial (Hyprland, GNOME, etc.)\e[0m"
        else
            echo -e "    \e[1;33m[!]\e[0m \e[0;37mNo graphical environment installed (Pure Server / CLI Mode).\e[0m"
            echo -e "    \e[1;33m[1]\e[0m \e[1;37mInstall an Official Desktop Environment (Hyprland, GNOME, etc.)\e[0m"
        end
    else
        if test "$dm_active" = "active"
            if test $is_es -eq 1
                printf "    \e[1;32m[1]\e[0m \e[0;37mVolver al Escritorio Gráfico (\e[1;32m%s\e[0m\e[0;37m)\e[0m\n" "$short_de"
                printf "    \e[1;31m[D]\e[0m \e[0;37mDetener Entorno Gráfico y liberar memoria RAM\e[0m\n"
            else
                printf "    \e[1;32m[1]\e[0m \e[0;37mReturn to Graphical Desktop (\e[1;32m%s\e[0m\e[0;37m)\e[0m\n" "$short_de"
                printf "    \e[1;31m[D]\e[0m \e[0;37mStop Graphical Environment and free RAM\e[0m\n"
            end
        else
            if test $is_es -eq 1
                printf "    \e[1;32m[1]\e[0m \e[0;37mIniciar %s\e[0m\n" "$desktop_names[1]"
            else
                printf "    \e[1;32m[1]\e[0m \e[0;37mStart %s\e[0m\n" "$desktop_names[1]"
            end
        end
        if test $is_es -eq 1
            echo -e "    \e[1;33m[I]\e[0m \e[1;37mInstalar o alternar a otro Entorno de Escritorio adicional\e[0m"
        else
            echo -e "    \e[1;33m[I]\e[0m \e[1;37mInstall or switch to another Desktop Environment\e[0m"
        end
    end

    # Section 3: Server & Maintenance Tools
    echo -e "\n  $border─────────────────────────────────────────────────────────────────────────────$reset"
    if test $is_es -eq 1
        echo -e "   $title HERRAMIENTAS DE SERVIDOR Y MANTENIMIENTO$reset"
    else
        echo -e "   $title SERVER & MAINTENANCE TOOLS$reset"
    end
    echo -e "  $border─────────────────────────────────────────────────────────────────────────────$reset"

    if test $is_es -eq 1
        printf "    \e[1;36m%-4s\e[0m \e[0;37m%-32s\e[0m \e[1;36m%-4s\e[0m \e[0;37m%-30s\e[0m\n" "[2]" "Monitor de Recursos (btop)" "[5]" "Diagnóstico y Red Wi-Fi"
        printf "    \e[1;36m%-4s\e[0m \e[0;37m%-32s\e[0m \e[1;36m%-4s\e[0m \e[0;37m%-30s\e[0m\n" "[3]" "Acceso Remoto SSH y Firewall" "[6]" "Mantenimiento y Limpieza"
        printf "    \e[1;36m%-4s\e[0m \e[0;37m%-32s\e[0m \e[1;36m%-4s\e[0m \e[0;37m%-30s\e[0m\n" "[4]" "Actualizar Sistema (Pacman)" "[7]" "Diagnóstico de Errores y Boot"
    else
        printf "    \e[1;36m%-4s\e[0m \e[0;37m%-32s\e[0m \e[1;36m%-4s\e[0m \e[0;37m%-30s\e[0m\n" "[2]" "Resource Monitor (btop)" "[5]" "Network & Wi-Fi Diagnostics"
        printf "    \e[1;36m%-4s\e[0m \e[0;37m%-32s\e[0m \e[1;36m%-4s\e[0m \e[0;37m%-30s\e[0m\n" "[3]" "Remote SSH & Firewall" "[6]" "Maintenance & Cleanup"
        printf "    \e[1;36m%-4s\e[0m \e[0;37m%-32s\e[0m \e[1;36m%-4s\e[0m \e[0;37m%-30s\e[0m\n" "[4]" "System Update (Pacman)" "[7]" "Error & Boot Diagnostics"
    end

    # Section 4: System Control
    echo -e "\n  $border─────────────────────────────────────────────────────────────────────────────$reset"
    if test $is_es -eq 1
        echo -e "   $title CONTROL DEL SISTEMA$reset"
    else
        echo -e "   $title SYSTEM CONTROL$reset"
    end
    echo -e "  $border─────────────────────────────────────────────────────────────────────────────$reset"

    if test $is_es -eq 1
        printf "    \e[1;36m%-4s\e[0m \e[0;37m%-32s\e[0m \e[1;36m%-4s\e[0m \e[0;37m%-30s\e[0m\n" "[8]" "Consola Pura (Fish Shell)" "[9]" "Reiniciar el Servidor"
        printf "    \e[1;36m%-4s\e[0m \e[0;37m%-32s\e[0m\n" "[0]" "Apagar el Servidor"
    else
        printf "    \e[1;36m%-4s\e[0m \e[0;37m%-32s\e[0m \e[1;36m%-4s\e[0m \e[0;37m%-30s\e[0m\n" "[8]" "Pure Console (Fish Shell)" "[9]" "Reboot System"
        printf "    \e[1;36m%-4s\e[0m \e[0;37m%-32s\e[0m\n" "[0]" "Shut Down System"
    end
    echo -e "  $border─────────────────────────────────────────────────────────────────────────────$reset"
end

function sanitize_user_dirs_and_configs
    # 1. Sincronizar configuraciones de /etc/skel/.config con sobrescritura para aplicar el tema del nuevo escritorio
    if test -d /etc/skel/.config
        mkdir -p $HOME/.config 2>/dev/null
        cp -rf /etc/skel/.config/. $HOME/.config/ 2>/dev/null
    end

    # 2. Inicializar y reparar directorios XDG según el idioma activo del sistema (evitando XDG_DESKTOP_DIR="$HOME")
    if type -q xdg-user-dirs-update
        xdg-user-dirs-update --force 2>/dev/null
    end

    if test $is_es -eq 1
        mkdir -p $HOME/Escritorio $HOME/Descargas $HOME/Documentos $HOME/Imágenes $HOME/Música $HOME/Plantillas $HOME/Público $HOME/Vídeos 2>/dev/null
        if test -f $HOME/.config/user-dirs.dirs
            sed -i 's|XDG_DESKTOP_DIR="\$HOME/\?"|XDG_DESKTOP_DIR="\$HOME/Escritorio"|g' $HOME/.config/user-dirs.dirs 2>/dev/null
            sed -i 's|XDG_TEMPLATES_DIR="\$HOME/\?"|XDG_TEMPLATES_DIR="\$HOME/Plantillas"|g' $HOME/.config/user-dirs.dirs 2>/dev/null
            sed -i 's|XDG_PUBLICSHARE_DIR="\$HOME/\?"|XDG_PUBLICSHARE_DIR="\$HOME/Público"|g' $HOME/.config/user-dirs.dirs 2>/dev/null
        end

        # 3. Unificar y limpiar carpetas duplicadas en inglés si el sistema está en español
        for pair in "Downloads:Descargas" "Pictures:Imágenes" "Videos:Vídeos" "Documents:Documentos" "Music:Música" "Desktop:Escritorio" "Templates:Plantillas" "Public:Público" "Projects:Proyectos"
            set -l en_dir (string split ":" $pair)[1]
            set -l es_dir (string split ":" $pair)[2]
            if test -d "$HOME/$en_dir"; and test -d "$HOME/$es_dir"
                # Mover cualquier archivo existente sin sobrescribir antes de eliminar el directorio vacío en inglés
                find "$HOME/$en_dir" -mindepth 1 -maxdepth 1 -exec mv -n '{}' "$HOME/$es_dir/" \; 2>/dev/null
                rmdir "$HOME/$en_dir" 2>/dev/null
            end
        end

        # Limpiar marcadores GTK rotos que apunten a carpetas en inglés ya unificadas
        if test -f $HOME/.config/gtk-3.0/bookmarks
            sed -i '/\/Downloads /d; /\/Pictures /d; /\/Videos /d; /\/Projects /d' $HOME/.config/gtk-3.0/bookmarks 2>/dev/null
        end
    else
        mkdir -p $HOME/Desktop $HOME/Downloads $HOME/Documents $HOME/Pictures $HOME/Music $HOME/Templates $HOME/Public $HOME/Videos 2>/dev/null
        if test -f $HOME/.config/user-dirs.dirs
            sed -i 's|XDG_DESKTOP_DIR="\$HOME/\?"|XDG_DESKTOP_DIR="\$HOME/Desktop"|g' $HOME/.config/user-dirs.dirs 2>/dev/null
            sed -i 's|XDG_TEMPLATES_DIR="\$HOME/\?"|XDG_TEMPLATES_DIR="\$HOME/Templates"|g' $HOME/.config/user-dirs.dirs 2>/dev/null
            sed -i 's|XDG_PUBLICSHARE_DIR="\$HOME/\?"|XDG_PUBLICSHARE_DIR="\$HOME/Public"|g' $HOME/.config/user-dirs.dirs 2>/dev/null
        end
    end

    # 4. Purgar cachés de iconos y de Plasma para garantizar carga limpia del tema de iconos activo
    rm -f $HOME/.cache/icon-cache.kcache $HOME/.cache/ksycoca6* 2>/dev/null
    rm -rf $HOME/.cache/plasmashell 2>/dev/null
end

function configure_desktop_boot_mode -a dm_service desktop_name
    sanitize_user_dirs_and_configs
    clear
    echo ""
    echo ""

    set -l border "\e[1;31m"
    set -l reset "\e[0m"
    set -l title "\e[1;37m"

    echo -e "  $border─────────────────────────────────────────────────────────────────────────────$reset"
    if test $is_es -eq 1
        echo -e "   $title CONFIGURACIÓN DE ARRANQUE DEL SISTEMA$reset"
    else
        echo -e "   $title SYSTEM BOOT CONFIGURATION$reset"
    end
    echo -e "  $border─────────────────────────────────────────────────────────────────────────────$reset\n"

    if test $is_es -eq 1
        echo -e "    \e[1;32m¡$desktop_name instalado con éxito!\e[0m\n"
        echo -e "    ¿Cómo deseas que arranque este equipo a partir de ahora?\n"
        echo -e "    \e[1;33m[1]\e[0m \e[1;37mModo Servidor / Consola (Recomendado)\e[0m"
        echo -e "        \e[0;37mArrancar siempre en el Centro de Mando TTY1 e iniciar el escritorio bajo demanda.\e[0m\n"
        echo -e "    \e[1;36m[2]\e[0m \e[1;37mModo Escritorio Completo (PC de uso diario)\e[0m"
        echo -e "        \e[0;37mArrancar automáticamente en la pantalla gráfica de inicio de sesión ($dm_service).\e[0m\n"
    else
        echo -e "    \e[1;32m$desktop_name installed successfully!\e[0m\n"
        echo -e "    How would you like this system to boot from now on?\n"
        echo -e "    \e[1;33m[1]\e[0m \e[1;37mServer / Console Mode (Recommended)\e[0m"
        echo -e "        \e[0;37mAlways boot into TTY1 Control Center and start desktop on demand.\e[0m\n"
        echo -e "    \e[1;36m[2]\e[0m \e[1;37mFull Desktop Mode (Daily Driver PC)\e[0m"
        echo -e "        \e[0;37mAutomatically boot into graphical login screen ($dm_service).\e[0m\n"
    end
    echo -e "  $border─────────────────────────────────────────────────────────────────────────────$reset"

    echo ""
    set -l prompt_boot (test $is_es -eq 1; and echo "  \e[1;31m> Selecciona el modo de arranque [1, 2]: \e[0m"; or echo "  \e[1;31m> Select boot mode [1, 2]: \e[0m")
    read -l -P (echo -e "$prompt_boot") boot_choice

    if test "$boot_choice" = "2"
        for other_dm in sddm gdm lightdm cosmic-greeter
            if test "$other_dm" != "$dm_service"
                sudo systemctl disable $other_dm 2>/dev/null
            end
        end
        sudo systemctl enable $dm_service
        sudo systemctl set-default graphical.target
        if test $is_es -eq 1
            echo -e "\n    \e[1;32m[OK] Modo Escritorio Automático activado ($dm_service habilitado al inicio).\e[0m"
        else
            echo -e "\n    \e[1;32m[OK] Automatic Desktop Mode activated ($dm_service enabled at boot).\e[0m"
        end
    else
        sudo systemctl disable $dm_service 2>/dev/null
        sudo systemctl set-default multi-user.target 2>/dev/null
        if test $is_es -eq 1
            echo -e "\n    \e[1;33m[OK] Modo Servidor / Consola preservado (TTY1 por defecto).\e[0m"
            echo -e "    \e[0;37mPodrás iniciar tu escritorio desde la opción [1] del Centro de Mando.\e[0m"
        else
            echo -e "\n    \e[1;33m[OK] Server / Console Mode preserved (TTY1 default).\e[0m"
            echo -e "    \e[0;37mYou can start your desktop anytime from option [1] in the Control Center.\e[0m"
        end
    end
    echo -e "\n  $border─────────────────────────────────────────────────────────────────────────────$reset"
    set -l prompt_back (test $is_es -eq 1; and echo "  Presiona Enter para volver..."; or echo "  Press Enter to return...")
    read -l -P "$prompt_back" dummy
end

function clean_previous_desktops -a target_id
    if test $is_es -eq 1
        echo -e "\n  \e[1;33m[*] Retirando entorno anterior para mantener la pureza del sistema...\e[0m"
    else
