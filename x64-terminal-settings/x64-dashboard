            if test -d $udir
                for wapp in (find $udir/.local/share/applications -maxdepth 1 -name "*.desktop" 2>/dev/null)
                    if grep -q "omarchy" $wapp 2>/dev/null
                        rm -f $wapp 2>/dev/null
                    end
                end
                rm -f $udir/.local/share/applications/foot.desktop $udir/.local/share/applications/imv.desktop $udir/.local/share/applications/mpv.desktop $udir/.local/share/applications/intent.cache 2>/dev/null
                update-desktop-database $udir/.local/share/applications 2>/dev/null
                rm -rf $udir/.config/omarchy $udir/.local/state/omarchy $udir/.cache/omarchy 2>/dev/null
                rm -rf $udir/.local/share/mise $udir/.config/mise $udir/.local/state/mise $udir/.cache/mise 2>/dev/null
                rm -rf $udir/.local/share/fcitx5/themes/omarchy 2>/dev/null
                rm -f $udir/.config/hypr/autostart.lua $udir/.config/hypr/bindings.lua $udir/.config/hypr/input.lua $udir/.config/hypr/looknfeel.lua $udir/.config/hypr/monitors.lua $udir/.config/hypr/xdph.conf $udir/.config/hypr/.luarc.json $udir/.config/hypr/hyprsunset.conf 2>/dev/null
                rm -f $udir/.config/systemd/user/*.wants/omarchy-* $udir/.config/systemd/user/*/*.wants/omarchy-* 2>/dev/null
                rm -f $udir/.config/uwsm/env.d/*omarchy* 2>/dev/null
                rm -f $udir/.config/nvim/lua/plugins/omarchy-theme-hotreload.lua 2>/dev/null
                find $udir/.config -name "com.omarchy.*" -delete 2>/dev/null
                rm -rf $udir/.agents/skills/omarchy* $udir/.claude/skills/omarchy* $udir/.claude/themes/omarchy* $udir/.codex/skills/omarchy* $udir/.pi/agent/skills/omarchy* $udir/.pi/agent/themes/omarchy* $udir/.gemini/config/skills/omarchy* $udir/.hermes/skills/omarchy* 2>/dev/null
                rmdir $udir/Fondos $udir/Temas $udir/Work/tries $udir/Work 2>/dev/null
            end
        end
    end

    if test "$target_id" != "2"; and test (count (pacman -Qq gnome-shell x64-gnome-settings 2>/dev/null)) -gt 0
        if test $is_es -eq 1
            echo -e "  \e[0;37m-> Desinstalando suite completa de GNOME...\e[0m"
