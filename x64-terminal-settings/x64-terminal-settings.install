post_install() {
    # Neutralizar auto-activacion de systemd-oomd por slices de cachyos-settings
    mkdir -p /etc/systemd/system/system.slice.d /etc/systemd/system/user-.slice.d
    ln -sf /dev/null /etc/systemd/system/system.slice.d/10-oomd-per-slice-defaults.conf
    ln -sf /dev/null /etc/systemd/system/user-.slice.d/10-oomd-per-slice-defaults.conf

    # Neutralizar systemd-backlight en GPUs Nvidia que fallan al escribir en sysfs
    for bl in /sys/class/backlight/nvidia_*; do
        if [ -d "$bl" ]; then
            devname=$(basename "$bl")
            systemctl mask "systemd-backlight@backlight:${devname}.service" 2>/dev/null || true
            systemctl stop "systemd-backlight@backlight:${devname}.service" 2>/dev/null || true
            systemctl reset-failed "systemd-backlight@backlight:${devname}.service" 2>/dev/null || true
        fi
    done
    systemctl reset-failed 2>/dev/null || true


    # Eliminar cualquier rastro de systemd-oomd generado por cachyos-settings
    rm -f /etc/systemd/system/multi-user.target.wants/systemd-oomd.service 2>/dev/null || true
    rm -f /etc/systemd/system/sockets.target.wants/systemd-oomd.socket 2>/dev/null || true
    rm -f /etc/systemd/system/dbus-org.freedesktop.oom1.service 2>/dev/null || true
    rm -f /etc/systemd/system/timers.target.wants/fwupd-refresh.timer 2>/dev/null || true

    # Neutralizar hooks de branding y reboot de cachyos-hooks y blindar identidad X64 LIOS
    mkdir -p /etc/pacman.d/hooks
    ln -sf /dev/null /etc/pacman.d/hooks/cachyos-branding.hook
    ln -sf /dev/null /etc/pacman.d/hooks/cachyos-reboot-required.hook
    ln -sf /dev/null /etc/pacman.d/hooks/os-release.hook
    ln -sf /dev/null /etc/pacman.d/hooks/lsb-release.hook

    cat << 'EOF' > /usr/lib/os-release
NAME="X64 LIOS Linux"
PRETTY_NAME="X64 LIOS Linux"
ID=x64lios
ID_LIKE=arch
BUILD_ID=rolling
ANSI_COLOR="38;2;255;0;0"
HOME_URL="https://x64lios.com/"
DOCUMENTATION_URL="https://x64lios.com/"
SUPPORT_URL="https://x64lios.com/"
BUG_REPORT_URL="https://x64lios.com/"
LOGO=x64lios
EOF
    ln -sf ../usr/lib/os-release /etc/os-release

    # Purgar cache de iconos de KDE / GTK para que kcm_about-distro muestre inmediatamente el Cubo 3D oficial (x64lios.png)
    if command -v gtk-update-icon-cache >/dev/null 2>&1; then
        gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true
    fi
    rm -f /home/*/.cache/icon-cache.kcache 2>/dev/null || true

    cat << 'EOF' > /etc/lsb-release
DISTRIB_ID="X64 LIOS"
DISTRIB_RELEASE="rolling"
DISTRIB_DESCRIPTION="X64 LIOS Linux"
EOF

    # Restaurar pre-login banner oficial X64 LIOS en /etc/issue
    if [ -f /usr/share/x64-lios/issue ]; then
        cp -f /usr/share/x64-lios/issue /etc/issue
    fi

    # Wrapper inteligente de Kitty para compatibilidad en maquinas virtuales (QEMU/KVM/VirtualBox/VMware/virtio-gpu)
    mkdir -p /usr/local/bin
    cat << 'EOF' > /usr/local/bin/kitty
#!/bin/bash
# X64 LIOS - Smart Kitty GPU/VM Wrapper
# On virtual machines with virtio-gpu/QEMU, virgl lacks 32-bit RGBA EGL configs for GLFW.
# Fallback to software rendering automatically on VMs while preserving 100% native GPU on bare-metal.

if [ -z "$LIBGL_ALWAYS_SOFTWARE" ]; then
    if grep -q -E "QEMU|VirtualBox|KVM|VMware" /sys/class/dmi/id/product_name /sys/class/dmi/id/sys_vendor 2>/dev/null; then
        export LIBGL_ALWAYS_SOFTWARE=1
    elif lspci 2>/dev/null | grep -qi "virtio.*gpu"; then
        export LIBGL_ALWAYS_SOFTWARE=1
    fi
fi

exec /usr/bin/kitty "$@"
EOF
    chmod 755 /usr/local/bin/kitty

    # Wrapper compatible con gamemoderun sin entrar en conflicto con el paquete falcond
    if [ ! -e /usr/bin/gamemoderun ]; then
        ln -sf /usr/bin/x64-gamemode /usr/local/bin/gamemoderun
    fi

    # Configurar parámetros de kernel (preempt=full siempre + Nvidia DRM solo si hay GPU Nvidia) en los 4 bootloaders oficiales (Limine, GRUB, systemd-boot, rEFInd)
    has_nvidia=0
    if command -v lspci >/dev/null 2>&1 && lspci 2>/dev/null | grep -qiE "(vga|3d|display).*nvidia"; then
        has_nvidia=1
    elif [ -d /proc/driver/nvidia ]; then
        has_nvidia=1
    fi

    # 1. Limine (/etc/default/limine)
    if [ -f /etc/default/limine ]; then
        limine_changed=0
        if [ "$has_nvidia" -eq 1 ] && ! grep -q "nvidia-drm.modeset=1" /etc/default/limine 2>/dev/null; then
            sed -i 's/splash rw/splash nvidia-drm.modeset=1 nvidia-drm.fbdev=1 rw/' /etc/default/limine 2>/dev/null || true
            sed -i 's/splash"$/ nvidia-drm.modeset=1 nvidia-drm.fbdev=1"/' /etc/default/limine 2>/dev/null || true
            limine_changed=1
        fi
        if ! grep -q "preempt=full" /etc/default/limine 2>/dev/null; then
            if grep -q "zswap.enabled=0" /etc/default/limine 2>/dev/null; then
                sed -i 's/zswap\.enabled=0/zswap.enabled=0 preempt=full/' /etc/default/limine 2>/dev/null || true
            else
                sed -i 's/^\(KERNEL_CMDLINE\[default\]+="[^"]*\)"/\1 preempt=full"/' /etc/default/limine 2>/dev/null || true
            fi
            limine_changed=1
        fi
        if [ "$limine_changed" -eq 1 ] && command -v limine-update >/dev/null 2>&1; then
            limine-update 2>/dev/null || true
        fi
    fi

    # 2. GRUB (/etc/default/grub)
    if [ -f /etc/default/grub ] && [ -f /boot/grub/grub.cfg ]; then
        grub_changed=0
        if ! grep -q "preempt=full" /etc/default/grub 2>/dev/null; then
            sed -i 's/^\(GRUB_CMDLINE_LINUX_DEFAULT="[^"]*\)"/\1 preempt=full"/' /etc/default/grub 2>/dev/null || true
            grub_changed=1
        fi
        if [ "$has_nvidia" -eq 1 ] && ! grep -q "nvidia-drm.modeset=1" /etc/default/grub 2>/dev/null; then
            sed -i 's/^\(GRUB_CMDLINE_LINUX_DEFAULT="[^"]*\)"/\1 nvidia-drm.modeset=1 nvidia-drm.fbdev=1"/' /etc/default/grub 2>/dev/null || true
            grub_changed=1
        fi
        if [ "$grub_changed" -eq 1 ] && command -v grub-mkconfig >/dev/null 2>&1; then
            grub-mkconfig -o /boot/grub/grub.cfg 2>/dev/null || true
        fi
    fi

    # 3. systemd-boot (/etc/kernel/cmdline y loader/entries/*.conf)
    if [ -f /etc/kernel/cmdline ]; then
        if ! grep -q "preempt=full" /etc/kernel/cmdline 2>/dev/null; then
            sed -i 's/[[:space:]]*$/ preempt=full/' /etc/kernel/cmdline 2>/dev/null || true
        fi
        if [ "$has_nvidia" -eq 1 ] && ! grep -q "nvidia-drm.modeset=1" /etc/kernel/cmdline 2>/dev/null; then
            sed -i 's/[[:space:]]*$/ nvidia-drm.modeset=1 nvidia-drm.fbdev=1/' /etc/kernel/cmdline 2>/dev/null || true
        fi
    fi
    for entry in /boot/efi/loader/entries/*.conf /boot/loader/entries/*.conf; do
        if [ -f "$entry" ]; then
            if ! grep -q "preempt=full" "$entry" 2>/dev/null; then
                sed -i '/^options / s/[[:space:]]*$/ preempt=full/' "$entry" 2>/dev/null || true
            fi
            if [ "$has_nvidia" -eq 1 ] && ! grep -q "nvidia-drm.modeset=1" "$entry" 2>/dev/null; then
                sed -i '/^options / s/[[:space:]]*$/ nvidia-drm.modeset=1 nvidia-drm.fbdev=1/' "$entry" 2>/dev/null || true
            fi
        fi
    done

    # 4. rEFInd (/boot/refind_linux.conf)
    if [ -f /boot/refind_linux.conf ]; then
        if ! grep -q "preempt=full" /boot/refind_linux.conf 2>/dev/null; then
            sed -i '/^[[:space:]]*"/ s/"$/ preempt=full"/' /boot/refind_linux.conf 2>/dev/null || true
        fi
        if [ "$has_nvidia" -eq 1 ] && ! grep -q "nvidia-drm.modeset=1" /boot/refind_linux.conf 2>/dev/null; then
            sed -i '/^[[:space:]]*"/ s/"$/ nvidia-drm.modeset=1 nvidia-drm.fbdev=1"/' /boot/refind_linux.conf 2>/dev/null || true
        fi
    fi

    # Asegurar grupo i2c para usuarios reales (DDC/CI sin errores en powerdevil)
    getent group i2c >/dev/null || groupadd -r i2c 2>/dev/null || true
    for u in $(awk -F: '$3 >= 1000 && $3 < 60000 {print $1}' /etc/passwd); do
        usermod -aG i2c "$u" 2>/dev/null || true
    done

    # Desactivar servicios nvidia-suspend/resume (evita Kernel Oops en nvidia-sleep.sh / uvm_suspend y delega al kernel + hook system-sleep)
    systemctl disable nvidia-suspend.service nvidia-resume.service nvidia-hibernate.service 2>/dev/null || true

    # Habilitar FalconD bajo multi-user.target (funciona tanto en Modo Consola TTY1 como en Modo Escritorio)
    if [ -x /usr/bin/falcond ]; then
        rm -f /etc/systemd/system/graphical.target.wants/falcond.service 2>/dev/null || true
        mkdir -p /etc/systemd/system/multi-user.target.wants
        ln -sf /etc/systemd/system/falcond.service /etc/systemd/system/multi-user.target.wants/falcond.service
    fi

    # Habilitar dmemcg-booster (SteamOS/Valve VRAM cgroup protection integrado con FalconD)
    if [ -f /usr/lib/systemd/system/dmemcg-booster-system.service ]; then
        mkdir -p /etc/systemd/system/multi-user.target.wants
        ln -sf /usr/lib/systemd/system/dmemcg-booster-system.service /etc/systemd/system/multi-user.target.wants/dmemcg-booster-system.service
    fi
    if [ -f /usr/lib/systemd/user/dmemcg-booster-user.service ]; then
        mkdir -p /etc/systemd/user/graphical-session-pre.target.wants
        ln -sf /usr/lib/systemd/user/dmemcg-booster-user.service /etc/systemd/user/graphical-session-pre.target.wants/dmemcg-booster-user.service
    fi

    # Habilitar thermald SOLO en CPUs Intel bare-metal (evita spawn innecesario en AMD Ryzen o VMs)
    is_intel_baremetal=0
    if grep -q "GenuineIntel" /proc/cpuinfo 2>/dev/null; then
        if ! command -v systemd-detect-virt >/dev/null 2>&1 || ! systemd-detect-virt --quiet 2>/dev/null; then
            is_intel_baremetal=1
        fi
    fi
    if [ "$is_intel_baremetal" -eq 1 ] && [ -f /usr/lib/systemd/system/thermald.service ]; then
        mkdir -p /etc/systemd/system/multi-user.target.wants
        ln -sf /usr/lib/systemd/system/thermald.service /etc/systemd/system/multi-user.target.wants/thermald.service
        ln -sf /usr/lib/systemd/system/thermald.service /etc/systemd/system/dbus-org.freedesktop.thermald.service
    else
        rm -f /etc/systemd/system/multi-user.target.wants/thermald.service \
              /etc/systemd/system/dbus-org.freedesktop.thermald.service 2>/dev/null || true
    fi

    # Aplicar reglas udev de baja latencia (NVMe ADIOS, USB HID anti-autosuspend, cpu_dma_latency)
    if command -v udevadm >/dev/null 2>&1; then
        udevadm control --reload-rules 2>/dev/null || true
        udevadm trigger --subsystem-match=block --subsystem-match=usb --subsystem-match=misc 2>/dev/null || true
    fi

    # Permitir puertos de descubrimiento y transferencia de KDE Connect / GSConnect (1714:1764 UDP/TCP) en el firewall UFW
    if [ -f /etc/ufw/user.rules ] && ! grep -q "1714:1764" /etc/ufw/user.rules 2>/dev/null; then
        sed -i '/^### END RULES ###/i ### tuple ### allow udp 1714:1764 0.0.0.0/0 any 0.0.0.0/0 in\n-A ufw-user-input -p udp -m multiport --dports 1714:1764 -j ACCEPT\n\n### tuple ### allow tcp 1714:1764 0.0.0.0/0 any 0.0.0.0/0 in\n-A ufw-user-input -p tcp -m multiport --dports 1714:1764 -j ACCEPT\n' /etc/ufw/user.rules 2>/dev/null || true
    fi
    if [ -f /etc/ufw/user6.rules ] && ! grep -q "1714:1764" /etc/ufw/user6.rules 2>/dev/null; then
        sed -i '/^### END RULES ###/i ### tuple ### allow udp 1714:1764 ::/0 any ::/0 in\n-A ufw6-user-input -p udp -m multiport --dports 1714:1764 -j ACCEPT\n\n### tuple ### allow tcp 1714:1764 ::/0 any ::/0 in\n-A ufw6-user-input -p tcp -m multiport --dports 1714:1764 -j ACCEPT\n' /etc/ufw/user6.rules 2>/dev/null || true
    fi
    if [ -d /run/systemd/system ] && command -v ufw >/dev/null 2>&1; then
        ufw allow 1714:1764/udp >/dev/null 2>&1 || true
        ufw allow 1714:1764/tcp >/dev/null 2>&1 || true
        if systemctl is-active --quiet ufw.service 2>/dev/null; then
            ufw reload >/dev/null 2>&1 || true
        fi
    fi

    # Migrar flags obsoletos de scx_flash/scx_bpfland en /etc/scx_loader/config.toml preservando la selección del usuario
    scx_cfg_migrated=0
    if [ -f /etc/scx_loader/config.toml ] && grep -qE '"-w", "-C", "0"|"-S", "500"|"-S", "1000"' /etc/scx_loader/config.toml 2>/dev/null; then
        cur_sched=$(grep -E '^[[:space:]]*default_sched[[:space:]]*=' /etc/scx_loader/config.toml 2>/dev/null | head -n1 || true)
        cur_mode=$(grep -E '^[[:space:]]*default_mode[[:space:]]*=' /etc/scx_loader/config.toml 2>/dev/null | head -n1 || true)
        {
            echo "# =============================================================================="
            echo "# X64 LIOS Linux - sched_ext (scx_loader) Low-Latency Gaming Profile"
            echo "# Protected via Pacman backup=() so user selections from X64 Hello persist."
            echo "# Scheduler mode flags are managed natively by scx_loader so scx-scheds updates"
            echo "# never break flag compatibility across scx_lavd, scx_bpfland, scx_cosmos,"
            echo "# scx_flash, or scx_rusty."
            echo "# =============================================================================="
            if [ -n "$cur_sched" ]; then
                echo "$cur_sched"
                if [ -n "$cur_mode" ]; then
                    echo "$cur_mode"
                else
                    echo 'default_mode = "Auto"'
                fi
            else
                echo "# Default scheduler at boot (BORE kernel default active; managed dynamically by FalconD)"
                echo '# default_sched = "scx_lavd"'
                echo '# default_mode = "Gaming"'
            fi
        } > /etc/scx_loader/config.toml
        scx_cfg_migrated=1
    fi

    # Recargar systemd y activar FalconD + dmemcg-booster + thermald (Intel) + scx_loader en vivo si no hay chroot
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload 2>/dev/null || true
        if [ -f /usr/lib/systemd/system/dmemcg-booster-system.service ]; then
            systemctl start dmemcg-booster-system.service 2>/dev/null || true
        fi
        if [ "$is_intel_baremetal" -eq 1 ] && [ -f /usr/lib/systemd/system/thermald.service ]; then
            systemctl start thermald.service 2>/dev/null || true
        fi
        if [ -x /usr/bin/falcond ]; then
            systemctl restart falcond.service 2>/dev/null || true
        fi
        if systemctl is-active --quiet scx_loader.service 2>/dev/null; then
            if [ "$scx_cfg_migrated" -eq 1 ]; then
                systemctl restart scx_loader.service 2>/dev/null || true
            elif grep -qE '^[[:space:]]*default_sched[[:space:]]*=' /etc/scx_loader/config.toml 2>/dev/null; then
                cur_ops=$(cat /sys/kernel/sched_ext/root/ops 2>/dev/null || true)
                if [ -z "$cur_ops" ] || [ "$cur_ops" = "none" ]; then
                    systemctl restart scx_loader.service 2>/dev/null || true
                fi
            fi
        fi
    fi

    # Regenerar initramfs para aplicar Early KMS de Nvidia
    if command -v mkinitcpio >/dev/null 2>&1; then
        mkinitcpio -P 2>/dev/null || true
    fi
}

post_upgrade() {
    post_install
}

post_remove() {
    rm -f /usr/local/bin/kitty 2>/dev/null || true
    if [ -L /usr/local/bin/gamemoderun ] && [ "$(readlink /usr/local/bin/gamemoderun)" = "/usr/bin/x64-gamemode" ]; then
        rm -f /usr/local/bin/gamemoderun 2>/dev/null || true
    fi
}


