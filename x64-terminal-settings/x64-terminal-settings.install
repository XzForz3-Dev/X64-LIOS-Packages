post_install() {
    # Neutralizar auto-activacion de systemd-oomd por slices de cachyos-settings
    mkdir -p /etc/systemd/system/system.slice.d /etc/systemd/system/user-.slice.d
    ln -sf /dev/null /etc/systemd/system/system.slice.d/10-oomd-per-slice-defaults.conf
    ln -sf /dev/null /etc/systemd/system/user-.slice.d/10-oomd-per-slice-defaults.conf

    # Eliminar cualquier rastro de systemd-oomd generado por cachyos-settings
    rm -f /etc/systemd/system/multi-user.target.wants/systemd-oomd.service 2>/dev/null || true
    rm -f /etc/systemd/system/sockets.target.wants/systemd-oomd.socket 2>/dev/null || true
    rm -f /etc/systemd/system/dbus-org.freedesktop.oom1.service 2>/dev/null || true
    rm -f /etc/systemd/system/timers.target.wants/fwupd-refresh.timer 2>/dev/null || true

    # Neutralizar hooks de branding y reboot de cachyos-hooks y blindar identidad X64 LIOS
    mkdir -p /etc/pacman.d/hooks
    ln -sf /dev/null /etc/pacman.d/hooks/cachyos-branding.hook
    ln -sf /dev/null /etc/pacman.d/hooks/cachyos-reboot-required.hook
    ln -sf /dev/null /etc/pacman.d/hooks/os-release.hook
    ln -sf /dev/null /etc/pacman.d/hooks/lsb-release.hook

    cat << 'EOF' > /usr/lib/os-release
NAME="X64 LIOS Linux"
PRETTY_NAME="X64 LIOS Linux"
ID=x64lios
ID_LIKE=arch
BUILD_ID=rolling
ANSI_COLOR="38;2;255;0;0"
HOME_URL="https://x64lios.com/"
DOCUMENTATION_URL="https://x64lios.com/"
SUPPORT_URL="https://x64lios.com/"
BUG_REPORT_URL="https://x64lios.com/"
LOGO=x64-logo
EOF
    ln -sf ../usr/lib/os-release /etc/os-release

    cat << 'EOF' > /etc/lsb-release
DISTRIB_ID="X64 LIOS"
DISTRIB_RELEASE="rolling"
DISTRIB_DESCRIPTION="X64 LIOS Linux"
EOF

    # Restaurar pre-login banner oficial X64 LIOS en /etc/issue
    if [ -f /usr/share/x64-lios/issue ]; then
        cp -f /usr/share/x64-lios/issue /etc/issue
    fi

    # Wrapper inteligente de Kitty para compatibilidad en maquinas virtuales (QEMU/KVM/VirtualBox/VMware/virtio-gpu)
    mkdir -p /usr/local/bin
    cat << 'EOF' > /usr/local/bin/kitty
#!/bin/bash
# X64 LIOS - Smart Kitty GPU/VM Wrapper
# On virtual machines with virtio-gpu/QEMU, virgl lacks 32-bit RGBA EGL configs for GLFW.
# Fallback to software rendering automatically on VMs while preserving 100% native GPU on bare-metal.

if [ -z "$LIBGL_ALWAYS_SOFTWARE" ]; then
    if grep -q -E "QEMU|VirtualBox|KVM|VMware" /sys/class/dmi/id/product_name /sys/class/dmi/id/sys_vendor 2>/dev/null; then
        export LIBGL_ALWAYS_SOFTWARE=1
    elif lspci 2>/dev/null | grep -qi "virtio.*gpu"; then
        export LIBGL_ALWAYS_SOFTWARE=1
    fi
fi

exec /usr/bin/kitty "$@"
EOF
    chmod 755 /usr/local/bin/kitty
}

post_upgrade() {
    post_install
}

post_remove() {
    rm -f /usr/local/bin/kitty 2>/dev/null || true
}


