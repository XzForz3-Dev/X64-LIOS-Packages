post_install() {
    gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true
    systemctl --global enable x64-update-tray.service 2>/dev/null || true
    systemctl --global enable x64-update.timer 2>/dev/null || true
    echo "==> x64-update instalado con éxito."
    echo "==> Servicio x64-update-tray habilitado como centinela en segundo plano."
}

post_upgrade() {
    post_install
}

post_remove() {
    gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true
    systemctl --global disable x64-update-tray.service 2>/dev/null || true
    systemctl --global disable x64-update.timer 2>/dev/null || true
}

