# Maintainer: X64 Studios <dev@x64lios.com>
pkgname=x64-update
pkgver=1.0.0
pkgrel=36
pkgdesc="Notificador y gestor de actualizaciones del sistema para X64 LIOS"
arch=('any')
url="https://x64lios.com"
license=('GPL-3.0-or-later')
depends=(
    'python'
    'python-pyqt6'
    'pacman-contrib'
    'archlinux-contrib'
    'libnotify'
)
optdepends=(
    'paru: Soporte de comprobación y actualización de paquetes AUR'
    'yay: Soporte de comprobación y actualización de paquetes AUR'
    'flatpak: Soporte de comprobación y actualización de aplicaciones Flatpak'
    'kitty: Terminal recomendada para la ejecución interactiva'
)
provides=('cachy-update' 'arch-update')
conflicts=('cachy-update' 'arch-update')
replaces=('cachy-update' 'arch-update')
install=x64-update.install
source=(
    'x64-update'
    'x64-update-tray'
    'x64-update.desktop'
    'x64-update-tray.desktop'
    'x64-update.service'
    'x64-update.timer'
    'x64-update-tray.service'
    '90-x64-update-tray.preset'
)
sha256sums=('06bde52aa89fa1c004526339220468aa5139795567cfa654a3500e7e703c452b'
            'b3fa8cd5ea28115e84ce1573d1967a78f2dc023f088c9eff1425b4acf4d96f38'
            'd79151c6b310521a0c4ae374862b2b7d3130662f06a8819d74724a6b899934d9'
            'e8dc06813b80282aa71644d23c36a550dbe6416546902fb2876d12517c60047c'
            '03115e1d57d880038c40576becaf51ee3e3c9e4d43ead98d1a838746958e9a58'
            'e69a6d44aa34f682a9ad6e3aa72a838cec08bfae33a96b1476489591e45dfad5'
            'b4e7c70b6b209022ee6f5f319ff4964265130a92153620e9d9235f6f3b30575f'
            'c2a74593722aee3400d35d11c15bd89149a7ef74514a73f489ddeb685d0f6375')

package() {
    # Binaries
    install -Dm755 "${srcdir}/x64-update" "${pkgdir}/usr/bin/x64-update"
    install -Dm755 "${srcdir}/x64-update-tray" "${pkgdir}/usr/bin/x64-update-tray"

    # Compatibility symlink
    ln -sf /usr/bin/x64-update "${pkgdir}/usr/bin/cachy-update"
    ln -sf /usr/bin/x64-update "${pkgdir}/usr/bin/arch-update"

    # Desktop entries
    install -Dm644 "${srcdir}/x64-update.desktop" "${pkgdir}/usr/share/applications/x64-update.desktop"
    install -Dm644 "${srcdir}/x64-update-tray.desktop" "${pkgdir}/etc/xdg/autostart/x64-update-tray.desktop"

    # Systemd user services & presets
    install -Dm644 "${srcdir}/x64-update.service" "${pkgdir}/usr/lib/systemd/user/x64-update.service"
    install -Dm644 "${srcdir}/x64-update.timer" "${pkgdir}/usr/lib/systemd/user/x64-update.timer"
    install -Dm644 "${srcdir}/x64-update-tray.service" "${pkgdir}/usr/lib/systemd/user/x64-update-tray.service"
    install -Dm644 "${srcdir}/90-x64-update-tray.preset" "${pkgdir}/usr/lib/systemd/user-preset/90-x64-update-tray.preset"

    # Icons
    for size in 16 22 24 32 48 64 128 256 500; do
        if [ -f "${startdir}/icons/${size}x${size}/apps/x64-update.png" ]; then
            install -Dm644 "${startdir}/icons/${size}x${size}/apps/x64-update.png" \
                "${pkgdir}/usr/share/icons/hicolor/${size}x${size}/apps/x64-update.png"
            install -Dm644 "${startdir}/icons/${size}x${size}/apps/x64-update-available.png" \
                "${pkgdir}/usr/share/icons/hicolor/${size}x${size}/apps/x64-update-available.png"
        fi
    done

    # Pixmaps fallback
    install -Dm644 "${startdir}/icons/500x500/apps/x64-update.png" "${pkgdir}/usr/share/pixmaps/x64-update.png"
    install -Dm644 "${startdir}/icons/500x500/apps/x64-update-available.png" "${pkgdir}/usr/share/pixmaps/x64-update-available.png"
}

