        def _update_chip_styles(self, tot, crit_cnt, repo_cnt, aur_cnt, fp_cnt):
            p = self.palette
            counts = {
                self.f_all: tot,
                self.f_crit: crit_cnt,
                self.f_repo: repo_cnt,
                self.f_aur: aur_cnt,
                self.f_fp: fp_cnt,
            }
            for btn, cnt in counts.items():
                fg = p['foreground'] if cnt > 0 else p['muted']
                bg = p['lighter_background'] if cnt > 0 else p['dark_background']
                bdr = p['accent_hover'] if cnt > 0 else p['card_border']
                btn.setStyleSheet(f"""
                    QPushButton {{
                        background-color: {bg};
                        color: {fg};
                        border: 1px solid {bdr};
                        border-radius: 8px;
                        padding: 0px 14px;
                        font-weight: 600;
                        font-size: 12px;
                    }}
                    QPushButton:hover {{
                        background-color: {p['selection']};
                        color: {p['foreground']};
                    }}
                    QPushButton:checked {{
                        background-color: {p['accent']};
                        color: #ffffff;
                        border: 1px solid {p['accent_hover']};
                        font-weight: 700;
                    }}
                """)

