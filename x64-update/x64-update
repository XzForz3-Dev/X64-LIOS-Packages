            print(f"\n{C_YELLOW}{C_BOLD}  ⚠️  ADVERTENCIA DE CIBERSEGURIDAD Y CONTROLADORES:{C_RESET}")
            print(f"{C_YELLOW}  Se han actualizado el Kernel Linux o módulos del sistema.{C_RESET}")
            print(f"{C_YELLOW}  Para aplicar las mejoras y mantener la máxima estabilidad gráfica,{C_RESET}")
            print(f"{C_YELLOW}  se recomienda reiniciar el equipo.{C_RESET}")
    else:
        print(f"{C_RED}{C_BOLD}  ╔════════════════════════════════════════════════════════════════════════════╗{C_RESET}")
        print(f"{C_RED}{C_BOLD}  ║  ✗  EL PROCESO TERMINÓ CON ADVERTENCIAS O ERRORES (Código: {main_ret})        ║{C_RESET}")
        print(f"{C_RED}{C_BOLD}  ╚════════════════════════════════════════════════════════════════════════════╝{C_RESET}")
        print(f"  {C_WHITE}Revise los mensajes de error mostrados arriba para más detalles.{C_RESET}")

    wait_for_user()
    return main_ret

def main():
    parser = argparse.ArgumentParser(description="Gestor de actualizaciones X64 LIOS")
    parser.add_argument("-c", "--check", action="store_true", help="Comprobar actualizaciones en segundo plano")
    parser.add_argument("-n", "--notify", action="store_true", help="Enviar notificación de escritorio si hay actualizaciones")
    parser.add_argument("-l", "--list", action="store_true", help="Listar paquetes pendientes")
    parser.add_argument("--count", action="store_true", help="Mostrar número de actualizaciones pendientes")

    args = parser.parse_args()

    # Fast non-interactive count query
    if args.count:
        if os.path.exists(COUNT_FILE):
            try:
                with open(COUNT_FILE, "r", encoding="utf-8") as f:
                    print(f.read().strip())
                    return 0
            except Exception:
                pass
        data = run_background_check_and_save()
        print(data["count"])
        return 0

    # Fast non-interactive list query
    if args.list:
        if os.path.exists(PACKAGES_FILE):
            try:
                with open(PACKAGES_FILE, "r", encoding="utf-8") as f:
                    print(f.read().strip())
                    return 0
            except Exception:
                pass
        data = run_background_check_and_save()
        for p in data["all"]:
            print(p)
        return 0

    # Fast non-interactive check (used by timer, tray and cron)
    if args.check:
        data = run_background_check_and_save()
        count = data["count"]
        print(f"X64 LIOS: {count} actualizaciones disponibles.")
        if args.notify and count > 0:
            if shutil.which("notify-send"):
                icon_arg = ["-i", "x64-update-available"]
                msg = f"Hay {count} actualización(es) disponibles para instalar."
                subprocess.run(
                    ["notify-send", "-a", "X64 LIOS", "-u", "normal"] + icon_arg + ["Actualizaciones disponibles", msg],
                    check=False
                )
        return 0

    # Interactive Terminal UI
    return run_interactive()

if __name__ == "__main__":
    sys.exit(main())
