def get_telemetry():
    kernel = "Linux Desconocido"
    try:
        raw_k = subprocess.check_output(["uname", "-r"], text=True).strip()
        # Cleanse distro branding from kernel string
        raw_k = raw_k.replace("-cachyos", "").replace("cachyos", "")
        kernel = raw_k
    except Exception:
        pass

    arch = "x86_64"
    try:
        arch = subprocess.check_output(["uname", "-m"], text=True).strip()
    except Exception:
        pass

    uptime_str = "Desconocido"
    try:
        with open("/proc/uptime", "r") as f:
            secs = float(f.readline().split()[0])
            h = int(secs // 3600)
            m = int((secs % 3600) // 60)
            uptime_str = f"{h}h {m}m" if h > 0 else f"{m}m"
    except Exception:
        pass

    hostname = "x64-pc"
    try:
        hostname = subprocess.check_output(["uname", "-n"], text=True).strip()
    except Exception:
        pass

    return {
        "kernel": kernel,
        "arch": arch,
        "uptime": uptime_str,
        "hostname": hostname
    }

def print_telemetry_box():
    t = get_telemetry()
    box_w = 75
    line_content = f"  {C_CYAN}Equipo:{C_RESET} {C_WHITE}{t['hostname']}{C_RESET}     {C_CYAN}Kernel:{C_RESET} {C_WHITE}{t['kernel']}{C_RESET}     {C_CYAN}Uptime:{C_RESET} {C_WHITE}{t['uptime']}{C_RESET}"
    
    # Calculate visible length (without ANSI codes)
    visible_content = f"  Equipo: {t['hostname']}     Kernel: {t['kernel']}     Uptime: {t['uptime']}"
    pad = max(0, box_w - len(visible_content))

    print(f"{C_GRAY}  ┌{'─' * box_w}┐{C_RESET}")
    print(f"{C_GRAY}  │{C_RESET}{line_content}{' ' * pad}{C_GRAY}│{C_RESET}")
    print(f"{C_GRAY}  └{'─' * box_w}┘{C_RESET}")
    print()

class Spinner:
    def __init__(self, message="Procesando..."):
        self.message = message
        self.frames = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"]
        self.stop_event = threading.Event()
        self.thread = None

    def _animate(self):
        idx = 0
        while not self.stop_event.is_set():
            frame = self.frames[idx % len(self.frames)]
            sys.stdout.write(f"\r  {C_CYAN}[ {frame} ]{C_RESET} {self.message} ")
            sys.stdout.flush()
            idx += 1
            time.sleep(0.08)
        sys.stdout.write("\r" + " " * (len(self.message) + 16) + "\r")
        sys.stdout.flush()

    def start(self):
        self.stop_event.clear()
        self.thread = threading.Thread(target=self._animate, daemon=True)
        self.thread.start()

    def stop(self, final_msg="", is_alert=False):
        self.stop_event.set()
        if self.thread:
            self.thread.join()
        if final_msg:
            # Check mark in green for clean status
            icon = f"{C_YELLOW}[ ! ]{C_RESET}" if is_alert else f"{C_GREEN}[ ✓ ]{C_RESET}"
            print(f"  {icon} {final_msg}")

def check_official_repos():
    repo_pkgs = []
    if not shutil.which("checkupdates"):
        return repo_pkgs

    tmp_db = tempfile.mkdtemp(prefix="x64-checkupdates-")
    env = os.environ.copy()
    env["CHECKUPDATES_DB"] = tmp_db
    try:
        res = subprocess.run(
            ["checkupdates"],
            env=env,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=50
        )
        for line in res.stdout.strip().splitlines():
            line = line.strip()
            if line:
                repo_pkgs.append(line)
    except Exception:
        pass
    finally:
        shutil.rmtree(tmp_db, ignore_errors=True)

    return repo_pkgs

def check_aur_packages():
    aur_pkgs = []
    aur_helper = None
    if shutil.which("paru"):
        aur_helper = "paru"
    elif shutil.which("yay"):
        aur_helper = "yay"

    if not aur_helper:
        return aur_pkgs

    try:
        res = subprocess.run(
            [aur_helper, "-Qua"],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=45
        )
        for line in res.stdout.strip().splitlines():
            line = line.strip()
            if line and not line.endswith("[ignored]"):
                aur_pkgs.append(line)
    except Exception:
        pass

    return aur_pkgs

def check_flatpak_packages():
    flatpak_pkgs = []
    if not shutil.which("flatpak"):
        return flatpak_pkgs

    try:
        res = subprocess.run(
            ["flatpak", "remote-ls", "--updates", "--columns=name,application,version"],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=30
        )
        for line in res.stdout.strip().splitlines():
            parts = line.strip().split("\t")
            if parts and parts[0]:
                name = parts[0]
                ver = parts[2] if len(parts) > 2 else ""
                flatpak_pkgs.append(f"{name} {ver}".strip())
    except Exception:
        pass

    return flatpak_pkgs

def run_background_check_and_save():
    ensure_state_dir()
    repo_pkgs = check_official_repos()
    aur_pkgs = check_aur_packages()
    flatpak_pkgs = check_flatpak_packages()

    all_pkgs = []
    for p in repo_pkgs:
        all_pkgs.append(p)
    for p in aur_pkgs:
        all_pkgs.append(f"{p} (AUR)")
    for p in flatpak_pkgs:
        all_pkgs.append(f"{p} (Flatpak)")

    total_count = len(all_pkgs)

    try:
        with open(COUNT_FILE, "w", encoding="utf-8") as f:
            f.write(f"{total_count}\n")
        with open(PACKAGES_FILE, "w", encoding="utf-8") as f:
            for p in all_pkgs:
                f.write(f"{p}\n")
        with open(LAST_CHECK_FILE, "w", encoding="utf-8") as f:
            f.write(f"{time.time()}\n")
    except Exception:
        pass

    return {
        "repo": repo_pkgs,
        "aur": aur_pkgs,
        "flatpak": flatpak_pkgs,
        "all": all_pkgs,
        "count": total_count
    }

def is_critical_package(name):
    lower = name.lower()
    critical_stems = [
        "linux", "kernel", "nvidia", "mesa", "vulkan", "systemd",
        "glibc", "pipewire", "wayland", "dracut", "mkinitcpio",
        "grub", "limine", "refind", "btrfs", "zfs", "scx"
    ]
    for stem in critical_stems:
        if stem in lower:
            return True
    return False

def parse_pkg_line(line):
    parts = line.split()
    if len(parts) >= 4 and parts[2] == "->":
        pkg = parts[0]
        old_v = parts[1]
        new_v = parts[3]
        return pkg, f"{old_v} ➔ {new_v}"
    elif len(parts) >= 2:
        return parts[0], " ".join(parts[1:])
    return line, ""

def render_package_table(repo_pkgs, aur_pkgs, flatpak_pkgs):
    items = []
    for line in repo_pkgs:
        p, trans = parse_pkg_line(line)
        items.append((p, trans, "Oficial", C_CYAN))
    for line in aur_pkgs:
        p, trans = parse_pkg_line(line)
        items.append((p, trans, "AUR", C_MAGENTA))
    for line in flatpak_pkgs:
        p, trans = parse_pkg_line(line)
        items.append((p, trans, "Flatpak", C_BLUE))

    shown_count = 0
    max_display = 28
    visible_items = items[:max_display]

    # Cálculo dinámico de ancho de columnas para garantizar alineación absoluta
    max_p_len = max([len(p) for p, _, _, _ in visible_items], default=15)
    col_name_w = max(28, max_p_len + 6)

    max_trans_len = max([len(trans) for _, trans, _, _ in visible_items], default=20)
    col_trans_w = max(32, max_trans_len + 4)

    col_type_w = 15

    header_top = f"{C_GRAY}  ┌{'─' * col_name_w}┬{'─' * col_trans_w}┬{'─' * col_type_w}┐{C_RESET}"
    header_mid = f"{C_GRAY}  ├{'─' * col_name_w}┼{'─' * col_trans_w}┼{'─' * col_type_w}┤{C_RESET}"
    header_bot = f"{C_GRAY}  └{'─' * col_name_w}┴{'─' * col_trans_w}┴{'─' * col_type_w}┘{C_RESET}"

    hdr_name = "PAQUETE"
    hdr_trans = "TRANSICIÓN DE VERSIÓN"
    hdr_type = "TIPO / ORIGEN"

    print(header_top)
    print(f"{C_GRAY}  │{C_RESET} {C_WHITE}{C_BOLD}{hdr_name:<{col_name_w-2}}{C_RESET} "
          f"{C_GRAY}│{C_RESET} {C_WHITE}{C_BOLD}{hdr_trans:<{col_trans_w-2}}{C_RESET} "
          f"{C_GRAY}│{C_RESET} {C_WHITE}{C_BOLD}{hdr_type:<{col_type_w-2}}{C_RESET} {C_GRAY}│{C_RESET}")
    print(header_mid)

    has_critical = False

    for p, trans, orig, col in visible_items:
        shown_count += 1
        is_crit = is_critical_package(p)
        if is_crit:
            has_critical = True
        tag = f"{C_YELLOW}[!] {C_RESET}" if is_crit else "    "
        pkg_display = (tag + f"{col}{p}{C_RESET}")
        raw_name_len = len(p) + 4
        pad_name = max(0, col_name_w - 2 - raw_name_len)

        raw_trans_len = len(trans)
        pad_trans = max(0, col_trans_w - 2 - raw_trans_len)

        raw_orig_len = len(orig)
        pad_orig = max(0, col_type_w - 2 - raw_orig_len)

        print(f"{C_GRAY}  │{C_RESET} {pkg_display}{' ' * pad_name} "
              f"{C_GRAY}│{C_RESET} {C_WHITE}{trans}{C_RESET}{' ' * pad_trans} "
              f"{C_GRAY}│{C_RESET} {col}{orig}{C_RESET}{' ' * pad_orig} {C_GRAY}│{C_RESET}")

    if len(items) > max_display:
        diff = len(items) - max_display
        tot_w = col_name_w + col_trans_w + col_type_w + 2
        msg = f"... y {diff} paquetes adicionales pendientes de actualización"
        pad = max(0, tot_w - len(msg) - 2)
        print(header_mid)
        print(f"{C_GRAY}  │{C_RESET} {C_GRAY}{msg}{' ' * pad}{C_RESET} {C_GRAY}│{C_RESET}")

    print(header_bot)
    if has_critical:
        print(f"  {C_YELLOW}[!] {C_WHITE}Componente crítico del sistema {C_CYAN}(Kernel, Core, Drivers, Schedulers){C_RESET}")
    print()

