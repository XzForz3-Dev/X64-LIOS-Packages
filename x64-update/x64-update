def load_theme_palette():
    palette = dict(DEFAULT_PALETTE)
    theme_file = os.path.expanduser("~/.local/state/omarchy/current/theme/colors.toml")
    if not os.path.isfile(theme_file):
        return palette

    raw = {}
    try:
        import tomllib
        with open(theme_file, "rb") as f:
            raw = tomllib.load(f)
    except Exception:
        try:
            with open(theme_file, "r", encoding="utf-8") as f:
                for line in f:
                    line = line.strip()
                    if "=" in line and not line.startswith("#"):
                        k, v = line.split("=", 1)
                        raw[k.strip()] = v.strip().strip('"').strip("'")
        except Exception:
            return palette

    mode = str(raw.get("mode", "dark")).lower()
    palette["mode"] = mode

    accent = raw.get("accent") or raw.get("red") or raw.get("color1") or "#dc2626"
    palette["accent"] = accent

    if mode == "light":
        palette["accent_hover"] = blend_colors(accent, "#000000", 0.15)
        palette["accent_subtle"] = blend_colors(accent, "#000000", 0.30)
    else:
        palette["accent_hover"] = raw.get("bright_accent") or raw.get("bright_red") or blend_colors(accent, "#ffffff", 0.18)
        palette["accent_subtle"] = blend_colors(accent, "#000000", 0.35)

    bg = raw.get("background") or raw.get("bg") or raw.get("color0") or ("#ffffff" if mode == "light" else "#09090d")
    palette["background"] = bg

    dark_bg = raw.get("dark_background") or (blend_colors(bg, "#000000", 0.04) if mode == "light" else blend_colors(bg, "#000000", 0.25))
    palette["dark_background"] = dark_bg
    palette["darker_background"] = raw.get("darker_background") or dark_bg

