    class TransactionWorker(QThread):
        output_received = pyqtSignal(str)
        stage_changed = pyqtSignal(str, int) # (stage_text, percent)
        transaction_done = pyqtSignal(bool, int, bool) # (success, exit_code, kernel_updated)

        def __init__(self, commands, password=None):
            super().__init__()
            self.commands = commands
            self.password = password
            self.master_fd = None
            self.proc = None
            self.kernel_updated = False

        def run(self):
            askpass_path = None
            if self.password:
                try:
                    askpass_path = f"/tmp/.x64-askpass-{os.getuid()}-{os.getpid()}"
                    with open(askpass_path, "w", encoding="utf-8") as af:
                        af.write("#!/bin/sh\nprintf '%s\\n' \"$X64_SUDO_SECRET\"\n")
                    os.chmod(askpass_path, 0o700)
                except Exception:
                    askpass_path = None

            master, slave = pty.openpty()
            self.master_fd = master

            # Set PTY window size (32 rows, 104 columns) so pacman/ncurses format progress bars cleanly inside log_view
            try:
                winsize = struct.pack("HHHH", 32, 104, 0, 0)
                fcntl.ioctl(slave, termios.TIOCSWINSZ, winsize)
            except Exception:
                pass

            env = os.environ.copy()
            env["TERM"] = "xterm-256color"
            env["COLUMNS"] = "104"
            env["LINES"] = "32"
            env["LC_ALL"] = "C.UTF-8"
            if askpass_path and self.password:
                env["SUDO_ASKPASS"] = askpass_path
                env["X64_SUDO_SECRET"] = self.password

            sudo_bin = "sudo -A" if (askpass_path and self.password) else "sudo"

            # 1. Pre-stamp PTY sudo ticket + auto-unlock stale /var/lib/pacman/db.lck inside the PTY session
            preamble = (
                f"if [ -n \"${{SUDO_ASKPASS:-}}\" ]; then {sudo_bin} -v >/dev/null 2>&1; fi; "
                f"if [ -e /var/lib/pacman/db.lck ] && ! pgrep -x pacman >/dev/null 2>&1; then "
                f"printf '\\033[1;33m::\\033[0;1m Detectado candado huérfano /var/lib/pacman/db.lck (sin procesos activos). Desbloqueando...\\033[0m\\r\\n'; "
                f"{sudo_bin} rm -f /var/lib/pacman/db.lck; "
                f"fi"
            )
            cmd_str = f"set -e; {preamble}; " + " && ".join(self.commands) + "; sync"

            def _setup_pty_session():
                os.setsid()
                try:
                    fcntl.ioctl(0, termios.TIOCSCTTY, 0)
                except Exception:
                    pass

            self.stage_changed.emit("Iniciando transacción de paquetes...", 10)

            try:
                self.proc = subprocess.Popen(
                    ["bash", "-e", "-c", cmd_str],
                    stdin=slave,
                    stdout=slave,
                    stderr=slave,
                    env=env,
                    preexec_fn=_setup_pty_session,
                    close_fds=True
                )
                os.close(slave)

                while True:
                    try:
                        data = os.read(master, 1024)
                        if not data:
                            break
                        text = data.decode("utf-8", errors="replace")
                        self.output_received.emit(text)

                        # Detect critical kernel / driver replacements
                        low = text.lower()
                        if "vmlinuz" in low or "initramfs" in low or "linux-cachyos" in low or "nvidia" in low:
                            self.kernel_updated = True

                        if "retrieving" in low or "recuperando" in low or "downloading" in low or "descargando" in low:
                            self.stage_changed.emit("Descargando paquetes de repositorios...", 35)
                        elif "checking keyring" in low or "comprobando el depósito" in low:
                            self.stage_changed.emit("Verificando claves y firmas de seguridad...", 55)
                        elif "checking package integrity" in low or "verificando la integridad" in low:
                            self.stage_changed.emit("Verificando integridad de archivos...", 65)
                        elif "upgrading" in low or "actualizando" in low or "installing" in low or "instalando" in low:
                            self.stage_changed.emit("Instalando y descomprimiendo paquetes...", 75)
                        elif "running post-transaction hooks" in low or "ejecutando" in low or "hooks" in low:
                            self.stage_changed.emit("Ejecutando ganchos del sistema (initramfs, kernel)...", 90)

                    except OSError:
                        break

                os.close(master)
                ret = self.proc.wait() if self.proc else 1
            except Exception as e:
                self.output_received.emit(f"\nError interno ejecutando transacción: {e}\n")
                ret = 1
            finally:
                if askpass_path and os.path.exists(askpass_path):
                    try:
                        os.remove(askpass_path)
                    except Exception:
                        pass

            # 7. Exact CachyOS kernel reboot check: verify if running kernel's vmlinuz was replaced
            try:
                running_kernel_vmlinuz = f"/usr/lib/modules/{os.uname().release}/vmlinuz"
                if not os.path.isfile(running_kernel_vmlinuz):
                    self.kernel_updated = True
            except Exception:
                pass

            success = (ret == 0)
            if success:
                # Immediately clear state files so tray icon updates to "up to date" without delay
                try:
                    ensure_state_dir()
                    with open(COUNT_FILE, "w", encoding="utf-8") as f:
                        f.write("0\n")
                    with open(PACKAGES_FILE, "w", encoding="utf-8") as f:
                        f.write("")
                except Exception:
                    pass
                self.stage_changed.emit("¡Transacción finalizada con éxito!", 100)
                run_background_check_and_save()
            else:
                self.stage_changed.emit(f"Transacción abortada con código: {ret}", 100)

            self.transaction_done.emit(success, ret, self.kernel_updated)

