            self.table.setSortingEnabled(True)

        def start_inapp_transaction(self):
            # Check if passwordless sudo (NOPASSWD) or a session-verified password is already available for a new PTY
            nopasswd_sudo = (
                subprocess.run(
                    ["setsid", "sudo", "-n", "-v"],
                    stdin=subprocess.DEVNULL,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL
                ).returncode == 0
            )
            cached_sudo = nopasswd_sudo or bool(getattr(self, "_session_sudo_pwd", None))

            # Count total items and breakdown by category
            items_count = len(self.all_items)
            crit_count = sum(1 for item in self.all_items if item.get("crit", False))
            breakdown = {
                "x64": sum(1 for item in self.all_items if item.get("x64", False)),
                "repo": sum(1 for item in self.all_items if item.get("type") == "Sistema" and not item.get("x64", False)),
                "aur": sum(1 for item in self.all_items if item.get("type") == "AUR" and not item.get("x64", False)),
                "fp": sum(1 for item in self.all_items if item.get("type") == "Flatpak"),
            }

            dlg = ConfirmDialog(items_count, crit_count, cached_sudo, self, breakdown=breakdown, palette=self.palette)
            if dlg.exec() != QDialog.DialogCode.Accepted:
                return # User canceled
            if dlg.get_password():
                self._session_sudo_pwd = dlg.get_password()
            password = getattr(self, "_session_sudo_pwd", None)
            sudo_cmd = "sudo -A" if password else "sudo"

            # Assemble transaction commands (CachyOS-grade separated & automated pipeline)
            aur_helper = "paru" if shutil.which("paru") else ("yay" if shutil.which("yay") else None)
            has_repo_updates = any(item.get("type") == "Sistema" for item in self.all_items)
            has_aur_updates = any(item.get("type") == "AUR" for item in self.all_items)
            has_fp_updates = any(item.get("type") == "Flatpak" for item in self.all_items)
            has_omarchy = os.path.isdir("/usr/share/omarchy/.git")

            commands = []
            display_cmds = []

            # 1. Sincronización previa del repositorio Git de Omarchy
            if has_omarchy:
                commands.append(
                    "{ if [ -d /usr/share/omarchy/.git ]; then "
                    "printf '\\033[1;36m[+]\\033[0;1m Sincronizando Capa X64 LIOS + Omarchy desde Git...\\033[0m\\n'; "
                    f"{sudo_cmd} git -C /usr/share/omarchy pull origin main || true; "
                    "fi; }"
                )
                display_cmds.append("sudo git -C /usr/share/omarchy pull origin main")

            # 3. Separate Pacman (-Syu) and AUR (-Sua) execution
            if has_repo_updates or (not has_aur_updates and not has_fp_updates):
                commands.append(f"{sudo_cmd} pacman -Syu --noconfirm")
                display_cmds.append("sudo pacman -Syu --noconfirm")

            if has_aur_updates and aur_helper:
                sudo_flags = "--sudoflags -A " if password else ""
                commands.append(f"{aur_helper} -Sua --noconfirm {sudo_flags}".strip())
                display_cmds.append(f"{aur_helper} -Sua --noconfirm")

            # 4. Flatpak update + unused runtime cleanup
            if has_fp_updates and shutil.which("flatpak"):
                commands.append("{ flatpak update -y && flatpak uninstall --unused -y; }")
                display_cmds.append("flatpak update -y && flatpak uninstall --unused -y")

            # 5. Automatic orphan packages cleanup (pacman -Qtdq -> pacman -Rns)
            commands.append(
                "{ orphans=$(pacman -Qtdq 2>/dev/null || true); "
                "if [ -n \"$orphans\" ]; then "
                "printf '\\033[1;34m::\\033[0;1m Eliminando paquetes huérfanos...\\033[0m\\n'; "
                f"{sudo_cmd} pacman -Rns --noconfirm $orphans; "
                "fi; }"
            )

            # 6. Automatic smart Pacman cache cleanup (paccache -rk2 -ruk0, keeping 2 rollback versions)
            if shutil.which("paccache"):
                commands.append(
                    "{ printf '\\033[1;34m::\\033[0;1m Optimizando caché de paquetes (conservando últimas 2 versiones)...\\033[0m\\n' && "
                    f"{sudo_cmd} paccache -rk2 -q && {sudo_cmd} paccache -ruk0 -q; }}"
                )

            # 7a. Recarga en caliente y sincronización de herramientas en Omarchy
            if has_omarchy:
                commands.append(
                    "{ if [ -x /usr/share/omarchy/bin/omarchy-update-restart ]; then "
                    "printf '\\033[1;36m[+]\\033[0;1m Recargando plugins y entorno de escritorio X64 LIOS + Omarchy...\\033[0m\\n'; "
                    "/usr/share/omarchy/bin/omarchy-update-restart || true; "
                    "fi; "
                    "if [ -x /usr/share/omarchy/bin/omarchy-update-mise ]; then "
                    "printf '\\033[1;36m[+]\\033[0;1m Actualizando herramientas y agentes IA (Mise)...\\033[0m\\n'; "
                    "/usr/share/omarchy/bin/omarchy-update-mise || true; "
                    "fi; }"
                )
                display_cmds.append("omarchy-update-restart && omarchy-update-mise")

            # 7b. Safe post-upgrade daemon restart (checkservices excluding display/session managers)
            if shutil.which("checkservices"):
                commands.append(
                    f"{{ svcs=$({sudo_cmd} checkservices -F -P -R "
                    "-i gdm.service -i plasmalogin.service -i sddm.service -i lightdm.service "
                    "-i lxdm.service -i slim.service -i xdm.service -i greetd.service "
                    "-i nodm.service -i ly.service -i lemurs.service -i dbus.service "
                    "-i systemd-logind.service -i NetworkManager.service 2>/dev/null "
                    "| grep '.service' | cut -f2 -d \"'\" || true); "
                    "if [ -n \"$svcs\" ]; then "
                    "printf '\\033[1;34m::\\033[0;1m Reiniciando servicios de segundo plano actualizados...\\033[0m\\n'; "
                    f"{sudo_cmd} systemctl restart $svcs || true; "
                    "fi; }"
                )

            # Switch to In-App Transaction View
            self.stacked_widget.setCurrentIndex(1)
            cmd_display = " && ".join(display_cmds).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
            header_html = (
                f"<div style=\"color: #ef4444; font-weight: bold; font-family: 'JetBrainsMono Nerd Font', 'Noto Sans Mono', monospace; font-size: 12px;\">"
                f"[X64 LIOS UPDATE] INICIANDO TRANSACCIÓN DE ACTUALIZACIÓN DEL SISTEMA...</div>"
                f"<div style=\"color: #71717a; font-family: 'JetBrainsMono Nerd Font', 'Noto Sans Mono', monospace; font-size: 12px;\">"
                f"Comandos: {cmd_display}</div>"
                f"<div style=\"color: #222230; font-family: 'JetBrainsMono Nerd Font', 'Noto Sans Mono', monospace; font-size: 12px; margin-bottom: 6px;\">"
                f"{'─' * 104}</div>"
            )
            self.vt_screen = Vt100Screen(header_html=header_html)
            self.vt_last_render = 0.0
            if not hasattr(self, "vt_render_timer"):
                self.vt_render_timer = QTimer(self)
                self.vt_render_timer.setSingleShot(True)
                self.vt_render_timer.timeout.connect(self.flush_vt_render)
            self.log_view.setHtml(self.vt_screen.to_html())

            # Reset header and transaction state
            self.lbl_live.setText("EN VIVO")
            self.lbl_live.setStyleSheet("background-color: #ef4444; color: #ffffff; font-weight: 900; font-size: 12px; padding: 2px 8px; border-radius: 4px;")
            self.lbl_tx_title.setText("ACTUALIZACIÓN DEL SISTEMA EN PROGRESO")
            self.lbl_tx_stage.setText("Inicializando transacción de paquetes...")
            self.lbl_tx_stage.setStyleSheet("color: #38bdf8; font-size: 13px; font-weight: bold;")
            self.lbl_tx_status.setText("⏳ Ejecutando comandos de actualización...")
            self.lbl_tx_status.setStyleSheet("color: #ffffff; font-weight: bold; font-size: 13px;")

            self.btn_tx_done.setEnabled(False)
            self.btn_tx_done.setText("Procesando...")
            self.btn_tx_done.setStyleSheet("""
                QPushButton {
                    background: #181822;
                    color: #555566;
                    border: 1px solid #222230;
                    border-radius: 8px;
                    padding: 10px 24px;
                    font-weight: bold;
                    font-size: 13px;
                }
            """)
            self.btn_tx_reboot.setVisible(False)
            self.tx_progress.setValue(10)
            self.tx_progress.setStyleSheet("""
                QProgressBar {
                    background-color: #14141e;
                    border: 1px solid #252536;
                    border-radius: 4px;
                }
                QProgressBar::chunk {
                    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #ff1a1a, stop:0.7 #f59e0b, stop:1 #22c55e);
                    border-radius: 4px;
                }
            """)
            self.tx_start_time = time.time()
            self.timer_elapsed.start(1000)

            # Start worker thread
            self.tx_worker = TransactionWorker(commands, password)
            self.tx_worker.output_received.connect(self.on_tx_output)
            self.tx_worker.stage_changed.connect(self.on_tx_stage)
            self.tx_worker.transaction_done.connect(self.on_tx_finished)
            self.tx_worker.start()

        def flush_vt_render(self):
            if not hasattr(self, "vt_screen"):
                return
            self.vt_last_render = time.time()
            self.log_view.setHtml(self.vt_screen.to_html())
            vbar = self.log_view.verticalScrollBar()
            vbar.setValue(vbar.maximum())
            hbar = self.log_view.horizontalScrollBar()
            hbar.setValue(0)

        def on_tx_output(self, raw_text):
            if not hasattr(self, "vt_screen"):
                self.vt_screen = Vt100Screen()
            self.vt_screen.feed(raw_text)
            now = time.time()
            if now - getattr(self, "vt_last_render", 0.0) >= 0.025:
                if hasattr(self, "vt_render_timer") and self.vt_render_timer.isActive():
                    self.vt_render_timer.stop()
                self.flush_vt_render()
            else:
                if hasattr(self, "vt_render_timer") and not self.vt_render_timer.isActive():
                    self.vt_render_timer.start(25)

