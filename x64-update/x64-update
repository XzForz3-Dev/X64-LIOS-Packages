        def verify_and_confirm(self):
            if not self.cached_sudo:
                pwd = self.pwd_input.text()
                if not pwd:
                    self.lbl_error.setText("Por favor, ingresa tu contraseña.")
                    self.lbl_error.setVisible(True)
                    return

                p = subprocess.run(
                    ["sudo", "-S", "-v"],
                    input=f"{pwd}\n".encode(),
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL
                )
                if p.returncode == 0:
                    self.accept()
                else:
                    self.lbl_error.setText("✕ Contraseña incorrecta. Inténtalo de nuevo.")
                    self.lbl_error.setVisible(True)
                    self.pwd_input.selectAll()
                    self.pwd_input.setFocus()
            else:
                self.accept()

        def get_password(self):
            return self.pwd_input.text() if self.pwd_input else None

