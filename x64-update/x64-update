def wait_for_user(msg="Presione [Enter] para cerrar esta ventana..."):
    print()
    try:
        input(f"  {C_CYAN}▶{C_RESET} {C_WHITE}{msg}{C_RESET} ")
    except (KeyboardInterrupt, EOFError):
