        def update_elapsed_time(self):
            elapsed = int(time.time() - self.tx_start_time)
            mins = elapsed // 60
            secs = elapsed % 60
            self.lbl_elapsed.setText(f"⏱ Tiempo: {mins:02d}:{secs:02d}")

        def load_cached_state(self):
            if not os.path.exists(PACKAGES_FILE):
                return
            try:
                lines = []
                with open(PACKAGES_FILE, "r", encoding="utf-8") as f:
                    lines = [l.strip() for l in f if l.strip()]
                
                repo_l = [l for l in lines if not l.endswith("(AUR)") and not l.endswith("(Flatpak)")]
                aur_l  = [l.replace(" (AUR)", "") for l in lines if l.endswith("(AUR)")]
                fp_l   = [l.replace(" (Flatpak)", "") for l in lines if l.endswith("(Flatpak)")]

                self.populate_items(repo_l, aur_l, fp_l)
            except Exception:
                pass

        def trigger_refresh(self):
            if self.check_worker and self.check_worker.isRunning():
                return
            self.prog_bar.setVisible(True)
            self.btn_refresh.setEnabled(False)
            self.btn_refresh.setText("Analizando...")

            self.check_worker = CheckWorker()
            self.check_worker.finished.connect(self.on_check_finished)
            self.check_worker.start()

        def on_check_finished(self, data):
            self.prog_bar.setVisible(False)
            self.btn_refresh.setEnabled(True)
            self.btn_refresh.setText("⟳ Comprobar")

            self.populate_items(data["repo"], data["aur"], data["flatpak"])

        def populate_items(self, repo_pkgs, aur_pkgs, flatpak_pkgs):
            self.all_items = []
            
            for line in repo_pkgs:
                p, old_v, new_v = parse_pkg_line(line)
                is_crit = is_critical_package(p)
                self.all_items.append({
                    "pkg": p,
                    "old_v": old_v,
                    "new_v": new_v,
                    "type": "Oficial",
                    "crit": is_crit
                })

            for line in aur_pkgs:
                p, old_v, new_v = parse_pkg_line(line)
                is_crit = is_critical_package(p)
                self.all_items.append({
                    "pkg": p,
                    "old_v": old_v,
                    "new_v": new_v,
                    "type": "AUR",
                    "crit": is_crit
                })

            for line in flatpak_pkgs:
                p, old_v, new_v = parse_pkg_line(line)
                self.all_items.append({
                    "pkg": p,
                    "old_v": old_v,
                    "new_v": new_v,
                    "type": "Flatpak",
                    "crit": False
                })

            self.all_items.sort(key=lambda x: (0 if x["crit"] else 1, x["pkg"]))

            tot = len(self.all_items)
            crit_cnt = sum(1 for x in self.all_items if x["crit"])
            repo_cnt = sum(1 for x in self.all_items if x["type"] == "Oficial")
            aur_cnt  = sum(1 for x in self.all_items if x["type"] == "AUR")
            fp_cnt   = sum(1 for x in self.all_items if x["type"] == "Flatpak")

            self.f_all.setText(f"Todos ({tot})")
            self.f_crit.setText(f"Críticos ({crit_cnt})")
            self.f_repo.setText(f"Oficiales ({repo_cnt})")
            self.f_aur.setText(f"AUR ({aur_cnt})")
            self.f_fp.setText(f"Flatpak ({fp_cnt})")

            self.chk_aur.setVisible(aur_cnt > 0)
            self.chk_flatpak.setVisible(fp_cnt > 0)

            if tot == 0:
                self.lbl_summary.setText("No hay actualizaciones pendientes.")
                self.btn_update.setEnabled(False)
                self.btn_update.setText("⚡ Sistema al Día")
                self.table.setVisible(False)
                self.zero_card.setVisible(True)
            else:
                crit_msg = f" • <span style='color: #ffb822;'>{crit_cnt} componentes críticos</span>" if crit_cnt > 0 else ""
                self.lbl_summary.setText(f"📦 <b>{tot}</b> paquetes detectados para actualización{crit_msg}")
                self.btn_update.setEnabled(True)
                self.btn_update.setText(f"⚡ Actualizar Sistema ({tot})")
                self.table.setVisible(True)
                self.zero_card.setVisible(False)

            self.apply_filter()

        def on_filter_clicked(self):
            sender = self.sender()
            if sender:
                self.active_filter = sender.property("filter")
                self.apply_filter()

        def apply_filter(self):
            query = self.search_input.text().strip().lower()

            self.table.setSortingEnabled(False)
            self.table.setRowCount(0)

            for item in self.all_items:
                if self.active_filter == "crit" and not item["crit"]:
                    continue
                if self.active_filter == "repo" and item["type"] != "Oficial":
                    continue
                if self.active_filter == "aur" and item["type"] != "AUR":
                    continue
                if self.active_filter == "fp" and item["type"] != "Flatpak":
                    continue

                if query:
                    if query not in item["pkg"].lower() and query not in item["new_v"].lower():
                        continue

                row = self.table.rowCount()
                self.table.insertRow(row)

                # Col 0: Badge / Type
                tag_text = " [!] Crítico " if item["crit"] else f"  {item['type']}  "
                tag_item = QTableWidgetItem(tag_text)
                tag_item.setTextAlignment(Qt.AlignmentFlag.AlignCenter)
                tag_font = QFont()
                tag_font.setBold(True)
                tag_font.setPointSize(10)
                tag_item.setFont(tag_font)
                if item["crit"]:
                    tag_item.setForeground(QColor("#ffb822"))
                    tag_item.setBackground(QColor("#2d1f05"))
                elif item["type"] == "Oficial":
                    tag_item.setForeground(QColor("#38bdf8"))
                    tag_item.setBackground(QColor("#06202e"))
                elif item["type"] == "AUR":
                    tag_item.setForeground(QColor("#e879f9"))
                    tag_item.setBackground(QColor("#2d0633"))
                else:
                    tag_item.setForeground(QColor("#818cf8"))
                    tag_item.setBackground(QColor("#0d0d38"))
                self.table.setItem(row, 0, tag_item)

                # Col 1: Package Name
                p_item = QTableWidgetItem(item["pkg"])
                p_font = QFont()
                p_font.setBold(True)
                p_item.setFont(p_font)
                p_item.setForeground(QColor("#ffffff"))
                self.table.setItem(row, 1, p_item)

                # Col 2: Current Version
                old_item = QTableWidgetItem(item["old_v"] if item["old_v"] else "—")
                old_item.setForeground(QColor("#9292a4"))
                self.table.setItem(row, 2, old_item)

                # Col 3: New Version
                new_str = f"➔ {item['new_v']}" if item["new_v"] else "disponible"
                new_item = QTableWidgetItem(new_str)
                new_item.setForeground(QColor("#22c55e") if not item["crit"] else QColor("#ffb822"))
                n_font = QFont()
                n_font.setBold(True)
                new_item.setFont(n_font)
                self.table.setItem(row, 3, new_item)

            self.table.setSortingEnabled(True)

        def start_inapp_transaction(self):
            # Check if sudo credentials are required
            cached_sudo = (subprocess.run(["sudo", "-n", "-v"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0)

            # Count total items and critical components
            items_count = len(self.all_items)
            crit_count = sum(1 for item in self.all_items if item.get("crit", False))

            dlg = ConfirmDialog(items_count, crit_count, cached_sudo, self)
            if dlg.exec() != QDialog.DialogCode.Accepted:
                return # User canceled
            password = dlg.get_password()

            # Assemble transaction commands
            aur_enabled = self.chk_aur.isChecked() and self.chk_aur.isVisible()
            fp_enabled = self.chk_flatpak.isChecked() and self.chk_flatpak.isVisible()
            clean_cache = self.chk_clean.isChecked()

            aur_helper = "paru" if shutil.which("paru") else ("yay" if shutil.which("yay") else None)

            commands = []
            if aur_enabled and aur_helper:
                commands.append(f"{aur_helper} -Syu --noconfirm")
            else:
                commands.append("sudo pacman -Syu --noconfirm")

            if fp_enabled and shutil.which("flatpak"):
                commands.append("flatpak update -y")

            if clean_cache:
                commands.append("sudo pacman -Sc --noconfirm")

            # Switch to In-App Transaction View
            self.stacked_widget.setCurrentIndex(1)
            cmd_display = " && ".join(commands).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
            header_html = (
                f"<div style=\"color: #ef4444; font-weight: bold; font-family: 'JetBrainsMono Nerd Font', 'Noto Sans Mono', monospace; font-size: 12px;\">"
                f"[X64 LIOS UPDATE] INICIANDO TRANSACCIÓN DE ACTUALIZACIÓN DEL SISTEMA...</div>"
                f"<div style=\"color: #71717a; font-family: 'JetBrainsMono Nerd Font', 'Noto Sans Mono', monospace; font-size: 12px;\">"
                f"Comandos: {cmd_display}</div>"
                f"<div style=\"color: #222230; font-family: 'JetBrainsMono Nerd Font', 'Noto Sans Mono', monospace; font-size: 12px; margin-bottom: 6px;\">"
                f"{'─' * 104}</div>"
            )
            self.vt_screen = Vt100Screen(header_html=header_html)
            self.vt_last_render = 0.0
            if not hasattr(self, "vt_render_timer"):
                self.vt_render_timer = QTimer(self)
                self.vt_render_timer.setSingleShot(True)
                self.vt_render_timer.timeout.connect(self.flush_vt_render)
            self.log_view.setHtml(self.vt_screen.to_html())

            # Reset header and transaction state
            self.lbl_live.setText("EN VIVO")
            self.lbl_live.setStyleSheet("background-color: #ef4444; color: #ffffff; font-weight: 900; font-size: 12px; padding: 2px 8px; border-radius: 4px;")
            self.lbl_tx_title.setText("ACTUALIZACIÓN DEL SISTEMA EN PROGRESO")
            self.lbl_tx_stage.setText("Inicializando transacción de paquetes...")
            self.lbl_tx_stage.setStyleSheet("color: #38bdf8; font-size: 13px; font-weight: bold;")
            self.lbl_tx_status.setText("⏳ Ejecutando comandos de actualización...")
            self.lbl_tx_status.setStyleSheet("color: #ffffff; font-weight: bold; font-size: 13px;")

            self.btn_tx_done.setEnabled(False)
            self.btn_tx_done.setText("Procesando...")
