        pkg_display = f"{tag}{col}{p_str}{C_RESET}{' ' * pad_name}"

        max_t_w = col_trans_w - 2
        t_str = trans if len(trans) <= max_t_w else trans[:max_t_w-2] + ".."
        pad_trans = max(0, max_t_w - len(t_str))

        max_o_w = col_type_w - 2
        o_str = orig[:max_o_w]
        pad_orig = max(0, max_o_w - len(o_str))

        print(f"{C_GRAY}  │{C_RESET} {pkg_display} "
              f"{C_GRAY}│{C_RESET} {C_WHITE}{t_str}{C_RESET}{' ' * pad_trans} "
              f"{C_GRAY}│{C_RESET} {col}{o_str}{C_RESET}{' ' * pad_orig} {C_GRAY}│{C_RESET}")

    print(header_bot)
    print()

    print(f"{C_WHITE}{C_BOLD}  OPCIONES DE ACTUALIZACIÓN:{C_RESET}")
    print(f"   {C_RED}[1]{C_RESET} {C_WHITE}Actualizar TODO el sistema ahora (Recomendado: Oficial + AUR + Flatpak){C_RESET}")
    print(f"   {C_RED}[2]{C_RESET} {C_WHITE}Solo repositorios oficiales{C_RESET}")
    print(f"   {C_RED}[3]{C_RESET} {C_WHITE}Actualizar y purgar caché de paquetes (pacman -Sc){C_RESET}")
    print(f"   {C_RED}[4]{C_RESET} {C_LIGHT}Cancelar y salir{C_RESET}\n")

    choice = "1"
    try:
        raw_choice = input(f"  {C_CYAN}Seleccione una opción [1-4] (por defecto 1): {C_RESET}").strip()
        if raw_choice:
            choice = raw_choice
    except (KeyboardInterrupt, EOFError):
        print(f"\n  {C_YELLOW}Operación cancelada.{C_RESET}")
        return 0

    if choice == "4":
        return 0

    aur_helper = "paru" if shutil.which("paru") else ("yay" if shutil.which("yay") else None)
    cmds = []
    if choice in ["1", "3"] and aur_helper:
        cmds.append(f"{aur_helper} -Syu")
    else:
        cmds.append("sudo pacman -Syu")

    if choice == "1" and shutil.which("flatpak") and len(flatpak_pkgs) > 0:
        cmds.append("flatpak update -y")

    if choice == "3":
        cmds.append("sudo pacman -Sc --noconfirm")

    subprocess.run(" && ".join(cmds), shell=True)
    run_background_check_and_save()
    wait_for_user()
    return 0


# ==============================================================================
# MAIN ENTRYPOINT
# ==============================================================================

def main():
    parser = argparse.ArgumentParser(description="x64-update: Gestor Oficial de Actualizaciones de X64 LIOS")
    parser.add_argument("--check", action="store_true", help="Comprueba en segundo plano y actualiza el estado")
    parser.add_argument("--cli", action="store_true", help="Fuerza la ejecución en terminal/CLI interactivo")
    args, unknown = parser.parse_known_args()

    if args.check:
        run_background_check_and_save()
        return 0

    has_display = bool(os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY"))

    if args.cli or not has_display:
        return run_cli_interactive()

    try:
        run_gui()
    except Exception as e:
        print(f"Error iniciando GUI PyQt6: {e}. Entrando a modo terminal...")
        return run_cli_interactive()

if __name__ == "__main__":
    sys.exit(main() or 0)
