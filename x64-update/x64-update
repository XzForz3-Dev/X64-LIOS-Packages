    class BadgeDelegate(QStyledItemDelegate):
        """Renders rounded pill badges inside Column 0 without breaking QTableWidget sorting."""
        def __init__(self, parent=None, palette=None):
            super().__init__(parent)
            self.palette = palette or {}

        def update_palette(self, palette):
            self.palette = palette

        def paint(self, painter, option, index):
            painter.save()
            painter.setRenderHint(QPainter.RenderHint.Antialiasing)

            sel_bg = self.palette.get("selection", "#1f1218")
            hover_bg = self.palette.get("lighter_background", "#161622")
            bdr_line = self.palette.get("card_border", "#171723")

            # Draw row selection/hover background if active
            if option.state & QStyle.StateFlag.State_Selected:
                painter.fillRect(option.rect, QColor(sel_bg))
            elif option.state & QStyle.StateFlag.State_MouseOver:
                painter.fillRect(option.rect, QColor(hover_bg))

            # Draw subtle horizontal bottom row separator to match columns 1..3
            painter.setPen(QPen(QColor(bdr_line), 1.0))
            painter.drawLine(option.rect.bottomLeft(), option.rect.bottomRight())

            meta = index.data(Qt.ItemDataRole.UserRole)
            if isinstance(meta, dict):
                label = meta.get("label", "")
                fg = QColor(meta.get("fg", "#38bdf8"))
                bg = QColor(meta.get("bg", "#092030"))
                border = QColor(meta.get("border", "#123b56"))

                font = QFont(option.font)
                font.setPixelSize(11)
                font.setBold(True)
                painter.setFont(font)

                pill_w = 86
                pill_h = 24
                x = option.rect.x() + (option.rect.width() - pill_w) / 2.0
                y = option.rect.y() + (option.rect.height() - pill_h) / 2.0
                pill_rect = QRectF(x, y, pill_w, pill_h)

                painter.setBrush(QBrush(bg))
                painter.setPen(QPen(border, 1.0))
                painter.drawRoundedRect(pill_rect, 6.0, 6.0)

                painter.setPen(fg)
                painter.drawText(pill_rect, Qt.AlignmentFlag.AlignCenter, label)

            painter.restore()

