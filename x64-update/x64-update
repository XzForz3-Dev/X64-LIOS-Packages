    win = X64UpdateWindow()
    win.show()
    sys.exit(app.exec())


# ==============================================================================
# CLI INTERACTIVO (Fallback para consola/TTY pura)
# ==============================================================================

def run_cli_interactive():
    if sys.stdout.isatty():
        os.system("clear")

    print(BANNER)
    t = get_telemetry()
    box_w = 82
    line_content = f"  {C_CYAN}Equipo:{C_RESET} {C_WHITE}{t['hostname']}{C_RESET}     {C_CYAN}Kernel:{C_RESET} {C_WHITE}{t['kernel']}{C_RESET}     {C_CYAN}Uptime:{C_RESET} {C_WHITE}{t['uptime']}{C_RESET}"
    visible_content = f"  Equipo: {t['hostname']}     Kernel: {t['kernel']}     Uptime: {t['uptime']}"
    pad = max(0, box_w - len(visible_content))

    print(f"{C_GRAY}  ┌{'─' * box_w}┐{C_RESET}")
    print(f"{C_GRAY}  │{C_RESET}{line_content}{' ' * pad}{C_GRAY}│{C_RESET}")
    print(f"{C_GRAY}  └{'─' * box_w}┘{C_RESET}\n")

    print(f"  {C_CYAN}[*]{C_RESET} Comprobando repositorios oficiales...")
    repo_pkgs = check_official_repos()
    omarchy_pkg = check_omarchy_git()
    if omarchy_pkg:
        repo_pkgs.insert(0, omarchy_pkg)
    aur_pkgs = check_aur_packages()
    flatpak_pkgs = check_flatpak_packages()

    total_updates = len(repo_pkgs) + len(aur_pkgs) + len(flatpak_pkgs)
    if total_updates == 0:
        print(f"\n  {C_GREEN}{C_BOLD}✓ ¡Tu sistema X64 LIOS está completamente al día!{C_RESET}\n")
        wait_for_user()
        return 0

    print(f"\n  {C_RED}{C_BOLD}▶ PAQUETES DETECTADOS PARA ACTUALIZACIÓN ({total_updates}):{C_RESET}\n")
    
    col_name_w = 32
    col_trans_w = 36
    col_type_w = 12
    header_top = f"{C_GRAY}  ┌{'─' * col_name_w}┬{'─' * col_trans_w}┬{'─' * col_type_w}┐{C_RESET}"
    header_mid = f"{C_GRAY}  ├{'─' * col_name_w}┼{'─' * col_trans_w}┼{'─' * col_type_w}┤{C_RESET}"
    header_bot = f"{C_GRAY}  └{'─' * col_name_w}┴{'─' * col_trans_w}┴{'─' * col_type_w}┘{C_RESET}"

    print(header_top)
    print(f"{C_GRAY}  │{C_RESET} {C_WHITE}{C_BOLD}{'PAQUETE':<{col_name_w-2}}{C_RESET} "
          f"{C_GRAY}│{C_RESET} {C_WHITE}{C_BOLD}{'TRANSICIÓN DE VERSIÓN':<{col_trans_w-2}}{C_RESET} "
          f"{C_GRAY}│{C_RESET} {C_WHITE}{C_BOLD}{'ORIGEN':<{col_type_w-2}}{C_RESET} {C_GRAY}│{C_RESET}")
    print(header_mid)

    all_list = []
    for line in repo_pkgs:
        p, old_v, new_v = parse_pkg_line(line)
        trans = f"{old_v} ➔ {new_v}" if new_v else old_v
        all_list.append((p, trans, "Oficial", C_CYAN, is_critical_package(p)))
    for line in aur_pkgs:
        p, old_v, new_v = parse_pkg_line(line)
        trans = f"{old_v} ➔ {new_v}" if new_v else old_v
        all_list.append((p, trans, "AUR", C_MAGENTA, is_critical_package(p)))
    for line in flatpak_pkgs:
        p, old_v, new_v = parse_pkg_line(line)
        all_list.append((p, old_v, "Flatpak", C_BLUE, False))

    all_list.sort(key=lambda x: (0 if x[4] else 1, x[0]))

    for p, trans, orig, col, is_crit in all_list:
        tag = f"{C_YELLOW}[!]{C_RESET} " if is_crit else "    "
        max_p_w = col_name_w - 6
        p_str = p if len(p) <= max_p_w else p[:max_p_w-2] + ".."
        pad_name = max(0, max_p_w - len(p_str))
        pkg_display = f"{tag}{col}{p_str}{C_RESET}{' ' * pad_name}"

        max_t_w = col_trans_w - 2
        t_str = trans if len(trans) <= max_t_w else trans[:max_t_w-2] + ".."
        pad_trans = max(0, max_t_w - len(t_str))

        max_o_w = col_type_w - 2
        o_str = orig[:max_o_w]
        pad_orig = max(0, max_o_w - len(o_str))

        print(f"{C_GRAY}  │{C_RESET} {pkg_display} "
              f"{C_GRAY}│{C_RESET} {C_WHITE}{t_str}{C_RESET}{' ' * pad_trans} "
              f"{C_GRAY}│{C_RESET} {col}{o_str}{C_RESET}{' ' * pad_orig} {C_GRAY}│{C_RESET}")

    print(header_bot)
    print()

    print(f"{C_WHITE}{C_BOLD}  OPCIONES DE ACTUALIZACIÓN:{C_RESET}")
    print(f"   {C_RED}[1]{C_RESET} {C_WHITE}Actualizar TODO el sistema ahora (Recomendado: Oficial + AUR + Flatpak){C_RESET}")
    print(f"   {C_RED}[2]{C_RESET} {C_WHITE}Solo repositorios oficiales{C_RESET}")
    print(f"   {C_RED}[3]{C_RESET} {C_WHITE}Actualizar y purgar caché de paquetes (pacman -Sc){C_RESET}")
    print(f"   {C_RED}[4]{C_RESET} {C_LIGHT}Cancelar y salir{C_RESET}\n")

    choice = "1"
    try:
        raw_choice = input(f"  {C_CYAN}Seleccione una opción [1-4] (por defecto 1): {C_RESET}").strip()
        if raw_choice:
            choice = raw_choice
    except (KeyboardInterrupt, EOFError):
        print(f"\n  {C_YELLOW}Operación cancelada.{C_RESET}")
        return 0

    if choice == "4":
        return 0

    aur_helper = "paru" if shutil.which("paru") else ("yay" if shutil.which("yay") else None)
    has_omarchy = os.path.isdir("/usr/share/omarchy/.git")
    cmds = []

    if has_omarchy:
        cmds.append("echo -e '\\033[1;36m[+]\\033[0;1m Sincronizando Capa X64 LIOS + Omarchy desde Git...\\033[0m' && sudo git -C /usr/share/omarchy pull origin main || true")

    if choice in ["1", "3"] and aur_helper:
        cmds.append(f"{aur_helper} -Syu")
    else:
        cmds.append("sudo pacman -Syu")

    if choice == "1" and shutil.which("flatpak") and len(flatpak_pkgs) > 0:
        cmds.append("flatpak update -y")

    if choice == "3":
        cmds.append("sudo pacman -Sc --noconfirm")

    if has_omarchy:
        cmds.append("if [ -x /usr/share/omarchy/bin/omarchy-update-restart ]; then /usr/share/omarchy/bin/omarchy-update-restart || true; fi")
        cmds.append("if [ -x /usr/share/omarchy/bin/omarchy-update-mise ]; then /usr/share/omarchy/bin/omarchy-update-mise || true; fi")

    subprocess.run(" && ".join(cmds), shell=True)
    run_background_check_and_save()
    wait_for_user()
    return 0


# ==============================================================================
# MAIN ENTRYPOINT
# ==============================================================================

def main():
    parser = argparse.ArgumentParser(description="x64-update: Gestor Oficial de Actualizaciones de X64 LIOS")
    parser.add_argument("--check", action="store_true", help="Comprueba en segundo plano y actualiza el estado")
    parser.add_argument("--cli", action="store_true", help="Fuerza la ejecución en terminal/CLI interactivo")
    args, unknown = parser.parse_known_args()

    if args.check:
        run_background_check_and_save()
        return 0

    has_display = bool(os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY"))

    if args.cli or not has_display:
        return run_cli_interactive()

    try:
        run_gui()
    except Exception as e:
        print(f"Error iniciando GUI PyQt6: {e}. Entrando a modo terminal...")
        return run_cli_interactive()

if __name__ == "__main__":
    sys.exit(main() or 0)
