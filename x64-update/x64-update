            self.tx_worker.stage_changed.connect(self.on_tx_stage)
            self.tx_worker.transaction_done.connect(self.on_tx_finished)
            self.tx_worker.start()

        def flush_vt_render(self):
            if not hasattr(self, "vt_screen"):
                return
            self.vt_last_render = time.time()
            self.log_view.setHtml(self.vt_screen.to_html())
            vbar = self.log_view.verticalScrollBar()
            vbar.setValue(vbar.maximum())
            hbar = self.log_view.horizontalScrollBar()
            hbar.setValue(0)

        def on_tx_output(self, raw_text):
            if not hasattr(self, "vt_screen"):
                self.vt_screen = Vt100Screen()
            self.vt_screen.feed(raw_text)
            now = time.time()
            if now - getattr(self, "vt_last_render", 0.0) >= 0.025:
                if hasattr(self, "vt_render_timer") and self.vt_render_timer.isActive():
                    self.vt_render_timer.stop()
                self.flush_vt_render()
            else:
                if hasattr(self, "vt_render_timer") and not self.vt_render_timer.isActive():
                    self.vt_render_timer.start(25)

