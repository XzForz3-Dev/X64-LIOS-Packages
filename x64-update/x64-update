def get_telemetry():
    kernel = "Linux Desconocido"
    try:
        raw_k = subprocess.check_output(["uname", "-r"], text=True).strip()
        raw_k = raw_k.replace("-cachyos", "").replace("cachyos", "")
        kernel = raw_k
    except Exception:
        pass

    arch = "x86_64"
    try:
        arch = subprocess.check_output(["uname", "-m"], text=True).strip()
    except Exception:
        pass

    uptime_str = "Desconocido"
    try:
        with open("/proc/uptime", "r") as f:
            secs = float(f.readline().split()[0])
            h = int(secs // 3600)
            m = int((secs % 3600) // 60)
            uptime_str = f"{h}h {m}m" if h > 0 else f"{m}m"
    except Exception:
        pass

    hostname = "x64-pc"
    try:
        hostname = subprocess.check_output(["uname", "-n"], text=True).strip()
    except Exception:
        pass

    return {
        "kernel": kernel,
        "arch": arch,
        "uptime": uptime_str,
        "hostname": hostname
    }

def is_critical_package(name):
    lower = name.lower()
    critical_stems = [
        "linux", "kernel", "nvidia", "mesa", "vulkan", "systemd",
        "glibc", "pipewire", "wayland", "dracut", "mkinitcpio",
        "grub", "limine", "refind", "btrfs", "zfs", "scx"
    ]
    for stem in critical_stems:
        if stem in lower:
            return True
    return False

def parse_pkg_line(line):
    line_clean = line.replace("(AUR)", "").replace("(Flatpak)", "").strip()
    parts = line_clean.split()
    if len(parts) >= 4 and parts[2] == "->":
        pkg = parts[0]
        old_v = parts[1]
        new_v = parts[3]
        return pkg, old_v, new_v
    elif len(parts) >= 2:
        return parts[0], parts[1], ""
    return line_clean, "", ""

def check_official_repos():
    repo_pkgs = []
    if not shutil.which("checkupdates"):
        return repo_pkgs

    tmp_db = tempfile.mkdtemp(prefix="x64-checkupdates-")
    env = os.environ.copy()
    env["CHECKUPDATES_DB"] = tmp_db
    try:
        res = subprocess.run(
            ["checkupdates"],
            env=env,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=50
        )
        for line in res.stdout.strip().splitlines():
            line = line.strip()
            if line:
                repo_pkgs.append(line)
    except Exception:
        pass
    finally:
        shutil.rmtree(tmp_db, ignore_errors=True)

    return repo_pkgs

def check_aur_packages():
    aur_pkgs = []
    aur_helper = None
    if shutil.which("paru"):
        aur_helper = "paru"
    elif shutil.which("yay"):
        aur_helper = "yay"

    if not aur_helper:
        return aur_pkgs

    try:
        res = subprocess.run(
            [aur_helper, "-Qua"],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=45
        )
        for line in res.stdout.strip().splitlines():
            line = line.strip()
            if line and not line.endswith("[ignored]"):
                aur_pkgs.append(line)
    except Exception:
        pass

    return aur_pkgs

def check_flatpak_packages():
    flatpak_pkgs = []
    if not shutil.which("flatpak"):
        return flatpak_pkgs

    try:
        res = subprocess.run(
            ["flatpak", "remote-ls", "--updates", "--columns=name,application,version"],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=30
        )
        for line in res.stdout.strip().splitlines():
            parts = line.strip().split("\t")
            if parts and parts[0]:
                name = parts[0]
                ver = parts[2] if len(parts) > 2 else ""
                flatpak_pkgs.append(f"{name} {ver}".strip())
    except Exception:
        pass

    return flatpak_pkgs

def run_background_check_and_save():
    ensure_state_dir()
    repo_pkgs = check_official_repos()
    aur_pkgs = check_aur_packages()
    flatpak_pkgs = check_flatpak_packages()

    all_pkgs = []
    for p in repo_pkgs:
        all_pkgs.append(p)
    for p in aur_pkgs:
        all_pkgs.append(f"{p} (AUR)")
    for p in flatpak_pkgs:
        all_pkgs.append(f"{p} (Flatpak)")

    total_count = len(all_pkgs)

    try:
        with open(COUNT_FILE, "w", encoding="utf-8") as f:
            f.write(f"{total_count}\n")
        with open(PACKAGES_FILE, "w", encoding="utf-8") as f:
            for p in all_pkgs:
                f.write(f"{p}\n")
        with open(LAST_CHECK_FILE, "w", encoding="utf-8") as f:
            f.write(f"{time.time()}\n")
    except Exception:
        pass

    return {
        "repo": repo_pkgs,
        "aur": aur_pkgs,
        "flatpak": flatpak_pkgs,
        "all": all_pkgs,
        "count": total_count
    }

ANSI_MAP = {
    '30': '#52525b', '31': '#ef4444', '32': '#22c55e', '33': '#facc15',
    '34': '#3b82f6', '35': '#d946ef', '36': '#06b6d4', '37': '#e4e4e7',
    '90': '#71717a', '91': '#f87171', '92': '#4ade80', '93': '#fde047',
    '94': '#60a5fa', '95': '#e879f9', '96': '#22d3ee', '97': '#ffffff',
}

# Bold + standard ANSI 30-37 maps to bright palette in modern terminals (like Kitty)
ANSI_BOLD_MAP = {
    '30': '#71717a', '31': '#f87171', '32': '#4ade80', '33': '#fde047',
    '34': '#60a5fa', '35': '#e879f9', '36': '#22d3ee', '37': '#ffffff',
}

def _xterm_256_to_hex(n):
    if n < 0 or n > 255:
        return '#d4d4d8'
    if n < 8:
        return ANSI_MAP.get(str(30 + n), '#d4d4d8')
    if n < 16:
        return ANSI_MAP.get(str(90 + (n - 8)), '#ffffff')
    if n < 232:
        n -= 16
        r_idx = n // 36
        g_idx = (n % 36) // 6
        b_idx = n % 6
        r = 0 if r_idx == 0 else 55 + r_idx * 40
        g = 0 if g_idx == 0 else 55 + g_idx * 40
        b = 0 if b_idx == 0 else 55 + b_idx * 40
        return f'#{r:02x}{g:02x}{b:02x}'
    # Grayscale ramp 232..255 (slightly lifted for dark background legibility, e.g. pacman 243)
    level = min(255, 18 + (n - 232) * 10)
    return f'#{level:02x}{level:02x}{min(255, level + 8):02x}'


class Vt100Screen:
    """True 2D VT100/ANSI Virtual Terminal Buffer for pixel-accurate pacman/paru/flatpak rendering."""

    def __init__(self, header_html=""):
        self.header_html = header_html
        self.lines = [[]]
        self.row = 0
        self.col = 0
        self.fg = None
        self.bold = False
        self.dim = False
        self.pending = ""
        self.cr_overwrite = False

    def feed(self, text):
        data = self.pending + text
        self.pending = ""

        # Hold back incomplete trailing CSI or OSC sequence across PTY read chunks
        m = re.search(r"(\x1b(?:\[[0-9;?]*|\][^\x07\x1b]{0,512}(?:\x1b)?)?)$", data, flags=re.DOTALL)
        if m:
            self.pending = m.group(1)
            data = data[:-len(self.pending)]

        if not data:
            return

        # 1. Strip complete OSC sequences (e.g. \x1b]3008;...\x1b\ or \x1b]0;...\x07)
        data = re.sub(r"\x1b\].*?(?:\x07|\x1b\\)", "", data, flags=re.DOTALL)
        # 2. Strip leftover literal shell notifications like []3008;end=...
        data = re.sub(r"\[\]\d+;[^\r\n]*", "", data)
        # 3. Strip DCS/PM/APC sequences
        data = re.sub(r"\x1b[PX^_].*?\x1b\\", "", data, flags=re.DOTALL)

        i = 0
        n = len(data)
        while i < n:
            ch = data[i]
            if ch == "\x1b":
                m_csi = re.match(r"\x1b\[([0-9;?]*)([A-Za-z@`])", data[i:])
                if m_csi:
                    self._handle_csi(m_csi.group(1), m_csi.group(2))
                    i += m_csi.end()
                    continue
                m_esc = re.match(r"\x1b(?:[\(\)][0-9A-Za-z]|[0-9A-Za-z=><\\])", data[i:])
                if m_esc:
                    i += m_esc.end()
                    continue
                i += 1
            elif ch == "\r":
                self.col = 0
                self.cr_overwrite = True
                i += 1
            elif ch == "\n":
                self.row += 1
                self.col = 0
                self.cr_overwrite = False
                while len(self.lines) <= self.row:
                    self.lines.append([])
                i += 1
            elif ch == "\b":
                self.col = max(0, self.col - 1)
                self.cr_overwrite = False
                i += 1
            elif ch == "\t":
                spaces = 8 - (self.col % 8)
                for _ in range(spaces):
                    self._put_char(" ")
                i += 1
            elif ord(ch) >= 32:
                self._put_char(ch)
                i += 1
            else:
                i += 1

    def _resolve_color(self):
        if self.fg is None:
            if self.bold:
                return "#ffffff"
            if self.dim:
                return "#71717a"
            return None
        if self.bold and self.fg in ANSI_BOLD_MAP:
            return ANSI_BOLD_MAP[self.fg]
        if self.fg in ANSI_MAP:
            return ANSI_MAP[self.fg]
        if self.fg.startswith("#"):
            return self.fg
        return None

    def _put_char(self, ch):
        while len(self.lines) <= self.row:
            self.lines.append([])
        line = self.lines[self.row]
        if self.cr_overwrite:
            line.clear()
            self.cr_overwrite = False
        while len(line) <= self.col:
            line.append((" ", None, False))
        line[self.col] = (ch, self._resolve_color(), self.bold)
        self.col += 1

    def _handle_csi(self, params, cmd):
        arg = params.lstrip("?")
        first_num = arg.split(";")[0] if arg else ""
        count = int(first_num) if first_num.isdigit() and int(first_num) > 0 else 1

        if cmd == "A":  # Cursor Up
            self.row = max(0, self.row - count)
            self.cr_overwrite = (self.col == 0)
        elif cmd == "B":  # Cursor Down
            self.row += count
            while len(self.lines) <= self.row:
                self.lines.append([])
            self.cr_overwrite = (self.col == 0)
        elif cmd == "C":  # Cursor Forward
            self.col += count
            self.cr_overwrite = False
        elif cmd == "D":  # Cursor Back
            self.col = max(0, self.col - count)
            self.cr_overwrite = False
        elif cmd == "E":  # Cursor Next Line (col 0)
            self.row += count
            self.col = 0
            self.cr_overwrite = True
            while len(self.lines) <= self.row:
                self.lines.append([])
        elif cmd == "F":  # Cursor Preceding Line (col 0)
            self.row = max(0, self.row - count)
            self.col = 0
            self.cr_overwrite = True
        elif cmd in ("G", "`"):  # Cursor Horizontal Absolute (1-based)
            self.col = max(0, count - 1)
            self.cr_overwrite = (self.col == 0)
        elif cmd == "K":  # Erase in Line
            while len(self.lines) <= self.row:
                self.lines.append([])
            line = self.lines[self.row]
            mode = int(first_num) if first_num.isdigit() else 0
            if mode == 0:
                if self.cr_overwrite and self.col == 0:
                    line.clear()
                    self.cr_overwrite = False
                else:
                    del line[self.col:]
            elif mode == 1:
                for c_idx in range(min(self.col + 1, len(line))):
                    line[c_idx] = (" ", None, False)
            elif mode == 2:
                line.clear()
                self.cr_overwrite = False
        elif cmd == "J":  # Erase in Display
            mode = int(first_num) if first_num.isdigit() else 0
            if mode in (2, 3):
                self.lines = [[]]
                self.row = 0
                self.col = 0
                self.cr_overwrite = False
        elif cmd == "m":  # SGR (Select Graphic Rendition)
            self._handle_sgr(params)

    def _handle_sgr(self, params):
        if not params or params == "0":
            self.fg = None
            self.bold = False
            self.dim = False
            return
        parts = params.split(";")
        idx = 0
        while idx < len(parts):
            p = parts[idx]
            if p in ("", "0"):
                self.fg = None
                self.bold = False
                self.dim = False
            elif p == "1":
                self.bold = True
            elif p == "2":
                self.dim = True
            elif p == "22":
                self.bold = False
                self.dim = False
            elif p == "39":
                self.fg = None
            elif p == "38" and idx + 2 < len(parts) and parts[idx + 1] == "5":
                if parts[idx + 2].isdigit():
                    self.fg = _xterm_256_to_hex(int(parts[idx + 2]))
                idx += 2
            elif p == "38" and idx + 4 < len(parts) and parts[idx + 1] == "2":
                try:
                    r = max(0, min(255, int(parts[idx + 2])))
                    g = max(0, min(255, int(parts[idx + 3])))
                    b = max(0, min(255, int(parts[idx + 4])))
                    self.fg = f"#{r:02x}{g:02x}{b:02x}"
                except ValueError:
                    pass
                idx += 4
            elif p in ANSI_MAP:
                self.fg = p
            idx += 1

    def to_html(self):
        out_lines = []
        for line in self.lines:
            if not line:
                out_lines.append("")
                continue
            row_parts = []
            cur_fg = None
            cur_bold = False
            buf = []

            def flush_run():
                if not buf:
                    return
                txt = "".join(buf).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
                if cur_fg or cur_bold:
                    styles = []
                    if cur_fg:
                        styles.append(f"color:{cur_fg}")
                    if cur_bold:
                        styles.append("font-weight:bold")
                    row_parts.append(f'<span style="{";".join(styles)}">{txt}</span>')
                else:
                    row_parts.append(txt)

            for ch, fg, bold in line:
                if fg != cur_fg or bold != cur_bold:
                    flush_run()
                    buf = [ch]
                    cur_fg = fg
                    cur_bold = bold
                else:
                    buf.append(ch)
            flush_run()
            out_lines.append("".join(row_parts))

        body = "\n".join(out_lines)
        return (
            f"{self.header_html}"
            f'<pre style="margin: 0; font-family: \'JetBrainsMono Nerd Font\', \'Noto Sans Mono\', monospace; '
            f'font-size: 12px; line-height: 1.38; color: #d4d4d8; white-space: pre;">{body}</pre>'
        )


def ansi_to_html(text):
    vt = Vt100Screen()
    vt.feed(text)
    return vt.to_html()


