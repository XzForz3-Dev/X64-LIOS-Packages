                    meta = {"label": "X64 LIOS", "fg": "#ff4d4d", "bg": "#2a0a0e", "border": "#5c161e"}
                elif item["type"] == "Sistema":
                    sort_key = "3_Sistema"
                    meta = {"label": "Sistema", "fg": "#38bdf8", "bg": "#092030", "border": "#123b56"}
                elif item["type"] == "AUR":
                    sort_key = "4_AUR"
                    meta = {"label": "AUR", "fg": "#e879f9", "bg": "#26092e", "border": "#481456"}
                else:
