post_install() {
    # Asegurar font_name en /etc/skel sin conflicto de paquetes
    mkdir -p /etc/skel/.config/cosmic/com.system76.CosmicTerm/v1
    echo '"JetBrainsMono Nerd Font"' > /etc/skel/.config/cosmic/com.system76.CosmicTerm/v1/font_name

    # Configurar fondo oficial para cosmic-greeter (Limine Splash HD)
    if [ -d /var/lib/cosmic-greeter ]; then
        mkdir -p /var/lib/cosmic-greeter/.config/cosmic/com.system76.CosmicBackground/v1
        echo "true" > /var/lib/cosmic-greeter/.config/cosmic/com.system76.CosmicBackground/v1/same-on-all
        cat << 'EOF' > /var/lib/cosmic-greeter/.config/cosmic/com.system76.CosmicBackground/v1/all
(
    output: "all",
    source: Path("/usr/share/backgrounds/x64-lios/x64-limine-splash.png"),
    filter_by_theme: false,
    rotation_frequency: 3600,
    filter_method: Lanczos,
    scaling_mode: Zoom,
    sampling_method: Alphanumeric,
)
EOF
        chown -R cosmic-greeter:cosmic-greeter /var/lib/cosmic-greeter/.config 2>/dev/null || true
    fi

    # Configurar auto-desbloqueo de gnome-keyring en greetd (cosmic-greeter)
    if [ -f /etc/pam.d/greetd ]; then
        if ! grep -q "pam_gnome_keyring.so" /etc/pam.d/greetd; then
            sed -i '/auth.*include.*system-local-login/a -auth      optional     pam_gnome_keyring.so' /etc/pam.d/greetd 2>/dev/null || true
            sed -i '/session.*include.*system-local-login/a -session   optional     pam_gnome_keyring.so auto_start' /etc/pam.d/greetd 2>/dev/null || true
        fi
    fi

    # Propagar configuraciones soberanas de COSMIC a usuarios existentes en /home/*
    for user_dir in /home/*; do
        if [ -d "$user_dir" ]; then
            u=$(basename "$user_dir")
            g=$(id -gn "$u" 2>/dev/null || echo "$u")
            uid=$(id -u "$u" 2>/dev/null || echo "1000")
            dbus_env="DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/${uid}/bus"

            target_cosmic="$user_dir/.config/cosmic"
            mkdir -p "$target_cosmic/com.system76.CosmicTheme.Dark/v2"
            mkdir -p "$target_cosmic/com.system76.CosmicTheme.Dark/v1"
            mkdir -p "$target_cosmic/com.system76.CosmicAppList/v1"
            mkdir -p "$target_cosmic/com.system76.CosmicTerm/v1"
            mkdir -p "$target_cosmic/com.system76.CosmicBackground/v1"
            mkdir -p "$target_cosmic/com.system76.CosmicSettings.Shortcuts/v1"
            mkdir -p "$target_cosmic/com.system76.CosmicIdle/v1"
            mkdir -p "$target_cosmic/com.system76.CosmicTk/v1"
            mkdir -p "$target_cosmic/com.system76.CosmicTheme.Mode/v1"

            # Copiar configs de skeleton
            if [ -d /etc/skel/.config/cosmic ]; then
                cp -rn /etc/skel/.config/cosmic/* "$target_cosmic/" 2>/dev/null || true
                # Forzar sincronizacion de temas, terminales, atajos, modo oscuro GTK y lista de favoritos
                cp -f /etc/skel/.config/cosmic/com.system76.CosmicTheme.Dark/v2/* "$target_cosmic/com.system76.CosmicTheme.Dark/v2/" 2>/dev/null || true
                cp -f /etc/skel/.config/cosmic/com.system76.CosmicAppList/v1/* "$target_cosmic/com.system76.CosmicAppList/v1/" 2>/dev/null || true
                cp -f /etc/skel/.config/cosmic/com.system76.CosmicTerm/v1/* "$target_cosmic/com.system76.CosmicTerm/v1/" 2>/dev/null || true
                cp -f /etc/skel/.config/cosmic/com.system76.CosmicSettings.Shortcuts/v1/* "$target_cosmic/com.system76.CosmicSettings.Shortcuts/v1/" 2>/dev/null || true
                cp -f /etc/skel/.config/cosmic/com.system76.CosmicIdle/v1/* "$target_cosmic/com.system76.CosmicIdle/v1/" 2>/dev/null || true
                cp -f /etc/skel/.config/cosmic/com.system76.CosmicTk/v1/* "$target_cosmic/com.system76.CosmicTk/v1/" 2>/dev/null || true
                cp -f /etc/skel/.config/cosmic/com.system76.CosmicTheme.Mode/v1/* "$target_cosmic/com.system76.CosmicTheme.Mode/v1/" 2>/dev/null || true

                # Fondo: solo si no existe o esta vacio, para respetar elecciones del usuario
                if [ ! -f "$target_cosmic/com.system76.CosmicBackground/v1/all" ]; then
                    cp -f /etc/skel/.config/cosmic/com.system76.CosmicBackground/v1/* "$target_cosmic/com.system76.CosmicBackground/v1/" 2>/dev/null || true
                fi
            fi

            # Asegurar tipografía JetBrainsMono Nerd Font en el usuario
            echo '"JetBrainsMono Nerd Font"' > "$target_cosmic/com.system76.CosmicTerm/v1/font_name"

            # Limpiar variante redundante winkeys en xkb_config de COSMIC si existe
            if [ -f "$target_cosmic/com.system76.CosmicComp/v1/xkb_config" ]; then
                sed -i 's/variant: "winkeys"/variant: ""/g' "$target_cosmic/com.system76.CosmicComp/v1/xkb_config" 2>/dev/null || true
            fi

            # Fijar tema oscuro GTK3/GTK4 en gsettings del usuario
            su - "$u" -c "$dbus_env gsettings set org.gnome.desktop.interface gtk-theme 'adw-gtk3-dark' && $dbus_env gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark' && $dbus_env gsettings set org.gnome.desktop.interface icon-theme 'Papirus-Dark'" 2>/dev/null || true

            chown -R "$u:$g" "$target_cosmic" 2>/dev/null || true
        fi
    done

    # Actualizar cache de iconos Papirus y Papirus-Dark
    gtk-update-icon-cache -f /usr/share/icons/Papirus 2>/dev/null || true
    gtk-update-icon-cache -f /usr/share/icons/Papirus-Dark 2>/dev/null || true

    # Ocultar utilidades redundantes o de desarrollo Qt en el App Library de COSMIC
    if [ -f /usr/share/applications/fcitx5-configtool.desktop ]; then
        sed -i 's/^NotShowIn=.*/NotShowIn=KDE;GNOME;COSMIC;/' /usr/share/applications/fcitx5-configtool.desktop 2>/dev/null || true
    fi
    for qt_app in assistant designer linguist qdbusviewer qv4l2 qvidcap; do
        if [ -f "/usr/share/applications/${qt_app}.desktop" ]; then
            if ! grep -q "NoDisplay" "/usr/share/applications/${qt_app}.desktop"; then
                echo "NoDisplay=true" >> "/usr/share/applications/${qt_app}.desktop"
            fi
        fi
    done

    # Refrescar cosmic-bg en caliente si esta corriendo y cerrar applets heredados
    sed -i '/XKBVARIANT=winkeys/d' /etc/vconsole.conf 2>/dev/null || true
    sed -i '/Option "XkbVariant" "winkeys"/d' /etc/X11/xorg.conf.d/00-keyboard.conf 2>/dev/null || true
    killall -q nm-applet 2>/dev/null || true
    killall -q cosmic-bg 2>/dev/null || true
}

post_upgrade() {
    post_install
}
