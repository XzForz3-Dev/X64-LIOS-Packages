#!/usr/bin/env bash
# X64 LIOS - Windows 11 26H2 Autostart Sequence (labwc)

dbus-update-activation-environment --systemd WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_SESSION_DESKTOP QT_QPA_PLATFORMTHEME >/dev/null 2>&1 || true
systemctl --user import-environment WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_SESSION_DESKTOP QT_QPA_PLATFORMTHEME >/dev/null 2>&1 || true

# 0. Synchronize GTK/Libadwaita portal theme to clean Windows 11 Fluent Blue Dark
if command -v gsettings >/dev/null 2>&1; then
    gsettings set org.gnome.desktop.interface gtk-theme 'adw-gtk3-dark' 2>/dev/null || true
    gsettings set org.gnome.desktop.interface icon-theme 'Papirus-Dark' 2>/dev/null || true
    gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark' 2>/dev/null || true
    gsettings set org.gnome.desktop.interface accent-color 'blue' 2>/dev/null || true
    gsettings set org.gnome.desktop.interface cursor-theme 'breeze_cursors' 2>/dev/null || true
fi

# 1. Generate dynamic user & hardware profile + calibrate multi-monitor layout
/usr/bin/x64-win11-app --dump-sysinfo >/dev/null 2>&1 || true
/usr/bin/x64-win11-outputs &

# 2. Polkit authentication agent
if [ -x /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 ]; then
    /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 &
fi

# 3. Launch Quickshell Windows 11 26H2 Multi-Monitor Shell (supervised for zero-downtime hot-reload)
pkill -f 'quickshell.*x64-win11' 2>/dev/null || true
(
    while pgrep -u "$(id -u)" -x labwc >/dev/null 2>&1; do
        quickshell -p /usr/share/x64-win11/shell/shell.qml >>/tmp/x64-win11-shell.log 2>&1
        sleep 0.4
    done
) &

# 4. Wait briefly for Quickshell StatusNotifierWatcher D-Bus registration, then start System Tray daemons
(
    sleep 1.0
    if [ -x /usr/bin/x64-update-tray ]; then
        /usr/bin/x64-update-tray &
    fi
    if [ -x /usr/lib/kdeconnectd ]; then
        /usr/lib/kdeconnectd &
    fi
    if [ -f "${HOME}/.config/autostart/x64-hello.desktop" ] && ! grep -qi "^Hidden=true" "${HOME}/.config/autostart/x64-hello.desktop" 2>/dev/null; then
        if [ -x /usr/bin/x64-hello ]; then
            /usr/bin/x64-hello &
        fi
    fi
) &
