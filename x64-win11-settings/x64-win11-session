#!/usr/bin/env bash
# X64 LIOS - Official Windows 11 26H2 Wayland Session Launcher (labwc + Quickshell)

export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP="labwc:wlroots"
export XDG_SESSION_DESKTOP="x64-win11"
export QT_QPA_PLATFORM="wayland;xcb"
export QT_QPA_PLATFORMTHEME=gtk3
export QT_AUTO_SCREEN_SCALE_FACTOR=1
export MOZ_ENABLE_WAYLAND=1
export _JAVA_AWT_WM_NONREPARENTING=1

mkdir -p "${HOME}/.local/state/x64-win11" "${HOME}/.config/labwc"
rm -f "${HOME}/.local/state/x64-win11/cmd" 2>/dev/null || true
# Only seed missing labwc config files so user customizations (cursor, theme, keyboard, libinput, desktops) persist across logins!
for _f in /etc/xdg/x64-win11/labwc/*; do
    _bn="$(basename "$_f")"
    [ ! -f "${HOME}/.config/labwc/${_bn}" ] && cp -f "$_f" "${HOME}/.config/labwc/${_bn}" 2>/dev/null || true
done
chmod +x "${HOME}/.config/labwc/autostart" 2>/dev/null || true

exec /usr/bin/labwc -C "${HOME}/.config/labwc"
