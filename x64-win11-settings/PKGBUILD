# Maintainer: X64 Studios <dev@x64lios.com>
pkgname=x64-win11-settings
pkgver=1.0.0
pkgrel=5
pkgdesc="Official X64 LIOS Windows 11 26H2 Fluent Dark Wayland Desktop Environment (labwc + Quickshell)"
arch=('any')
url="https://x64lios.com"
license=('GPL3')
install='x64-win11-settings.install'
depends=(
    'labwc'
    'quickshell'
    'wlr-randr'
    'xorg-xwayland'
    'sddm'
    'x64-sddm-theme'
    'polkit-gnome'
    'python-pyqt6'
    'qt6-svg'
    'xdg-desktop-portal-wlr'
    'xdg-desktop-portal-gtk'
    'wl-clipboard'
    'grim'
    'slurp'
    'brightnessctl'
    'breeze-cursors'
    'breeze-icons'
    'adw-gtk-theme'
    'papirus-icon-theme'
    'kitty'
)

package() {
    # 1. Core executables
    install -d "${pkgdir}/usr/bin"
    install -m755 "${startdir}/x64-win11-session" "${pkgdir}/usr/bin/x64-win11-session"
    install -m755 "${startdir}/x64-win11-ctl" "${pkgdir}/usr/bin/x64-win11-ctl"
    install -m755 "${startdir}/x64-win11-outputs" "${pkgdir}/usr/bin/x64-win11-outputs"
    install -m755 "${startdir}/x64-win11-app" "${pkgdir}/usr/bin/x64-win11-app"

    # 2. Wayland session entry for SDDM, XDG Desktop Portal mapping & Desktop Application entries
    install -d "${pkgdir}/usr/share/wayland-sessions"
    install -m644 "${startdir}/x64-win11.desktop" "${pkgdir}/usr/share/wayland-sessions/x64-win11.desktop"

    install -d "${pkgdir}/usr/share/xdg-desktop-portal"
    install -m644 "${startdir}/labwc-portals.conf" "${pkgdir}/usr/share/xdg-desktop-portal/labwc-portals.conf"
    install -m644 "${startdir}/labwc-portals.conf" "${pkgdir}/usr/share/xdg-desktop-portal/wlroots-portals.conf"

    install -d "${pkgdir}/usr/share/applications"
    install -m644 "${startdir}/x64-win11-explorer.desktop" "${pkgdir}/usr/share/applications/x64-win11-explorer.desktop"
    install -m644 "${startdir}/x64-win11-settings-app.desktop" "${pkgdir}/usr/share/applications/x64-win11-settings-app.desktop"
    install -m644 "${startdir}/x64-win11-taskmgr.desktop" "${pkgdir}/usr/share/applications/x64-win11-taskmgr.desktop"

    # 3. labwc compositor configuration, XKB environment & Windows 11 Dark Titlebar theme
    install -d "${pkgdir}/etc/xdg/x64-win11/labwc"
    install -m644 "${startdir}/labwc-rc.xml" "${pkgdir}/etc/xdg/x64-win11/labwc/rc.xml"
    install -m644 "${startdir}/labwc-themerc" "${pkgdir}/etc/xdg/x64-win11/labwc/themerc"
    install -m644 "${startdir}/labwc-environment" "${pkgdir}/etc/xdg/x64-win11/labwc/environment"
    install -m755 "${startdir}/labwc-autostart" "${pkgdir}/etc/xdg/x64-win11/labwc/autostart"

    # Also populate /etc/skel/.config for new user accounts and x64-dashboard skel sync
    install -d "${pkgdir}/etc/skel/.config/labwc"
    install -m644 "${startdir}/labwc-rc.xml" "${pkgdir}/etc/skel/.config/labwc/rc.xml"
    install -m644 "${startdir}/labwc-themerc" "${pkgdir}/etc/skel/.config/labwc/themerc"
    install -m644 "${startdir}/labwc-environment" "${pkgdir}/etc/skel/.config/labwc/environment"
    install -m755 "${startdir}/labwc-autostart" "${pkgdir}/etc/skel/.config/labwc/autostart"

    install -d "${pkgdir}/etc/skel/.config/gtk-3.0" "${pkgdir}/etc/skel/.config/gtk-4.0"
    install -m644 "${startdir}/gtk-settings.ini" "${pkgdir}/etc/skel/.config/gtk-3.0/settings.ini"
    install -m644 "${startdir}/gtk-settings.ini" "${pkgdir}/etc/skel/.config/gtk-4.0/settings.ini"

    install -d "${pkgdir}/usr/share/themes/X64-Win11-Dark/openbox-3"
    install -m644 "${startdir}/labwc-themerc" "${pkgdir}/usr/share/themes/X64-Win11-Dark/openbox-3/themerc"
    install -d "${pkgdir}/usr/share/themes/X64-Win11-Dark/labwc"
    install -m644 "${startdir}/labwc-themerc" "${pkgdir}/usr/share/themes/X64-Win11-Dark/labwc/themerc"

    # 4. Quickshell Windows 11 26H2 Layer-Shell & Native App QMLs
    install -d "${pkgdir}/usr/share/x64-win11/shell"
    install -m644 "${startdir}/shell/shell.qml" "${pkgdir}/usr/share/x64-win11/shell/shell.qml"
    install -m644 "${startdir}/shell/Win11Shell.qml" "${pkgdir}/usr/share/x64-win11/shell/Win11Shell.qml"
    install -m644 "${startdir}/shell/Win11ExplorerWindow.qml" "${pkgdir}/usr/share/x64-win11/shell/Win11ExplorerWindow.qml"
    install -m644 "${startdir}/shell/Win11SettingsWindow.qml" "${pkgdir}/usr/share/x64-win11/shell/Win11SettingsWindow.qml"
    install -m644 "${startdir}/shell/Win11TaskMgrWindow.qml" "${pkgdir}/usr/share/x64-win11/shell/Win11TaskMgrWindow.qml"

    # 5. Official Windows 11 SVG Icons & 4K Bloom Wallpapers
    install -d "${pkgdir}/usr/share/x64-win11/assets/icons"
    cp -a "${startdir}/assets/icons/"* "${pkgdir}/usr/share/x64-win11/assets/icons/"

    install -d "${pkgdir}/usr/share/x64-win11/assets/wallpapers"
    cp -a "${startdir}/assets/wallpapers/"* "${pkgdir}/usr/share/x64-win11/assets/wallpapers/"
}
