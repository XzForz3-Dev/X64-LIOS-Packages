                if ! pgrep -x kdeconnectd >/dev/null 2>&1; then
                    if [ -x /usr/bin/kdeconnectd ]; then
                        setsid -f /usr/bin/kdeconnectd >/dev/null 2>&1 || true
                    elif [ -x /usr/lib/kdeconnectd ]; then
                        setsid -f /usr/lib/kdeconnectd >/dev/null 2>&1 || true
                    fi
                fi
                command -v kdeconnect-cli >/dev/null 2>&1 && kdeconnect-cli --refresh >/dev/null 2>&1 &
                /usr/bin/x64-win11-app --dump-sysinfo >/dev/null 2>&1 &
                ;;
            ring)
                did=""
                dname=""
                if command -v busctl >/dev/null 2>&1; then
                    eval "$(python3 - <<'PYEOF'
import json, subprocess
try:
    out = subprocess.check_output(
        ["busctl", "--user", "--json=short", "call", "org.kde.kdeconnect", "/modules/kdeconnect",
         "org.kde.kdeconnect.daemon", "deviceNames", "bb", "true", "true"],
        text=True, timeout=0.8, stderr=subprocess.DEVNULL
    )
    m = json.loads(out).get("data", [{}])[0]
    if isinstance(m, dict) and m:
        did, dname = next(iter(m.items()))
        print(f'did="{did}"\ndname="{dname.replace(chr(34), "")}"')
except Exception:
    pass
PYEOF
)"
                fi
                if [ -n "$did" ]; then
                    busctl --user call org.kde.kdeconnect "/modules/kdeconnect/devices/${did}/findmyphone" org.kde.kdeconnect.device.findmyphone ring >/dev/null 2>&1 || kdeconnect-cli -d "$did" --ring >/dev/null 2>&1 &
                    notify-send -a "Enlace Móvil" "Haciendo sonar ${dname:-tu teléfono}" "Pulsa «Encontrado» en el móvil para detener el timbre." 2>/dev/null || true
                else
                    notify-send -a "Enlace Móvil" "«Hacer sonar» requiere KDE Connect" "Instala y vincula la app KDE Connect en tu móvil (Android o iPhone) desde Configuración › Dispositivos móviles." 2>/dev/null || true
                fi
                ;;
            send-file)
                ser="${3:-}"
                if [ -z "$ser" ] && command -v adb >/dev/null 2>&1; then
