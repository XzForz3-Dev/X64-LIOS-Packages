                    printf '{"active":true,"mode":"%s","serial":"%s","pid":%d}\n' "$mode" "$serial" "$SPID" > "${MIRROR_JSON}.tmp"
                    mv -f "${MIRROR_JSON}.tmp" "$MIRROR_JSON"
                    wait "$SPID" 2>/dev/null || true
                    cur_p=$(cat "$MIRROR_PID" 2>/dev/null || true)
                    if [ "$cur_p" = "$SPID" ]; then
                        rm -f "$MIRROR_PID"
                        printf '{"active":false,"mode":"","serial":"","pid":0}\n' > "${MIRROR_JSON}.tmp"
                        mv -f "${MIRROR_JSON}.tmp" "$MIRROR_JSON"
