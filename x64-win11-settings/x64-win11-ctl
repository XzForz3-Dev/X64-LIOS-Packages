                    exit 1
                fi
                python3 - "$ser" <<'PYEOF' >/dev/null 2>&1 &
import os, subprocess, sys
from PyQt6.QtWidgets import QApplication, QFileDialog
ser = sys.argv[1]
app = QApplication([])
fp, _ = QFileDialog.getOpenFileName(None, "Enviar archivo al teléfono (Descargas)", os.path.expanduser("~"), "Todos los archivos (*)")
if not fp or not os.path.isfile(fp):
