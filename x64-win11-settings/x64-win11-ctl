            busctl set-property net.hadess.PowerProfiles /net/hadess/PowerProfiles net.hadess.PowerProfiles ActiveProfile s "$target_prof" >/dev/null 2>&1 || powerprofilesctl set "$target_prof" >/dev/null 2>&1 || true
