import json, os, sys
prof = sys.argv[1]
labels = {"performance": "Gaming X64", "balanced": "Equilibrado", "power-saver": "Ahorro energía"}
p = os.path.expanduser("~/.local/state/x64-win11/sysinfo.json")
if os.path.isfile(p):
    try:
        with open(p, "r", encoding="utf-8") as f:
            data = json.load(f)
        hw = data.setdefault("hwControls", {})
        hw["powerProfile"] = prof
        hw["cpuGovernor"] = labels.get(prof, "Equilibrado")
        hw["gamingActive"] = (prof == "performance")
        hw["powerSaverActive"] = (prof == "power-saver")
        tmp = p + ".tmp"
