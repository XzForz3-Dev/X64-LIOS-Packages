        CHIME="${STATE_DIR}/notif-chime.wav"
        if [ ! -f "$CHIME" ]; then
            python3 - "$CHIME" <<'PYEOF' 2>/dev/null || true
import math, struct, sys, wave
sr, dur = 44100, 0.34
n = int(sr * dur)
buf = bytearray()
for i in range(n):
    t = i / sr
    # Gentle Windows 11-inspired soft two-tone chime (E5 -> B5)
    e1 = min(1.0, t / 0.012) * math.exp(-t * 10.0)
    t2 = max(0.0, t - 0.085)
    e2 = (min(1.0, t2 / 0.012) * math.exp(-t2 * 9.0)) if t >= 0.085 else 0.0
    v = 0.22 * (e1 * math.sin(2 * math.pi * 659.25 * t) + 0.85 * e2 * math.sin(2 * math.pi * 987.77 * t2))
    buf += struct.pack("<h", max(-32767, min(32767, int(v * 32767))))
with wave.open(sys.argv[1], "wb") as wf:
    wf.setnchannels(1); wf.setsampwidth(2); wf.setframerate(sr); wf.writeframes(bytes(buf))
PYEOF
        fi
