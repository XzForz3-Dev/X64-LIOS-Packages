        /usr/bin/x64-win11-app --dump-sysinfo >/dev/null 2>&1 || true
        ;;
    toggle-pin-start)
        python3 - "$2" "$3" "$4" <<'PYEOF'
import json, os, sys
name, cmd, icon_url = sys.argv[1], sys.argv[2], sys.argv[3]
cfg_p = os.path.expanduser("~/.local/state/x64-win11/config.json")
sys_p = os.path.expanduser("~/.local/state/x64-win11/sysinfo.json")
os.makedirs(os.path.dirname(cfg_p), exist_ok=True)
cfg = json.load(open(cfg_p)) if os.path.isfile(cfg_p) else {}
sys_d = json.load(open(sys_p)) if os.path.isfile(sys_p) else {}
cur_cmds = {x.get("cmd") for x in (sys_d.get("startPinned") or [])}
unpinned = list(cfg.get("unpinnedStartCmds") or [])
extra = [x for x in (cfg.get("extraStartPinned") or []) if isinstance(x, dict)]
if cmd in cur_cmds:
    if cmd not in unpinned:
        unpinned.append(cmd)
    extra = [x for x in extra if x.get("cmd") != cmd]
else:
    unpinned = [c for c in unpinned if c != cmd]
    if not any(x.get("cmd") == cmd for x in extra):
        extra.append({"name": name, "cmd": cmd, "iconUrl": icon_url})
cfg["unpinnedStartCmds"] = unpinned
cfg["extraStartPinned"] = extra
with open(cfg_p + ".tmp", "w") as f: json.dump(cfg, f)
os.replace(cfg_p + ".tmp", cfg_p)
PYEOF
        /usr/bin/x64-win11-app --dump-sysinfo >/dev/null 2>&1 || true
        ;;
    toggle-pin-taskbar)
        python3 - "$2" "$3" "$4" "$5" <<'PYEOF'
import json, os, sys, re
title, cmd, icon_url, match_k = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
cfg_p = os.path.expanduser("~/.local/state/x64-win11/config.json")
sys_p = os.path.expanduser("~/.local/state/x64-win11/sysinfo.json")
os.makedirs(os.path.dirname(cfg_p), exist_ok=True)
cfg = json.load(open(cfg_p)) if os.path.isfile(cfg_p) else {}
sys_d = json.load(open(sys_p)) if os.path.isfile(sys_p) else {}
cur_cmds = {x.get("cmd") for x in (sys_d.get("taskbarPinned") or [])}
unpinned = list(cfg.get("unpinnedTaskbarCmds") or [])
extra = [x for x in (cfg.get("extraTaskbarPinned") or []) if isinstance(x, dict)]
if cmd in cur_cmds:
    if cmd not in unpinned:
        unpinned.append(cmd)
    extra = [x for x in extra if x.get("cmd") != cmd]
else:
    unpinned = [c for c in unpinned if c != cmd]
    if not any(x.get("cmd") == cmd for x in extra):
        slug = re.sub(r'[^a-z0-9]+', '', title.lower()) or "app"
        extra.append({"id": slug, "title": title, "match": match_k or slug, "cmd": cmd, "iconUrl": icon_url})
cfg["unpinnedTaskbarCmds"] = unpinned
cfg["extraTaskbarPinned"] = extra
with open(cfg_p + ".tmp", "w") as f: json.dump(cfg, f)
os.replace(cfg_p + ".tmp", cfg_p)
PYEOF
        /usr/bin/x64-win11-app --dump-sysinfo >/dev/null 2>&1 || true
        ;;
    explorer)
        setsid -f /usr/bin/x64-win11-app explorer "${2:-Este equipo}" >/dev/null 2>&1 &
        ;;
    settings)
        setsid -f /usr/bin/x64-win11-app settings "${2:-Inicio}" >/dev/null 2>&1 &
        ;;
    taskmgr)
        setsid -f /usr/bin/x64-win11-app taskmgr >/dev/null 2>&1 &
        ;;
    reload)
        /usr/bin/x64-win11-app --dump-sysinfo >/dev/null 2>&1 || true
        pkill -f 'quickshell.*x64-win11' 2>/dev/null || true
        ;;
    sysinfo)
        /usr/bin/x64-win11-app --dump-sysinfo >/dev/null 2>&1 || true
        ;;
    set-config)
        python3 - "$2" "$3" <<'PYEOF'
import json, os, sys
p = os.path.expanduser("~/.local/state/x64-win11/config.json")
os.makedirs(os.path.dirname(p), exist_ok=True)
cfg = {}
if os.path.isfile(p):
    try:
        with open(p, "r", encoding="utf-8") as f:
            cfg = json.load(f)
    except Exception:
        cfg = {}
try:
    cfg[sys.argv[1]] = json.loads(sys.argv[2])
except Exception:
    cfg[sys.argv[1]] = sys.argv[2]
tmp = p + ".tmp"
with open(tmp, "w", encoding="utf-8") as f:
    json.dump(cfg, f)
os.replace(tmp, p)
PYEOF
        ;;
    wifi)
        case "$2" in
            toggle)
                cur=$(LC_ALL=C nmcli -t -f WIFI g 2>/dev/null || echo "enabled")
                if [ "$cur" = "enabled" ]; then
                    nmcli radio wifi off >/dev/null 2>&1 || true
                else
                    nmcli radio wifi on >/dev/null 2>&1 || true
                fi
                ;;
            on)
                nmcli radio wifi on >/dev/null 2>&1 || true
                ;;
            off)
                nmcli radio wifi off >/dev/null 2>&1 || true
                ;;
            rescan)
                nmcli dev wifi rescan >/dev/null 2>&1 || true
                ;;
            connect)
                shift 2
                ssid="$*"
                if [ -n "$ssid" ]; then
                    if ! nmcli dev wifi connect "$ssid" >/dev/null 2>&1; then
                        setsid -f nm-connection-editor >/dev/null 2>&1 &
                    fi
                fi
                ;;
        esac
        /usr/bin/x64-win11-app --dump-sysinfo >/dev/null 2>&1 || true
        ;;
    bluetooth)
        case "$2" in
            toggle)
                if rfkill list bluetooth 2>/dev/null | grep -qi "Soft blocked: yes"; then
                    rfkill unblock bluetooth >/dev/null 2>&1 || true
                    bluetoothctl power on >/dev/null 2>&1 || true
                else
                    bluetoothctl power off >/dev/null 2>&1 || true
                    rfkill block bluetooth >/dev/null 2>&1 || true
                fi
                ;;
        esac
        /usr/bin/x64-win11-app --dump-sysinfo >/dev/null 2>&1 || true
        ;;
    power-profile)
        target_prof="${2:-balanced}"
        [ "$target_prof" = "powersave" ] && target_prof="power-saver"

        # 1. Immediately update sysinfo.json atomically (<15ms) so UI pollers never read stale state
        python3 - "$target_prof" <<'PYEOF'
import json, os, sys
prof = sys.argv[1]
labels = {"performance": "Gaming X64", "balanced": "Equilibrado", "power-saver": "Ahorro energía"}
p = os.path.expanduser("~/.local/state/x64-win11/sysinfo.json")
if os.path.isfile(p):
    try:
        with open(p, "r", encoding="utf-8") as f:
            data = json.load(f)
        hw = data.setdefault("hwControls", {})
        hw["powerProfile"] = prof
        hw["cpuGovernor"] = labels.get(prof, "Equilibrado")
        hw["gamingActive"] = (prof == "performance")
        hw["powerSaverActive"] = (prof == "power-saver")
        tmp = p + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(data, f)
        os.replace(tmp, p)
    except Exception:
        pass
PYEOF

        # 2. Apply real hardware & scx_loader profile via power-profiles-daemon (or sysfs fallback)
        if command -v powerprofilesctl >/dev/null 2>&1 && systemctl is-active --quiet power-profiles-daemon 2>/dev/null; then
            powerprofilesctl set "$target_prof" >/dev/null 2>&1 || true
        else
            case "$target_prof" in
                performance)
                    target_gov="performance"
                    target_epp="performance"
                    ;;
                power-saver)
                    target_gov="powersave"
                    target_epp="power"
                    ;;
                *)
                    target_gov="powersave"
                    target_epp="balance_performance"
                    ;;
            esac
            for gfile in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
                [ -w "$gfile" ] && echo "$target_gov" > "$gfile" 2>/dev/null || true
            done
            for efile in /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference; do
                [ -w "$efile" ] && echo "$target_epp" > "$efile" 2>/dev/null || true
            done
        fi
        ;;
    volume)
        case "$2" in
            up)   wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+ ;;
            down) wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- ;;
            mute) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
        esac
        ;;
    brightness)
        target_pct="${3:-80}"
        for bdir in /sys/class/backlight/*; do
            if [ -f "$bdir/brightness" ] && [ -f "$bdir/max_brightness" ]; then
                max_b=$(cat "$bdir/max_brightness" 2>/dev/null || echo 100)
                cur_b=$(cat "$bdir/brightness" 2>/dev/null || echo 100)
                case "$2" in
                    up)   new_pct=$(( (cur_b * 100 / max_b) + 5 )) ;;
                    down) new_pct=$(( (cur_b * 100 / max_b) - 5 )) ;;
                    set)  new_pct="$target_pct" ;;
                esac
                [ "$new_pct" -gt 100 ] 2>/dev/null && new_pct=100
                [ "$new_pct" -lt 10 ] 2>/dev/null && new_pct=10
                new_val=$(( new_pct * max_b / 100 ))
                [ -w "$bdir/brightness" ] && echo "$new_val" > "$bdir/brightness" 2>/dev/null || true
            fi
        done
        /usr/bin/x64-win11-ctl set-config brightnessPct "${new_pct:-$target_pct}" >/dev/null 2>&1 || true
        /usr/bin/x64-win11-app --dump-sysinfo >/dev/null 2>&1 || true
        ;;
    screenshot)
        SHOT_DIR="${HOME}/Imágenes/Capturas"
        mkdir -p "$SHOT_DIR"
        OUT="${SHOT_DIR}/Captura_$(date +%Y%m%d_%H%M%S).png"
        if command -v slurp >/dev/null 2>&1 && command -v grim >/dev/null 2>&1; then
            GEOM=$(slurp 2>/dev/null || true)
            if [ -n "$GEOM" ]; then
                grim -g "$GEOM" "$OUT" && wl-copy < "$OUT" 2>/dev/null || true
                notify-send -a "Recortes de Windows 11" "Captura guardada y copiada" "$OUT" 2>/dev/null || true
            fi
        fi
        ;;
esac
