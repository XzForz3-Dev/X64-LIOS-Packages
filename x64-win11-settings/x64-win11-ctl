                    home)    kc="3" ;;
                    recents) kc="187" ;;
                    power)   kc="26" ;;
                    volup)   kc="24" ;;
                    voldown) kc="25" ;;
                esac
                if [ -n "$kc" ] && command -v adb >/dev/null 2>&1; then
                    if [ -n "$ser" ]; then
                        adb -s "$ser" shell input keyevent "$kc" >/dev/null 2>&1 &
                    else
                        adb shell input keyevent "$kc" >/dev/null 2>&1 &
                    fi
                fi
                ;;
