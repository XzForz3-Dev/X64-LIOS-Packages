                    target_epp="performance"
                    ;;
                power-saver)
                    target_gov="powersave"
                    target_epp="power"
                    ;;
                *)
                    target_gov="powersave"
                    target_epp="balance_performance"
                    ;;
            esac
            for gfile in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
                [ -w "$gfile" ] && echo "$target_gov" > "$gfile" 2>/dev/null || true
            done
            for efile in /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference; do
                [ -w "$efile" ] && echo "$target_epp" > "$efile" 2>/dev/null || true
            done
        fi
        ;;
    volume)
        OVER_AMP=$(python3 -c 'import json,os; d=json.load(open(os.path.expanduser("~/.local/state/x64-win11/config.json"))); print("1.5" if d.get("audioOverAmplify") else "1.0")' 2>/dev/null || echo "1.0")
        case "$2" in
            up)       wpctl set-volume -l "$OVER_AMP" @DEFAULT_AUDIO_SINK@ 5%+ ;;
            down)     wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- ;;
            mute)     wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
            mic-mute) wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle ;;
        esac
        OSD_KIND="volume"
        WP_TARGET="@DEFAULT_AUDIO_SINK@"
        if [ "$2" = "mic-mute" ]; then
            OSD_KIND="mic"
            WP_TARGET="@DEFAULT_AUDIO_SOURCE@"
        fi
        V_RAW=$(wpctl get-volume "$WP_TARGET" 2>/dev/null || echo "Volume: 0.50")
        V_MUTED="false"
        echo "$V_RAW" | grep -q "MUTED" && V_MUTED="true"
        V_PCT=$(echo "$V_RAW" | awk '{for(i=1;i<=NF;i++) if($i ~ /^[0-9]+(\.[0-9]+)?$/){printf "%d", ($i*100)+0.5; exit}}')
        [ -z "$V_PCT" ] && V_PCT=50
        OSD_TS=$(date +%s%3N)
        printf '{"kind":"%s","value":%d,"muted":%s,"showOsd":true,"ts":%s}\n' "$OSD_KIND" "$V_PCT" "$V_MUTED" "$OSD_TS" > "${STATE_DIR}/osd.json.tmp"
        mv -f "${STATE_DIR}/osd.json.tmp" "${STATE_DIR}/osd.json"
        ;;
    brightness)
        target_pct="${3:-80}"
        SHOW_OSD="true"
        [ "$2" = "set" ] && SHOW_OSD="false"
        HAS_HW_BL=0
        new_pct=""
        for bdir in /sys/class/backlight/*; do
            if [ -f "$bdir/brightness" ] && [ -f "$bdir/max_brightness" ]; then
                HAS_HW_BL=1
                max_b=$(cat "$bdir/max_brightness" 2>/dev/null || echo 100)
                cur_b=$(cat "$bdir/brightness" 2>/dev/null || echo 100)
                case "$2" in
                    up)   new_pct=$(( (cur_b * 100 / max_b) + 5 )) ;;
                    down) new_pct=$(( (cur_b * 100 / max_b) - 5 )) ;;
                    set)  new_pct="$target_pct" ;;
                esac
                [ "$new_pct" -gt 100 ] 2>/dev/null && new_pct=100
                [ "$new_pct" -lt 10 ] 2>/dev/null && new_pct=10
                new_val=$(( new_pct * max_b / 100 ))
                [ -w "$bdir/brightness" ] && echo "$new_val" > "$bdir/brightness" 2>/dev/null || true
            fi
        done
        if [ "$HAS_HW_BL" -eq 0 ]; then
            cur_cfg=$(python3 -c 'import json,os; d=json.load(open(os.path.expanduser("~/.local/state/x64-win11/config.json"))); print(int(round(float(d.get("brightnessPct",100)))))' 2>/dev/null || echo 100)
            case "$2" in
                up)   new_pct=$(( cur_cfg + 5 )) ;;
                down) new_pct=$(( cur_cfg - 5 )) ;;
                set)  new_pct="$target_pct" ;;
            esac
            [ "$new_pct" -gt 100 ] 2>/dev/null && new_pct=100
            [ "$new_pct" -lt 10 ] 2>/dev/null && new_pct=10
        fi
        FINAL_BPCT="${new_pct:-$target_pct}"
        /usr/bin/x64-win11-ctl set-config brightnessPct "$FINAL_BPCT" >/dev/null 2>&1 || true
        OSD_TS=$(date +%s%3N)
        printf '{"kind":"brightness","value":%d,"muted":false,"showOsd":%s,"ts":%s}\n' "$FINAL_BPCT" "$SHOW_OSD" "$OSD_TS" > "${STATE_DIR}/osd.json.tmp"
        mv -f "${STATE_DIR}/osd.json.tmp" "${STATE_DIR}/osd.json"
        /usr/bin/x64-win11-app --dump-sysinfo >/dev/null 2>&1 || true
        ;;
    screenshot)
        SHOT_DIR="${HOME}/Imágenes/Capturas"
        mkdir -p "$SHOT_DIR"
        OUT="${SHOT_DIR}/Captura_$(date +%Y%m%d_%H%M%S).png"
        if command -v slurp >/dev/null 2>&1 && command -v grim >/dev/null 2>&1; then
            GEOM=$(slurp 2>/dev/null || true)
            if [ -n "$GEOM" ]; then
                grim -g "$GEOM" "$OUT" && wl-copy < "$OUT" 2>/dev/null || true
                notify-send -a "Recortes de Windows 11" "Captura guardada y copiada" "$OUT" 2>/dev/null || true
            fi
        fi
        ;;
    phone)
        sub="$2"
        MIRROR_JSON="${STATE_DIR}/phone-mirror.json"
        MIRROR_PID="${STATE_DIR}/scrcpy.pid"
        case "$sub" in
            stop)
                if [ -f "$MIRROR_PID" ]; then
                    old_p=$(cat "$MIRROR_PID" 2>/dev/null || true)
                    [ -n "$old_p" ] && kill "$old_p" 2>/dev/null || true
                    rm -f "$MIRROR_PID"
                fi
                pkill -f "scrcpy.*X64-Phone-" 2>/dev/null || true
                printf '{"active":false,"mode":"","serial":"","pid":0}\n' > "${MIRROR_JSON}.tmp"
                mv -f "${MIRROR_JSON}.tmp" "$MIRROR_JSON"
                ;;
            mirror)
                serial="${3:-}"
                # Backward-compat if old mode token passed as $3
                if [ "$serial" = "float" ] || [ "$serial" = "docked" ] || [ "$serial" = "float-pin" ]; then
                    serial="${4:-}"
                fi
                if ! command -v scrcpy >/dev/null 2>&1 || ! command -v adb >/dev/null 2>&1; then
                    notify-send -a "Enlace Móvil" "scrcpy no disponible" "Instala scrcpy y android-tools para proyectar tu móvil Android." 2>/dev/null || true
                    exit 1
                fi
                if [ -f "$MIRROR_PID" ]; then
                    old_p=$(cat "$MIRROR_PID" 2>/dev/null || true)
                    [ -n "$old_p" ] && kill "$old_p" 2>/dev/null || true
                    rm -f "$MIRROR_PID"
                fi
                pkill -f "scrcpy.*X64-Phone" 2>/dev/null || true
                sleep 0.12

                if [ -z "$serial" ]; then
                    serial=$(adb devices 2>/dev/null | awk 'NR>1 && $2=="device" {print $1; exit}')
                fi
                if [ -z "$serial" ]; then
                    unauth=$(adb devices 2>/dev/null | awk 'NR>1 && $2=="unauthorized" {print $1; exit}')
                    if [ -n "$unauth" ]; then
                        notify-send -a "Enlace Móvil" "Autoriza este PC en tu teléfono" "Acepta el aviso de «Permitir depuración USB» que aparece en la pantalla de tu móvil Android." 2>/dev/null || true
                    else
                        notify-send -a "Enlace Móvil" "Ningún Android detectado" "Conecta tu móvil por USB con Depuración USB activada o usa Modo Wi-Fi en Configuración › Dispositivos móviles." 2>/dev/null || true
                    fi
                    printf '{"active":false,"mode":"","serial":"","pid":0}\n' > "${MIRROR_JSON}.tmp"
                    mv -f "${MIRROR_JSON}.tmp" "$MIRROR_JSON"
                    exit 1
                fi

                eval "$(python3 - <<'PYEOF'
import json, os
p = os.path.expanduser("~/.local/state/x64-win11/config.json")
c = {}
if os.path.isfile(p):
    try: c = json.load(open(p, "r", encoding="utf-8"))
    except Exception: c = {}
fps = int(c.get("phoneMaxFps", 60) or 60)
if fps not in (30, 60, 90, 120): fps = 60
br = str(c.get("phoneBitrate", "8M") or "8M")
if br not in ("4M", "8M", "12M", "16M"): br = "8M"
audio = "1" if c.get("phoneAudio", True) is not False else "0"
scroff = "1" if bool(c.get("phoneTurnScreenOff", False)) else "0"
awake = "1" if c.get("phoneStayAwake", True) is not False else "0"
ontop = "1" if bool(c.get("phoneAlwaysOnTop", False)) else "0"
print(f"P_FPS={fps}\nP_BR={br}\nP_AUDIO={audio}\nP_SCROFF={scroff}\nP_AWAKE={awake}\nP_ONTOP={ontop}")
PYEOF
)"
                ARGS=("-s" "$serial" "--max-fps=${P_FPS:-60}" "--video-bit-rate=${P_BR:-8M}" "--window-height=760")
                [ "${P_AUDIO:-1}" = "0" ] && ARGS+=("--no-audio")
                [ "${P_SCROFF:-0}" = "1" ] && ARGS+=("--turn-screen-off")
                [ "${P_AWAKE:-1}" = "1" ] && ARGS+=("--stay-awake")
