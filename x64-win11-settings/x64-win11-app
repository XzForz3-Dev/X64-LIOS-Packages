                except Exception:
                    pass
                try:
                    net_full["tcpCongestion"] = open("/proc/sys/net/ipv4/tcp_congestion_control").read().strip()
                except Exception:
                    pass
                try:
                    net_full["qdisc"] = open("/proc/sys/net/core/default_qdisc").read().strip()
                except Exception:
                    pass
                try:
                    ps_p = "/etc/NetworkManager/conf.d/99-x64-wifi-powersave.conf"
                    if os.path.isfile(ps_p) and "wifi.powersave = 2" in open(ps_p).read():
                        net_full["wifiPowerSaveOff"] = True
                except Exception:
                    pass
            except Exception:
                pass

            # 5. Account Info
            groups = []
            try:
                groups = [g.gr_name for g in grp.getgrall() if uname in g.gr_mem]
