def _verify_linux_password(username, password):
    if not username or password is None or password == "":
        return False
    chk = "/usr/bin/unix_chkpwd" if os.path.exists("/usr/bin/unix_chkpwd") else "/usr/sbin/unix_chkpwd"
    if not os.path.exists(chk):
        return False
    try:
        r = subprocess.run(
            [chk, username, "nullok"],
            input=(str(password) + "\x00").encode("utf-8"),
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5.0
        )
        return r.returncode == 0
    except Exception:
        return False


def _verify_quick_pin(candidate):
    if not candidate or not os.path.isfile(PIN_FILE):
        return False
    try:
        d = json.load(open(PIN_FILE, "r", encoding="utf-8"))
        salt = bytes.fromhex(str(d.get("salt", "")))
        iters = int(d.get("iters", 200000))
        expected = str(d.get("hash", ""))
        if not salt or not expected:
            return False
        got = hashlib.pbkdf2_hmac("sha256", str(candidate).encode("utf-8"), salt, iters).hex()
        return hmac.compare_digest(got, expected)
    except Exception:
        return False


def _get_sddm_autologin_state(uname):
    paths = ["/etc/sddm.conf.d/20-x64-autologin.conf"]
    if os.path.isdir("/etc/sddm.conf.d"):
        for fn in sorted(os.listdir("/etc/sddm.conf.d")):
            p = os.path.join("/etc/sddm.conf.d", fn)
            if fn.endswith(".conf") and p not in paths:
                paths.append(p)
    paths.append("/etc/sddm.conf")
    for p in paths:
        if not os.path.isfile(p):
            continue
        try:
            in_auto = False
            for raw in open(p, "r", encoding="utf-8", errors="ignore"):
                s = raw.strip()
                if not s or s.startswith("#"):
                    continue
                if s.startswith("["):
                    in_auto = (s.lower() == "[autologin]")
                    continue
                if in_auto and s.startswith("User="):
                    val = s.split("=", 1)[1].strip()
                    if val == uname:
                        return True
        except Exception:
            continue
    return False


def _get_available_shells(current_shell):
    excluded = {"sh", "rbash", "git-shell", "nologin", "false", "systemd-home-fallback-shell"}
    shells = []
    seen_real = set()
    if current_shell and os.path.exists(current_shell):
        shells.append(current_shell)
        seen_real.add(os.path.realpath(current_shell))
    try:
        if os.path.isfile("/etc/shells"):
            for raw in open("/etc/shells", "r", encoding="utf-8", errors="ignore"):
                s = raw.strip()
                if not s or s.startswith("#") or not s.startswith("/"):
                    continue
                bn = os.path.basename(s)
                if bn in excluded or not os.path.exists(s):
                    continue
                rp = os.path.realpath(s)
                if rp in seen_real:
                    continue
                seen_real.add(rp)
                shells.append(s)
    except Exception:
        pass
    return shells[:8]


def _list_local_users(current_uname):
    wheel_members = set()
    try:
        wheel_members = set(grp.getgrnam("wheel").gr_mem)
    except Exception:
        pass
    cfg_cur = load_cfg()
    disp_ov = str(cfg_cur.get("displayNameOverride", "") or "").strip()
    users = []
    try:
        for p in pwd.getpwall():
            if p.pw_uid < 1000 or p.pw_uid >= 65000 or p.pw_name == "nobody":
                continue
            gecos = (p.pw_gecos or "").split(",")[0].strip()
            disp = gecos if gecos else p.pw_name.capitalize()
            is_cur = (p.pw_name == current_uname)
            av_url = ""
            if is_cur:
                if disp_ov:
                    disp = disp_ov
                av_url = str(cfg_cur.get("userAvatarUrl", "") or "")
            else:
                face_p = os.path.join(p.pw_dir, ".face")
                if os.path.isfile(face_p) and os.access(face_p, os.R_OK):
                    av_url = f"file://{face_p}"
            users.append({
                "username": p.pw_name,
                "displayName": disp,
                "uid": p.pw_uid,
                "homeDir": p.pw_dir,
                "shell": p.pw_shell,
                "isAdmin": (p.pw_name in wheel_members),
                "isCurrent": is_cur,
                "avatarUrl": av_url,
            })
    except Exception:
        pass
    users.sort(key=lambda u: (not u["isCurrent"], u["username"].lower()))
    return users


