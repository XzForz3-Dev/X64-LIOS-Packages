def dump_sysinfo_file():
    os.makedirs(STATE_DIR, exist_ok=True)
    data = generate_sysinfo_dict()
    tmp = SYSINFO_FILE + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(data, f)
    os.replace(tmp, SYSINFO_FILE)


def get_dynamic_drives():
    drives = []
    seen_devs = set()
    letters = ["C", "D", "E", "F", "G", "H"]
    letter_idx = 0

    # 1. Root filesystem (C:)
    try:
        usage = shutil.disk_usage("/")
        total_gb = usage.total / (1024 ** 3)
        free_gb = usage.free / (1024 ** 3)
        used_ratio = max(0.04, min(1.0, (usage.total - usage.free) / max(1, usage.total)))
        drives.append({
            "name": "X64 LIOS Sistema (C:)",
            "path": "/",
            "icon": "drive-c.svg",
            "usedRatio": round(used_ratio, 3),
            "isCritical": used_ratio >= 0.90,
            "info": f"{free_gb:.1f} GB disponibles de {total_gb:.1f} GB"
        })
        letter_idx = 1
    except Exception:
        pass

    # 2. Scan real secondary mounted block devices (/mnt/*, /run/media/*, /home if separate disk)
    valid_fs = {"btrfs", "ext4", "xfs", "f2fs", "ntfs", "ntfs3", "fuseblk", "vfat", "exfat"}
    try:
        root_dev_id = os.stat("/").st_dev
    except Exception:
        root_dev_id = -1

    try:
        with open("/proc/mounts", "r", encoding="utf-8") as f:
            for line in f:
                parts = line.split()
                if len(parts) < 3:
                    continue
                dev, mnt, fstype = parts[0], parts[1].replace("\\040", " "), parts[2]
                if not dev.startswith("/dev/") or fstype not in valid_fs:
                    continue
                if mnt in ("/", "/boot", "/boot/efi") or mnt.startswith("/var/") or mnt.startswith("/snap"):
                    continue
                try:
                    st_dev = os.stat(mnt).st_dev
                except Exception:
                    continue
                if st_dev == root_dev_id or st_dev in seen_devs:
                    continue
                seen_devs.add(st_dev)
                try:
                    usage = shutil.disk_usage(mnt)
                    total_gb = usage.total / (1024 ** 3)
                    free_gb = usage.free / (1024 ** 3)
                    if total_gb < 1.0:
                        continue
                    used_ratio = max(0.04, min(1.0, (usage.total - usage.free) / max(1, usage.total)))
                    ltr = letters[min(letter_idx, len(letters) - 1)]
                    letter_idx += 1
                    label = os.path.basename(mnt.rstrip("/")) or "Volumen"
                    drives.append({
                        "name": f"{label.capitalize()} ({ltr}:)",
                        "path": mnt,
                        "icon": "drive.svg",
                        "usedRatio": round(used_ratio, 3),
                        "isCritical": used_ratio >= 0.90,
                        "info": f"{fstype.upper()} • {free_gb:.1f} GB libres de {total_gb:.1f} GB"
                    })
                except Exception:
                    continue
    except Exception:
        pass

    # 3. Also show Home folder volume shortcut if no external drive is mounted
    if len(drives) == 1:
        display_name, _, _ = get_real_user_info()
        try:
            usage = shutil.disk_usage(HOME_DIR)
            free_gb = usage.free / (1024 ** 3)
            used_ratio = max(0.04, min(1.0, (usage.total - usage.free) / max(1, usage.total)))
            drives.append({
                "name": f"Carpeta Personal — {display_name} (D:)",
                "path": HOME_DIR,
                "icon": "drive.svg",
                "usedRatio": round(used_ratio, 3),
                "isCritical": used_ratio >= 0.90,
                "info": f"Espacio de usuario • {free_gb:.1f} GB libres"
            })
        except Exception:
            pass

    return drives


