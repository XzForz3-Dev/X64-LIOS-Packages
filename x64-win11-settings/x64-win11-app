                            net_full["activeType"] = "ethernet"
                            net_full["activeIface"] = e["iface"]
                            net_full["activeName"] = e["connName"]
                            net_full["activeUuid"] = e["connUuid"]
                            break

                # DNS summary (prefer real NetworkManager upstream DNS over 127.0.0.53)
                dns_l = []
                if net_iface != "—" and net_iface in dev_map:
                    dns_l = list(dev_map[net_iface].get("_dns") or [])
                if not dns_l and os.path.isfile("/etc/resolv.conf"):
