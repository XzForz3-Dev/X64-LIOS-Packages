        @pyqtSlot(result=str)
        def getSystemTelemetryJson(self):
            now_ts = time.monotonic()
            display_name, uname, hostname = get_real_user_info()
            cpu_model = "Procesador x86_64"
            cpu_cache = "—"
            cpu_virt = "No detectada"
            phys_cores = set()
            try:
                with open("/proc/cpuinfo", "r", encoding="utf-8") as f:
                    phys_id = "0"
                    for line in f:
                        if "model name" in line and cpu_model == "Procesador x86_64":
                            cpu_model = line.split(":", 1)[1].strip()
                        elif line.startswith("cache size") and cpu_cache == "—":
                            kb_s = line.split(":", 1)[1].strip().split()[0]
                            try:
                                cpu_cache = f"{int(kb_s) / 1024:.0f} MB" if int(kb_s) >= 1024 else f"{kb_s} KB"
                            except Exception:
                                cpu_cache = line.split(":", 1)[1].strip()
                        elif line.startswith("flags") and cpu_virt == "No detectada":
                            fl = line.split(":", 1)[1].split()
                            if "vmx" in fl:
                                cpu_virt = "Habilitada (Intel VT-x)"
                            elif "svm" in fl:
                                cpu_virt = "Habilitada (AMD-V)"
                        elif line.startswith("physical id"):
                            phys_id = line.split(":", 1)[1].strip()
                        elif line.startswith("core id"):
                            phys_cores.add((phys_id, line.split(":", 1)[1].strip()))
            except Exception:
                pass
            logical_cores = os.cpu_count() or 4
            physical_cores = len(phys_cores) if phys_cores else max(1, logical_cores // 2)

            # Detailed Memory & Swap / ZRAM from /proc/meminfo
            mem_total_gb = 16.0
            mem_used_gb = 2.0
            mem_avail_gb = 14.0
            mem_cached_gb = 1.0
            swap_total_gb = 0.0
            swap_used_gb = 0.0
            mem_pct = 12
            swap_pct = 0
            try:
                mem = {}
                with open("/proc/meminfo", "r", encoding="utf-8") as f:
                    for line in f:
                        parts = line.split(":")
                        if len(parts) == 2:
                            mem[parts[0].strip()] = int(parts[1].strip().split()[0])
                mem_total_gb = mem.get("MemTotal", 16384000) / (1024 ** 2)
                mem_avail_gb = mem.get("MemAvailable", 14000000) / (1024 ** 2)
                mem_used_gb = max(0.0, mem_total_gb - mem_avail_gb)
                mem_cached_gb = (mem.get("Cached", 0) + mem.get("Buffers", 0) + mem.get("SReclaimable", 0)) / (1024 ** 2)
                swap_total_gb = mem.get("SwapTotal", 0) / (1024 ** 2)
                swap_free_gb = mem.get("SwapFree", 0) / (1024 ** 2)
                swap_used_gb = max(0.0, swap_total_gb - swap_free_gb)
                mem_pct = int(round((mem_used_gb / max(0.1, mem_total_gb)) * 100))
                swap_pct = int(round((swap_used_gb / max(0.1, swap_total_gb)) * 100)) if swap_total_gb > 0.05 else 0
            except Exception:
                pass

            # Overall CPU % + Live Per-Core CPU % from /proc/stat
            cpu_pct = 4
            per_core = []
            try:
                with open("/proc/stat", "r", encoding="utf-8") as f:
                    for ln in f:
                        if ln.startswith("cpu "):
                            fields = [int(x) for x in ln.split()[1:8]]
                            idle = fields[3] + fields[4]
                            total = sum(fields)
                            if self._prev_cpu_total > 0 and total > self._prev_cpu_total:
                                cpu_pct = int(round((1.0 - (idle - self._prev_cpu_idle) / (total - self._prev_cpu_total)) * 100))
                            self._prev_cpu_total = total
                            self._prev_cpu_idle = idle
                        elif ln.startswith("cpu") and ln[3:4].isdigit():
                            toks = ln.split()
                            cname = toks[0]
                            fields = [int(x) for x in toks[1:8]]
                            idle = fields[3] + fields[4]
                            total = sum(fields)
                            prev = self._prev_core_stats.get(cname)
                            cp = 0
                            if prev and total > prev[0]:
                                cp = int(round((1.0 - (idle - prev[1]) / (total - prev[0])) * 100))
                            self._prev_core_stats[cname] = (total, idle)
                            per_core.append(max(0, min(100, cp)))
                        else:
                            break
            except Exception:
                pass
            if not per_core:
                per_core = [cpu_pct] * min(16, logical_cores)

            # CPU Frequency (current avg & max) + CPU Temperature
            cpu_ghz = "—"
            cpu_max_ghz = "—"
            try:
                cur_freqs = []
                for fp in glob.glob("/sys/devices/system/cpu/cpu*/cpufreq/scaling_cur_freq"):
                    try:
                        cur_freqs.append(int(open(fp).read().strip()))
                    except Exception:
                        pass
                if cur_freqs:
                    cpu_ghz = f"{(sum(cur_freqs) / len(cur_freqs)) / 1_000_000:.2f} GHz"
                max_p = "/sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_max_freq"
                if os.path.isfile(max_p):
                    cpu_max_ghz = f"{int(open(max_p).read().strip()) / 1_000_000:.2f} GHz"
            except Exception:
                pass

            cpu_temp_str = "—"
            try:
                for hw in sorted(glob.glob("/sys/class/hwmon/hwmon*")):
                    np = os.path.join(hw, "name")
                    if not os.path.isfile(np):
                        continue
                    hname = open(np).read().strip().lower()
                    if any(k in hname for k in ("coretemp", "k10temp", "zenpower", "cpu_thermal", "acpitz")):
                        tp = os.path.join(hw, "temp1_input")
                        if os.path.isfile(tp):
                            t_c = int(open(tp).read().strip()) / 1000.0
                            if 10 < t_c < 120:
                                cpu_temp_str = f"{t_c:.0f} °C"
                                break
            except Exception:
                pass

            kernel = os.uname().release
            sched = "BORE (Nativo)"
            try:
                if os.path.exists("/sys/kernel/sched_ext/state"):
                    with open("/sys/kernel/sched_ext/state") as f:
                        if f.read().strip() == "enabled":
                            with open("/sys/kernel/sched_ext/root/ops") as f2:
                                sched = "scx_" + f2.read().strip().split("_")[0]
            except Exception:
                pass

            # Universal Multi-Disk Discovery + Per-Disk Live Read/Write MB/s & Active % from /proc/diskstats
            root_fstype = "BTRFS"
            root_dev = ""
            try:
                with open("/proc/mounts", "r", encoding="utf-8") as f:
                    for line in f:
                        parts = line.split()
                        if len(parts) >= 3 and parts[1] == "/":
                            root_dev = parts[0]
                            root_fstype = parts[2].upper()
                            break
            except Exception:
                pass
            base_blk = _base_blk_from_dev(root_dev)

            # Refresh physical disk metadata every 4 seconds (letters, capacity, model, type, I/O scheduler)
            if not self._disk_meta_cache or (now_ts - self._disk_meta_ts) >= 4.0:
                drives_map = {}
                try:
                    for drv in get_dynamic_drives():
                        b = drv.get("baseBlk") or _base_blk_from_dev(drv.get("device", ""))
                        if b:
                            drives_map.setdefault(b, []).append(drv)
                except Exception:
                    pass

                blk_names = []
                try:
                    for b in sorted(os.listdir("/sys/block")):
                        if b.startswith(("zram", "loop", "dm-", "ram", "sr", "fd")):
                            continue
                        sz_p = f"/sys/block/{b}/size"
                        if not os.path.isfile(sz_p):
                            continue
                        try:
                            sectors = int(open(sz_p).read().strip())
                        except Exception:
                            sectors = 0
                        if sectors <= 0:
                            continue
                        blk_names.append((b, sectors))
                except Exception:
                    pass

                # Put root system disk first (Disco 0 (C:)), then remaining physical disks sorted naturally
                blk_names.sort(key=lambda pair: (0 if pair[0] == base_blk else 1, pair[0]))

                meta_list = []
                for idx_d, (b, sectors) in enumerate(blk_names):
                    cap_gb = (sectors * 512.0) / (1024 ** 3)
                    d_model = f"Disco {b}"
                    try:
                        mp = f"/sys/block/{b}/device/model"
                        if os.path.isfile(mp):
                            d_model = open(mp).read().strip() or d_model
                    except Exception:
                        pass
                    d_type = "SSD"
                    try:
                        rp = f"/sys/block/{b}/queue/rotational"
                        rot = open(rp).read().strip() if os.path.isfile(rp) else "0"
                        rem_p = f"/sys/block/{b}/removable"
                        is_rem = (open(rem_p).read().strip() == "1") if os.path.isfile(rem_p) else False
                        if b.startswith("nvme"):
                            d_type = "NVMe SSD"
                        elif is_rem:
                            d_type = "USB / Extraíble"
                        elif b.startswith("mmcblk"):
                            d_type = "eMMC / SD"
                        else:
                            d_type = "SATA HDD" if rot == "1" else "SATA SSD"
                    except Exception:
                        pass
                    d_sched = "none"
                    try:
                        sp = f"/sys/block/{b}/queue/scheduler"
                        if os.path.isfile(sp):
                            stxt = open(sp).read().strip()
                            if "[" in stxt and "]" in stxt:
                                d_sched = stxt.split("[", 1)[1].split("]", 1)[0]
                    except Exception:
                        pass

                    part_drvs = drives_map.get(b, [])
                    ltrs = [d.get("letter", "") for d in part_drvs if d.get("letter")]
                    ltr_str = " ".join(ltrs)
                    lbl = f"Disco {idx_d} ({ltr_str})" if ltr_str else f"Disco {idx_d} ({b})"
                    fs_names = sorted({d.get("fstype", "") for d in part_drvs if d.get("fstype")})
                    d_fs = " / ".join(fs_names) if fs_names else (root_fstype if b == base_blk else "Sin formato")

                    used_pct = -1
                    free_gb = 0.0
                    tot_mounted_gb = 0.0
                    any_mounted = False
                    if b == base_blk:
                        try:
                            du = shutil.disk_usage("/")
                            tot_mounted_gb = du.total / (1024 ** 3)
                            free_gb = du.free / (1024 ** 3)
                            used_pct = int(round(((du.total - du.free) / max(1, du.total)) * 100))
                            any_mounted = True
                        except Exception:
                            pass
                    else:
                        t_sum = 0
                        f_sum = 0
                        for pd in part_drvs:
                            if pd.get("mounted") and pd.get("path"):
                                try:
                                    du = shutil.disk_usage(pd["path"])
                                    t_sum += du.total
                                    f_sum += du.free
                                    any_mounted = True
                                except Exception:
                                    pass
                        if any_mounted and t_sum > 0:
                            tot_mounted_gb = t_sum / (1024 ** 3)
                            free_gb = f_sum / (1024 ** 3)
                            used_pct = int(round(((t_sum - f_sum) / t_sum) * 100))

                    free_str = (
                        f"{free_gb:.1f} GB ({100 - used_pct}%)"
                        if any_mounted and used_pct >= 0
                        else "Desmontado (clic en Explorador)"
                    )
                    sub_usage = (
                        f"{used_pct}% ocupado"
                        if any_mounted and used_pct >= 0
                        else f"{cap_gb:.0f} GB • Desmontado"
                    )

                    meta_list.append({
                        "id": f"disk_{idx_d}",
                        "blk": b,
                        "label": lbl,
                        "titleLabel": f"{lbl} — {d_type}",
                        "model": d_model,
                        "type": d_type,
                        "fs": d_fs,
                        "ioSched": d_sched,
                        "totalGb": round(tot_mounted_gb if (any_mounted and tot_mounted_gb > 0) else cap_gb, 1),
                        "freeGb": round(free_gb, 1),
                        "freeStr": free_str,
                        "usedPct": used_pct if used_pct >= 0 else 0,
                        "mounted": any_mounted,
                        "subUsage": sub_usage,
                    })

                if not meta_list:
                    meta_list.append({
                        "id": "disk_0", "blk": base_blk or "sda", "label": "Disco 0 (C:)",
                        "titleLabel": "Disco 0 (C:) — SSD", "model": "Unidad del sistema",
                        "type": "SSD", "fs": root_fstype, "ioSched": "adios",
                        "totalGb": 256.0, "freeGb": 100.0, "freeStr": "100.0 GB",
                        "usedPct": 15, "mounted": True, "subUsage": "15% ocupado",
                    })
                self._disk_meta_cache = meta_list
                self._disk_meta_ts = now_ts

            # Read live /proc/diskstats for ALL detected physical disks simultaneously
            cur_diskstats = {}
            try:
                wanted_blks = {m["blk"] for m in self._disk_meta_cache}
                with open("/proc/diskstats", "r", encoding="utf-8") as f:
                    for ln in f:
                        p = ln.split()
                        if len(p) >= 14 and p[2] in wanted_blks:
                            cur_diskstats[p[2]] = (int(p[5]), int(p[9]), int(p[12]))
            except Exception:
                pass

            dt_disk = (now_ts - self._prev_disk_ts) if (self._prev_disk_ts > 0 and now_ts > self._prev_disk_ts) else 0.0
            disks_list = []
            for m in self._disk_meta_cache:
                b = m["blk"]
                r_mbs = 0.0
                w_mbs = 0.0
                act_pct = 0
                if b in cur_diskstats:
                    r_sec, w_sec, io_ms = cur_diskstats[b]
                    if dt_disk > 0 and b in self._prev_disks:
                        pr, pw, pio = self._prev_disks[b]
                        r_mbs = max(0.0, ((r_sec - pr) * 512.0) / (1024 ** 2) / dt_disk)
                        w_mbs = max(0.0, ((w_sec - pw) * 512.0) / (1024 ** 2) / dt_disk)
                        act_pct = max(0, min(100, int(round(((io_ms - pio) / (dt_disk * 1000.0)) * 100))))
                    self._prev_disks[b] = (r_sec, w_sec, io_ms)
                d_entry = dict(m)
                d_entry["activePct"] = act_pct
                d_entry["readStr"] = f"{r_mbs:.1f} MB/s"
                d_entry["writeStr"] = f"{w_mbs:.1f} MB/s"
                disks_list.append(d_entry)
            self._prev_disk_ts = now_ts

            d0 = disks_list[0]
            disk_model = d0["model"]
            disk_type = d0["type"]
            disk_io_sched = d0["ioSched"]
            disk_active_pct = d0["activePct"]
            disk_read_mbs = float(d0["readStr"].split()[0])
            disk_write_mbs = float(d0["writeStr"].split()[0])
            disk_used_pct = d0["usedPct"]
            disk_total_gb = d0["totalGb"]
            disk_free_gb = d0["freeGb"]

            # Live Network Throughput from /proc/net/dev
            net_iface = "Sin red"
            net_type = "Red"
            net_ip = "Sin conexión"
            net_mac = "—"
            net_recv_kbs = 0.0
            net_send_kbs = 0.0
            net_tot_rx_gb = 0.0
            net_tot_tx_gb = 0.0
            try:
                rout = subprocess.check_output(["ip", "-4", "route", "get", "1.1.1.1"], text=True, timeout=0.6, stderr=subprocess.DEVNULL)
                rtoks = rout.split()
                if "dev" in rtoks:
                    net_iface = rtoks[rtoks.index("dev") + 1]
                if "src" in rtoks:
                    net_ip = rtoks[rtoks.index("src") + 1]
                if net_iface != "Sin red":
                    net_type = "Wi-Fi" if os.path.isdir(f"/sys/class/net/{net_iface}/wireless") else "Ethernet"
                    mac_p = f"/sys/class/net/{net_iface}/address"
                    if os.path.isfile(mac_p):
                        net_mac = open(mac_p).read().strip().upper()
            except Exception:
                pass

            try:
                rx_b = 0
                tx_b = 0
                with open("/proc/net/dev", "r", encoding="utf-8") as f:
                    for ln in f.readlines()[2:]:
                        if ":" not in ln:
                            continue
                        ifn, rest = ln.split(":", 1)
                        ifn = ifn.strip()
                        if ifn == "lo":
                            continue
                        if net_iface != "Sin red" and ifn != net_iface:
                            continue
                        vals = rest.split()
                        rx_b += int(vals[0])
                        tx_b += int(vals[8])
                        if net_iface == "Sin red":
                            net_iface = ifn
                net_tot_rx_gb = rx_b / (1024 ** 3)
                net_tot_tx_gb = tx_b / (1024 ** 3)
                if self._prev_net_ts > 0 and now_ts > self._prev_net_ts:
                    dt = now_ts - self._prev_net_ts
                    net_recv_kbs = max(0.0, (rx_b - self._prev_net_rx) / 1024.0 / dt)
                    net_send_kbs = max(0.0, (tx_b - self._prev_net_tx) / 1024.0 / dt)
                self._prev_net_ts = now_ts
                self._prev_net_rx = rx_b
                self._prev_net_tx = tx_b
            except Exception:
                pass

            def fmt_rate(kbs):
                if kbs >= 1024.0:
                    return f"{kbs / 1024.0:.2f} MB/s"
                return f"{kbs:.0f} KB/s"

            # Universal Multi-GPU Telemetry (cached 2s — NVIDIA SLI/Multi-GPU + AMD/Intel DRM/Hybrid Laptops!)
            if self._gpu_cache is None or (now_ts - self._gpu_cache_ts) >= 2.0:
                gpus_list = []
                seen_bus = set()
                lspci_map = {}
                try:
                    lout = subprocess.check_output(["lspci", "-D"], text=True, timeout=1.0, stderr=subprocess.DEVNULL)
                    for ln in lout.splitlines():
                        if "VGA compatible controller:" in ln or "3D controller:" in ln or "Display controller:" in ln:
                            toks = ln.split(None, 1)
                            if len(toks) == 2:
                                bus_id = toks[0].strip().lower()
                                desc = toks[1].split(":", 1)[-1].strip()
                                lspci_map[bus_id] = desc
                except Exception:
                    pass

                # 1. All NVIDIA GPUs via nvidia-smi (supports 1, 2, 3, 4+ GPUs / SLI / Optimus!)
                if shutil.which("nvidia-smi"):
                    try:
                        nout = subprocess.check_output(
                            ["nvidia-smi",
                             "--query-gpu=index,pci.bus_id,name,utilization.gpu,temperature.gpu,memory.used,memory.total,driver_version",
                             "--format=csv,noheader,nounits"],
                            text=True, timeout=1.4, stderr=subprocess.DEVNULL
                        ).splitlines()
                        for raw_ln in nout:
                            gp = [x.strip() for x in raw_ln.split(",")]
                            if len(gp) < 8:
                                continue
                            raw_bus = gp[1].lower()
                            # Normalize 00000000:01:00.0 -> 0000:01:00.0
                            if len(raw_bus) > 12 and raw_bus.startswith("0000"):
                                norm_bus = raw_bus[-12:]
                            else:
                                norm_bus = raw_bus
                            seen_bus.add(norm_bus)
                            g_idx = len(gpus_list)
                            g_name = gp[2] or "NVIDIA GPU"
                            g_pct = int(float(gp[3])) if gp[3].replace(".", "", 1).isdigit() else 0
                            g_temp = f"{gp[4]} °C" if gp[4].isdigit() else "—"
                            v_used = int(float(gp[5])) if gp[5].replace(".", "", 1).isdigit() else 0
                            v_tot = int(float(gp[6])) if gp[6].replace(".", "", 1).isdigit() else 0
                            v_pct = int(round((v_used / max(1, v_tot)) * 100)) if v_tot > 0 else 0
                            gpus_list.append({
                                "id": f"gpu_{g_idx}",
                                "label": f"GPU {g_idx}",
                                "name": g_name,
                                "pct": max(0, min(100, g_pct)),
                                "temp": g_temp,
                                "vramUsedMb": v_used,
                                "vramTotalMb": v_tot,
                                "vramPct": v_pct,
                                "vramStr": f"{v_used / 1024:.1f} / {v_tot / 1024:.1f} GB" if v_tot > 0 else "Compartida",
                                "driver": f"NVIDIA {gp[7]}",
                                "busId": norm_bus.upper()
                            })
                    except Exception:
                        pass

                # 2. All additional AMD / Intel / DRM GPUs via /sys/class/drm/card*
                for card in sorted(glob.glob("/sys/class/drm/card[0-9]*")):
                    bname = os.path.basename(card)
                    if "-" in bname:
                        continue
                    dev_dir = os.path.join(card, "device")
                    if not os.path.isdir(dev_dir):
                        continue
                    pci_slot = ""
                    drv = "DRM/KMS"
                    uev = os.path.join(dev_dir, "uevent")
                    if os.path.isfile(uev):
                        try:
                            for ln in open(uev, "r", encoding="utf-8", errors="ignore"):
                                if ln.startswith("PCI_SLOT_NAME="):
                                    pci_slot = ln.split("=", 1)[1].strip().lower()
                                elif ln.startswith("DRIVER="):
                                    drv = ln.split("=", 1)[1].strip()
                        except Exception:
                            pass
                    if pci_slot and pci_slot in seen_bus:
                        continue
                    if drv.lower() == "nvidia" and len(gpus_list) > 0:
                        continue
                    if pci_slot:
                        seen_bus.add(pci_slot)

                    g_name = lspci_map.get(pci_slot, f"GPU {drv.upper()}")
                    g_pct = 0
                    g_temp = "—"
                    v_used = 0
                    v_tot = 0
                    bp = os.path.join(dev_dir, "gpu_busy_percent")
                    if os.path.isfile(bp):
                        try:
                            g_pct = int(open(bp).read().strip())
                        except Exception:
                            pass
                    vu = os.path.join(dev_dir, "mem_info_vram_used")
                    vt = os.path.join(dev_dir, "mem_info_vram_total")
                    if os.path.isfile(vu) and os.path.isfile(vt):
                        try:
                            v_used = int(open(vu).read().strip()) // (1024 ** 2)
                            v_tot = int(open(vt).read().strip()) // (1024 ** 2)
                        except Exception:
                            pass
                    for hw in sorted(glob.glob(os.path.join(dev_dir, "hwmon", "hwmon*", "temp1_input"))):
                        try:
                            tc = int(open(hw).read().strip()) / 1000.0
                            if 5 < tc < 125:
                                g_temp = f"{tc:.0f} °C"
                                break
                        except Exception:
                            pass
                    drv_lbl = {"amdgpu": "AMD AMDGPU", "i915": "Intel i915", "xe": "Intel Xe", "nouveau": "Nouveau"}.get(drv.lower(), drv.upper())
                    g_idx = len(gpus_list)
                    v_pct = int(round((v_used / max(1, v_tot)) * 100)) if v_tot > 0 else 0
                    gpus_list.append({
                        "id": f"gpu_{g_idx}",
                        "label": f"GPU {g_idx}",
                        "name": g_name,
                        "pct": max(0, min(100, g_pct)),
                        "temp": g_temp,
                        "vramUsedMb": v_used,
                        "vramTotalMb": v_tot,
                        "vramPct": v_pct,
                        "vramStr": f"{v_used / 1024:.1f} / {v_tot / 1024:.1f} GB" if v_tot > 0 else "Compartida",
                        "driver": drv_lbl,
                        "busId": pci_slot.upper() if pci_slot else "Integrada"
                    })

                # 3. Fallback via lspci if no DRM/nvidia-smi device was enumerated
                if not gpus_list:
                    for bus_id, desc in sorted(lspci_map.items()):
                        g_idx = len(gpus_list)
                        gpus_list.append({
                            "id": f"gpu_{g_idx}",
                            "label": f"GPU {g_idx}",
                            "name": desc,
                            "pct": 0,
                            "temp": "—",
                            "vramUsedMb": 0,
                            "vramTotalMb": 0,
                            "vramPct": 0,
                            "vramStr": "Compartida",
                            "driver": "DRM/KMS",
                            "busId": bus_id.upper()
                        })
                if not gpus_list:
                    gpus_list.append({
                        "id": "gpu_0", "label": "GPU 0", "name": "Adaptador gráfico",
                        "pct": 0, "temp": "—", "vramUsedMb": 0, "vramTotalMb": 0, "vramPct": 0,
                        "vramStr": "Compartida", "driver": "DRM/KMS", "busId": "—"
                    })

                self._gpu_cache = {
                    "gpus": gpus_list,
                    "gpuName": gpus_list[0]["name"],
                    "gpuPct": gpus_list[0]["pct"],
                    "gpuTemp": gpus_list[0]["temp"],
                    "gpuVramUsedMb": gpus_list[0]["vramUsedMb"],
                    "gpuVramTotalMb": gpus_list[0]["vramTotalMb"],
                    "gpuVramStr": gpus_list[0]["vramStr"],
                    "gpuDriver": gpus_list[0]["driver"]
                }
                self._gpu_cache_ts = now_ts

            # Processes (top 80 with PPID, User, Threads, Command Line & Exe Path)
            procs = []
            proc_total = 0
            thread_total = 0
            try:
                all_lines = subprocess.check_output(
                    ["ps", "-eo", "pid,ppid,user:16,state,nlwp,%cpu,rss,comm", "--sort=-%cpu"],
                    text=True, timeout=1.5
                ).splitlines()
                proc_total = max(0, len(all_lines) - 1)
                for line in all_lines[1:]:
                    parts = line.split(None, 7)
                    if len(parts) < 8:
                        continue
                    try:
                        nlwp = int(parts[4])
                    except Exception:
                        nlwp = 1
                    thread_total += nlwp
                    if len(procs) >= 80:
                        continue
                    pid, ppid, puser, st_ch = parts[0], parts[1], parts[2], parts[3]
                    pcpu = float(parts[5])
                    rss_kb = int(parts[6])
                    comm = parts[7].strip()
                    mem_mb = rss_kb / 1024.0
                    st_lbl = "En ejecución" if st_ch == "R" else ("Suspendido" if st_ch == "T" else "En segundo plano")
                    cmdline = ""
                    try:
                        cmdline = open(f"/proc/{pid}/cmdline", "rb").read().replace(b"\x00", b" ").decode("utf-8", errors="ignore").strip()[:180]
                    except Exception:
                        pass
                    procs.append({
                        "pid": pid,
                        "ppid": ppid,
                        "user": puser,
                        "name": comm,
                        "cmdline": cmdline or comm,
                        "threads": nlwp,
                        "state": st_lbl,
                        "cpuNum": round(pcpu, 1),
                        "cpu": f"{pcpu:.1f}%",
                        "memNum": round(mem_mb, 1),
                        "mem": f"{mem_mb:.1f} MB",
                        "iconUrl": resolve_app_icon_url(comm)
                    })
            except Exception:
                pass

            uptime_str = "0:00:00:00"
            try:
                up_s = int(float(open("/proc/uptime").read().split()[0]))
                d_u, rem = divmod(up_s, 86400)
                h_u, rem = divmod(rem, 3600)
                m_u, s_u = divmod(rem, 60)
                uptime_str = f"{d_u}:{h_u:02d}:{m_u:02d}:{s_u:02d}"
            except Exception:
                pass

            net_pct = max(0, min(100, int(round(min(100.0, ((net_recv_kbs + net_send_kbs) / 2048.0) * 100.0)))))

            return json.dumps({
                "user": display_name,
                "username": uname,
                "hostname": hostname,
                "userEmail": f"{uname}@{hostname}",
                "cpu": cpu_model,
                "cpuCores": logical_cores,
                "cpuPhysCores": physical_cores,
                "cpuPerCore": per_core,
                "cpuGhz": cpu_ghz,
                "cpuMaxGhz": cpu_max_ghz,
                "cpuTemp": cpu_temp_str,
                "cpuCache": cpu_cache,
                "cpuVirt": cpu_virt,
                "cpuPct": max(1, min(100, cpu_pct)),
                "ram": f"{mem_used_gb:.1f} / {mem_total_gb:.1f} GB ({mem_pct}%)",
                "ramShort": f"{mem_used_gb:.1f}/{mem_total_gb:.0f} GB",
                "ramPct": mem_pct,
                "ramUsedGb": round(mem_used_gb, 1),
                "ramTotalGb": round(mem_total_gb, 1),
                "ramAvailGb": round(mem_avail_gb, 1),
                "ramCachedGb": round(mem_cached_gb, 1),
                "swapUsedGb": round(swap_used_gb, 1),
                "swapTotalGb": round(swap_total_gb, 1),
                "swapPct": swap_pct,
                "uptime": uptime_str,
                "procCount": proc_total,
                "threadCount": thread_total,
                "kernel": kernel,
                "sched": sched,
                "disks": disks_list,
                "diskLabel": d0["titleLabel"],
                "diskModel": disk_model,
                "diskType": disk_type,
                "diskFs": root_fstype,
                "diskIoSched": disk_io_sched,
                "diskPct": disk_used_pct,
                "diskActivePct": disk_active_pct,
                "diskReadStr": f"{disk_read_mbs:.1f} MB/s",
                "diskWriteStr": f"{disk_write_mbs:.1f} MB/s",
                "diskFreeGb": round(disk_free_gb, 1),
                "diskTotalGb": round(disk_total_gb, 1),
                "diskInfo": f"{disk_model} • {root_fstype}",
                "netIface": net_iface,
                "netType": net_type,
                "netIp": net_ip,
                "netMac": net_mac,
                "netRecvKbs": round(net_recv_kbs, 1),
                "netSendKbs": round(net_send_kbs, 1),
                "netRecvStr": fmt_rate(net_recv_kbs),
                "netSendStr": fmt_rate(net_send_kbs),
                "netPct": net_pct,
                "netTotalRecvStr": f"{net_tot_rx_gb:.2f} GB",
                "netTotalSentStr": f"{net_tot_tx_gb:.2f} GB",
                "gpus": self._gpu_cache["gpus"],
                "gpuName": self._gpu_cache["gpuName"],
                "gpuPct": self._gpu_cache["gpuPct"],
                "gpuTemp": self._gpu_cache["gpuTemp"],
                "gpuVramUsedMb": self._gpu_cache["gpuVramUsedMb"],
                "gpuVramTotalMb": self._gpu_cache["gpuVramTotalMb"],
                "gpuVramStr": self._gpu_cache["gpuVramStr"],
                "gpuDriver": self._gpu_cache["gpuDriver"],
                "procs": procs
            })
    
    mode = sys.argv[1] if len(sys.argv) > 1 else "explorer"
    arg2 = sys.argv[2] if len(sys.argv) > 2 else ""
    if arg2.startswith("file://"):
        arg2 = urllib.parse.unquote(arg2[7:])

    dump_sysinfo_file()

    app = QApplication(sys.argv)
    app.setFont(QFont("Inter", 10))
    if mode == "settings":
        app.setApplicationName("x64-win11-settings-app")
        app.setDesktopFileName("x64-win11-settings-app")
        app.setWindowIcon(QIcon(os.path.join(ASSET_DIR, "settings.svg")))
        title = "Configuración"
        qml_file = "Win11SettingsWindow.qml"
        w, h = 1020, 680
    elif mode == "taskmgr":
        app.setApplicationName("x64-win11-taskmgr")
        app.setDesktopFileName("x64-win11-taskmgr")
        app.setWindowIcon(QIcon(os.path.join(ASSET_DIR, "taskmgr.svg")))
        title = "Administrador de tareas"
        qml_file = "Win11TaskMgrWindow.qml"
        w, h = 980, 650
    else:
        app.setApplicationName("x64-win11-explorer")
        app.setDesktopFileName("x64-win11-explorer")
        app.setWindowIcon(QIcon(os.path.join(ASSET_DIR, "explorer.svg")))
        title = "Explorador de archivos"
        qml_file = "Win11ExplorerWindow.qml"
        w, h = 1120, 700

    qml_dir = "/usr/share/x64-win11/shell"
    if not os.path.isdir(qml_dir):
        qml_dir = "/home/qqqq/Proyectos/X64-LIOS-Packages/x64-win11-settings/shell"

    view = QQuickView()
    view.setColor(QColor("#191919"))
    view.setTitle(title)
    view.setResizeMode(QQuickView.ResizeMode.SizeRootObjectToView)
    view.resize(w, h)

    class _MouseNavFilter(QObject):
        def eventFilter(self, obj, ev):
            if ev.type() == QEvent.Type.MouseButtonPress:
                btn = ev.button()
                if btn == Qt.MouseButton.BackButton:
                    bridge.mouseBackPressed.emit()
                    return True
                elif btn == Qt.MouseButton.ForwardButton:
                    bridge.mouseForwardPressed.emit()
                    return True
            return False

    bridge = AppBridge(view)
    mouse_nav_filter = _MouseNavFilter(view)
    view.installEventFilter(mouse_nav_filter)
    view.rootContext().setContextProperty("bridge", bridge)
    view.rootContext().setContextProperty("initialArg", arg2)
    view.rootContext().setContextProperty("assetDirUrl", f"file://{ASSET_DIR}")
    view.rootContext().setContextProperty("wpDirUrl", f"file://{WP_DIR}")
    view.setSource(QUrl.fromLocalFile(os.path.join(qml_dir, qml_file)))
    view.show()

    sys.exit(app.exec())


if __name__ == "__main__":
    main()
