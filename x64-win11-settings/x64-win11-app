        def phoneEnableWifiAdb(self, serial=""):
            if not shutil.which("adb"):
                return "error:adb no instalado"
            try:
                target = (serial or "").strip()
                if not target:
                    out = subprocess.check_output(["adb", "devices"], text=True, timeout=2.0, stderr=subprocess.DEVNULL)
                    for ln in out.splitlines()[1:]:
                        toks = ln.strip().split()
                        if len(toks) >= 2 and toks[1] == "device" and ":" not in toks[0]:
                            target = toks[0]; break
                if not target:
                    return "error:Conecta el móvil Android por USB primero"
                ip_out = subprocess.check_output(["adb", "-s", target, "shell", "ip", "-4", "addr", "show", "wlan0"], text=True, timeout=3.0, stderr=subprocess.DEVNULL)
                m_ip = re.search(r"inet\s+(\d+\.\d+\.\d+\.\d+)", ip_out)
                if not m_ip:
                    ip_out2 = subprocess.check_output(["adb", "-s", target, "shell", "ip", "route"], text=True, timeout=3.0, stderr=subprocess.DEVNULL)
                    m_ip = re.search(r"src\s+(\d+\.\d+\.\d+\.\d+)", ip_out2)
                if not m_ip:
                    return "error:El móvil no parece estar conectado a la red Wi-Fi"
                phone_ip = m_ip.group(1)
                subprocess.run(["adb", "-s", target, "tcpip", "5555"], timeout=4.0, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                time.sleep(1.1)
                rc = subprocess.run(["adb", "connect", f"{phone_ip}:5555"], capture_output=True, text=True, timeout=6.0)
                if "connected" in (rc.stdout or "").lower():
                    dump_sysinfo_file()
                    return f"ok:{phone_ip}:5555"
                return "error:No se pudo enlazar por Wi-Fi (verifica misma red LAN)"
            except Exception as ex:
                return f"error:{str(ex)[:75]}"

