def get_real_user_info():
    try:
        pw = pwd.getpwuid(os.getuid())
        uname = pw.pw_name
        gecos = (pw.pw_gecos or "").split(",")[0].strip()
        display_name = gecos if gecos else uname.capitalize()
    except Exception:
        uname = os.environ.get("USER", "x64")
        display_name = uname.capitalize()
    try:
        if os.path.isfile(CONFIG_FILE):
            with open(CONFIG_FILE, "r", encoding="utf-8") as cf:
                c = json.load(cf)
                ov = str(c.get("displayNameOverride", "") or "").strip()
                if ov:
                    display_name = ov
    except Exception:
        pass
    hostname = socket.gethostname()
    return display_name, uname, hostname


def load_cfg():
    os.makedirs(STATE_DIR, exist_ok=True)
    if os.path.isfile(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, "r", encoding="utf-8") as f:
                data = json.load(f)
                out = dict(DEFAULT_CFG)
                out.update(data)
                return out
        except Exception:
            pass
    return dict(DEFAULT_CFG)


def save_cfg(cfg):
    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = CONFIG_FILE + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(cfg, f)
    os.replace(tmp, CONFIG_FILE)


def resolve_special_folder(name):
    display_name, uname, _ = get_real_user_info()
    if name in (display_name, uname, "Inicio", "Home"):
        return HOME_DIR
    if name in ("Papelera", "Papelera de reciclaje", "Trash"):
        trash_dir = os.path.join(HOME_DIR, ".local", "share", "Trash", "files")
        os.makedirs(trash_dir, exist_ok=True)
        return trash_dir
    mapping = {
        "Escritorio": ["Escritorio", "Desktop"],
        "Descargas": ["Descargas", "Downloads"],
        "Documentos": ["Documentos", "Documents"],
        "Imágenes": ["Imágenes", "Imagenes", "Pictures"],
        "Música": ["Música", "Musica", "Music"],
        "Vídeos": ["Vídeos", "Videos"],
        "Proyectos": ["Proyectos", "Projects"],
        "X64 LIOS (C:)": ["/"],
    }
    if name in mapping:
        for cand in mapping[name]:
            if cand == "/":
                return "/"
            p = os.path.join(HOME_DIR, cand)
            if os.path.isdir(p):
                return p
        return os.path.join(HOME_DIR, mapping[name][0])
    if os.path.isdir(name):
        return name
    return HOME_DIR


def get_battery_status():
    bats = sorted(glob.glob("/sys/class/power_supply/BAT*"))
    if not bats:
        return {
            "hasBattery": False,
            "batteryPct": 100,
            "batteryCharging": True,
            "batteryText": "Conectado a CA (PC de Escritorio)"
        }
    bat = bats[0]
    try:
        with open(os.path.join(bat, "capacity"), "r", encoding="utf-8") as f:
            pct = max(0, min(100, int(f.read().strip())))
    except Exception:
        pct = 100
    try:
        with open(os.path.join(bat, "status"), "r", encoding="utf-8") as f:
            st = f.read().strip()
    except Exception:
        st = "Full"
    charging = st in ("Charging", "Full", "Not charging", "Unknown")
    if pct <= 0 and charging:
        return {
            "hasBattery": False,
            "batteryPct": 100,
            "batteryCharging": True,
            "batteryText": "Conectado a CA (Alimentación directa)"
        }
    st_es = "Cargando (CA)" if st == "Charging" else ("Carga completa (CA)" if charging else "En batería")
    return {
        "hasBattery": True,
        "batteryPct": pct,
        "batteryCharging": charging,
        "batteryText": f"{pct}% • {st_es}"
    }


def get_live_hardware_controls():
    # 1. Wi-Fi state & active SSID + nearby networks (--rescan no is <15ms)
    wifi_enabled = True
    wifi_ssid = "Wi-Fi"
    wifi_networks = []
    try:
        env = dict(os.environ, LC_ALL="C")
        out_g = subprocess.check_output(
            ["nmcli", "-t", "-f", "WIFI", "g"],
            text=True, timeout=1.2, env=env, stderr=subprocess.DEVNULL
        ).strip().lower()
        wifi_enabled = (out_g == "enabled")
        if wifi_enabled:
            out_w = subprocess.check_output(
                ["nmcli", "-t", "-f", "ACTIVE,SSID,SIGNAL,SECURITY", "dev", "wifi", "list", "--rescan", "no"],
                text=True, timeout=1.5, env=env, stderr=subprocess.DEVNULL
            ).splitlines()
            seen_ssids = set()
            for line in out_w:
                parts = line.split(":")
                if len(parts) < 4:
                    continue
                act = (parts[0].strip().lower() == "yes")
                ssid = parts[1].strip()
                if not ssid:
                    continue
                try:
                    sig = int(parts[2].strip())
                except Exception:
                    sig = 50
                sec = parts[3].strip() or "Abierta"
                if act:
                    wifi_ssid = ssid
                if ssid not in seen_ssids or act:
                    seen_ssids.add(ssid)
                    wifi_networks.append({
                        "ssid": ssid,
                        "signal": sig,
                        "security": sec,
                        "active": act
                    })
            wifi_networks.sort(key=lambda x: (not x["active"], -x["signal"]))
        else:
            wifi_ssid = "Desactivado"
    except Exception:
        pass

    # 2. Bluetooth state via rfkill
    bt_enabled = True
    try:
        out_bt = subprocess.check_output(
            ["rfkill", "list", "bluetooth"],
            text=True, timeout=1.0, stderr=subprocess.DEVNULL
        ).lower()
        if "soft blocked: yes" in out_bt or "hard blocked: yes" in out_bt:
            bt_enabled = False
    except Exception:
        pass

    # 3. Brightness via brightnessctl -m
    brightness_pct = 100
    try:
        out_br = subprocess.check_output(
            ["brightnessctl", "-m"],
            text=True, timeout=1.0, stderr=subprocess.DEVNULL
        ).strip()
        # Format: device,class,curr,pct%,max
        for field in out_br.split(","):
            if field.endswith("%"):
                brightness_pct = max(5, min(100, int(field[:-1])))
                break
    except Exception:
        pass

    # 4. Real 3-State Hardware Power Profile (performance | balanced | power-saver)
    power_profile = "balanced"
    ppd_ok = False
    if shutil.which("powerprofilesctl"):
        try:
            out_pp = subprocess.check_output(
                ["powerprofilesctl", "get"],
                text=True, timeout=1.2, stderr=subprocess.DEVNULL
            ).strip().lower()
            if out_pp in ("performance", "balanced", "power-saver"):
                power_profile = out_pp
                ppd_ok = True
        except Exception:
            pass

    if not ppd_ok:
        try:
            epp_path = "/sys/devices/system/cpu/cpu0/cpufreq/energy_performance_preference"
            gov_path = "/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor"
            if os.path.isfile(epp_path):
                with open(epp_path, "r", encoding="utf-8") as f:
                    epp = f.read().strip().lower()
                if epp == "performance":
                    power_profile = "performance"
                elif epp in ("power", "balance_power"):
                    power_profile = "power-saver"
                else:
                    power_profile = "balanced"
            elif os.path.isfile(gov_path):
                with open(gov_path, "r", encoding="utf-8") as f:
                    gov = f.read().strip().lower()
                power_profile = "performance" if gov == "performance" else "power-saver"
        except Exception:
            pass

    profile_labels = {
        "performance": "Gaming X64",
        "balanced": "Equilibrado",
        "power-saver": "Ahorro energía",
    }

    return {
        "wifiEnabled": wifi_enabled,
        "wifiSsid": wifi_ssid,
        "wifiNetworks": wifi_networks[:8],
        "btEnabled": bt_enabled,
        "brightnessPct": brightness_pct,
        "powerProfile": power_profile,
        "cpuGovernor": profile_labels.get(power_profile, "Equilibrado"),
        "gamingActive": (power_profile == "performance"),
        "powerSaverActive": (power_profile == "power-saver")
    }


def detect_default_browser():
    candidates = [
        ("chromium", "Chromium", "chromium.png"),
        ("google-chrome-stable", "Google Chrome", "chrome.svg"),
        ("brave", "Brave Browser", "edge.svg"),
        ("firefox", "Firefox Web", "edge.svg"),
        ("zen-browser", "Zen Browser", "edge.svg"),
        ("librewolf", "LibreWolf", "edge.svg"),
        ("vivaldi-stable", "Vivaldi", "edge.svg"),
    ]
    for bin_name, label, icon in candidates:
        if shutil.which(bin_name):
            return bin_name, label, icon
