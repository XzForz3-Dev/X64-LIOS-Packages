        def _save_monitors_patch(self, patches):
            mon_p = os.path.join(STATE_DIR, "monitors.json")
            os.makedirs(STATE_DIR, exist_ok=True)
            mdata = {}
            if os.path.isfile(mon_p):
                try:
                    mdata = json.load(open(mon_p, "r", encoding="utf-8"))
                except Exception:
                    mdata = {}
            if not isinstance(mdata, dict):
                mdata = {}
            for name, upd in (patches or {}).items():
                ent = dict(mdata.get(str(name), {}))
                ent.update(upd)
                mdata[str(name)] = ent
            with open(mon_p + ".tmp", "w", encoding="utf-8") as f:
