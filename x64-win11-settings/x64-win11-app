        f"/usr/share/icons/breeze-dark/apps/48/{icon_name}.svg",
    ]
    for cand in search_Files:
        if os.path.isfile(cand):
            return f"file://{cand}"
    return f"file://{ASSET_DIR}windows.svg"


def scan_installed_desktop_apps():
    dirs = [
        "/usr/share/applications",
        os.path.join(HOME_DIR, ".local", "share", "applications"),
    ]
    seen_names = set()
    apps = []
    for d in dirs:
        if not os.path.isdir(d):
            continue
        for fname in sorted(os.listdir(d)):
            if not fname.endswith(".desktop"):
                continue
            fpath = os.path.join(d, fname)
            try:
                with open(fpath, "r", encoding="utf-8", errors="ignore") as f:
                    lines = f.read().splitlines()
            except Exception:
                continue

            in_entry = False
            name = ""
            name_es = ""
            exec_cmd = ""
            icon = ""
            cats = ""
            no_display = False
            hidden = False
            terminal = False

            for raw in lines:
                line = raw.strip()
                if not line or line.startswith("#"):
                    continue
                if line.startswith("["):
                    if line == "[Desktop Entry]":
                        in_entry = True
                        continue
                    elif in_entry:
                        break
                if not in_entry or "=" not in line:
                    continue
                k, v = line.split("=", 1)
                k = k.strip()
                v = v.strip()
                if k == "Name":
                    name = v
                elif k in ("Name[es]", "Name[es_ES]", "Name[es_PA]"):
                    name_es = v
                elif k == "Exec":
                    exec_cmd = v
                elif k == "Icon":
                    icon = v
                elif k == "Categories":
                    cats = v
                elif k == "NoDisplay" and v.lower() == "true":
                    no_display = True
                elif k == "Hidden" and v.lower() == "true":
                    hidden = True
                elif k == "Terminal" and v.lower() == "true":
                    terminal = True

            if no_display or hidden or not exec_cmd:
                continue
            # Skip raw terminal TUIs unless it's btop/nvim/opencode
            clean_exec = " ".join(
                tok for tok in exec_cmd.split()
                if not tok.startswith("%")
            ).strip()
            if not clean_exec:
                continue
            if terminal:
                base_bin = clean_exec.split()[0]
                if os.path.basename(base_bin) not in ("btop", "opencode", "nvim"):
                    continue
                clean_exec = f"kitty -e {clean_exec}"

            final_name = name_es or name
            if not final_name:
                continue
            key = final_name.lower()
            if key in seen_names:
                continue
            seen_names.add(key)

            apps.append({
                "id": fname[:-8],
                "name": final_name,
                "cmd": clean_exec,
                "iconUrl": resolve_app_icon_url(icon),
                "categories": cats.lower()
            })

    apps.sort(key=lambda x: x["name"].lower())
    return apps


def build_calendar_data():
    now = datetime.now()
    months_es = [
        "", "enero", "febrero", "marzo", "abril", "mayo", "junio",
        "julio", "agosto", "septiembre", "octubre", "noviembre", "diciembre"
    ]
    cal = calendar.Calendar(firstweekday=0)  # Monday first
    month_days = list(cal.itermonthdays(now.year, now.month))
    cells = [{"label": h, "isToday": False, "isCurrentMonth": True, "isHeader": True}
             for h in ("L", "M", "X", "J", "V", "S", "D")]
    for d in month_days:
        if d == 0:
            cells.append({"label": "", "isToday": False, "isCurrentMonth": False, "isHeader": False})
        else:
            cells.append({
                "label": str(d),
                "isToday": (d == now.day),
                "isCurrentMonth": True,
                "isHeader": False
            })
    return {
        "header": f"{months_es[now.month].capitalize()} de {now.year}",
        "cells": cells
    }


def wmo_code_to_spanish_and_icon(code, is_night=False):
    c = int(code or 0)
    if c == 0:
        if is_night:
            return "Noche despejada", "win11-weather-night-clear.svg"
        return "Soleado", "win11-weather-clear.svg"
    if c in (1, 2):
        if is_night:
            return "Parcialmente nublado", "win11-weather-night-cloudy.svg"
        return "Parcialmente nublado", "win11-weather.svg"
    if c == 3:
        if is_night:
            return "Noche nublada", "win11-weather-night-cloudy.svg"
        return "Nublado", "win11-weather.svg"
    if c in (45, 48):
        return "Niebla", "win11-weather.svg"
    if c in (51, 53, 55, 56, 57):
        return "Llovizna", "win11-weather-rain.svg"
    if c in (61, 63, 65, 66, 67, 80, 81, 82):
        return "Lluvia", "win11-weather-rain.svg"
    if c in (71, 73, 75, 77, 85, 86):
        return "Nieve", "win11-weather-rain.svg"
    if c in (95, 96, 99):
        return "Tormenta eléctrica", "win11-weather-storm.svg"
    return ("Noche nublada", "win11-weather-night-cloudy.svg") if is_night else ("Parcialmente nublado", "win11-weather.svg")


def get_live_weather_data(force_refresh=False):
    os.makedirs(STATE_DIR, exist_ok=True)
    if not force_refresh and os.path.isfile(WEATHER_CACHE_FILE):
        try:
            age = time.time() - os.path.getmtime(WEATHER_CACHE_FILE)
            if age < 180:  # 3 minutes background cache; opening the panel forces live refresh
                with open(WEATHER_CACHE_FILE, "r", encoding="utf-8") as f:
                    return json.load(f)
        except Exception:
            pass

    try:
        req = urllib.request.Request("https://ipwho.is/", headers={"User-Agent": "Mozilla/5.0"})
        geo = json.loads(urllib.request.urlopen(req, timeout=2.5).read().decode("utf-8"))
        lat = geo.get("latitude", 8.9824)
        lon = geo.get("longitude", -79.5199)
        city = geo.get("city") or "Ciudad"
        country = geo.get("country") or ""

        url = (
            f"https://api.open-meteo.com/v1/forecast?latitude={lat}&longitude={lon}"
            "&current=temperature_2m,relative_humidity_2m,apparent_temperature,is_day,weather_code,wind_speed_10m,surface_pressure"
            "&hourly=temperature_2m,weather_code,is_day"
            "&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max"
            "&timezone=auto&forecast_days=5"
        )
        wreq = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
        w = json.loads(urllib.request.urlopen(wreq, timeout=3.0).read().decode("utf-8"))

        cur = w.get("current", {})
        temp = round(float(cur.get("temperature_2m", 24)))
        feels = round(float(cur.get("apparent_temperature", temp)))
        hum = int(cur.get("relative_humidity_2m", 65))
        wind = round(float(cur.get("wind_speed_10m", 10)))
        press = round(float(cur.get("surface_pressure", 1012)))
        cur_hour = datetime.now().hour
        cur_is_night = (cur.get("is_day") == 0) if ("is_day" in cur) else (cur_hour < 6 or cur_hour >= 18)
        desc, icon = wmo_code_to_spanish_and_icon(cur.get("weather_code", 1), is_night=cur_is_night)

        # Hourly (next 5 intervals of 3 hours)
        hourly_raw = w.get("hourly", {})
        h_times = hourly_raw.get("time", [])
        h_temps = hourly_raw.get("temperature_2m", [])
        h_codes = hourly_raw.get("weather_code", [])
        h_is_day = hourly_raw.get("is_day", [])
        now_hour_str = datetime.now().strftime("%Y-%m-%dT%H:00")
        start_idx = 0
        for idx, tstr in enumerate(h_times):
            if tstr >= now_hour_str:
                start_idx = idx
                break

        hourly_list = []
        for step in range(0, 15, 3):
            ii = start_idx + step
            if ii < len(h_times) and ii < len(h_temps):
                hh = h_times[ii].split("T")[-1][:5]
                try:
                    slot_hr = int(hh.split(":")[0])
                except Exception:
                    slot_hr = 12
                slot_night = (h_is_day[ii] == 0) if (ii < len(h_is_day)) else (slot_hr < 6 or slot_hr >= 18)
                _, hic = wmo_code_to_spanish_and_icon(h_codes[ii] if ii < len(h_codes) else 0, is_night=slot_night)
                hourly_list.append({
                    "time": "Ahora" if step == 0 else hh,
                    "temp": f"{round(float(h_temps[ii]))}°",
                    "icon": hic
                })

        # 5-Day Forecast
        daily_raw = w.get("daily", {})
        d_times = daily_raw.get("time", [])
        d_max = daily_raw.get("temperature_2m_max", [])
        d_min = daily_raw.get("temperature_2m_min", [])
        d_codes = daily_raw.get("weather_code", [])
        d_rain = daily_raw.get("precipitation_probability_max", [])
        weekdays_es = ["Lun", "Mar", "Mié", "Jue", "Vie", "Sáb", "Dom"]
        daily_list = []
        for i in range(min(5, len(d_times))):
            try:
                dt = datetime.strptime(d_times[i], "%Y-%m-%d")
                day_lbl = "Hoy" if i == 0 else ("Mañana" if i == 1 else f"{weekdays_es[dt.weekday()]} {dt.day}")
            except Exception:
                day_lbl = d_times[i]
            ddesc, dic = wmo_code_to_spanish_and_icon(d_codes[i] if i < len(d_codes) else 0)
            rain_pct = int(d_rain[i]) if i < len(d_rain) and d_rain[i] is not None else 0
            daily_list.append({
                "day": day_lbl,
                "desc": ddesc,
                "icon": dic,
                "max": f"{round(float(d_max[i]))}°",
                "min": f"{round(float(d_min[i]))}°",
                "rain": f"{rain_pct}%"
            })

        today_max = daily_list[0]["max"] if daily_list else f"{temp}°"
        today_min = daily_list[0]["min"] if daily_list else f"{temp}°"
        today_rain = daily_list[0]["rain"] if daily_list else "0%"

        result = {
            "city": city,
            "country": country,
            "location": f"{city}, {country}" if country else city,
            "temp": f"{temp}°C",
            "desc": desc,
            "icon": icon,
            "feelsLike": f"{feels}°C",
            "humidity": f"{hum}%",
