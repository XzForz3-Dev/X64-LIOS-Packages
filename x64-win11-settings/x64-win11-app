                    "parent": os.path.dirname(target_path.rstrip("/")) or "/",
                    "isDir": is_dir,
                    "isLink": is_link,
                    "linkTarget": os.readlink(target_path) if is_link else "",
                    "sizeStr": sz_str,
                    "sizeBytes": total_bytes,
                    "contentsStr": f"{file_cnt} archivos, {dir_cnt} carpetas" if is_dir else "",
                    "owner": owner,
                    "perms": perms,
                    "isExecutable": is_exec,
