            def emit_prog(step, pct, line=""):
                if line:
                    log_lines.append(line)
                self.progress.emit(json.dumps({"step": step, "pct": pct, "logLine": line}))

            try:
                if self.source == "pacman":
                    if not re.match(r"^[a-zA-Z0-9@._+-]+$", self.pkg_or_id) or is_pkg_system_protected(self.pkg_or_id):
                        self.done.emit(json.dumps({
                            "ok": False, "appName": self.app_name, "pkgName": self.pkg_or_id,
                            "error": "Paquete protegido del sistema: no se puede desinstalar.", "log": ""
                        }))
                        return
                    emit_prog("Solicitando autorización de administrador...", 15, f"$ pkexec pacman -Rns --noconfirm {self.pkg_or_id}")
                    proc = subprocess.Popen(
                        ["pkexec", "pacman", "-Rns", "--noconfirm", self.pkg_or_id],
                        stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
                        env=dict(os.environ, LC_ALL="C")
                    )
                    pct = 25
                    for raw in proc.stdout:
                        ln = raw.rstrip("\r\n")
                        if not ln:
                            continue
                        if "checking dependencies" in ln.lower():
                            pct = 35
                            emit_prog("Comprobando dependencias...", pct, ln)
                        elif "removing " in ln.lower():
                            pct = min(82, pct + 12)
                            emit_prog("Eliminando archivos del paquete...", pct, ln)
                        elif "running post-transaction hooks" in ln.lower():
                            pct = 86
                            emit_prog("Actualizando base de datos del escritorio...", pct, ln)
                        else:
                            emit_prog("Desinstalando paquete...", pct, ln)
                    rc = proc.wait(timeout=180)
                    if rc != 0:
                        err_msg = "Desinstalación cancelada por el usuario." if rc in (126, 127) else "No se pudo desinstalar el paquete (revisa el registro técnico)."
                        for ln in reversed(log_lines):
                            if "breaks dependency" in ln.lower() or "error:" in ln.lower():
                                err_msg = ln.strip()[:180]
                                break
                        self.done.emit(json.dumps({
                            "ok": False, "appName": self.app_name, "pkgName": self.pkg_or_id,
                            "error": err_msg, "log": "\n".join(log_lines[-40:])
                        }))
                        return

                elif self.source == "flatpak":
                    if not re.match(r"^[A-Za-z0-9_.-]+$", self.pkg_or_id):
                        self.done.emit(json.dumps({
                            "ok": False, "appName": self.app_name, "pkgName": self.pkg_or_id,
                            "error": "Identificador Flatpak no válido.", "log": ""
                        }))
                        return
                    if self.flatpak_scope == "user":
                        cmd = ["flatpak", "uninstall", "-y", "--user", "--noninteractive", self.pkg_or_id]
                        emit_prog("Desinstalando aplicación Flatpak de usuario...", 25, "$ " + " ".join(cmd))
                    else:
                        cmd = ["pkexec", "flatpak", "uninstall", "-y", "--system", "--noninteractive", self.pkg_or_id]
                        emit_prog("Solicitando autorización para Flatpak...", 20, "$ " + " ".join(cmd))
                    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
                    pct = 40
                    for raw in proc.stdout:
                        ln = raw.rstrip("\r\n")
                        if ln:
                            pct = min(84, pct + 8)
                            emit_prog("Eliminando aplicación Flatpak...", pct, ln)
                    rc = proc.wait(timeout=180)
                    if rc != 0:
                        err_msg = "Desinstalación cancelada por el usuario." if rc in (126, 127) else "Flatpak devolvió un error al desinstalar."
                        self.done.emit(json.dumps({
                            "ok": False, "appName": self.app_name, "pkgName": self.pkg_or_id,
                            "error": err_msg, "log": "\n".join(log_lines[-40:])
                        }))
                        return

                elif self.source == "local":
                    user_apps_dir = os.path.realpath(os.path.join(HOME_DIR, ".local", "share", "applications"))
                    rp = os.path.realpath(self.desktop_path) if self.desktop_path else ""
                    if not rp or not rp.startswith(user_apps_dir + os.sep) or not rp.endswith(".desktop") or not os.path.isfile(rp):
                        self.done.emit(json.dumps({
                            "ok": False, "appName": self.app_name, "pkgName": self.pkg_or_id,
                            "error": "No se encontró un lanzador local de usuario válido.", "log": ""
                        }))
                        return
                    emit_prog("Eliminando acceso local de aplicación...", 50, f"rm {rp}")
                    os.remove(rp)
                else:
                    self.done.emit(json.dumps({
                        "ok": False, "appName": self.app_name, "pkgName": self.pkg_or_id,
                        "error": "Origen de aplicación no soportado para desinstalación.", "log": ""
                    }))
                    return

                # Optional user-data cleanup (strictly recomputed safe paths inside $HOME!)
                cleaned_dirs = []
                if self.clean_user_data:
                    safe_dirs = _find_safe_user_data_paths(self.pkg_or_id, self.app_name, self.source)
                    for sd in safe_dirs:
                        try:
                            emit_prog("Limpiando datos locales del usuario...", 90, f"rm -rf {sd}")
                            shutil.rmtree(sd, ignore_errors=True)
                            cleaned_dirs.append(sd)
                        except Exception:
                            pass

                emit_prog("Actualizando Menú Inicio y lista de aplicaciones...", 95, "Sincronizando sysinfo.json...")
                dump_sysinfo_file()
                emit_prog("Desinstalación completada", 100, "Listo.")
                self.done.emit(json.dumps({
                    "ok": True, "appName": self.app_name, "pkgName": self.pkg_or_id,
                    "cleanedDirs": cleaned_dirs, "error": "", "log": "\n".join(log_lines[-40:])
                }))
            except Exception as ex:
                self.done.emit(json.dumps({
                    "ok": False, "appName": self.app_name, "pkgName": self.pkg_or_id,
                    "error": str(ex)[:140], "log": "\n".join(log_lines[-40:])
                }))

