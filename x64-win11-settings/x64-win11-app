        @pyqtSlot(str, str, str, str, result=str)
        def applyMonitorAdvanced(self, output_name, transform_str, adaptive_str, power_str):
            if not output_name:
                return "error:Monitor inválido"
            # Safety guard: never allow turning off the only enabled monitor!
            if power_str == "off":
                try:
                    wdata = json.loads(subprocess.check_output(["wlr-randr", "--json"], text=True, timeout=1.5, stderr=subprocess.DEVNULL))
                    enabled_mons = [m.get("name") for m in (wdata if isinstance(wdata, list) else []) if m.get("enabled")]
                    if len(enabled_mons) <= 1 and output_name in enabled_mons:
                        return "error:No puedes apagar la única pantalla activa"
                except Exception:
                    return "error:No se pudo comprobar las pantallas activas"
            cmd = ["wlr-randr", "--output", str(output_name)]
            if power_str == "on":
                cmd += ["--on"]
            elif power_str == "off":
                cmd += ["--off"]
            if transform_str in ("normal", "90", "180", "270"):
                cmd += ["--transform", transform_str]
            if adaptive_str in ("enabled", "disabled"):
                cmd += ["--adaptive-sync", adaptive_str]
            if len(cmd) <= 3:
                return "error:Sin cambios"
            try:
                r = subprocess.run(cmd, capture_output=True, text=True, timeout=2.5)
                if r.returncode != 0:
                    err = (r.stderr or r.stdout or "El monitor no soporta este ajuste").strip()
                    return f"error:{err[:90]}"
                entry = {}
                if transform_str:
                    entry["transform"] = transform_str
                if adaptive_str:
                    entry["adaptiveSync"] = adaptive_str
                if power_str == "on":
                    entry["enabled"] = True
                elif power_str == "off":
                    entry["enabled"] = False
                if entry:
                    self._save_monitors_patch({str(output_name): entry})
                if transform_str or power_str in ("on", "off"):
                    self._repack_monitors_contiguous()
                return "ok"
            except Exception as ex:
                return f"error:{str(ex)[:80]}"

