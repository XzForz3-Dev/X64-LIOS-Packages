            return f"file://{icon_name}"
        return f"file://{ASSET_DIR}windows.svg"

    low = icon_name.lower()
    builtin_map = {
        "antigravity-ide": "antigravity.png",
        "antigravity": "antigravity.png",
        "chromium": "edge.svg",
        "google-chrome": "chrome.svg",
        "firefox": "edge.svg",
        "brave": "edge.svg",
        "shelly": "store.svg",
        "org.X64.shelly": "store.svg",
        "kitty": "terminal.svg",
        "utilities-terminal": "terminal.svg",
        "x64-hello": "x64lios.png",
        "x64-hello-icon": "x64lios.png",
        "x64lios": "x64lios.png",
        "x64-update": "update.svg",
        "steam": "steam.svg",
        "discord": "discord.svg",
        "org.gnome.calculator": "calculator.svg",
        "accessories-calculator": "calculator.svg",
        "org.gnome.disks": "drive-c.svg",
        "drive-harddisk": "drive-c.svg",
        "org.gnome.loupe": "folder-images.svg",
        "org.gnome.papers": "folder-documents.svg",
        "org.gnome.fileroller": "folder.svg",
        "blueman": "bluetooth.svg",
        "preferences-system-bluetooth": "bluetooth.svg",
        "nm-connection-editor": "network.svg",
        "preferences-system-network": "network.svg",
    }
    for k, v in builtin_map.items():
        if k == low or k in low:
            p = os.path.join(ASSET_DIR, v)
            if os.path.isfile(p):
                return f"file://{p}"

    search_Files = [
        f"/usr/share/pixmaps/{icon_name}.png",
        f"/usr/share/pixmaps/{icon_name}.svg",
        f"/usr/share/icons/hicolor/scalable/apps/{icon_name}.svg",
        f"/usr/share/icons/hicolor/256x256/apps/{icon_name}.png",
