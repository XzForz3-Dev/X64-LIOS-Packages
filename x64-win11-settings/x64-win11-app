        @pyqtSlot(result=bool)
        def playTestSound(self):
            try:
                import math, struct, tempfile, wave
                sr = 44100
                dur = 0.38
                n = int(sr * dur)
                frames = bytearray()
                for i in range(n):
                    t = i / sr
                    env = min(1.0, t / 0.015) * math.exp(-t * 7.5)
                    # Pleasant Windows 11-like major fifth chime (523.25 Hz C5 + 783.99 Hz G5)
                    val = 0.35 * env * (math.sin(2 * math.pi * 523.25 * t) + 0.65 * math.sin(2 * math.pi * 783.99 * t))
                    frames += struct.pack("<h", max(-32767, min(32767, int(val * 32767))))
                tmp_wav = os.path.join(STATE_DIR, "test-chime.wav")
                os.makedirs(STATE_DIR, exist_ok=True)
                with wave.open(tmp_wav, "wb") as wf:
                    wf.setnchannels(1)
                    wf.setsampwidth(2)
                    wf.setframerate(sr)
                    wf.writeframes(bytes(frames))
                player = shutil.which("pw-play") or shutil.which("paplay") or shutil.which("aplay")
                if not player:
                    return False
                subprocess.Popen([player, tmp_wav], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
                return True
            except Exception:
                return False

