        @pyqtSlot(str, result=str)
        def mountDrive(self, device_path):
            dev = (device_path or "").strip()
            if not dev.startswith("/dev/") or not os.path.exists(dev):
                return json.dumps({"ok": False, "path": "", "error": "Dispositivo no encontrado"})
            try:
                # Check if already mounted
                cur_mnt = subprocess.check_output(["lsblk", "-no", "MOUNTPOINT", dev], text=True, timeout=1.5, stderr=subprocess.DEVNULL).strip().splitlines()
                cur_mnt = [m.strip() for m in cur_mnt if m.strip() and os.path.isdir(m.strip())]
                if cur_mnt:
                    return json.dumps({"ok": True, "path": cur_mnt[0], "error": ""})

                r = subprocess.run(["udisksctl", "mount", "-b", dev, "--no-user-interaction"], capture_output=True, text=True, timeout=10.0)
                if r.returncode != 0 and ("NotAuthorized" in (r.stderr or "") or "authentication" in (r.stderr or "").lower()):
                    r = subprocess.run(["udisksctl", "mount", "-b", dev], capture_output=True, text=True, timeout=25.0)
                if r.returncode != 0:
                    err = (r.stderr or r.stdout or "Error al montar la unidad").strip()
                    if "hibernated" in err.lower() or "unsafe state" in err.lower():
                        err = "Disco NTFS hibernado por Windows (apaga Inicio rápido en Windows)"
                    return json.dumps({"ok": False, "path": "", "error": err[:140]})

                mnt = ""
                if " at " in (r.stdout or ""):
                    mnt = r.stdout.split(" at ", 1)[1].strip().rstrip(".")
                if not mnt or not os.path.isdir(mnt):
                    out2 = subprocess.check_output(["lsblk", "-no", "MOUNTPOINT", dev], text=True, timeout=1.5, stderr=subprocess.DEVNULL).strip().splitlines()
                    for m in out2:
                        if m.strip() and os.path.isdir(m.strip()):
                            mnt = m.strip()
                            break
                dump_sysinfo_file()
                return json.dumps({"ok": bool(mnt), "path": mnt, "error": "" if mnt else "No se obtuvo ruta de montaje"})
            except Exception as e:
                return json.dumps({"ok": False, "path": "", "error": str(e)[:120]})

        @pyqtSlot(str, result=str)
        def unmountDrive(self, device_path):
            dev = (device_path or "").strip()
            if not dev.startswith("/dev/"):
                return json.dumps({"ok": False, "error": "Dispositivo inválido"})
            try:
                r = subprocess.run(["udisksctl", "unmount", "-b", dev, "--no-user-interaction"], capture_output=True, text=True, timeout=10.0)
                if r.returncode != 0 and ("NotAuthorized" in (r.stderr or "") or "authentication" in (r.stderr or "").lower()):
                    r = subprocess.run(["udisksctl", "unmount", "-b", dev], capture_output=True, text=True, timeout=20.0)
                if r.returncode != 0:
                    err = (r.stderr or r.stdout or "Unidad ocupada o en uso").strip()
                    return json.dumps({"ok": False, "error": err[:140]})
                dump_sysinfo_file()
                return json.dumps({"ok": True, "error": ""})
            except Exception as e:
                return json.dumps({"ok": False, "error": str(e)[:120]})

        @pyqtSlot(str, str, bool, bool, result=str)
        def listDirectoryExJson(self, section_or_path, sort_by="name", sort_asc=True, show_hidden=False):
            if section_or_path in ("Este equipo", "This PC"):
                return json.dumps({"mode": "thispc", "path": "Este equipo", "isReadOnly": False, "items": [], "count": 8})

            real_path = resolve_special_folder(section_or_path)
            is_trash = real_path.endswith("/Trash/files")
            is_read_only = (not is_trash) and (not os.access(real_path, os.W_OK))
            is_root_dir = (os.path.normpath(real_path) == "/")
            virtual_root_dirs = {"proc", "sys", "dev", "run", "lost+found"}
            trash_info_dir = os.path.join(HOME_DIR, ".local", "share", "Trash", "info")
            items = []
            try:
                entries = list(os.scandir(real_path))
            except Exception:
                entries = []

            for e in entries:
                if not show_hidden and (e.name.startswith(".") or (is_root_dir and e.name in virtual_root_dirs)):
                    continue
                try:
                    st = e.stat(follow_symlinks=True)
                    is_dir = e.is_dir(follow_symlinks=True)
                    mtime = datetime.fromtimestamp(st.st_mtime).strftime("%d/%m/%Y %H:%M")
                    is_img = False
                    is_arc = False
                    orig_path = ""
                    if is_trash:
                        ip = os.path.join(trash_info_dir, f"{e.name}.trashinfo")
                        if os.path.isfile(ip):
                            try:
                                for ln in open(ip, "r", encoding="utf-8", errors="ignore"):
                                    if ln.startswith("Path="):
                                        orig_path = urllib.parse.unquote(ln.split("=", 1)[1].strip())
                                    elif ln.startswith("DeletionDate="):
                                        mtime = ln.split("=", 1)[1].strip().replace("T", " ")[:16]
                            except Exception:
                                pass
                    if is_dir:
                        low = e.name.lower()
                        if "descarg" in low or "download" in low:
                            icon = "folder-download.svg"
                        elif "doc" in low:
                            icon = "folder-documents.svg"
                        elif "imág" in low or "imag" in low or "pict" in low or "foto" in low:
                            icon = "folder-images.svg"
                        elif "músic" in low or "music" in low:
                            icon = "folder-music.svg"
                        elif "vídeo" in low or "video" in low:
                            icon = "folder-videos.svg"
                        elif "escritorio" in low or "desktop" in low:
                            icon = "folder-desktop.svg"
                        elif "juego" in low or "game" in low or "steam" in low:
                            icon = "folder-games.svg"
                        else:
                            icon = "folder.svg"
                        type_label = "Carpeta de archivos"
                        size_val = ""
                        size_str = orig_path if orig_path else type_label
                        size_bytes = -1
                    else:
                        ext = os.path.splitext(e.name)[1].lower()
                        low_n = e.name.lower()
                        if ext in (".png", ".jpg", ".jpeg", ".webp", ".svg", ".gif"):
                            icon = "folder-images.svg"
                            type_label = f"Imagen {ext[1:].upper()}"
                            is_img = True
                        elif ext in (".mp4", ".mkv", ".webm", ".avi"):
                            icon = "folder-videos.svg"
                            type_label = f"Vídeo {ext[1:].upper()}"
                        elif ext in (".mp3", ".flac", ".ogg", ".wav"):
                            icon = "folder-music.svg"
                            type_label = f"Audio {ext[1:].upper()}"
                        elif ext in (".sh", ".py", ".qml", ".js", ".ts", ".rs", ".c", ".cpp", ".md", ".json", ".xml", ".txt", ".conf", ".ini"):
                            icon = "fluent-document.svg"
                            type_label = f"Archivo {ext[1:].upper()}"
                        elif ext in (".zip", ".tar", ".gz", ".zst", ".xz", ".bz2", ".7z", ".rar") or low_n.endswith((".tar.gz", ".tar.xz", ".tar.bz2")):
                            icon = "fluent-folder-zip.svg"
                            type_label = f"Comprimido {ext[1:].upper()}"
                            is_arc = True
                        else:
                            icon = "fluent-document.svg"
                            type_label = f"Archivo {ext[1:].upper()}" if ext else "Archivo"
                        sb = st.st_size
                        size_bytes = sb
                        if sb < 1024:
                            size_val = f"{sb} B"
                        elif sb < 1024 ** 2:
                            size_val = f"{sb / 1024:.1f} KB"
                        elif sb < 1024 ** 3:
                            size_val = f"{sb / (1024 ** 2):.1f} MB"
                        else:
                            size_val = f"{sb / (1024 ** 3):.2f} GB"
                        size_str = orig_path if orig_path else f"{size_val} • {type_label}"

                    items.append({
                        "name": e.name,
                        "path": e.path,
                        "fileUrl": f"file://{e.path}",
                        "isDir": is_dir,
                        "isImage": is_img,
                        "isArchive": is_arc,
                        "isHidden": e.name.startswith("."),
                        "origPath": orig_path,
                        "icon": icon,
                        "typeLabel": type_label,
                        "sizeLabel": size_val,
                        "sub": size_str,
                        "mtime": mtime,
                        "mtimeTs": st.st_mtime,
                        "sizeBytes": size_bytes
                    })
                except Exception:
                    continue

            dirs_only = [x for x in items if x["isDir"]]
            files_only = [x for x in items if not x["isDir"]]
            if sort_by == "date":
                dirs_only.sort(key=lambda x: x["mtimeTs"], reverse=sort_asc)
                files_only.sort(key=lambda x: x["mtimeTs"], reverse=sort_asc)
            elif sort_by == "size":
                dirs_only.sort(key=lambda x: x["name"].lower(), reverse=not sort_asc)
                files_only.sort(key=lambda x: (x["sizeBytes"], x["name"].lower()), reverse=sort_asc)
            elif sort_by == "type":
                dirs_only.sort(key=lambda x: x["name"].lower(), reverse=not sort_asc)
                files_only.sort(key=lambda x: (x["typeLabel"].lower(), x["name"].lower()), reverse=not sort_asc)
            else:
                dirs_only.sort(key=lambda x: x["name"].lower(), reverse=not sort_asc)
                files_only.sort(key=lambda x: x["name"].lower(), reverse=not sort_asc)

            combined = dirs_only + files_only
            return json.dumps({
                "mode": "dir",
                "path": real_path,
                "isTrash": is_trash,
                "isReadOnly": is_read_only,
                "items": combined[:500],
                "count": len(combined)
            })

