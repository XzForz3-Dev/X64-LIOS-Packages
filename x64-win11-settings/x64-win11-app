    class _NetPingWorker(QThread):
        pingDone = pyqtSignal(str)
        def run(self):
            import socket
            res = {"ok": False, "ipMs": -1, "dnsMs": -1, "gwMs": -1, "summary": "Sin respuesta de red"}
            try:
                # 1. Gateway ping (if default route exists)
                gw = ""
                try:
                    rout = subprocess.check_output(["ip", "route", "show", "default"], text=True, timeout=0.8, stderr=subprocess.DEVNULL).splitlines()
                    if rout:
                        rt = rout[0].split()
                        if "via" in rt:
                            gw = rt[rt.index("via") + 1]
                except Exception:
                    pass
                def _ping_one(host):
                    try:
                        out = subprocess.check_output(
                            ["ping", "-c", "1", "-W", "2", host],
                            text=True, timeout=3.0, stderr=subprocess.DEVNULL, env=dict(os.environ, LC_ALL="C")
                        )
                        m = re.search(r"time=([\d.]+)", out)
                        if m:
                            return round(float(m.group(1)), 1)
                    except Exception:
                        pass
                    return -1
                if gw:
                    res["gwMs"] = _ping_one(gw)
                res["ipMs"] = _ping_one("1.1.1.1")
                t0 = time.monotonic()
                try:
                    socket.getaddrinfo("repo.x64lios.com", 443)
                    res["dnsMs"] = round((time.monotonic() - t0) * 1000.0, 1)
                except Exception:
                    res["dnsMs"] = -1
                if res["ipMs"] >= 0:
                    res["ok"] = True
                    parts = []
                    if res["gwMs"] >= 0:
                        parts.append(f"Router {res['gwMs']} ms")
                    parts.append(f"Internet {res['ipMs']} ms")
                    if res["dnsMs"] >= 0:
                        parts.append(f"DNS {res['dnsMs']} ms")
                    res["summary"] = "  •  ".join(parts)
                elif res["gwMs"] >= 0:
                    res["summary"] = f"Router responde ({res['gwMs']} ms), sin salida a Internet"
            except Exception:
                pass
            self.pingDone.emit(json.dumps(res))

