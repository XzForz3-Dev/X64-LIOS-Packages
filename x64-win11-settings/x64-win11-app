def _base_blk_from_dev(dev_path):
    try:
        real_dev = os.path.realpath(dev_path) if dev_path else ""
        bname = os.path.basename(real_dev)
        if (bname.startswith("nvme") or bname.startswith("mmcblk")) and "p" in bname:
            return bname.rsplit("p", 1)[0]
        return bname.rstrip("0123456789")
    except Exception:
        return ""


def get_dynamic_drives():
    """
    Universal Multi-Disk & Multi-Partition discovery for ANY PC:
    Combines `lsblk --json` + `/proc/mounts` so ALL real internal disks (NVMe/SATA/HDD/SSD,
    NTFS/ext4/Btrfs/XFS/exFAT/FAT32) and USB drives appear in Este equipo, Sidebar & Settings —
    both mounted and unmounted (with 1-click udisks2 mounting).
    """
    drives = []
    letters = [chr(c) for c in range(ord("C"), ord("Z") + 1)]
    letter_idx = 0

    # Read /proc/mounts once to map real device -> mountpoint and detect root device
    mounts_by_dev = {}
    root_dev_real = ""
    root_fstype = "BTRFS"
    try:
        with open("/proc/mounts", "r", encoding="utf-8") as f:
            for line in f:
                parts = line.split()
                if len(parts) < 3:
                    continue
                dev, mnt, fstype = parts[0], parts[1].replace("\\040", " "), parts[2]
                if mnt == "/":
                    root_dev_real = os.path.realpath(dev) if dev.startswith("/dev/") else dev
                    root_fstype = fstype.upper()
                if dev.startswith("/dev/"):
                    rdev = os.path.realpath(dev)
                    # Prefer user/media mountpoints over /var/* or /boot/*
                    prev = mounts_by_dev.get(rdev)
                    if prev is None or prev[0].startswith("/var/") or prev[0] in ("/home",):
                        if not mnt.startswith("/var/") and not mnt.startswith("/snap"):
                            mounts_by_dev[rdev] = (mnt, fstype)
    except Exception:
        pass

    root_base_blk = _base_blk_from_dev(root_dev_real)

    # 1. Root filesystem (C:)
    try:
        usage = shutil.disk_usage("/")
        total_gb = usage.total / (1024 ** 3)
        free_gb = usage.free / (1024 ** 3)
        used_ratio = max(0.04, min(1.0, (usage.total - usage.free) / max(1, usage.total)))
        drives.append({
            "name": "X64 LIOS Sistema (C:)",
            "letter": "C:",
            "path": "/",
            "device": root_dev_real,
            "baseBlk": root_base_blk,
            "mounted": True,
            "isSystem": True,
            "removable": False,
            "fstype": root_fstype,
            "sizeGb": round(total_gb, 1),
            "icon": "drive-c.svg",
            "usedRatio": round(used_ratio, 3),
            "isCritical": used_ratio >= 0.90,
            "info": f"{free_gb:.1f} GB disponibles de {total_gb:.1f} GB"
        })
        letter_idx = 1
    except Exception:
        pass

    # 2. Discover ALL real secondary partitions & removable volumes (mounted AND unmounted) via lsblk
    valid_fs = {"btrfs", "ext4", "ext3", "ext2", "xfs", "f2fs", "ntfs", "ntfs3", "fuseblk", "vfat", "exfat", "hfsplus", "iso9660", "udf"}
    skip_parttypes = {
        "c12a7328-f81f-11d2-ba4b-00a0c93ec93b",  # EFI System Partition
        "e3c9e316-0b5c-4db8-817d-f92df00215ae",  # Microsoft Reserved (MSR)
        "de94bba4-06d1-4d40-a16a-bfd50179d6ac",  # Windows Recovery Environment
        "21686148-6449-6e6f-744e-656564454649",  # BIOS Boot
        "0657fd6d-a4ab-43c4-84e5-0933c84b4f4f",  # Linux Swap
    }
    seen_devs = {root_dev_real} if root_dev_real else set()
    seen_st_devs = set()
    try:
        seen_st_devs.add(os.stat("/").st_dev)
    except Exception:
        pass

    lsblk_ok = False
    try:
        out = subprocess.check_output(
            ["lsblk", "-J", "-b", "-o", "NAME,KNAME,PATH,SIZE,FSTYPE,LABEL,MOUNTPOINT,TYPE,RM,HOTPLUG,TRAN,MODEL,PARTTYPE,PARTLABEL,PKNAME"],
            text=True, timeout=1.8, stderr=subprocess.DEVNULL
        )
        data = json.loads(out)
        lsblk_ok = True

        def walk_blk(node, parent_model="", parent_tran="", parent_rm=False, parent_hotplug=False, parent_blk=""):
            nonlocal letter_idx
            name = str(node.get("name") or "")
            kname = str(node.get("kname") or name)
            dev_path = str(node.get("path") or (f"/dev/{kname}" if kname else ""))
            btype = str(node.get("type") or "")
            fstype = str(node.get("fstype") or "").lower()
            label = str(node.get("label") or "").strip()
            partlabel = str(node.get("partlabel") or "").strip()
            parttype = str(node.get("parttype") or "").lower().strip()
            model = str(node.get("model") or "").strip() or parent_model
            tran = str(node.get("tran") or "").lower().strip() or parent_tran
            rm = bool(node.get("rm")) or parent_rm
            hotplug = bool(node.get("hotplug")) or parent_hotplug
            cur_blk = kname if btype == "disk" else (parent_blk or str(node.get("pkname") or _base_blk_from_dev(dev_path)))

            if kname.startswith(("zram", "loop", "ram")):
                return

            children = node.get("children") or []
            if children:
                for ch in children:
                    walk_blk(ch, model, tran, rm, hotplug, cur_blk)
                return

            if not dev_path or fstype not in valid_fs:
                return
            if parttype in skip_parttypes:
                return
            if btype == "rom" and not fstype:
                return

            rdev = os.path.realpath(dev_path) if os.path.exists(dev_path) else dev_path
            if rdev in seen_devs:
                return

            mnt = str(node.get("mountpoint") or "").strip()
            if rdev in mounts_by_dev:
                mnt = mounts_by_dev[rdev][0]
            if mnt in ("/", "/boot", "/boot/efi", "/efi", "[SWAP]") or mnt.startswith(("/var/", "/snap/")):
                return

            size_b = int(node.get("size") or 0)
            size_gb = size_b / (1024 ** 3)
            # Skip tiny hidden system partitions (< 128 MB) unless explicitly user-mounted
            if size_b < 128 * 1024 * 1024 and not mnt.startswith(("/run/media/", "/mnt/", "/media/")):
                return
            if partlabel.lower() in ("efi", "efi system partition", "microsoft reserved partition", "recovery"):
                return

            mounted = bool(mnt and os.path.isdir(mnt))
            if mounted:
                try:
                    st_dev = os.stat(mnt).st_dev
                    if st_dev in seen_st_devs:
                        return
                    seen_st_devs.add(st_dev)
                except Exception:
                    pass

            seen_devs.add(rdev)
            ltr = letters[min(letter_idx, len(letters) - 1)]
            letter_idx += 1

            is_removable = bool(rm or hotplug or tran == "usb")
            fs_disp = "NTFS" if fstype in ("ntfs", "ntfs3", "fuseblk") else fstype.upper()
            brand = model.split()[0] if model else ""
            if brand.upper() in ("ATA", "ST", "GENERIC"):
                brand = model[:18].strip()

            mnt_base = os.path.basename(mnt.rstrip("/")) if mounted else ""
            is_hex_uuid = bool(mnt_base and re.fullmatch(r"[0-9A-Fa-f\-]{8,}", mnt_base))

            if label:
                disp_name = f"{label} ({ltr}:)"
            elif mounted and mnt_base and not is_hex_uuid and mnt_base.lower() not in ("mnt", "media", "run"):
                disp_name = f"{mnt_base} ({ltr}:)"
            elif is_removable:
                disp_name = f"Unidad USB {brand} ({ltr}:)".replace("  ", " ")
            elif brand:
                disp_name = f"Disco local {brand} ({ltr}:)"
            else:
                disp_name = f"Disco local ({ltr}:)"

            if mounted:
                try:
                    usage = shutil.disk_usage(mnt)
                    t_gb = usage.total / (1024 ** 3)
                    f_gb = usage.free / (1024 ** 3)
                    used_ratio = max(0.02, min(1.0, (usage.total - usage.free) / max(1, usage.total)))
                    info_str = f"{fs_disp} • {f_gb:.1f} GB libres de {t_gb:.1f} GB"
                    size_gb = t_gb
                except Exception:
                    used_ratio = 0.0
                    info_str = f"{fs_disp} • {size_gb:.1f} GB"
            else:
                used_ratio = 0.0
                info_str = f"{fs_disp} • {size_gb:.1f} GB — Clic para montar"

            drives.append({
                "name": disp_name,
                "letter": f"{ltr}:",
                "path": mnt if mounted else "",
                "device": dev_path,
                "baseBlk": cur_blk,
                "mounted": mounted,
                "isSystem": False,
                "removable": is_removable,
                "fstype": fs_disp,
                "model": model,
                "sizeGb": round(size_gb, 1),
                "icon": "drive.svg",
                "usedRatio": round(used_ratio, 3),
                "isCritical": mounted and used_ratio >= 0.90,
                "info": info_str
            })

        for top in (data.get("blockdevices") or []):
            walk_blk(top)
    except Exception:
        pass

    # Fallback to /proc/mounts only if lsblk failed completely
    if not lsblk_ok:
        for rdev, (mnt, fstype) in mounts_by_dev.items():
            if rdev in seen_devs or fstype not in valid_fs or mnt in ("/", "/boot", "/boot/efi"):
                continue
            try:
                usage = shutil.disk_usage(mnt)
                t_gb = usage.total / (1024 ** 3)
                f_gb = usage.free / (1024 ** 3)
                if t_gb < 0.2:
                    continue
                used_ratio = max(0.02, min(1.0, (usage.total - usage.free) / max(1, usage.total)))
                ltr = letters[min(letter_idx, len(letters) - 1)]
                letter_idx += 1
                lbl = os.path.basename(mnt.rstrip("/")) or "Volumen"
                drives.append({
                    "name": f"{lbl.capitalize()} ({ltr}:)",
                    "letter": f"{ltr}:",
                    "path": mnt,
                    "device": rdev,
                    "baseBlk": _base_blk_from_dev(rdev),
                    "mounted": True,
                    "isSystem": False,
                    "removable": False,
                    "fstype": fstype.upper(),
                    "sizeGb": round(t_gb, 1),
                    "icon": "drive.svg",
                    "usedRatio": round(used_ratio, 3),
                    "isCritical": used_ratio >= 0.90,
                    "info": f"{fstype.upper()} • {f_gb:.1f} GB libres de {t_gb:.1f} GB"
                })
            except Exception:
                continue

    # 3. Always include user's Home volume card in "Dispositivos y unidades" (without stealing D:/E: from real disks)
    try:
        display_name, _, _ = get_real_user_info()
        usage = shutil.disk_usage(HOME_DIR)
        t_gb = usage.total / (1024 ** 3)
        f_gb = usage.free / (1024 ** 3)
        used_ratio = max(0.04, min(1.0, (usage.total - usage.free) / max(1, usage.total)))
        drives.append({
            "name": f"Carpeta Personal — {display_name} (HOME)",
            "letter": "HOME",
            "path": HOME_DIR,
            "device": "",
            "baseBlk": "",
            "mounted": True,
            "isSystem": True,
            "isHomeVolume": True,
            "removable": False,
            "fstype": root_fstype,
            "sizeGb": round(t_gb, 1),
            "icon": "drive.svg",
            "usedRatio": round(used_ratio, 3),
            "isCritical": used_ratio >= 0.90,
            "info": f"Espacio de usuario • {f_gb:.1f} GB libres"
        })
    except Exception:
        pass

    return drives


