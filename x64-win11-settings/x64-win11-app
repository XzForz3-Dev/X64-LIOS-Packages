                                is_img = (not is_dir) and ext in (".png", ".jpg", ".jpeg", ".webp", ".svg", ".gif")
                                is_arc = (not is_dir) and (ext in (".zip", ".tar", ".gz", ".xz", ".bz2", ".zst", ".7z", ".rar") or nm.lower().endswith((".tar.gz", ".tar.xz", ".tar.bz2")))
                                sb = st.st_size if not is_dir else -1
                                sz = "" if is_dir else (f"{sb} B" if sb < 1024 else (f"{sb/1024:.1f} KB" if sb < 1024**2 else f"{sb/(1024**2):.1f} MB"))
                                results.append({
