        f"/usr/share/icons/Papirus-Dark/48x48/apps/{icon_name}.svg",
        f"/usr/share/icons/breeze-dark/apps/48/{icon_name}.svg",
    ]
    for cand in search_Files:
        if os.path.isfile(cand):
            return f"file://{cand}"
    return f"file://{ASSET_DIR}windows.svg"


def scan_installed_desktop_apps():
    dirs = [
        "/usr/share/applications",
        os.path.join(HOME_DIR, ".local", "share", "applications"),
    ]
    seen_names = set()
    apps = []
    for d in dirs:
        if not os.path.isdir(d):
            continue
        for fname in sorted(os.listdir(d)):
            if not fname.endswith(".desktop"):
                continue
            fpath = os.path.join(d, fname)
            try:
                with open(fpath, "r", encoding="utf-8", errors="ignore") as f:
                    lines = f.read().splitlines()
            except Exception:
                continue

            in_entry = False
            name = ""
            name_es = ""
            exec_cmd = ""
            icon = ""
            cats = ""
            no_display = False
            hidden = False
            terminal = False

            for raw in lines:
                line = raw.strip()
                if not line or line.startswith("#"):
                    continue
                if line.startswith("["):
                    if line == "[Desktop Entry]":
                        in_entry = True
                        continue
                    elif in_entry:
                        break
                if not in_entry or "=" not in line:
                    continue
                k, v = line.split("=", 1)
                k = k.strip()
                v = v.strip()
                if k == "Name":
                    name = v
                elif k in ("Name[es]", "Name[es_ES]", "Name[es_PA]"):
                    name_es = v
                elif k == "Exec":
                    exec_cmd = v
                elif k == "Icon":
                    icon = v
                elif k == "Categories":
                    cats = v
                elif k == "NoDisplay" and v.lower() == "true":
                    no_display = True
                elif k == "Hidden" and v.lower() == "true":
                    hidden = True
                elif k == "Terminal" and v.lower() == "true":
                    terminal = True

            if no_display or hidden or not exec_cmd:
                continue
            # Skip raw terminal TUIs unless it's btop/nvim/opencode
            clean_exec = " ".join(
                tok for tok in exec_cmd.split()
                if not tok.startswith("%")
            ).strip()
            if not clean_exec:
                continue
            if terminal:
                base_bin = clean_exec.split()[0]
                if os.path.basename(base_bin) not in ("btop", "opencode", "nvim"):
                    continue
                clean_exec = f"kitty -e {clean_exec}"

            final_name = name_es or name
            if not final_name:
                continue
            key = final_name.lower()
            if key in seen_names:
                continue
            seen_names.add(key)

            apps.append({
                "id": fname[:-8],
                "name": final_name,
                "cmd": clean_exec,
                "iconUrl": resolve_app_icon_url(icon),
                "categories": cats.lower()
            })

    apps.sort(key=lambda x: x["name"].lower())
    return apps


def build_calendar_data():
    now = datetime.now()
    months_es = [
        "", "enero", "febrero", "marzo", "abril", "mayo", "junio",
        "julio", "agosto", "septiembre", "octubre", "noviembre", "diciembre"
    ]
    cal = calendar.Calendar(firstweekday=0)  # Monday first
    month_days = list(cal.itermonthdays(now.year, now.month))
    cells = [{"label": h, "isToday": False, "isCurrentMonth": True, "isHeader": True}
             for h in ("L", "M", "X", "J", "V", "S", "D")]
    for d in month_days:
        if d == 0:
            cells.append({"label": "", "isToday": False, "isCurrentMonth": False, "isHeader": False})
        else:
            cells.append({
                "label": str(d),
                "isToday": (d == now.day),
                "isCurrentMonth": True,
                "isHeader": False
            })
    return {
        "header": f"{months_es[now.month].capitalize()} de {now.year}",
        "cells": cells
    }


