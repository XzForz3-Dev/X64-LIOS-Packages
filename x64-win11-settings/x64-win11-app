                s = "none"
            pair = f"{p},{s}" if s != "none" else p
            opt = (toggle_opt or "grp:alt_shift_toggle").strip()
            if opt not in ("grp:alt_shift_toggle", "grp:ctrl_shift_toggle", "none"):
