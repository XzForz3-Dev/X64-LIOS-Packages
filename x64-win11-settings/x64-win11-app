        @pyqtSlot(bool, result=str)
        def setUpdateTrayEnabled(self, enabled):
            en = bool(enabled)
            if en and shutil.which("x64-update-tray") is None:
                return "error:x64-update-tray no está instalado"
            try:
                auto_dir = os.path.join(HOME_DIR, ".config", "autostart")
                os.makedirs(auto_dir, exist_ok=True)
                user_desk = os.path.join(auto_dir, "x64-update-tray.desktop")
                sys_desk = "/etc/xdg/autostart/x64-update-tray.desktop"
                if os.path.isfile(sys_desk):
                    with open(sys_desk, "r", encoding="utf-8", errors="ignore") as sf:
                        base_lines = [
                            ln for ln in sf.read().splitlines()
                            if not ln.lower().startswith(("hidden=", "x-gnome-autostart-enabled="))
                        ]
                else:
                    base_lines = [
                        "[Desktop Entry]",
                        "Name=X64 Update Tray",
                        "Comment=Notificador de actualizaciones de X64 LIOS",
                        "Exec=x64-update-tray",
                        "Icon=x64-update",
                        "Terminal=false",
                        "Type=Application",
                        "StartupNotify=false",
                        "NoDisplay=true",
                    ]
                base_lines.append("Hidden=false" if en else "Hidden=true")
                base_lines.append("X-GNOME-Autostart-enabled=true" if en else "X-GNOME-Autostart-enabled=false")
                with open(user_desk, "w", encoding="utf-8") as df:
                    df.write("\n".join(base_lines) + "\n")

                if en:
                    if not _is_update_tray_running():
                        subprocess.Popen(
                            ["/usr/bin/x64-update-tray"],
                            start_new_session=True,
                            stdout=subprocess.DEVNULL,
                            stderr=subprocess.DEVNULL,
                        )
                        time.sleep(0.25)
                else:
                    my_uid = os.getuid()
                    for pid in os.listdir("/proc"):
                        if not pid.isdigit():
                            continue
                        pdir = os.path.join("/proc", pid)
                        try:
                            if os.stat(pdir).st_uid != my_uid:
                                continue
                            cmd = open(os.path.join(pdir, "cmdline"), "rb").read().replace(b"\x00", b" ").decode("utf-8", "ignore")
                            if "/usr/bin/x64-update-tray" in cmd or cmd.strip().endswith("x64-update-tray"):
                                os.kill(int(pid), signal.SIGTERM)
                        except Exception:
                            continue
                    time.sleep(0.15)
                return "ok"
            except Exception as ex:
                return "error:" + str(ex)[:110]

