            }

            if force_slow or (now_ts - self._cache_storage_ts) > 30.0:
                trash_files_dir = os.path.join(HOME_DIR, ".local", "share", "Trash", "files")
                tr_count = 0
                tr_bytes = 0
                try:
                    if os.path.isdir(trash_files_dir):
                        for e in os.scandir(trash_files_dir):
                            tr_count += 1
                            if e.is_file(follow_symlinks=False):
                                tr_bytes += e.stat(follow_symlinks=False).st_size
                            elif e.is_dir(follow_symlinks=False):
                                for rdir, _, fls in os.walk(e.path):
                                    for fn in fls:
                                        try:
                                            tr_bytes += os.path.getsize(os.path.join(rdir, fn))
                                        except Exception:
                                            pass
                except Exception:
                    pass
                def fmt_sz(nb):
                    if nb < 1024: return f"{nb} B"
                    if nb < 1024**2: return f"{nb / 1024:.1f} KB"
                    if nb < 1024**3: return f"{nb / (1024**2):.1f} MB"
                    return f"{nb / (1024**3):.2f} GB"

                pac_bytes = 0
                pac_files = 0
                try:
                    pac_dir = "/var/cache/pacman/pkg"
                    if os.path.isdir(pac_dir):
                        for e in os.scandir(pac_dir):
                            if e.is_file(follow_symlinks=False):
                                pac_files += 1
                                pac_bytes += e.stat(follow_symlinks=False).st_size
                except Exception:
                    pass

                # Fast batched du -sb for ~/.cache, /var/log/journal, and personal folders (cached 30s in worker thread!)
                user_cache_dir = os.path.join(HOME_DIR, ".cache")
                journal_dir = "/var/log/journal"
                folder_specs = [
                    ("Descargas",  "folder-download.svg",  resolve_special_folder("Descargas")),
                    ("Documentos", "folder-documents.svg", resolve_special_folder("Documentos")),
                    ("Imágenes",   "folder-images.svg",    resolve_special_folder("Imágenes")),
                    ("Vídeos",     "folder-videos.svg",    resolve_special_folder("Vídeos")),
                    ("Música",     "folder-music.svg",     resolve_special_folder("Música")),
                ]
                du_targets = []
                for p in [user_cache_dir, journal_dir] + [sp[2] for sp in folder_specs]:
                    if p and os.path.isdir(p) and p not in du_targets:
                        du_targets.append(p)
                du_sizes = {}
                if du_targets:
                    try:
                        du_res = subprocess.run(
                            ["du", "-sb", "--"] + du_targets,
                            capture_output=True, text=True, timeout=4.0
                        )
                        for ln in (du_res.stdout or "").splitlines():
                            parts = ln.split("\t", 1)
                            if len(parts) == 2 and parts[0].strip().isdigit():
                                du_sizes[parts[1].strip()] = int(parts[0].strip())
                    except Exception:
                        pass

                uc_bytes = du_sizes.get(user_cache_dir, 0)
                jn_bytes = du_sizes.get(journal_dir, 0)
                user_folders = []
                for f_key, f_icon, f_path in folder_specs:
