                    return "error:No se puede eliminar una cuenta del sistema"
            except KeyError:
                return "error:La cuenta ya no existe"
            try:
                cmd = ["pkexec", "/usr/bin/userdel"] + (["-r"] if remove_home else []) + [un]
                r = subprocess.run(cmd, capture_output=True, text=True, timeout=30.0)
                if r.returncode == 0:
                    return "ok"
                if r.returncode in (126, 127):
                    return "error:Autorización cancelada por el usuario"
                return "error:" + ((r.stderr or r.stdout or "No se pudo eliminar la cuenta").strip()[:120])
            except Exception as ex:
                return "error:" + str(ex)[:120]

