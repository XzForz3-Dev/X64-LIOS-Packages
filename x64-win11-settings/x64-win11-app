            rr = max(15, min(60, int(repeat_rate)))
            rd = max(200, min(1000, int(repeat_delay)))
            nl = "on" if bool(numlock_on) else "off"
            rc_p = os.path.join(HOME_DIR, ".config", "labwc", "rc.xml")
            try:
                os.makedirs(os.path.dirname(rc_p), exist_ok=True)
                if not os.path.isfile(rc_p) and os.path.isfile("/etc/xdg/x64-win11/labwc/rc.xml"):
                    shutil.copy2("/etc/xdg/x64-win11/labwc/rc.xml", rc_p)
                txt = open(rc_p, "r", encoding="utf-8", errors="ignore").read() if os.path.isfile(rc_p) else "<labwc_config><keyboard></keyboard></labwc_config>"
                txt = re.sub(r"\n?[ \t]*<(?:repeatRate|repeatDelay|numlock)>[^<]*</(?:repeatRate|repeatDelay|numlock)>", "", txt)
                inject = f"\n    <repeatRate>{rr}</repeatRate>\n    <repeatDelay>{rd}</repeatDelay>\n    <numlock>{nl}</numlock>"
                if "<keyboard>" in txt:
                    txt = txt.replace("<keyboard>", "<keyboard>" + inject, 1)
                elif "</labwc_config>" in txt:
                    txt = txt.replace("</labwc_config>", f"  <keyboard>{inject}\n  </keyboard>\n</labwc_config>", 1)
                with open(rc_p + ".tmp", "w", encoding="utf-8") as f:
                    f.write(txt)
                os.replace(rc_p + ".tmp", rc_p)
                subprocess.run(["pkill", "-HUP", "-x", "labwc"], timeout=1.0, stderr=subprocess.DEVNULL)
                return True
            except Exception:
                return False

