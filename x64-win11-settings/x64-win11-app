def is_pkg_system_protected(pkg_name):
    p = (pkg_name or "").strip().lower()
    if not p:
        return False
    if p in PROTECTED_SYSTEM_PKGS:
        return True
    return any(p.startswith(pref) for pref in PROTECTED_SYSTEM_PREFIXES)


def _fmt_size_bytes(n):
    try:
        n = float(n or 0)
    except Exception:
        n = 0.0
    if n <= 0:
        return "—"
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024.0 or unit == "TB":
            return f"{n:.1f} {unit}" if unit != "B" else f"{int(n)} B"
        n /= 1024.0
    return "—"


def _dir_size_bytes(path, max_files=4000):
    total = 0
    cnt = 0
    try:
        if os.path.isfile(path) or os.path.islink(path):
            return os.path.getsize(path)
        for dp, _, fns in os.walk(path):
            for fn in fns:
                cnt += 1
                if cnt > max_files:
                    return total
                try:
                    total += os.path.getsize(os.path.join(dp, fn))
                except Exception:
                    pass
    except Exception:
        pass
    return total


def _find_safe_user_data_paths(pkg_or_id, app_name, source):
    found = []
    seen = set()
    real_home = os.path.realpath(HOME_DIR)
    if source == "flatpak" and pkg_or_id and "." in pkg_or_id and "/" not in pkg_or_id:
        fp_var = os.path.join(HOME_DIR, ".var", "app", pkg_or_id)
        if os.path.isdir(fp_var):
            rp = os.path.realpath(fp_var)
            if rp.startswith(real_home + os.sep):
                found.append(fp_var)
                seen.add(rp)
        return found

    cands = set()
    for raw in (pkg_or_id or "", app_name or ""):
        s = raw.strip().lower()
        if not s:
            continue
        cands.add(s)
        cands.add(re.sub(r"[^a-z0-9._-]+", "-", s).strip("-"))
        cands.add(re.sub(r"[^a-z0-9]+", "", s))
        if s.endswith("-bin") or s.endswith("-git"):
            cands.add(s[:-4])

    clean_cands = [c for c in cands if len(c) >= 3 and "/" not in c and ".." not in c and c not in UNSAFE_USERDATA_SLUGS]
    bases = [
        os.path.join(HOME_DIR, ".config"),
        os.path.join(HOME_DIR, ".cache"),
        os.path.join(HOME_DIR, ".local", "share"),
    ]
    for base in bases:
        if not os.path.isdir(base):
            continue
        try:
            entries = os.listdir(base)
        except Exception:
            continue
        lower_map = {e.lower(): e for e in entries}
        for c in clean_cands:
            if c in lower_map:
                full = os.path.join(base, lower_map[c])
                rp = os.path.realpath(full)
                if rp.startswith(real_home + os.sep) and rp not in seen and os.path.isdir(full):
                    seen.add(rp)
                    found.append(full)
    return found[:6]


def _scan_pacman_local_index():
    """Fast pure-Python index of /var/lib/pacman/local (<100ms, zero subprocesses)."""
    desktop_to_pkg = {}
    bin_to_pkg = {}
    pkg_meta = {}
    base = "/var/lib/pacman/local"
    if not os.path.isdir(base):
        return desktop_to_pkg, bin_to_pkg, pkg_meta
    try:
        dirs = os.listdir(base)
    except Exception:
        return desktop_to_pkg, bin_to_pkg, pkg_meta
    for d in dirs:
        dp = os.path.join(base, d)
        desc_p = os.path.join(dp, "desc")
        if not os.path.isfile(desc_p):
            continue
        name = ver = desc = packager = ""
        size_b = 0
        inst_ts = 0
        cur = None
        try:
            with open(desc_p, "r", encoding="utf-8", errors="ignore") as f:
                for raw in f:
                    s = raw.strip()
                    if s.startswith("%") and s.endswith("%"):
                        cur = s
                    elif s:
                        if cur == "%NAME%":
                            name = s
                        elif cur == "%VERSION%":
                            ver = s
                        elif cur == "%DESC%":
                            desc = s
                        elif cur == "%PACKAGER%":
                            packager = s
                        elif cur == "%SIZE%":
                            try:
                                size_b = int(s)
                            except Exception:
                                pass
                        elif cur == "%INSTALLDATE%":
                            try:
                                inst_ts = int(s)
                            except Exception:
                                pass
        except Exception:
            continue
        if not name:
            continue
        inst_date = ""
        if inst_ts > 0:
            try:
                inst_date = datetime.fromtimestamp(inst_ts).strftime("%d/%m/%Y")
            except Exception:
                pass
        pub = "Arch / CachyOS"
        if "x64" in name.lower() or "x64" in packager.lower():
            pub = "X64 Studios"
        elif "cachyos" in packager.lower():
            pub = "CachyOS"
        elif packager and "<" in packager:
            pub = packager.split("<", 1)[0].strip() or "Arch / CachyOS"
        pkg_meta[name] = {
            "version": ver,
            "sizeBytes": size_b,
            "desc": desc,
            "installDate": inst_date,
            "publisher": pub,
        }
        files_p = os.path.join(dp, "files")
        if os.path.isfile(files_p):
            try:
                with open(files_p, "r", encoding="utf-8", errors="ignore") as f:
                    for raw in f:
                        s = raw.strip()
                        if s.startswith("usr/share/applications/") and s.endswith(".desktop"):
                            desktop_to_pkg["/" + s] = name
                        elif s.startswith("usr/bin/") and "/" not in s[8:]:
                            bin_to_pkg[s[8:]] = name
            except Exception:
                pass
    return desktop_to_pkg, bin_to_pkg, pkg_meta


def _scan_flatpak_apps_map():
    fp_map = {}
    if not shutil.which("flatpak"):
        return fp_map
    try:
        out = subprocess.check_output(
            ["flatpak", "list", "--app", "--columns=application,name,version,size,origin,installation"],
            text=True, timeout=2.5, stderr=subprocess.DEVNULL, env=dict(os.environ, LC_ALL="C")
        )
        for ln in out.splitlines():
            parts = ln.split("\t")
            if len(parts) < 2:
                continue
            app_id = parts[0].strip()
            if not app_id:
                continue
            nm = parts[1].strip() if len(parts) > 1 else app_id
            ver = parts[2].strip() if len(parts) > 2 else ""
            sz_str = parts[3].strip() if len(parts) > 3 else ""
            origin = parts[4].strip() if len(parts) > 4 else "Flathub"
            scope = parts[5].strip().lower() if len(parts) > 5 else "system"
            # Parse flatpak size string like "412.3 MB" or "85.2 kB"
            sz_b = 0
            m = re.match(r"([\d.,]+)\s*([kKmMgGtT]?)[bB]?", sz_str.replace("\xa0", " "))
            if m:
                try:
                    val = float(m.group(1).replace(",", "."))
                    u = m.group(2).lower()
                    mul = {"": 1, "k": 1024, "m": 1024**2, "g": 1024**3, "t": 1024**4}.get(u, 1)
                    sz_b = int(val * mul)
                except Exception:
                    pass
            fp_map[app_id] = {
                "name": nm,
                "version": ver,
                "sizeBytes": sz_b,
                "sizeHuman": _fmt_size_bytes(sz_b) if sz_b > 0 else (sz_str or "—"),
                "origin": origin or "Flathub",
                "scope": "user" if "user" in scope else "system",
            }
    except Exception:
        pass
    return fp_map


def scan_installed_desktop_apps(detailed=False):
    dirs = [
        "/usr/share/applications",
        "/var/lib/flatpak/exports/share/applications",
        os.path.join(HOME_DIR, ".local", "share", "flatpak", "exports", "share", "applications"),
        os.path.join(HOME_DIR, ".local", "share", "applications"),
    ]
    desktop_to_pkg, bin_to_pkg, pkg_meta = _scan_pacman_local_index() if detailed else ({}, {}, {})
    fp_map = _scan_flatpak_apps_map() if detailed else {}
    seen_names = set()
    apps = []
    user_apps_dir = os.path.realpath(os.path.join(HOME_DIR, ".local", "share", "applications"))

    for d in dirs:
        if not os.path.isdir(d):
            continue
        for fname in sorted(os.listdir(d)):
            if not fname.endswith(".desktop"):
                continue
            fpath = os.path.join(d, fname)
            try:
                with open(fpath, "r", encoding="utf-8", errors="ignore") as f:
                    lines = f.read().splitlines()
            except Exception:
                continue

            in_entry = False
            name = ""
            name_es = ""
            comment = ""
            comment_es = ""
            exec_cmd = ""
            icon = ""
            cats = ""
            x_flatpak = ""
            no_display = False
            hidden = False
            terminal = False

            for raw in lines:
                line = raw.strip()
                if not line or line.startswith("#"):
                    continue
                if line.startswith("["):
                    if line == "[Desktop Entry]":
                        in_entry = True
                        continue
                    elif in_entry:
                        break
                if not in_entry or "=" not in line:
                    continue
                k, v = line.split("=", 1)
                k = k.strip()
                v = v.strip()
                if k == "Name":
                    name = v
                elif k in ("Name[es]", "Name[es_ES]", "Name[es_PA]"):
                    name_es = v
                elif k == "Comment":
                    comment = v
                elif k in ("Comment[es]", "Comment[es_ES]", "Comment[es_PA]"):
                    comment_es = v
                elif k == "Exec":
                    exec_cmd = v
                elif k == "Icon":
                    icon = v
                elif k == "Categories":
                    cats = v
                elif k == "X-Flatpak":
                    x_flatpak = v
                elif k == "NoDisplay" and v.lower() == "true":
                    no_display = True
                elif k == "Hidden" and v.lower() == "true":
                    hidden = True
                elif k == "Terminal" and v.lower() == "true":
                    terminal = True

            if no_display or hidden or not exec_cmd:
                continue
            # Skip raw terminal TUIs unless it's btop/nvim/opencode
            clean_exec = " ".join(
                tok for tok in exec_cmd.split()
                if not tok.startswith("%")
            ).strip()
            if not clean_exec:
                continue
            if terminal:
                base_bin = clean_exec.split()[0]
                if os.path.basename(base_bin) not in ("btop", "opencode", "nvim"):
                    continue
                clean_exec = f"kitty -e {clean_exec}"

            final_name = name_es or name
            if not final_name:
                continue
            key = final_name.lower()
            if key in seen_names:
                continue
            seen_names.add(key)

            entry = {
                "id": fname[:-8],
                "name": final_name,
                "cmd": clean_exec,
                "iconUrl": resolve_app_icon_url(icon),
                "categories": cats.lower(),
            }
            if detailed:
                # Detect source: flatpak > pacman > local
                fp_id = x_flatpak
                if not fp_id and ("flatpak run" in exec_cmd or "/flatpak/exports/" in fpath):
                    m_fp = re.search(r"flatpak\s+run\s+(?:--[^\s]+\s+)*([A-Za-z0-9_.-]+\.[A-Za-z0-9_.-]+)", exec_cmd)
                    fp_id = m_fp.group(1) if m_fp else fname[:-8]

                source = "local"
                source_label = "Local"
                pkg_name = fname[:-8]
                version = ""
                size_bytes = 0
                install_date = ""
                publisher = "Aplicación local"
                fp_scope = ""
                protected = False
                can_uninst = False

                if fp_id and (fp_id in fp_map or "/flatpak/exports/" in fpath):
                    meta = fp_map.get(fp_id, {})
                    source = "flatpak"
                    source_label = "Flatpak"
                    pkg_name = fp_id
                    version = meta.get("version", "")
                    size_bytes = meta.get("sizeBytes", 0)
                    publisher = meta.get("origin", "Flathub")
                    fp_scope = meta.get("scope", "system")
                    protected = False
                    can_uninst = True
                else:
                    owner = desktop_to_pkg.get(fpath, "")
                    if not owner:
                        # Try binary owner lookup
                        toks = clean_exec.split()
                        cand_bin = toks[-1] if (toks[0] == "kitty" and len(toks) >= 3) else toks[0]
                        bname = os.path.basename(cand_bin.strip("\"'"))
                        if bname and bname not in ("env", "sh", "bash", "python", "python3", "kitty"):
                            owner = bin_to_pkg.get(bname, "")
                    if owner and owner in pkg_meta:
                        pm = pkg_meta[owner]
                        source = "pacman"
                        source_label = "Pacman"
                        pkg_name = owner
                        version = pm["version"]
                        size_bytes = pm["sizeBytes"]
                        install_date = pm["installDate"]
                        publisher = pm["publisher"]
                        protected = is_pkg_system_protected(owner)
                        can_uninst = not protected
                    else:
                        rp = os.path.realpath(fpath)
                        if rp.startswith(user_apps_dir + os.sep):
                            source = "local"
                            source_label = "Local"
                            pkg_name = fname[:-8]
                            try:
                                size_bytes = os.path.getsize(fpath)
                            except Exception:
                                size_bytes = 0
                            can_uninst = True
                        else:
                            source = "system"
                            source_label = "Sistema"
                            pkg_name = fname[:-8]
                            protected = True
                            can_uninst = False

                entry.update({
                    "comment": comment_es or comment or (pkg_meta.get(pkg_name, {}).get("desc", "") if source == "pacman" else ""),
                    "desktopPath": fpath,
                    "source": source,
                    "sourceLabel": source_label,
                    "pkgName": pkg_name,
                    "version": version,
                    "sizeBytes": size_bytes,
                    "sizeHuman": _fmt_size_bytes(size_bytes),
                    "installDate": install_date,
                    "publisher": publisher,
                    "flatpakScope": fp_scope,
                    "isSystemProtected": protected,
                    "canUninstall": can_uninst,
                })
            apps.append(entry)

    apps.sort(key=lambda x: x["name"].lower())
    return apps


def build_calendar_data():
    now = datetime.now()
    months_es = [
        "", "enero", "febrero", "marzo", "abril", "mayo", "junio",
        "julio", "agosto", "septiembre", "octubre", "noviembre", "diciembre"
    ]
    cal = calendar.Calendar(firstweekday=0)  # Monday first
    month_days = list(cal.itermonthdays(now.year, now.month))
    cells = [{"label": h, "isToday": False, "isCurrentMonth": True, "isHeader": True}
             for h in ("L", "M", "X", "J", "V", "S", "D")]
    for d in month_days:
        if d == 0:
            cells.append({"label": "", "isToday": False, "isCurrentMonth": False, "isHeader": False})
        else:
            cells.append({
                "label": str(d),
                "isToday": (d == now.day),
                "isCurrentMonth": True,
                "isHeader": False
            })
    return {
        "header": f"{months_es[now.month].capitalize()} de {now.year}",
        "cells": cells
    }


def wmo_code_to_spanish_and_icon(code, is_night=False):
    c = int(code or 0)
    if c == 0:
        if is_night:
            return "Noche despejada", "win11-weather-night-clear.svg"
        return "Soleado", "win11-weather-clear.svg"
    if c in (1, 2):
        if is_night:
            return "Parcialmente nublado", "win11-weather-night-cloudy.svg"
        return "Parcialmente nublado", "win11-weather.svg"
    if c == 3:
        if is_night:
            return "Noche nublada", "win11-weather-night-cloudy.svg"
        return "Nublado", "win11-weather.svg"
    if c in (45, 48):
        return "Niebla", "win11-weather.svg"
    if c in (51, 53, 55, 56, 57):
        return "Llovizna", "win11-weather-rain.svg"
    if c in (61, 63, 65, 66, 67, 80, 81, 82):
        return "Lluvia", "win11-weather-rain.svg"
    if c in (71, 73, 75, 77, 85, 86):
        return "Nieve", "win11-weather-rain.svg"
    if c in (95, 96, 99):
        return "Tormenta eléctrica", "win11-weather-storm.svg"
    return ("Noche nublada", "win11-weather-night-cloudy.svg") if is_night else ("Parcialmente nublado", "win11-weather.svg")


def get_live_weather_data(force_refresh=False):
    os.makedirs(STATE_DIR, exist_ok=True)
    if not force_refresh and os.path.isfile(WEATHER_CACHE_FILE):
        try:
            age = time.time() - os.path.getmtime(WEATHER_CACHE_FILE)
            if age < 180:  # 3 minutes background cache; opening the panel forces live refresh
                with open(WEATHER_CACHE_FILE, "r", encoding="utf-8") as f:
                    return json.load(f)
        except Exception:
            pass

    try:
        req = urllib.request.Request("https://ipwho.is/", headers={"User-Agent": "Mozilla/5.0"})
        geo = json.loads(urllib.request.urlopen(req, timeout=2.5).read().decode("utf-8"))
        lat = geo.get("latitude", 8.9824)
        lon = geo.get("longitude", -79.5199)
        city = geo.get("city") or "Ciudad"
        country = geo.get("country") or ""

        url = (
            f"https://api.open-meteo.com/v1/forecast?latitude={lat}&longitude={lon}"
            "&current=temperature_2m,relative_humidity_2m,apparent_temperature,is_day,weather_code,wind_speed_10m,surface_pressure"
            "&hourly=temperature_2m,weather_code,is_day"
            "&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max"
            "&timezone=auto&forecast_days=5"
        )
        wreq = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
        w = json.loads(urllib.request.urlopen(wreq, timeout=3.0).read().decode("utf-8"))

        cur = w.get("current", {})
        temp = round(float(cur.get("temperature_2m", 24)))
        feels = round(float(cur.get("apparent_temperature", temp)))
        hum = int(cur.get("relative_humidity_2m", 65))
        wind = round(float(cur.get("wind_speed_10m", 10)))
        press = round(float(cur.get("surface_pressure", 1012)))
        cur_hour = datetime.now().hour
        cur_is_night = (cur.get("is_day") == 0) if ("is_day" in cur) else (cur_hour < 6 or cur_hour >= 18)
        desc, icon = wmo_code_to_spanish_and_icon(cur.get("weather_code", 1), is_night=cur_is_night)

        # Hourly (next 5 intervals of 3 hours)
        hourly_raw = w.get("hourly", {})
        h_times = hourly_raw.get("time", [])
        h_temps = hourly_raw.get("temperature_2m", [])
        h_codes = hourly_raw.get("weather_code", [])
        h_is_day = hourly_raw.get("is_day", [])
        now_hour_str = datetime.now().strftime("%Y-%m-%dT%H:00")
        start_idx = 0
        for idx, tstr in enumerate(h_times):
            if tstr >= now_hour_str:
                start_idx = idx
                break

        hourly_list = []
        for step in range(0, 15, 3):
            ii = start_idx + step
            if ii < len(h_times) and ii < len(h_temps):
                hh = h_times[ii].split("T")[-1][:5]
                try:
                    slot_hr = int(hh.split(":")[0])
                except Exception:
                    slot_hr = 12
                slot_night = (h_is_day[ii] == 0) if (ii < len(h_is_day)) else (slot_hr < 6 or slot_hr >= 18)
                _, hic = wmo_code_to_spanish_and_icon(h_codes[ii] if ii < len(h_codes) else 0, is_night=slot_night)
                hourly_list.append({
                    "time": "Ahora" if step == 0 else hh,
                    "temp": f"{round(float(h_temps[ii]))}°",
                    "icon": hic
                })

        # 5-Day Forecast
        daily_raw = w.get("daily", {})
        d_times = daily_raw.get("time", [])
        d_max = daily_raw.get("temperature_2m_max", [])
        d_min = daily_raw.get("temperature_2m_min", [])
        d_codes = daily_raw.get("weather_code", [])
        d_rain = daily_raw.get("precipitation_probability_max", [])
        weekdays_es = ["Lun", "Mar", "Mié", "Jue", "Vie", "Sáb", "Dom"]
        daily_list = []
        for i in range(min(5, len(d_times))):
            try:
                dt = datetime.strptime(d_times[i], "%Y-%m-%d")
                day_lbl = "Hoy" if i == 0 else ("Mañana" if i == 1 else f"{weekdays_es[dt.weekday()]} {dt.day}")
            except Exception:
                day_lbl = d_times[i]
            ddesc, dic = wmo_code_to_spanish_and_icon(d_codes[i] if i < len(d_codes) else 0)
            rain_pct = int(d_rain[i]) if i < len(d_rain) and d_rain[i] is not None else 0
            daily_list.append({
                "day": day_lbl,
                "desc": ddesc,
                "icon": dic,
                "max": f"{round(float(d_max[i]))}°",
                "min": f"{round(float(d_min[i]))}°",
                "rain": f"{rain_pct}%"
            })

        today_max = daily_list[0]["max"] if daily_list else f"{temp}°"
        today_min = daily_list[0]["min"] if daily_list else f"{temp}°"
        today_rain = daily_list[0]["rain"] if daily_list else "0%"

        result = {
            "city": city,
            "country": country,
            "location": f"{city}, {country}" if country else city,
            "temp": f"{temp}°C",
            "desc": desc,
            "icon": icon,
            "feelsLike": f"{feels}°C",
            "humidity": f"{hum}%",
            "wind": f"{wind} km/h",
            "pressure": f"{press} hPa",
            "todayMax": today_max,
            "todayMin": today_min,
            "rainProb": today_rain,
            "updatedAt": datetime.now().strftime("%H:%M:%S"),
            "hourly": hourly_list,
            "daily": daily_list
        }
        tmp = WEATHER_CACHE_FILE + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(result, f)
        os.replace(tmp, WEATHER_CACHE_FILE)
        return result
    except Exception:
        if os.path.isfile(WEATHER_CACHE_FILE):
            try:
                with open(WEATHER_CACHE_FILE, "r", encoding="utf-8") as f:
                    return json.load(f)
            except Exception:
                pass
        return {
            "city": "Local",
            "country": "",
            "location": "Ubicación local",
            "temp": "24°C",
            "desc": "Despejado",
            "icon": "win11-weather.svg",
            "feelsLike": "25°C",
            "humidity": "60%",
            "wind": "10 km/h",
            "pressure": "1013 hPa",
            "todayMax": "28°",
            "todayMin": "21°",
            "rainProb": "10%",
            "updatedAt": datetime.now().strftime("%H:%M"),
            "hourly": [],
            "daily": []
        }


