        @pyqtSlot(str, str, str, str, result=str)
        def inspectUninstallPlanJson(self, pkg_or_id, source, desktop_path, app_name):
            pkg = (pkg_or_id or "").strip()
            src = (source or "").strip().lower()
            dpath = (desktop_path or "").strip()
            aname = (app_name or pkg).strip()
            plan = {
                "ok": True,
                "canUninstall": False,
                "blockedReason": "",
                "source": src,
                "sourceLabel": {"pacman": "Pacman / CachyOS", "flatpak": "Flatpak", "local": "Aplicación local"}.get(src, "Sistema"),
                "pkgName": pkg,
                "appName": aname,
                "version": "",
                "description": "",
                "totalFreeBytes": 0,
                "totalFreeHuman": "—",
                "removePkgs": [],
                "orphanCount": 0,
                "requiredBy": [],
                "needsRoot": src == "pacman",
                "flatpakScope": "system",
                "userDataPaths": [],
                "userDataSizeHuman": "",
            }
            try:
                if src == "pacman":
                    if not pkg or not re.match(r"^[a-zA-Z0-9@._+-]+$", pkg):
                        plan["blockedReason"] = "No se pudo resolver un paquete Pacman válido para esta aplicación."
                        return json.dumps(plan)
                    if is_pkg_system_protected(pkg):
                        plan["blockedReason"] = "Componente protegido del sistema X64 LIOS / escritorio Windows 11. Está bloqueado para proteger la estabilidad del equipo."
                        return json.dumps(plan)
                    env_c = dict(os.environ, LC_ALL="C")
                    qi = subprocess.run(["pacman", "-Qi", pkg], capture_output=True, text=True, timeout=3.0, env=env_c)
                    if qi.returncode != 0:
                        plan["blockedReason"] = f"El paquete «{pkg}» ya no se encuentra instalado en la base de Pacman."
                        return json.dumps(plan)
                    for ln in qi.stdout.splitlines():
                        if ln.startswith("Version"):
                            plan["version"] = ln.split(":", 1)[1].strip()
                        elif ln.startswith("Description"):
                            plan["description"] = ln.split(":", 1)[1].strip()
                        elif ln.startswith("Installed Size"):
                            plan["totalFreeHuman"] = ln.split(":", 1)[1].strip()

                    rsp = subprocess.run(["pacman", "-Rsp", "--print-format", "%n|%s", pkg], capture_output=True, text=True, timeout=4.0, env=env_c)
                    if rsp.returncode == 0:
                        rem = []
                        tot_b = 0
                        for ln in rsp.stdout.splitlines():
                            s = ln.strip()
                            if "|" in s:
                                pnm, sstr = s.split("|", 1)
                                pnm = pnm.strip()
                                try:
                                    sb = int(sstr.strip())
                                except Exception:
                                    sb = 0
                                if is_pkg_system_protected(pnm):
                                    plan["blockedReason"] = f"La desinstalación afectaría al componente protegido «{pnm}»."
                                    return json.dumps(plan)
                                rem.append({"name": pnm, "sizeHuman": _fmt_size_bytes(sb)})
                                tot_b += sb
                        plan["removePkgs"] = rem
                        plan["orphanCount"] = max(0, len(rem) - 1)
                        plan["totalFreeBytes"] = tot_b
                        if tot_b > 0:
                            plan["totalFreeHuman"] = _fmt_size_bytes(tot_b)
                        plan["canUninstall"] = True
                    else:
                        blockers = []
                        combined = (rsp.stdout or "") + "\n" + (rsp.stderr or "")
                        for ln in combined.splitlines():
                            m = re.search(r"required by\s+([^\s]+)", ln)
                            if m:
                                b = m.group(1).strip()
                                if b not in blockers:
                                    blockers.append(b)
                        plan["requiredBy"] = blockers[:10]
                        if blockers:
                            plan["blockedReason"] = "Otros paquetes instalados dependen de esta aplicación: " + ", ".join(blockers[:6]) + ("..." if len(blockers) > 6 else "") + "."
                        else:
                            plan["blockedReason"] = "Pacman no permite eliminar este paquete debido a dependencias activas del sistema."
                        return json.dumps(plan)

                elif src == "flatpak":
                    if not pkg or not shutil.which("flatpak"):
                        plan["blockedReason"] = "Flatpak no está disponible o el identificador no es válido."
                        return json.dumps(plan)
                    env_c = dict(os.environ, LC_ALL="C")
                    fi = subprocess.run(["flatpak", "info", pkg], capture_output=True, text=True, timeout=3.0, env=env_c)
                    if fi.returncode != 0:
                        plan["blockedReason"] = f"La aplicación Flatpak «{pkg}» no se encuentra instalada."
                        return json.dumps(plan)
                    for ln in fi.stdout.splitlines():
                        s = ln.strip()
                        if s.startswith("Version:"):
                            plan["version"] = s.split(":", 1)[1].strip()
                        elif s.startswith("Installed:"):
                            plan["totalFreeHuman"] = s.split(":", 1)[1].strip()
                        elif s.startswith("Installation:"):
                            sc = s.split(":", 1)[1].strip().lower()
                            plan["flatpakScope"] = "user" if "user" in sc else "system"
                            plan["needsRoot"] = (plan["flatpakScope"] != "user")
                    plan["removePkgs"] = [{"name": pkg, "sizeHuman": plan["totalFreeHuman"]}]
                    plan["canUninstall"] = True

                elif src == "local":
                    user_apps_dir = os.path.realpath(os.path.join(HOME_DIR, ".local", "share", "applications"))
                    rp = os.path.realpath(dpath) if dpath else ""
                    if rp and rp.startswith(user_apps_dir + os.sep) and rp.endswith(".desktop") and os.path.isfile(rp):
                        sb = os.path.getsize(rp)
                        plan["totalFreeBytes"] = sb
                        plan["totalFreeHuman"] = _fmt_size_bytes(sb)
                        plan["description"] = f"Lanzador local en {dpath}"
                        plan["removePkgs"] = [{"name": os.path.basename(rp), "sizeHuman": _fmt_size_bytes(sb)}]
                        plan["needsRoot"] = False
                        plan["canUninstall"] = True
                    else:
                        plan["blockedReason"] = "Este acceso directo pertenece al sistema y no puede eliminarse como app local."
                        return json.dumps(plan)
                else:
                    plan["blockedReason"] = "Esta aplicación es un componente del sistema o no tiene un gestor de paquetes desinstalable."
                    return json.dumps(plan)

                # Inspect safe optional user-data folders
                udirs = _find_safe_user_data_paths(pkg, aname, src)
                if udirs:
                    utot = sum(_dir_size_bytes(p) for p in udirs)
                    plan["userDataPaths"] = [p.replace(HOME_DIR, "~", 1) for p in udirs]
                    plan["userDataSizeHuman"] = _fmt_size_bytes(utot)
            except Exception as ex:
                plan["ok"] = False
                plan["blockedReason"] = str(ex)[:140]
            return json.dumps(plan)

