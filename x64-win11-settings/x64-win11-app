        @pyqtSlot(result=str)
        def getSettingsExtendedJson(self):
            return json.dumps(self._build_settings_extended_dict(force_slow=True))

        def _build_settings_extended_dict(self, force_slow=False):
            import grp
            now_ts = time.monotonic()
            display_name, uname, hostname = get_real_user_info()
            cfg = load_cfg()
            # 1. Monitors via wlr-randr --json (left-to-right physical order + separated Resolutions & Hz!)
            monitors_list = []
            try:
                import math
                wraw = subprocess.check_output(["wlr-randr", "--json"], text=True, timeout=1.5, stderr=subprocess.DEVNULL)
                wdata = json.loads(wraw)
                for mon in (wdata if isinstance(wdata, list) else []):
                    mname = str(mon.get("name", "")).strip()
                    if not mname:
                        continue
                    desc = str(mon.get("description") or mname).strip()
                    make = str(mon.get("make") or "").strip()
                    model_m = str(mon.get("model") or "").strip()
                    ps = mon.get("physical_size") or {}
                    pw_mm = int(ps.get("width", 0)) if isinstance(ps, dict) else 0
                    ph_mm = int(ps.get("height", 0)) if isinstance(ps, dict) else 0
                    diag_in = f'{math.hypot(pw_mm, ph_mm) / 25.4:.1f}"' if (pw_mm > 50 and ph_mm > 50) else ""
                    enabled = bool(mon.get("enabled", True))
                    sc_val = float(mon.get("scale") or 1.0)
                    if sc_val <= 0.1:
                        sc_val = 1.0
                    scale_s = f"{sc_val:.2f}".rstrip("0").rstrip(".") or "1"
                    pos = mon.get("position") or {}
                    pos_x = int(pos.get("x", 0)) if isinstance(pos, dict) else 0
                    pos_y = int(pos.get("y", 0)) if isinstance(pos, dict) else 0
                    pos_s = f"{pos_x},{pos_y}"
                    transform_s = str(mon.get("transform") or "normal")
                    vrr_on = bool(mon.get("adaptive_sync", False))
                    cur_mode_lbl = ""
                    cur_res = ""
                    cur_hz = 60
                    cur_hz_exact = "60.00 Hz"
                    cur_arg = ""
                    cur_w, cur_h = 1920, 1080
                    res_buckets = {}
                    for m in (mon.get("modes") or []):
                        w = int(m.get("width", 0))
                        h = int(m.get("height", 0))
                        if w <= 0 or h <= 0:
                            continue
                        ref = float(m.get("refresh", 60.0))
                        hz_int = max(1, int(round(ref)))
                        is_cur = bool(m.get("current", False))
                        is_pref = bool(m.get("preferred", False))
                        rkey = f"{w}x{h}"
                        arg = f"{w}x{h}@{ref:.6f}Hz"
                        if is_cur:
                            cur_mode_lbl = f"{w}×{h} ({hz_int} Hz)"
                            cur_res = rkey
                            cur_hz = hz_int
                            cur_hz_exact = f"{ref:.2f} Hz"
                            cur_arg = arg
                            cur_w, cur_h = w, h
                        b = res_buckets.setdefault(rkey, {
                            "w": w, "h": h, "res": rkey, "label": f"{w} × {h}",
                            "preferred": False, "current": False, "rates_by_hz": {}
                        })
                        if is_pref:
                            b["preferred"] = True
                        if is_cur:
                            b["current"] = True
                        prev_r = b["rates_by_hz"].get(hz_int)
                        cand = {"hz": hz_int, "exact": ref, "label": f"{hz_int} Hz", "arg": arg, "current": is_cur, "preferred": is_pref}
                        if prev_r is None or is_cur or (not prev_r["current"] and (is_pref or ref > prev_r["exact"])):
                            b["rates_by_hz"][hz_int] = cand

                    # Build clean deduplicated Resolutions list sorted by pixel area descending
                    resolutions = []
                    for rkey, b in sorted(res_buckets.items(), key=lambda kv: (kv[1]["w"] * kv[1]["h"], kv[1]["w"]), reverse=True):
                        all_rates = sorted(b["rates_by_hz"].values(), key=lambda x: x["hz"], reverse=True)
                        # Filter out cinema-only <45Hz clutter unless current or no >=45Hz rate exists!
                        usable_rates = [rt for rt in all_rates if rt["hz"] >= 45 or rt["current"]]
                        if not usable_rates:
                            usable_rates = all_rates
                        best = next((rt for rt in usable_rates if rt["current"]), next((rt for rt in usable_rates if rt["preferred"]), usable_rates[0]))
                        resolutions.append({
                            "res": b["res"],
                            "label": b["label"] + (" (Recomendada)" if b["preferred"] else ""),
                            "shortLabel": b["label"],
                            "preferred": b["preferred"],
                            "current": b["current"],
                            "bestArg": best["arg"],
                            "rates": [{"hz": rt["hz"], "label": rt["label"], "arg": rt["arg"], "current": rt["current"]} for rt in usable_rates]
                        })
                    if not cur_res and resolutions:
                        cur_res = resolutions[0]["res"]
                        cur_mode_lbl = resolutions[0]["shortLabel"]

                    eff_w, eff_h = (cur_h, cur_w) if transform_s in ("90", "270") else (cur_w, cur_h)
                    log_w = max(320, int(round(eff_w / sc_val)))
                    log_h = max(240, int(round(eff_h / sc_val)))
                    # Real ~1.5ms hardware VRR/FreeSync capability probe via wlr-randr --dryrun (zero flicker!)
                    vrr_supported = bool(vrr_on)
                    if enabled and not vrr_supported:
                        try:
                            vr = subprocess.run(
                                ["wlr-randr", "--dryrun", "--output", mname, "--adaptive-sync", "enabled"],
                                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=0.6
                            )
                            vrr_supported = (vr.returncode == 0)
                        except Exception:
                            vrr_supported = False
                    monitors_list.append({
                        "name": mname,
                        "desc": desc,
                        "make": make,
                        "model": model_m,
                        "diagInches": diag_in,
                        "enabled": enabled,
                        "currentMode": cur_mode_lbl,
                        "currentRes": cur_res,
                        "currentHz": cur_hz,
                        "currentHzExact": cur_hz_exact,
                        "currentArg": cur_arg,
                        "resolutions": resolutions[:12],
                        "scale": scale_s,
                        "position": pos_s,
                        "posX": pos_x,
                        "posY": pos_y,
                        "widthPx": cur_w,
                        "heightPx": cur_h,
                        "logicalW": log_w,
                        "logicalH": log_h,
                        "transform": transform_s,
                        "adaptiveSync": vrr_on,
                        "vrrSupported": vrr_supported,
                    })
                # Sort enabled monitors left-to-right by real physical posX, disabled at the end!
                monitors_list.sort(key=lambda m: (not m["enabled"], m["posX"], m["posY"], m["name"]))
            except Exception:
                pass

            # 2. Full Structured PipeWire Audio via pactl --format=json (Sinks, Sources, Ports, Per-App Streams & Card Profiles!)
            sinks = []
            sources = []
            audio_streams = []
            audio_cards = []
            mic_vol = 50
            mic_muted = False

            def _avg_vol_pct(vol_obj):
                vals = []
                if isinstance(vol_obj, dict):
                    for ch in vol_obj.values():
                        if isinstance(ch, dict):
                            vp = str(ch.get("value_percent", "")).replace("%", "").strip()
                            if vp.isdigit():
                                vals.append(int(vp))
                return int(round(sum(vals) / len(vals))) if vals else 80

            def _bus_type(name_s, props, active_port=""):
                low = (name_s or "").lower()
                ap = (active_port or "").lower()
                dbus = str((props or {}).get("device.bus", "")).lower()
                if "bluez" in low or dbus == "bluetooth":
                    return "Bluetooth"
                if "hdmi" in low or "hdmi" in ap or "displayport" in ap:
                    return "HDMI"
                if "usb" in low or dbus == "usb":
                    return "USB"
                return "Interno"

            try:
                def_sink = subprocess.check_output(["pactl", "get-default-sink"], text=True, timeout=0.8, stderr=subprocess.DEVNULL).strip()
                def_source = subprocess.check_output(["pactl", "get-default-source"], text=True, timeout=0.8, stderr=subprocess.DEVNULL).strip()

                raw_sinks = json.loads(subprocess.check_output(["pactl", "--format=json", "list", "sinks"], text=True, timeout=1.2, stderr=subprocess.DEVNULL))
                sink_id_map = {}
                for s in (raw_sinks if isinstance(raw_sinks, list) else []):
                    sname = str(s.get("name") or "")
                    sid = str(s.get("index", ""))
                    sdesc = str(s.get("description") or sname)
                    act_port = str(s.get("active_port") or "")
                    ports_out = []
                    act_port_lbl = ""
                    for p in (s.get("ports") or []):
                        pn = str(p.get("name") or "")
                        pl = str(p.get("description") or pn)
                        av = str(p.get("availability") or "") != "not available"
                        if pn == act_port:
                            act_port_lbl = pl
                        ports_out.append({"name": pn, "label": pl, "available": av, "active": (pn == act_port)})
                    sink_id_map[sid] = sdesc
                    sinks.append({
                        "id": sid,
                        "nodeName": sname,
                        "name": sdesc,
                        "active": (sname == def_sink),
                        "volume": _avg_vol_pct(s.get("volume")),
                        "muted": bool(s.get("mute", False)),
                        "busType": _bus_type(sname, s.get("properties"), act_port),
                        "activePort": act_port,
                        "activePortLabel": act_port_lbl,
                        "ports": ports_out
                    })

                raw_sources = json.loads(subprocess.check_output(["pactl", "--format=json", "list", "sources"], text=True, timeout=1.2, stderr=subprocess.DEVNULL))
                for src in (raw_sources if isinstance(raw_sources, list) else []):
                    sname = str(src.get("name") or "")
                    if ".monitor" in sname:
                        continue
                    sid = str(src.get("index", ""))
                    sdesc = str(src.get("description") or sname)
                    act_port = str(src.get("active_port") or "")
                    ports_out = []
                    act_port_lbl = ""
                    for p in (src.get("ports") or []):
                        pn = str(p.get("name") or "")
                        pl = str(p.get("description") or pn)
                        av = str(p.get("availability") or "") != "not available"
                        if pn == act_port:
                            act_port_lbl = pl
                        ports_out.append({"name": pn, "label": pl, "available": av, "active": (pn == act_port)})
                    is_def = (sname == def_source)
                    v_pct = _avg_vol_pct(src.get("volume"))
                    is_mut = bool(src.get("mute", False))
                    if is_def:
                        mic_vol = v_pct
                        mic_muted = is_mut
                    sources.append({
                        "id": sid,
                        "nodeName": sname,
                        "name": sdesc,
                        "active": is_def,
                        "volume": v_pct,
                        "muted": is_mut,
                        "busType": _bus_type(sname, src.get("properties"), act_port),
                        "activePort": act_port,
                        "activePortLabel": act_port_lbl,
                        "ports": ports_out
                    })

                raw_si = json.loads(subprocess.check_output(["pactl", "--format=json", "list", "sink-inputs"], text=True, timeout=1.0, stderr=subprocess.DEVNULL))
                for si in (raw_si if isinstance(raw_si, list) else []):
                    props = si.get("properties") or {}
                    app_n = str(props.get("application.name") or props.get("media.name") or "Aplicación")
                    med_n = str(props.get("media.name") or "")
                    if med_n == app_n:
                        med_n = ""
                    sk_id = str(si.get("sink", ""))
                    audio_streams.append({
                        "id": str(si.get("index", "")),
                        "appName": app_n,
                        "mediaName": med_n,
                        "sinkId": sk_id,
                        "sinkName": sink_id_map.get(sk_id, "Salida predeterminada"),
                        "volume": _avg_vol_pct(si.get("volume")),
                        "muted": bool(si.get("mute", False))
                    })

                raw_cards = json.loads(subprocess.check_output(["pactl", "--format=json", "list", "cards"], text=True, timeout=1.0, stderr=subprocess.DEVNULL))
                for c in (raw_cards if isinstance(raw_cards, list) else []):
                    cname = str(c.get("name") or "")
                    props = c.get("properties") or {}
                    cdesc = str(props.get("device.description") or cname)
                    act_p = str(c.get("active_profile") or "")
                    ports_d = c.get("ports") or {}
                    has_usable_port = any(str(pv.get("availability") or "") != "not available" for pv in ports_d.values()) if isinstance(ports_d, dict) else True
                    if act_p == "off" and not has_usable_port:
                        continue
                    profs_out = []
                    act_p_lbl = act_p
                    for pk, pv in (c.get("profiles") or {}).items():
                        if not isinstance(pv, dict):
                            continue
                        if not pv.get("available", True) and pk != act_p:
                            continue
                        plbl = str(pv.get("description") or pk)
                        if pk == act_p:
                            act_p_lbl = plbl
                        profs_out.append({"name": pk, "label": plbl, "active": (pk == act_p)})
                    if profs_out:
                        audio_cards.append({
                            "id": str(c.get("index", "")),
                            "cardName": cname,
                            "name": cdesc,
                            "busType": _bus_type(cname, props, act_p),
                            "activeProfile": act_p,
                            "activeProfileLabel": act_p_lbl,
                            "profiles": profs_out
                        })
            except Exception:
                pass

            # 3. Bluetooth Adapter + Paired Devices (with Battery % & Device Type Icon!)
            bt_adapter = {"present": False, "powered": False, "discoverable": False, "pairable": False, "alias": hostname, "address": ""}
            bt_devices = []
            try:
                show_out = subprocess.check_output(["bluetoothctl", "show"], text=True, timeout=1.0, stderr=subprocess.DEVNULL)
                m_ctrl = re.search(r"Controller\s+([0-9A-Fa-f:]{17})", show_out)
                if m_ctrl:
                    bt_adapter["present"] = True
                    bt_adapter["address"] = m_ctrl.group(1).upper()
                    bt_adapter["powered"] = "Powered: yes" in show_out
                    bt_adapter["discoverable"] = "Discoverable: yes" in show_out
                    bt_adapter["pairable"] = "Pairable: yes" in show_out
                    m_al = re.search(r"Alias:\s*(.+)", show_out)
                    if m_al:
                        bt_adapter["alias"] = m_al.group(1).strip()
            except Exception:
                pass
            try:
                bout = subprocess.check_output(["bluetoothctl", "devices"], text=True, timeout=1.2, stderr=subprocess.DEVNULL)
                for ln in bout.splitlines()[:16]:
                    toks = ln.split(" ", 2)
                    if len(toks) == 3 and toks[0] == "Device":
                        mac, bname = toks[1], toks[2].strip()
                        paired = False
                        conn = False
                        bat_pct = -1
                        icon_k = ""
                        try:
                            iout = subprocess.check_output(["bluetoothctl", "info", mac], text=True, timeout=0.8, stderr=subprocess.DEVNULL)
                            paired = "Paired: yes" in iout
                            conn = "Connected: yes" in iout
                            m_bat = re.search(r"Battery Percentage:.*?\((\d+)\)", iout)
                            if m_bat:
                                bat_pct = int(m_bat.group(1))
                            m_ic = re.search(r"Icon:\s*(\S+)", iout)
                            if m_ic:
                                icon_k = m_ic.group(1).strip().lower()
                        except Exception:
                            pass
                        if paired or conn:
                            bt_devices.append({
                                "mac": mac, "name": bname, "paired": paired,
                                "connected": conn, "battery": bat_pct, "btIcon": icon_k
                            })
            except Exception:
                pass

            # 3B. Live USB Peripherals enriched with /sys/bus/usb/devices (Speed + Category + Vendor + Safe Eject!)
            sysfs_usb = {}
            try:
                for ud in glob.glob("/sys/bus/usb/devices/*"):
                    vp = os.path.join(ud, "idVendor")
                    pp = os.path.join(ud, "idProduct")
                    if not (os.path.isfile(vp) and os.path.isfile(pp)):
                        continue
                    vid = open(vp, "r", errors="ignore").read().strip().lower()
                    pid = open(pp, "r", errors="ignore").read().strip().lower()
                    bcls = open(os.path.join(ud, "bDeviceClass"), "r", errors="ignore").read().strip().lower() if os.path.isfile(os.path.join(ud, "bDeviceClass")) else ""
                    if bcls == "09":
                        continue
                    spd_raw = open(os.path.join(ud, "speed"), "r", errors="ignore").read().strip() if os.path.isfile(os.path.join(ud, "speed")) else ""
                    mfg = open(os.path.join(ud, "manufacturer"), "r", errors="ignore").read().strip() if os.path.isfile(os.path.join(ud, "manufacturer")) else ""
                    prod = open(os.path.join(ud, "product"), "r", errors="ignore").read().strip() if os.path.isfile(os.path.join(ud, "product")) else ""
                    ifcs = set()
                    for ip in glob.glob(os.path.join(ud, "*:*/bInterfaceClass")):
                        try:
                            ifcs.add(open(ip, "r", errors="ignore").read().strip().lower())
                        except Exception:
                            pass
                    spd_map = {"1.5": "USB 1.1 • 1.5 Mbps", "12": "USB 1.1 • 12 Mbps", "480": "USB 2.0 • 480 Mbps", "5000": "USB 3.0 • 5 Gbps", "10000": "USB 3.1 • 10 Gbps", "20000": "USB 3.2 • 20 Gbps"}
                    spd_lbl = spd_map.get(spd_raw, (f"{spd_raw} Mbps" if spd_raw else "USB"))
                    if "01" in ifcs:
                        cat_lbl, cat_ic = "Audio", "audio-speakers-symbolic.svg"
                    elif "08" in ifcs:
                        cat_lbl, cat_ic = "Almacenamiento", "drive-c.svg"
                    elif "e0" in ifcs or bcls == "e0":
                        cat_lbl, cat_ic = "Bluetooth", "fluent-bluetooth.svg"
                    elif "0e" in ifcs:
                        cat_lbl, cat_ic = "Cámara", "fluent-image.svg"
                    elif "07" in ifcs:
                        cat_lbl, cat_ic = "Impresora", "printer-symbolic.svg"
                    elif "03" in ifcs:
                        low_p = (prod + " " + mfg).lower()
                        if "keyboard" in low_p or "teclado" in low_p:
                            cat_lbl, cat_ic = "Teclado", "fluent-keyboard.svg"
                        elif "mouse" in low_p or "ratón" in low_p:
                            cat_lbl, cat_ic = "Mouse", "input-mouse-symbolic.svg"
                        elif "gamepad" in low_p or "controller" in low_p or "xbox" in low_p or "dual" in low_p:
                            cat_lbl, cat_ic = "Mando", "fluent-games.svg"
                        else:
                            cat_lbl, cat_ic = "Periférico HID", "usb-hub-symbolic.svg"
                    else:
                        cat_lbl, cat_ic = "USB", "usb-hub-symbolic.svg"
                    sysfs_usb[f"{vid}:{pid}"] = {"speed": spd_lbl, "mfg": mfg, "prod": prod, "category": cat_lbl, "icon": cat_ic}
            except Exception:
                pass

            # Map mounted removable USB block devices for safe eject button!
            rem_usb_devs = []
            try:
                for drv in get_dynamic_drives():
                    if drv.get("isRemovable") and drv.get("device"):
                        rem_usb_devs.append({"device": drv["device"], "name": drv.get("name", ""), "mounted": bool(drv.get("mounted"))})
            except Exception:
                pass

            usb_devices = []
            try:
                uout = subprocess.check_output(["lsusb"], text=True, timeout=1.2, stderr=subprocess.DEVNULL)
                for ln in uout.splitlines():
                    if "root hub" in ln.lower():
                        continue
                    m_u = re.match(r"Bus\s+(\d+)\s+Device\s+(\d+):\s+ID\s+([0-9a-fA-F:]+)\s*(.*)", ln.strip())
                    if m_u:
                        bus, devn, usbid, uname_d = m_u.groups()
                        uk = usbid.lower()
                        meta = sysfs_usb.get(uk, {})
                        uname_d = uname_d.strip() or meta.get("prod") or f"Dispositivo USB ({usbid})"
                        cat_lbl = meta.get("category", "USB")
                        cat_ic = meta.get("icon", "usb-hub-symbolic.svg")
                        low_n = uname_d.lower()
                        if cat_lbl in ("USB", "Periférico HID"):
                            if "mouse" in low_n:
                                cat_lbl, cat_ic = "Mouse", "input-mouse-symbolic.svg"
                            elif "keyboard" in low_n:
                                cat_lbl, cat_ic = "Teclado", "fluent-keyboard.svg"
                            elif "bluetooth" in low_n:
                                cat_lbl, cat_ic = "Bluetooth", "fluent-bluetooth.svg"
                            elif "audio" in low_n or "dac" in low_n or "headset" in low_n:
                                cat_lbl, cat_ic = "Audio", "audio-speakers-symbolic.svg"
                        ej_dev = ""
                        if cat_lbl == "Almacenamiento" and rem_usb_devs:
                            ej_dev = rem_usb_devs[0]["device"]
                        usb_devices.append({
                            "bus": bus, "dev": devn, "id": usbid, "name": uname_d,
                            "mfg": meta.get("mfg", ""),
                            "speed": meta.get("speed", "USB"),
                            "category": cat_lbl,
                            "icon": cat_ic,
                            "ejectDevice": ej_dev
                        })
            except Exception:
                pass

            # Lazy-cached CUPS printers + service status (lpstat -p can block ~1s when idle — only query on demand!)
            cups_active = False
            try:
                cups_active = (subprocess.run(["systemctl", "is-active", "--quiet", "cups.service"], timeout=0.5).returncode == 0
                               or subprocess.run(["systemctl", "is-active", "--quiet", "cups.socket"], timeout=0.5).returncode == 0)
            except Exception:
                pass
            if force_slow:
                printers_list = []
                def_prn = ""
                try:
                    dout = subprocess.check_output(["lpstat", "-d"], text=True, timeout=0.6, stderr=subprocess.DEVNULL)
                    if ":" in dout:
                        def_prn = dout.split(":", 1)[1].strip()
                except Exception:
                    pass
                try:
                    pout = subprocess.check_output(["lpstat", "-p"], text=True, timeout=0.9, stderr=subprocess.DEVNULL)
                    for ln in pout.splitlines():
                        if ln.strip():
                            toks = ln.strip().split()
                            if len(toks) >= 2:
                                pname = toks[1]
                                printers_list.append({
                                    "name": pname,
                                    "status": " ".join(toks[2:])[:60] or "Lista",
                                    "isDefault": (pname == def_prn)
                                })
                except Exception:
                    pass
                self._cache_printers = printers_list
                self._cache_printers_ts = now_ts
            else:
                printers_list = self._cache_printers

            # Detect real Mouse & Touchpad hardware names from /proc/bus/input/devices (<0.2ms!)
            mouse_hw_name = ""
            touchpad_hw_name = ""
            try:
                if os.path.isfile("/proc/bus/input/devices"):
                    cur_n = ""
                    for ln in open("/proc/bus/input/devices", "r", encoding="utf-8", errors="ignore"):
                        if ln.startswith("N: Name="):
                            cur_n = ln.split("=", 1)[1].strip().strip('"').strip()
                        elif ln.startswith("H: Handlers="):
                            low_n = cur_n.lower()
                            if "mouse" in ln:
                                if any(k in low_n for k in ("touchpad", "synaptics", "elan", "trackpad", "alps", "cypress")):
                                    if not touchpad_hw_name:
                                        touchpad_hw_name = cur_n
                                elif not mouse_hw_name and "virtual" not in low_n:
                                    mouse_hw_name = cur_n
            except Exception:
                pass

            input_cfg = {
                "mouseSpeed": 0.0,
                "mouseAccel": "adaptive",
                "mouseLeftHanded": False,
                "mouseNaturalScroll": False,
                "mouseScrollFactor": 1.0,
                "mouseMiddleEmulation": False,
                "mouseHwName": mouse_hw_name,
                "hasTouchpad": bool(touchpad_hw_name),
                "touchpadHwName": touchpad_hw_name,
                "tpSendEvents": "yes",
                "tpTap": True,
                "tpTapAndDrag": True,
                "tpThreeFingerDrag": False,
                "tpNaturalScroll": True,
                "tpDisableTyping": True,
                "tpClickMethod": "clickfinger",
                "tpSpeed": 0.0,
            }
            try:
                rc_p = os.path.join(HOME_DIR, ".config", "labwc", "rc.xml")
                if os.path.isfile(rc_p):
                    import xml.etree.ElementTree as ET
                    tree = ET.parse(rc_p)
                    lib_el = tree.getroot().find("libinput")
                    if lib_el is not None:
                        for dev_el in lib_el.findall("device"):
                            cat = (dev_el.attrib.get("category") or "default").strip().lower()
                            def _txt(tag, default=""):
                                el = dev_el.find(tag)
                                return el.text.strip() if (el is not None and el.text) else default
                            if cat == "non-touch":
                                try: input_cfg["mouseSpeed"] = float(_txt("pointerSpeed", "0"))
                                except Exception: pass
                                acc = _txt("accelProfile", "adaptive").lower()
                                input_cfg["mouseAccel"] = "flat" if acc == "flat" else "adaptive"
                                input_cfg["mouseLeftHanded"] = (_txt("leftHanded", "no").lower() == "yes")
                                input_cfg["mouseNaturalScroll"] = (_txt("naturalScroll", "no").lower() == "yes")
                                input_cfg["mouseMiddleEmulation"] = (_txt("middleEmulation", "no").lower() == "yes")
                                try: input_cfg["mouseScrollFactor"] = float(_txt("scrollFactor", "1.0"))
                                except Exception: pass
                            elif cat == "touchpad":
                                se = _txt("sendEventsMode", "yes")
                                input_cfg["tpSendEvents"] = se if se in ("yes", "no", "disabledOnExternalMouse") else "yes"
                                input_cfg["tpTap"] = (_txt("tap", "yes").lower() == "yes")
                                input_cfg["tpTapAndDrag"] = (_txt("tapAndDrag", "yes").lower() == "yes")
                                input_cfg["tpThreeFingerDrag"] = (_txt("threeFingerDrag", "no").lower() in ("yes", "3"))
                                input_cfg["tpNaturalScroll"] = (_txt("naturalScroll", "yes").lower() == "yes")
                                input_cfg["tpDisableTyping"] = (_txt("disableWhileTyping", "yes").lower() == "yes")
                                cm = _txt("clickMethod", "clickfinger")
                                input_cfg["tpClickMethod"] = cm if cm in ("clickfinger", "buttonAreas") else "clickfinger"
                                try: input_cfg["tpSpeed"] = float(_txt("pointerSpeed", "0"))
                                except Exception: pass
            except Exception:
                pass

            # 4. Network Extra Info & Universal NetworkManager Hub Telemetry (Wi-Fi, Ethernet, VPN, Data Usage, Stack)
            def _fmt_net_bytes(nb):
                nb = float(max(0, nb))
                for u in ("B", "KB", "MB", "GB", "TB"):
                    if nb < 1024.0 or u == "TB":
                        return f"{nb:.2f} {u}" if u in ("GB", "TB") else (f"{nb:.1f} {u}" if u == "MB" else f"{int(nb)} {u}")
                    nb /= 1024.0
                return "0 B"

            net_gw = "—"
            net_dns = "—"
            net_iface = "—"
            net_full = {
                "connected": False, "activeType": "none", "activeName": "Sin conexión",
                "activeIface": "", "activeUuid": "", "hasWifi": False, "wifiIface": "",
                "wifiEnabled": False, "wifiConnected": False, "wifiBand": "", "wifiRate": "",
                "wifiSignalDbm": "", "wifiConName": "", "wifiUuid": "", "wifiAutoconnect": True,
                "wifiMetered": False, "wifiIp4": "", "wifiIp6": "", "wifiGateway": "",
                "wifiMac": "", "wifiDns": "", "airplaneMode": False,
                "knownWifi": [], "ethernetDevices": [], "vpnProfiles": [], "adapters": [],
                "totalRxHuman": "0 B", "totalTxHuman": "0 B",
                "dnsDot": False, "ufwActive": False, "tcpCongestion": "—", "qdisc": "—", "wifiPowerSaveOff": False
            }
            try:
                c_env = dict(os.environ, LC_ALL="C")
                rout = subprocess.check_output(["ip", "route", "show", "default"], text=True, timeout=0.8, stderr=subprocess.DEVNULL).splitlines()
                if rout:
                    rt = rout[0].split()
                    if "via" in rt:
                        net_gw = rt[rt.index("via") + 1]
                    if "dev" in rt:
                        net_iface = rt[rt.index("dev") + 1]

                # Radios & Airplane mode
                wifi_radio_on = True
                if shutil.which("nmcli"):
                    try:
                        rg = subprocess.check_output(["nmcli", "-t", "-f", "WIFI", "g"], text=True, timeout=0.8, env=c_env, stderr=subprocess.DEVNULL).strip().lower()
                        wifi_radio_on = (rg == "enabled")
                    except Exception:
                        pass
                bt_blocked = False
                try:
                    rf_out = subprocess.check_output(["rfkill", "list", "bluetooth"], text=True, timeout=0.6, stderr=subprocess.DEVNULL).lower()
                    bt_blocked = ("soft blocked: yes" in rf_out or "hard blocked: yes" in rf_out)
                except Exception:
                    pass
                net_full["wifiEnabled"] = wifi_radio_on

                # Enumerate all NetworkManager devices & saved connections cleanly
                dev_map = {}
                if shutil.which("nmcli"):
                    try:
                        dout = subprocess.check_output(
                            ["nmcli", "-t", "-f", "GENERAL.DEVICE,GENERAL.TYPE,GENERAL.STATE,GENERAL.CONNECTION,GENERAL.HWADDR,GENERAL.MTU,IP4.ADDRESS,IP4.GATEWAY,IP4.DNS,IP6.ADDRESS,CAPABILITIES.SPEED", "device", "show"],
                            text=True, timeout=1.5, env=c_env, stderr=subprocess.DEVNULL
                        )
                        cur_dev = {}
                        def _flush_dev(cd):
                            dn = cd.get("GENERAL.DEVICE", "")
                            dt = cd.get("GENERAL.TYPE", "")
                            if dn and dt not in ("loopback", "wifi-p2p", "bridge", "tun", "dummy"):
                                dev_map[dn] = cd
                        for ln in dout.splitlines():
                            if not ln.strip():
                                if cur_dev:
                                    _flush_dev(cur_dev)
                                    cur_dev = {}
                                continue
                            if ":" in ln:
                                k, v = ln.split(":", 1)
                                k = k.strip()
                                v = v.strip()
                                if k.startswith("IP4.DNS"):
                                    cur_dev.setdefault("_dns", []).append(v)
                                elif k.startswith("IP4.ADDRESS"):
                                    cur_dev.setdefault("_ip4", []).append(v)
                                elif k.startswith("IP6.ADDRESS"):
                                    cur_dev.setdefault("_ip6", []).append(v)
                                else:
                                    cur_dev[k] = v
                        if cur_dev:
                            _flush_dev(cur_dev)
                    except Exception:
                        pass

                # Helper to read connection properties (autoconnect, metered, dns-over-tls)
                def _conn_props(uuid_str):
                    out_p = {"autoconnect": True, "metered": False, "dot": False}
                    if not uuid_str or not shutil.which("nmcli"):
                        return out_p
                    try:
                        co = subprocess.check_output(
                            ["nmcli", "-t", "-f", "connection.autoconnect,connection.metered,connection.dns-over-tls", "con", "show", "uuid", uuid_str],
                            text=True, timeout=0.9, env=c_env, stderr=subprocess.DEVNULL
                        ).splitlines()
                        for cl in co:
                            if ":" not in cl:
                                continue
                            ck, cv = cl.split(":", 1)
                            cv = cv.strip().lower()
                            if ck == "connection.autoconnect":
                                out_p["autoconnect"] = (cv == "yes")
                            elif ck == "connection.metered":
                                out_p["metered"] = (cv in ("yes", "1", "3"))
                            elif ck == "connection.dns-over-tls":
                                out_p["dot"] = (cv in ("2", "yes", "1"))
                    except Exception:
                        pass
                    return out_p

                known_wifi = []
                vpn_profiles = []
                eth_con_by_name = {}
                wifi_con_uuid_by_name = {}
                if shutil.which("nmcli"):
                    try:
                        clines = subprocess.check_output(
                            ["nmcli", "-t", "-f", "NAME,UUID,TYPE,DEVICE,AUTOCONNECT", "con", "show"],
                            text=True, timeout=1.2, env=c_env, stderr=subprocess.DEVNULL
                        ).splitlines()
                        for ln in clines:
                            ps = re.split(r"(?<!\\):", ln)
                            if len(ps) < 5:
                                continue
                            cname = ps[0].replace("\\:", ":").strip()
                            cuuid = ps[1].strip()
                            ctype = ps[2].strip()
                            cdev = ps[3].strip()
                            cauto = (ps[4].strip().lower() == "yes")
                            cact = bool(cdev and cdev != "--")
                            if ctype == "802-11-wireless":
                                wifi_con_uuid_by_name[cname] = cuuid
                                known_wifi.append({
                                    "name": cname, "uuid": cuuid,
                                    "autoconnect": cauto, "active": cact, "device": cdev if cact else ""
                                })
                            elif ctype == "802-3-ethernet":
                                eth_con_by_name[cname] = {"name": cname, "uuid": cuuid, "autoconnect": cauto, "active": cact, "device": cdev}
                            elif ctype in ("vpn", "wireguard"):
                                vpn_profiles.append({
                                    "name": cname, "uuid": cuuid,
                                    "vpnType": "WireGuard" if ctype == "wireguard" else "OpenVPN / VPN",
                                    "active": cact, "device": cdev if cact else ""
                                })
                    except Exception:
                        pass
                known_wifi.sort(key=lambda x: (not x["active"], x["name"].lower()))
                vpn_profiles.sort(key=lambda x: (not x["active"], x["name"].lower()))
                net_full["knownWifi"] = known_wifi
                net_full["vpnProfiles"] = vpn_profiles

                # Build adapters, ethernetDevices, wifi details & session data usage
                total_rx, total_tx = 0, 0
                adapters = []
                eth_list = []
                st_es_map = {
                    "connected": "Conectado",
                    "disconnected": "Desconectado",
                    "unavailable": "Cable desconectado",
                    "connecting": "Conectando...",
                    "unmanaged": "Sin gestionar"
                }
                for dn, cd in dev_map.items():
                    dtype = cd.get("GENERAL.TYPE", "")
                    st_raw = cd.get("GENERAL.STATE", "")
                    st_key = re.sub(r"^\d+\s*\(([^)]+)\).*$", r"\1", st_raw).strip().lower()
                    is_conn = (st_key == "connected")
                    cname = cd.get("GENERAL.CONNECTION", "")
                    if cname == "--":
                        cname = ""
                    mac = cd.get("GENERAL.HWADDR", "—")
                    mtu = cd.get("GENERAL.MTU", "1500")
                    spd = cd.get("CAPABILITIES.SPEED", "")
                    if spd.lower() in ("unknown", ""):
                        spd = ""
                    ip4 = (cd.get("_ip4") or [""])[0].split("/")[0]
                    ip6_list = [x.split("/")[0] for x in (cd.get("_ip6") or []) if x]
                    ip6 = ip6_list[0] if ip6_list else ""
                    gw_d = cd.get("IP4.GATEWAY", "")
                    if gw_d == "--":
                        gw_d = ""
                    dns_d = ", ".join((cd.get("_dns") or [])[:2])
                    drv = ""
                    rx_b, tx_b = 0, 0
                    try:
                        dlk = os.path.realpath(f"/sys/class/net/{dn}/device/driver")
                        if os.path.isdir(dlk):
                            drv = os.path.basename(dlk)
                    except Exception:
                        pass
                    try:
                        rx_b = int(open(f"/sys/class/net/{dn}/statistics/rx_bytes").read().strip())
                        tx_b = int(open(f"/sys/class/net/{dn}/statistics/tx_bytes").read().strip())
                    except Exception:
                        pass
                    total_rx += rx_b
                    total_tx += tx_b

                    st_lbl = st_es_map.get(st_key, st_key.capitalize() or "Desconocido")
                    if dtype == "wifi" and st_key == "unavailable":
                        st_lbl = "Desactivado"

                    if dtype == "wifi":
                        net_full["hasWifi"] = True
                        if not net_full["wifiIface"] or is_conn:
                            net_full["wifiIface"] = dn
                            net_full["wifiConnected"] = is_conn
                            net_full["wifiConName"] = cname
                            net_full["wifiMac"] = mac
                            net_full["wifiIp4"] = ip4
                            net_full["wifiIp6"] = ip6
                            net_full["wifiGateway"] = gw_d
                            net_full["wifiDns"] = dns_d
                            net_full["wifiRate"] = spd
                            w_uuid = wifi_con_uuid_by_name.get(cname, "")
                            net_full["wifiUuid"] = w_uuid
                            if is_conn and w_uuid:
                                wp = _conn_props(w_uuid)
                                net_full["wifiAutoconnect"] = wp["autoconnect"]
                                net_full["wifiMetered"] = wp["metered"]
                                if dn == net_iface:
                                    net_full["dnsDot"] = wp["dot"]
                            if is_conn and shutil.which("iw"):
                                try:
                                    iwo = subprocess.check_output(["iw", "dev", dn, "link"], text=True, timeout=0.6, stderr=subprocess.DEVNULL)
                                    mf = re.search(r"freq:\s*([\d.]+)", iwo)
                                    if mf:
                                        fmhz = float(mf.group(1))
                                        net_full["wifiBand"] = "6 GHz" if fmhz >= 5900 else ("5 GHz" if fmhz >= 4900 else "2.4 GHz")
                                    ms = re.search(r"signal:\s*(-?\d+\s*dBm)", iwo)
                                    if ms:
                                        net_full["wifiSignalDbm"] = ms.group(1)
                                    mr = re.search(r"rx bitrate:\s*([\d.]+)\s*MBit/s", iwo)
                                    mt = re.search(r"tx bitrate:\s*([\d.]+)\s*MBit/s", iwo)
                                    if mr:
                                        rx_r = int(round(float(mr.group(1))))
                                        tx_r = int(round(float(mt.group(1)))) if mt else rx_r
                                        net_full["wifiRate"] = f"{rx_r} / {tx_r} Mb/s"
                                except Exception:
                                    pass
                    elif dtype == "ethernet":
                        # Find matching ethernet profile (active or first available wired profile)
                        e_prof = eth_con_by_name.get(cname) if cname else None
                        if not e_prof and eth_con_by_name:
                            e_prof = next(iter(eth_con_by_name.values()))
                        e_uuid = e_prof["uuid"] if e_prof else ""
                        ep = _conn_props(e_uuid) if e_uuid else {"autoconnect": True, "metered": False, "dot": False}
                        if is_conn and dn == net_iface:
                            net_full["dnsDot"] = ep["dot"]
                        carrier_on = False
                        try:
                            carrier_on = (open(f"/sys/class/net/{dn}/carrier").read().strip() == "1")
                        except Exception:
                            carrier_on = is_conn
                        eth_list.append({
                            "iface": dn, "state": st_key, "stateLabel": st_lbl,
                            "connected": is_conn, "carrier": carrier_on,
                            "connName": cname or (e_prof["name"] if e_prof else "Conexión cableada"),
                            "connUuid": e_uuid, "mac": mac, "mtu": mtu, "driver": drv or "ethernet",
                            "speed": spd or ("1000 Mb/s" if is_conn else "—"),
                            "ip4": ip4 or "—", "ip6": ip6 or "—", "gateway": gw_d or "—", "dns": dns_d or "—",
                            "autoconnect": ep["autoconnect"], "metered": ep["metered"],
                            "rxHuman": _fmt_net_bytes(rx_b), "txHuman": _fmt_net_bytes(tx_b)
                        })

                    adapters.append({
                        "iface": dn, "type": dtype,
                        "typeLabel": "Wi-Fi" if dtype == "wifi" else ("Ethernet" if dtype == "ethernet" else dtype.upper()),
                        "state": st_key, "stateLabel": st_lbl, "connected": is_conn,
                        "connName": cname, "mac": mac, "mtu": mtu, "driver": drv or "kernel",
                        "speed": net_full["wifiRate"] if (dtype == "wifi" and net_full["wifiRate"]) else (spd or "—"),
                        "ip4": ip4 or "—", "rxBytes": rx_b, "txBytes": tx_b,
                        "rxHuman": _fmt_net_bytes(rx_b), "txHuman": _fmt_net_bytes(tx_b)
                    })

                adapters.sort(key=lambda x: (not x["connected"], x["type"] != "ethernet", x["iface"]))
                net_full["adapters"] = adapters
                net_full["ethernetDevices"] = eth_list
                net_full["totalRxHuman"] = _fmt_net_bytes(total_rx)
                net_full["totalTxHuman"] = _fmt_net_bytes(total_tx)
                net_full["airplaneMode"] = (not wifi_radio_on) and (bt_blocked or not net_full["hasWifi"])
                if not net_full["hasWifi"]:
                    net_full["airplaneMode"] = False

                # Resolve primary active connection for universal Hero Banner (Ethernet OR Wi-Fi!)
                if net_iface != "—" and net_iface in dev_map:
                    ad = dev_map[net_iface]
                    atype = ad.get("GENERAL.TYPE", "")
                    net_full["connected"] = True
                    net_full["activeType"] = atype if atype in ("wifi", "ethernet") else "other"
                    net_full["activeIface"] = net_iface
                    net_full["activeName"] = ad.get("GENERAL.CONNECTION", "") or net_iface
                    if atype == "wifi":
                        net_full["activeUuid"] = net_full["wifiUuid"]
                    elif atype == "ethernet":
                        for e in eth_list:
                            if e["iface"] == net_iface:
                                net_full["activeUuid"] = e["connUuid"]
                                break
                elif net_full["wifiConnected"]:
                    net_full["connected"] = True
                    net_full["activeType"] = "wifi"
                    net_full["activeIface"] = net_full["wifiIface"]
                    net_full["activeName"] = net_full["wifiConName"] or "Wi-Fi"
                    net_full["activeUuid"] = net_full["wifiUuid"]
                else:
                    for e in eth_list:
                        if e["connected"]:
