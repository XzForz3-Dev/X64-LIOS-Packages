            def scan_role_candidates(mime_key, cur_df):
                cands = []
                seen_df = set()
                for app_dir in ("/usr/share/applications", os.path.join(HOME_DIR, ".local", "share", "applications")):
                    if not os.path.isdir(app_dir):
                        continue
                    for df in sorted(os.listdir(app_dir)):
                        if not df.endswith(".desktop") or df in seen_df:
                            continue
                        fp = os.path.join(app_dir, df)
                        try:
                            txt = open(fp, "r", encoding="utf-8", errors="ignore").read()
                            if "NoDisplay=true" in txt:
                                continue
                            if mime_key == "__terminal__":
                                if "TerminalEmulator" not in txt and df not in ("kitty.desktop", "alacritty.desktop", "foot.desktop", "org.kde.konsole.desktop", "org.gnome.Console.desktop"):
                                    continue
                            else:
                                if "Terminal=true" in txt:
                                    continue
                                if mime_key not in txt and df != cur_df:
                                    continue
                            nm = friendly_map.get(df, "")
                            if not nm:
                                for ln in txt.splitlines():
                                    if ln.startswith("Name[es]="):
                                        nm = ln.split("=", 1)[1].strip(); break
