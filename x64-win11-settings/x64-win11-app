                st = os.stat(target_path)
                is_dir = os.path.isdir(target_path)
                is_link = os.path.islink(target_path)
                total_bytes = st.st_size if not is_dir else 0
                file_cnt = 0
                dir_cnt = 0
                if is_dir:
                    walked = 0
                    for rdir, dirs, files in os.walk(target_path):
                        dir_cnt += len(dirs)
                        file_cnt += len(files)
