    class _UpdateCheckWorker(QThread):
        done = pyqtSignal(str)
        def _has_network(self):
            for host, port in (("repo.x64lios.com", 443), ("archlinux.org", 443), ("1.1.1.1", 53)):
                try:
                    with socket.create_connection((host, port), timeout=2.5):
                        return True
                except Exception:
                    continue
            return False

        def run(self):
            if not self._has_network():
                self.done.emit(json.dumps({
                    "count": -1,
                    "pacmanCount": 0,
                    "aurCount": 0,
                    "flatpakCount": 0,
                    "packages": [],
                    "flatpakPackages": [],
                    "checkedAt": datetime.now().strftime("%H:%M:%S"),
                    "error": "Sin conexión a Internet para comprobar actualizaciones.",
                }))
                return

            if shutil.which("x64-update"):
                try:
                    r = subprocess.run(["x64-update", "--check"], capture_output=True, text=True, timeout=60.0)
                    cached = _read_x64_update_cache()
                    if r.returncode == 0 and cached is not None:
                        cached["fromCache"] = False
                        cached["checkedAt"] = datetime.now().strftime("%H:%M:%S")
                        self.done.emit(json.dumps(cached))
                        return
                except subprocess.TimeoutExpired:
                    self.done.emit(json.dumps({
                        "count": -1,
                        "pacmanCount": 0,
                        "aurCount": 0,
                        "flatpakCount": 0,
                        "packages": [],
                        "flatpakPackages": [],
                        "checkedAt": datetime.now().strftime("%H:%M:%S"),
                        "error": "Tiempo de espera agotado al consultar los repositorios.",
                    }))
                    return
                except Exception:
                    pass

            pac_pkgs = []
            fp_pkgs = []
            err_msg = ""
            try:
                cmd = ["checkupdates"] if shutil.which("checkupdates") else ["pacman", "-Qu"]
                r = subprocess.run(cmd, capture_output=True, text=True, timeout=25.0)
                if r.returncode == 0:
                    for ln in (r.stdout or "").splitlines():
                        s = ln.strip()
                        if s:
                            pac_pkgs.append(s)
                elif r.returncode == 2:
                    pac_pkgs = []
                else:
                    err_msg = "No se pudo consultar los repositorios (comprueba tu conexión a Internet)."
            except subprocess.TimeoutExpired:
                err_msg = "Tiempo de espera agotado al consultar los repositorios."
            except Exception as ex:
                err_msg = f"Error al comprobar actualizaciones: {str(ex)[:90]}"

            if not err_msg and shutil.which("flatpak"):
                try:
                    rf = subprocess.run(
                        ["flatpak", "remote-ls", "--updates", "--columns=application,version"],
                        capture_output=True, text=True, timeout=6.0
                    )
                    if rf.returncode == 0:
                        for ln in (rf.stdout or "").splitlines():
                            s = ln.strip().replace("\t", " ")
                            if s:
                                fp_pkgs.append(s)
                except Exception:
                    pass

            all_pkgs = pac_pkgs + [f"{p} (Flatpak)" for p in fp_pkgs]
            self.done.emit(json.dumps({
                "count": -1 if err_msg else len(all_pkgs),
                "pacmanCount": len(pac_pkgs),
                "aurCount": 0,
                "flatpakCount": len(fp_pkgs),
                "packages": all_pkgs[:50],
                "flatpakPackages": fp_pkgs[:20],
                "checkedAt": datetime.now().strftime("%H:%M:%S"),
                "error": err_msg,
            }))

