        @pyqtSlot(str, result=bool)
        def killProcessTree(self, pid_str):
            try:
                pid = int(pid_str)
                if pid <= 2 or pid == os.getpid():
                    return False
                protected = {"systemd", "labwc", "quickshell", "dbus-daemon", "pipewire", "wireplumber"}
                to_kill = [pid]
                # Find descendants via /proc
                children_map = {}
                for entry in os.listdir("/proc"):
                    if not entry.isdigit():
                        continue
                    try:
                        with open(f"/proc/{entry}/stat", "r", encoding="utf-8") as f:
                            st_txt = f.read()
                        rp = st_txt.rfind(")")
                        ppid = int(st_txt[rp + 2:].split()[1])
                        children_map.setdefault(ppid, []).append(int(entry))
                    except Exception:
                        continue
                stack = [pid]
                while stack:
                    cur = stack.pop()
                    for ch in children_map.get(cur, []):
                        if ch not in to_kill:
                            to_kill.append(ch)
                            stack.append(ch)
                killed_any = False
                for kpid in reversed(to_kill):
                    if kpid <= 2 or kpid == os.getpid():
                        continue
                    try:
                        comm = open(f"/proc/{kpid}/comm", "r", encoding="utf-8").read().strip().lower()
                        if comm in protected:
                            continue
                    except Exception:
                        pass
                    try:
                        os.kill(kpid, signal.SIGTERM)
                        killed_any = True
                    except Exception:
                        pass
                return killed_any
            except Exception:
                return False

