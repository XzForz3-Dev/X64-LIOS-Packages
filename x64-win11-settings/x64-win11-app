    candidates = [
        ("chromium", "Navegador Web", "edge.svg"),
        ("google-chrome-stable", "Google Chrome", "chrome.svg"),
        ("brave", "Brave Browser", "edge.svg"),
        ("firefox", "Firefox Web", "edge.svg"),
        ("zen-browser", "Zen Browser", "edge.svg"),
