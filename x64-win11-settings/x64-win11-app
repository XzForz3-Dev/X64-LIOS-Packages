    class _UpdateCheckWorker(QThread):
        done = pyqtSignal(str)
        def run(self):
            pkgs = []
            try:
                cmd = ["checkupdates"] if shutil.which("checkupdates") else ["pacman", "-Qu"]
                out = subprocess.check_output(cmd, text=True, timeout=12.0, stderr=subprocess.DEVNULL)
                for ln in out.splitlines():
                    ln = ln.strip()
                    if ln:
                        pkgs.append(ln)
            except subprocess.CalledProcessError as e:
                if e.returncode == 2:
                    pkgs = []
            except Exception:
                pass
            self.done.emit(json.dumps({
                "count": len(pkgs),
                "packages": pkgs[:40],
                "checkedAt": datetime.now().strftime("%H:%M:%S")
            }))

