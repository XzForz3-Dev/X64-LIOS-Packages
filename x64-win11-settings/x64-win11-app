                try:
                    owner = pwd.getpwuid(st.st_uid).pw_name
                except Exception:
                    owner = str(st.st_uid)
                import stat as statmod
                perms = statmod.filemode(st.st_mode)
                is_exec = bool(st.st_mode & 0o111) and not is_dir
                mtime_s = datetime.fromtimestamp(st.st_mtime).strftime("%d/%m/%Y %H:%M:%S")
