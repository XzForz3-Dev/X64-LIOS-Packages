        @pyqtSlot(str, result=bool)
        def compressToZip(self, target_path):
            if not target_path or not os.path.exists(target_path):
                return False
            parent = os.path.dirname(target_path.rstrip("/"))
            base = os.path.basename(target_path.rstrip("/"))
            stem = os.path.splitext(base)[0] if os.path.isfile(target_path) else base
            out_zip = os.path.join(parent, f"{stem}.zip")
            idx = 2
            while os.path.exists(out_zip):
                out_zip = os.path.join(parent, f"{stem} ({idx}).zip")
                idx += 1
            try:
                with zipfile.ZipFile(out_zip, "w", zipfile.ZIP_DEFLATED) as zf:
                    if os.path.isdir(target_path):
                        for rdir, _, files in os.walk(target_path):
                            for fn in files:
                                fp = os.path.join(rdir, fn)
                                arc = os.path.relpath(fp, parent)
                                zf.write(fp, arc)
                    else:
                        zf.write(target_path, base)
                dump_sysinfo_file()
                return True
            except Exception:
                return False

