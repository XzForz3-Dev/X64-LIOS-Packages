_ADB_META_CACHE = {}

def get_phone_link_status():
    kde_inst = (shutil.which("kdeconnectd") is not None) or os.path.isfile("/usr/bin/kdeconnectd") or os.path.isfile("/usr/lib/kdeconnectd") or (shutil.which("kdeconnect-cli") is not None)
    scrcpy_inst = shutil.which("scrcpy") is not None
    adb_inst = shutil.which("adb") is not None
    kde_running = False
    try:
        kde_running = subprocess.run(["pgrep", "-x", "kdeconnectd"], timeout=0.4, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
    except Exception:
        pass

    kde_devs = []
    if kde_inst and kde_running and shutil.which("busctl"):
        try:
            raw_j = subprocess.check_output(
                ["busctl", "--user", "--json=short", "call",
                 "org.kde.kdeconnect", "/modules/kdeconnect",
                 "org.kde.kdeconnect.daemon", "deviceNames", "bb", "false", "false"],
                text=True, timeout=0.6, stderr=subprocess.DEVNULL
            )
            parsed = json.loads(raw_j)
            dev_map = parsed.get("data", [{}])[0] if isinstance(parsed.get("data"), list) and parsed.get("data") else {}
            if isinstance(dev_map, dict):
                for did, dname in dev_map.items():
                    paired, reach, bat_pct, bat_chg = False, False, -1, False
                    try:
                        p_out = subprocess.check_output(
                            ["busctl", "--user", "get-property", "org.kde.kdeconnect",
                             f"/modules/kdeconnect/devices/{did}", "org.kde.kdeconnect.device",
                             "isPaired", "isReachable"],
                            text=True, timeout=0.4, stderr=subprocess.DEVNULL
                        ).strip().splitlines()
                        if len(p_out) >= 1:
                            paired = "true" in p_out[0].lower()
                        if len(p_out) >= 2:
                            reach = "true" in p_out[1].lower()
                    except Exception:
                        pass
                    if paired and reach:
                        try:
                            b_out = subprocess.check_output(
                                ["busctl", "--user", "get-property", "org.kde.kdeconnect",
                                 f"/modules/kdeconnect/devices/{did}/battery", "org.kde.kdeconnect.device.battery",
                                 "charge", "isCharging"],
                                text=True, timeout=0.4, stderr=subprocess.DEVNULL
                            ).strip().splitlines()
                            if len(b_out) >= 1:
                                toks = b_out[0].strip().split()
                                if len(toks) >= 2 and toks[-1].lstrip("-").isdigit():
                                    v = int(toks[-1])
                                    if 0 <= v <= 100:
                                        bat_pct = v
                            if len(b_out) >= 2:
                                bat_chg = "true" in b_out[1].lower()
                        except Exception:
                            pass
                    kde_devs.append({
                        "id": str(did), "name": str(dname), "paired": paired,
                        "reachable": reach, "battery": bat_pct, "charging": bat_chg
                    })
        except Exception:
            pass

    adb_devs = []
    now_m = time.monotonic()
    if adb_inst:
        try:
            aout = subprocess.check_output(["adb", "devices", "-l"], text=True, timeout=0.8, stderr=subprocess.DEVNULL)
            for ln in aout.splitlines()[1:]:
                s = ln.strip()
                if not s or s.startswith("*"):
                    continue
                toks = s.split()
                if len(toks) < 2:
                    continue
                ser, st = toks[0], toks[1]
                model = ser
                for tk in toks[2:]:
                    if tk.startswith("model:"):
                        model = tk.split(":", 1)[1].replace("_", " ")
                        break
                disp_name = model
                bat_pct = -1
                bat_chg = False
                if st == "device":
                    cached = _ADB_META_CACHE.get(ser)
                    if cached and (now_m - cached["ts"]) < 10.0:
                        disp_name, bat_pct, bat_chg = cached["name"], cached["battery"], cached["charging"]
                    else:
                        try:
                            meta_out = subprocess.check_output(
                                ["adb", "-s", ser, "shell",
                                 "settings get global device_name 2>/dev/null; echo '---M---'; getprop ro.product.marketname 2>/dev/null; echo '---B---'; dumpsys battery 2>/dev/null | head -n 18"],
                                text=True, timeout=0.9, stderr=subprocess.DEVNULL
                            )
                            p1 = meta_out.split("---M---")
                            dn = (p1[0] or "").strip() if len(p1) > 0 else ""
                            p2 = (p1[1] if len(p1) > 1 else "").split("---B---")
                            mn = (p2[0] or "").strip() if len(p2) > 0 else ""
                            bs = p2[1] if len(p2) > 1 else ""
                            if dn and dn.lower() not in ("null", "none"):
                                disp_name = dn
                            elif mn and mn.lower() not in ("null", "none"):
                                disp_name = mn
                            m_lvl = re.search(r"level:\s*(\d+)", bs)
                            if m_lvl:
                                v = int(m_lvl.group(1))
                                if 0 <= v <= 100:
                                    bat_pct = v
                            m_st = re.search(r"status:\s*(\d+)", bs)
                            if m_st and m_st.group(1) in ("2", "5"):
                                bat_chg = True
                            elif any(k in bs for k in ("USB powered: true", "AC powered: true", "Wireless powered: true")):
                                bat_chg = True
                            _ADB_META_CACHE[ser] = {"ts": now_m, "name": disp_name, "battery": bat_pct, "charging": bat_chg}
                        except Exception:
                            pass
                adb_devs.append({
                    "serial": ser, "model": disp_name, "rawModel": model, "state": st,
                    "authorized": (st == "device"), "isWifi": (":" in ser),
                    "battery": bat_pct, "charging": bat_chg
                })
