        @pyqtSlot(result=str)
        def getStartupAppsJson(self):
            user_dir = os.path.join(HOME_DIR, ".config", "autostart")
            sys_dir = "/etc/xdg/autostart"
            entries = {}

            def parse_desktop(fp):
                data = {"name": "", "name_es": "", "icon": "windows.svg", "exec": "", "comment": "", "hidden": False, "enabled": True}
                try:
                    with open(fp, "r", encoding="utf-8", errors="ignore") as f:
                        in_entry = False
                        for raw in f:
                            ln = raw.strip()
                            if not ln or ln.startswith("#"):
                                continue
                            if ln.startswith("["):
                                if ln == "[Desktop Entry]":
                                    in_entry = True
                                    continue
                                elif in_entry:
                                    break
                            if not in_entry or "=" not in ln:
                                continue
                            k, v = ln.split("=", 1)
                            k, v = k.strip(), v.strip()
                            if k == "Name":
                                data["name"] = v
                            elif k in ("Name[es]", "Name[es_ES]"):
                                data["name_es"] = v
                            elif k == "Icon":
                                data["icon"] = v
                            elif k == "Exec":
                                data["exec"] = v
                            elif k == "Comment":
                                data["comment"] = v
                            elif k == "Hidden" and v.lower() == "true":
                                data["hidden"] = True
                            elif k == "X-GNOME-Autostart-enabled" and v.lower() == "false":
                                data["enabled"] = False
                except Exception:
                    pass
                return data

            if os.path.isdir(sys_dir):
                for fn in sorted(os.listdir(sys_dir)):
                    if fn.endswith(".desktop"):
                        fp = os.path.join(sys_dir, fn)
                        d = parse_desktop(fp)
                        entries[fn] = {"sys": d, "user": None, "sysPath": fp, "userPath": ""}

            if os.path.isdir(user_dir):
                for fn in sorted(os.listdir(user_dir)):
                    if fn.endswith(".desktop"):
                        fp = os.path.join(user_dir, fn)
                        d = parse_desktop(fp)
                        if fn in entries:
                            entries[fn]["user"] = d
                            entries[fn]["userPath"] = fp
                        else:
                            entries[fn] = {"sys": None, "user": d, "sysPath": "", "userPath": fp}

            items = []
            for fn in sorted(entries.keys()):
                rec = entries[fn]
                u = rec["user"]
                s = rec["sys"]
                primary = u or s
                fallback = s or u
                if not primary:
                    continue
                name = (primary.get("name_es") or primary.get("name") or (fallback.get("name_es") if fallback else "") or (fallback.get("name") if fallback else "") or fn[:-8]).strip()
                exec_cmd = (primary.get("exec") or (fallback.get("exec") if fallback else "") or "").strip()
                icon = (primary.get("icon") or (fallback.get("icon") if fallback else "") or "windows.svg").strip()
                if not name:
                    continue
                is_enabled = not primary.get("hidden", False) and primary.get("enabled", True)
                low_exec = exec_cmd.lower()
                if any(k in low_exec for k in ("discord", "steam", "chromium", "chrome", "electron", "antigravity", "spotify")):
                    impact = "Alto"
                elif any(k in low_exec for k in ("kdeconnect", "blueman", "nm-applet", "polkit", "x64-update", "tray")):
                    impact = "Medio"
                elif exec_cmd:
                    impact = "Bajo"
                else:
                    impact = "No medido"
                items.append({
                    "id": fn,
                    "name": name,
                    "execCmd": exec_cmd or "(Servicio del sistema)",
                    "publisher": "Usuario" if (u and not s) else "Sistema",
                    "enabled": is_enabled,
                    "status": "Habilitado" if is_enabled else "Deshabilitado",
                    "impact": impact,
                    "filePath": rec["userPath"] or rec["sysPath"],
                    "canRemove": bool(u and not s),
                    "iconUrl": resolve_app_icon_url(icon)
                })
            items.sort(key=lambda x: (not x["enabled"], x["name"].lower()))
            return json.dumps(items[:80])

        @pyqtSlot(str, bool, result=bool)
        def setStartupAppEnabled(self, desktop_id, enabled):
            if not desktop_id or "/" in desktop_id or not desktop_id.endswith(".desktop"):
                return False
            user_dir = os.path.join(HOME_DIR, ".config", "autostart")
            os.makedirs(user_dir, exist_ok=True)
            user_fp = os.path.join(user_dir, desktop_id)
            sys_fp = os.path.join("/etc/xdg/autostart", desktop_id)
            src_fp = user_fp if os.path.isfile(user_fp) else (sys_fp if os.path.isfile(sys_fp) else "")
            if not src_fp:
                return False
            try:
                with open(src_fp, "r", encoding="utf-8", errors="ignore") as f:
                    lines = f.read().splitlines()
                out = []
                in_entry = False
                set_h = False
                set_g = False
                for ln in lines:
                    s = ln.strip()
                    if s.startswith("["):
                        if in_entry:
                            if not set_h:
                                out.append(f"Hidden={'false' if enabled else 'true'}")
                                set_h = True
                            if not set_g:
                                out.append(f"X-GNOME-Autostart-enabled={'true' if enabled else 'false'}")
                                set_g = True
                        in_entry = (s == "[Desktop Entry]")
                        out.append(ln)
                        continue
                    if in_entry and s.startswith("Hidden="):
                        out.append(f"Hidden={'false' if enabled else 'true'}")
                        set_h = True
                        continue
                    if in_entry and s.startswith("X-GNOME-Autostart-enabled="):
                        out.append(f"X-GNOME-Autostart-enabled={'true' if enabled else 'false'}")
                        set_g = True
                        continue
                    out.append(ln)
                if not set_h:
                    out.append(f"Hidden={'false' if enabled else 'true'}")
                if not set_g:
