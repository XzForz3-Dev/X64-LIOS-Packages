            os.replace(mon_p + ".tmp", mon_p)

        def _repack_monitors_contiguous(self, order_override=None):
            """Recalculate exact contiguous --pos X,0 for all enabled outputs (zero dead cursor gaps!)."""
            try:
                wdata = json.loads(subprocess.check_output(["wlr-randr", "--json"], text=True, timeout=1.8, stderr=subprocess.DEVNULL))
                if not isinstance(wdata, list):
                    return False
                by_name = {str(m.get("name", "")): m for m in wdata if m.get("name")}
                enabled = [m for m in wdata if m.get("enabled") and m.get("name")]
                if order_override:
                    ordered = [by_name[n] for n in order_override if n in by_name and by_name[n].get("enabled")]
                    for m in enabled:
                        if m not in ordered:
                            ordered.append(m)
                else:
                    ordered = sorted(enabled, key=lambda m: (int((m.get("position") or {}).get("x", 0)), int((m.get("position") or {}).get("y", 0)), str(m.get("name", ""))))
                if not ordered:
                    return True
                cmd = ["wlr-randr"]
                patches = {}
                cur_x = 0
                for m in ordered:
                    nm = str(m["name"])
                    sc = float(m.get("scale") or 1.0)
                    if sc <= 0.1:
                        sc = 1.0
                    tr = str(m.get("transform") or "normal")
                    mw, mh = 1920, 1080
                    for md in (m.get("modes") or []):
                        if md.get("current"):
                            mw = int(md.get("width", 1920))
                            mh = int(md.get("height", 1080))
                            break
                    if tr in ("90", "270", "flipped-90", "flipped-270"):
                        mw, mh = mh, mw
                    log_w = max(320, int(round(mw / sc)))
                    pos_s = f"{cur_x},0"
                    cmd += ["--output", nm, "--pos", pos_s]
                    patches[nm] = {"pos": pos_s, "enabled": True}
                    cur_x += log_w
                if len(cmd) > 1:
                    subprocess.run(cmd, timeout=2.5, stderr=subprocess.DEVNULL)
                    self._save_monitors_patch(patches)
                return True
            except Exception:
                return False

