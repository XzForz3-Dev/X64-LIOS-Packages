def _build_gaming_info(cfg=None):
    if cfg is None:
        cfg = load_cfg()
    def _svc_on(svc):
        try:
            return subprocess.run(["systemctl", "is-active", "--quiet", svc], timeout=0.6).returncode == 0
        except Exception:
            return False

    sched = "BORE"
    try:
        if os.path.isfile("/sys/kernel/sched_ext/state") and open("/sys/kernel/sched_ext/state").read().strip() == "enabled":
            ops = open("/sys/kernel/sched_ext/root/ops").read().strip() if os.path.isfile("/sys/kernel/sched_ext/root/ops") else ""
            if ops:
                sched = "scx_" + ops.split("_")[0]
            else:
                sched = "scx_ext"
    except Exception:
        pass

    adaptive_sync = "yes"
    allow_tearing = "no"
    try:
        rc_p = os.path.join(HOME_DIR, ".config", "labwc", "rc.xml")
        if os.path.isfile(rc_p):
            rc_t = open(rc_p, "r", encoding="utf-8", errors="ignore").read()
            m_as = re.search(r"<adaptiveSync>\s*(yes|no|fullscreen)\s*</adaptiveSync>", rc_t, re.I)
            if m_as:
                adaptive_sync = m_as.group(1)
            m_at = re.search(r"<allowTearing>\s*(yes|no|fullscreen|fullscreenForced)\s*</allowTearing>", rc_t)
            if m_at:
                allow_tearing = m_at.group(1)
    except Exception:
        pass

    shot_dir = _resolve_screenshot_dir(cfg)
    shot_count = 0
    try:
        if os.path.isdir(shot_dir):
            shot_count = sum(1 for fn in os.listdir(shot_dir) if fn.lower().endswith((".png", ".jpg", ".jpeg", ".webp")))
    except Exception:
        pass

    gamepads = []
    seen_gp = set()
    noise_kw = ("motion sensor", "touchpad", "accelerometer", "gyro", "imu")

    def _is_evdev_gamepad(dev_dir):
        key_p = os.path.join(dev_dir, "capabilities", "key")
        if not os.path.isfile(key_p):
            return False
        try:
            words = [int(w, 16) for w in open(key_p).read().strip().split()]
            # Linux input-event-codes.h: BTN_GAMEPAD = 0x130 (304), BTN_JOYSTICK = 0x120 (288)
            bits = 0
            for idx, w in enumerate(reversed(words)):
                bits |= (w << (idx * 64))
            return bool((bits & (1 << 0x130)) or (bits & (1 << 0x120)))
        except Exception:
            return False

    try:
        for js_p in sorted(glob.glob("/sys/class/input/js*")):
            nm_p = os.path.join(js_p, "device", "name")
            if os.path.isfile(nm_p):
                gname = open(nm_p, "r", encoding="utf-8", errors="ignore").read().strip()
                low = gname.lower()
                if gname and gname not in seen_gp and not any(nk in low for nk in noise_kw):
                    seen_gp.add(gname)
                    gamepads.append({"id": os.path.basename(js_p), "name": gname})
        for ev_p in sorted(glob.glob("/sys/class/input/event*")):
            dev_d = os.path.join(ev_p, "device")
            nm_p = os.path.join(dev_d, "name")
            if os.path.isfile(nm_p) and _is_evdev_gamepad(dev_d):
                gname = open(nm_p, "r", encoding="utf-8", errors="ignore").read().strip()
                low = gname.lower()
                if gname and gname not in seen_gp and not any(nk in low for nk in noise_kw):
                    seen_gp.add(gname)
                    gamepads.append({"id": os.path.basename(ev_p), "name": gname})
    except Exception:
        pass

    def _pick_icon(candidates, fallback_svg):
        for k in candidates:
            u = resolve_app_icon_url(k)
            if u and not u.endswith("windows.svg"):
                return u
        return f"file://{ASSET_DIR}{fallback_svg}"

    app_icons = {
        "steam":    _pick_icon(["steam"], "steam.svg"),
        "heroic":   _pick_icon(["com.heroicgameslauncher.hgl", "heroic"], "fluent-games.svg"),
        "lutris":   _pick_icon(["net.lutris.Lutris", "lutris"], "fluent-games.svg"),
        "goverlay": _pick_icon(["io.github.benjamimgois.goverlay", "goverlay"], "fluent-display.svg"),
        "obs":      _pick_icon(["com.obsproject.Studio", "obs"], "fluent-play-filled.svg"),
    }

    return {
        "sched": sched,
        "falcond": _svc_on("falcond.service"),
        "dmemcg": _svc_on("dmemcg-booster-system.service"),
        "ananicy": _svc_on("ananicy-cpp.service"),
        "ntsync": os.path.exists("/dev/ntsync") or os.environ.get("PROTON_USE_NTSYNC") == "1",
        "hasSteam": shutil.which("steam") is not None,
        "hasHeroic": shutil.which("heroic") is not None,
        "hasLutris": shutil.which("lutris") is not None,
        "hasGoverlay": shutil.which("goverlay") is not None,
        "hasMangohud": shutil.which("mangohud") is not None,
        "hasGamescope": shutil.which("gamescope") is not None,
        "hasObs": shutil.which("obs") is not None,
        "hasX64Hello": shutil.which("x64-hello") is not None,
        "adaptiveSync": adaptive_sync,
        "allowTearing": allow_tearing,
        "screenshotDir": shot_dir,
        "screenshotCount": shot_count,
        "gamepads": gamepads,
        "appIcons": app_icons,
    }


def _read_x64_update_cache():
    st_dir = os.path.join(HOME_DIR, ".local", "state", "x64-update")
    cnt_f = os.path.join(st_dir, "count")
    pkg_f = os.path.join(st_dir, "packages.txt")
    chk_f = os.path.join(st_dir, "last_check")
    if not os.path.isfile(cnt_f):
        return None
    try:
        raw_cnt = open(cnt_f, "r", encoding="utf-8", errors="ignore").read().strip()
        total_cnt = int(raw_cnt)
    except Exception:
        return None
    all_pkgs = []
    pac_cnt = 0
    aur_cnt = 0
    fp_cnt = 0
    if os.path.isfile(pkg_f):
        try:
            for ln in open(pkg_f, "r", encoding="utf-8", errors="ignore"):
                s = ln.strip()
                if not s:
                    continue
                all_pkgs.append(s)
                if s.endswith("(AUR)"):
                    aur_cnt += 1
                elif s.endswith("(Flatpak)") or s.startswith("[Flatpak]"):
                    fp_cnt += 1
                else:
                    pac_cnt += 1
        except Exception:
            pass
    if all_pkgs and total_cnt != len(all_pkgs):
        total_cnt = len(all_pkgs)
    checked_at = ""
    if os.path.isfile(chk_f):
        try:
            ts = float(open(chk_f, "r", encoding="utf-8", errors="ignore").read().strip())
            dt = datetime.fromtimestamp(ts)
            now = datetime.now()
            checked_at = dt.strftime("%H:%M:%S") if dt.date() == now.date() else dt.strftime("%Y-%m-%d %H:%M")
        except Exception:
            pass
    return {
        "count": total_cnt,
        "pacmanCount": pac_cnt,
        "aurCount": aur_cnt,
        "flatpakCount": fp_cnt,
        "packages": all_pkgs[:50],
        "flatpakPackages": [p for p in all_pkgs if p.endswith("(Flatpak)") or p.startswith("[Flatpak]")][:20],
        "checkedAt": checked_at,
        "error": "",
        "fromCache": True,
    }


def _is_update_tray_running():
    my_uid = os.getuid()
    try:
        for pid in os.listdir("/proc"):
            if not pid.isdigit():
                continue
            pdir = os.path.join("/proc", pid)
            try:
                if os.stat(pdir).st_uid != my_uid:
                    continue
                cmd = open(os.path.join(pdir, "cmdline"), "rb").read().replace(b"\x00", b" ").decode("utf-8", "ignore")
                if "/usr/bin/x64-update-tray" in cmd or cmd.strip().endswith("x64-update-tray"):
                    return True
            except Exception:
                continue
    except Exception:
        pass
    return False


def _is_update_tray_autostart():
    user_desk = os.path.join(HOME_DIR, ".config", "autostart", "x64-update-tray.desktop")
    if not os.path.isfile(user_desk):
        return os.path.isfile("/etc/xdg/autostart/x64-update-tray.desktop") or shutil.which("x64-update-tray") is not None
    try:
        txt = open(user_desk, "r", encoding="utf-8", errors="ignore").read().lower()
        if "hidden=true" in txt or "x-gnome-autostart-enabled=false" in txt:
            return False
        return True
    except Exception:
        return True


def _build_update_info():
    history = []
    last_upg_date = ""
    try:
        if os.path.isfile("/var/log/pacman.log"):
            lines = open("/var/log/pacman.log", "r", encoding="utf-8", errors="ignore").readlines()[-3500:]
            for ln in reversed(lines):
                act = ""
                body = ""
                if "[ALPM] upgraded " in ln:
                    act = "upgraded"
                    body = ln.split("[ALPM] upgraded ", 1)[1].strip()
                elif "[ALPM] installed " in ln:
                    act = "installed"
                    body = ln.split("[ALPM] installed ", 1)[1].strip()
                elif "[ALPM] removed " in ln:
                    act = "removed"
                    body = ln.split("[ALPM] removed ", 1)[1].strip()
                elif "[ALPM] downgraded " in ln:
                    act = "downgraded"
                    body = ln.split("[ALPM] downgraded ", 1)[1].strip()
                else:
                    continue
                dt = ln[1:17].replace("T", " ")
                pkg_nm = body.split()[0] if body else ""
                if act == "upgraded" and not last_upg_date:
                    last_upg_date = dt
                history.append({"date": dt, "action": act, "pkg": pkg_nm, "entry": body})
                if len(history) >= 60:
                    break
    except Exception:
        pass

    try:
        pkg_count = max(0, len(os.listdir("/var/lib/pacman/local")) - 1)
    except Exception:
        pkg_count = 0

    repos = []
    ignore_pkgs = []
    try:
        if os.path.isfile("/etc/pacman.conf"):
            for raw in open("/etc/pacman.conf", "r", encoding="utf-8", errors="ignore"):
                s = raw.strip()
                if not s or s.startswith("#"):
                    continue
                if s.startswith("[") and s.endswith("]"):
                    rname = s[1:-1].strip()
                    if rname and rname.lower() != "options" and rname not in repos:
                        repos.append(rname)
                elif s.startswith("IgnorePkg"):
                    vals = s.split("=", 1)[1].strip().split() if "=" in s else []
                    for v in vals:
                        if v and v not in ignore_pkgs:
                            ignore_pkgs.append(v)
    except Exception:
        pass

    def _unit_exists(unit):
        return os.path.isfile(f"/usr/lib/systemd/system/{unit}") or os.path.isfile(f"/etc/systemd/system/{unit}")

    def _timer_enabled(unit):
        if not _unit_exists(unit):
            return False
        try:
            r = subprocess.run(["systemctl", "is-enabled", unit], capture_output=True, text=True, timeout=0.8)
            return r.stdout.strip() == "enabled"
        except Exception:
            return False

    cache_bytes = 0
    try:
        if os.path.isdir("/var/cache/pacman/pkg"):
            for ent in os.scandir("/var/cache/pacman/pkg"):
                try:
                    if ent.is_file(follow_symlinks=False):
                        cache_bytes += ent.stat(follow_symlinks=False).st_size
                except Exception:
                    pass
    except Exception:
        pass
    if cache_bytes >= 1024 ** 3:
        pacman_cache_human = f"{cache_bytes / (1024 ** 3):.1f} GB"
    else:
        pacman_cache_human = f"{cache_bytes / (1024 ** 2):.0f} MB"

    tray_running = _is_update_tray_running()
    tray_autostart = _is_update_tray_autostart()

    running_k = ""
    try:
        running_k = os.uname().release
    except Exception:
        pass

    installed_kernels = []
    installed_k_releases = set()
    try:
        if os.path.isdir("/var/lib/pacman/local"):
            for d in sorted(os.listdir("/var/lib/pacman/local")):
                if not d.startswith("linux"):
                    continue
                files_p = os.path.join("/var/lib/pacman/local", d, "files")
                desc_p = os.path.join("/var/lib/pacman/local", d, "desc")
                if not os.path.isfile(files_p) or not os.path.isfile(desc_p):
                    continue
                rel_found = ""
                try:
                    with open(files_p, "r", encoding="utf-8", errors="ignore") as ff:
                        for fln in ff:
                            s = fln.strip()
                            if s.startswith("usr/lib/modules/") and s.endswith("/vmlinuz"):
                                parts = s.split("/")
                                if len(parts) >= 5:
                                    rel_found = parts[3]
                                    break
                except Exception:
                    continue
                if not rel_found:
                    continue
                installed_k_releases.add(rel_found)
                kname = kver = ""
                cur = None
                with open(desc_p, "r", encoding="utf-8", errors="ignore") as df:
                    for raw in df:
                        s = raw.strip()
                        if s.startswith("%") and s.endswith("%"):
                            cur = s
                        elif s:
                            if cur == "%NAME%": kname = s
                            elif cur == "%VERSION%": kver = s
                if kname:
                    installed_kernels.append({
                        "name": kname,
                        "version": kver,
                        "release": rel_found,
                        "active": bool(running_k) and (rel_found == running_k),
                    })
    except Exception:
        pass

    if running_k and installed_k_releases:
        reboot_required = running_k not in installed_k_releases
    else:
        reboot_required = bool(running_k) and not os.path.isdir(f"/usr/lib/modules/{running_k}")

    snapper_cfgs = []
    try:
        if os.path.isdir("/etc/snapper/configs"):
            snapper_cfgs = sorted(f for f in os.listdir("/etc/snapper/configs") if not f.startswith("."))
    except Exception:
        pass

    has_snap_pac = os.path.isfile("/usr/share/libalpm/hooks/05-snap-pac-pre.hook")
    has_limine_snapper = _timer_enabled("limine-snapper-sync.service")

    is_uefi = os.path.isdir("/sys/firmware/efi")
    can_fw_reboot = False
    if is_uefi:
        try:
            rfw = subprocess.run(
                ["busctl", "call", "org.freedesktop.login1", "/org/freedesktop/login1",
                 "org.freedesktop.login1.Manager", "CanRebootToFirmwareSetup"],
                capture_output=True, text=True, timeout=0.8
            )
            out_fw = (rfw.stdout or "").lower()
            if '"yes"' in out_fw or '"challenge"' in out_fw:
                can_fw_reboot = True
            elif rfw.returncode != 0:
                can_fw_reboot = bool(glob.glob("/sys/firmware/efi/efivars/OsIndicationsSupported-*"))
        except Exception:
            can_fw_reboot = bool(glob.glob("/sys/firmware/efi/efivars/OsIndicationsSupported-*"))

    return {
        "history": history,
        "lastUpgradeDate": last_upg_date,
        "pkgCount": pkg_count,
        "repos": repos,
        "ignorePkgs": ignore_pkgs,
        "hasPaccacheTimer": _unit_exists("paccache.timer"),
        "hasFstrimTimer": _unit_exists("fstrim.timer"),
        "paccacheTimerEnabled": _timer_enabled("paccache.timer"),
        "fstrimTimerEnabled": _timer_enabled("fstrim.timer"),
        "pacmanCacheHuman": pacman_cache_human,
        "trayRunning": tray_running,
        "trayAutostartEnabled": tray_autostart,
        "hasUpdateTray": shutil.which("x64-update-tray") is not None,
        "runningKernel": running_k,
        "rebootRequired": reboot_required,
        "installedKernels": installed_kernels,
        "snapperConfigs": snapper_cfgs,
        "hasSnapPac": has_snap_pac,
        "hasLimineSnapper": has_limine_snapper,
        "hasBtrfsAssistant": shutil.which("btrfs-assistant") is not None,
        "hasX64Update": shutil.which("x64-update") is not None,
        "hasX64Hello": shutil.which("x64-hello") is not None,
        "isUefi": is_uefi,
        "canRebootFirmware": can_fw_reboot,
        "cachedCheck": _read_x64_update_cache(),
    }


def get_real_user_info():
    try:
        pw = pwd.getpwuid(os.getuid())
        uname = pw.pw_name
        gecos = (pw.pw_gecos or "").split(",")[0].strip()
        display_name = gecos if gecos else uname.capitalize()
    except Exception:
        uname = os.environ.get("USER", "x64")
        display_name = uname.capitalize()
    try:
        if os.path.isfile(CONFIG_FILE):
            with open(CONFIG_FILE, "r", encoding="utf-8") as cf:
                c = json.load(cf)
                ov = str(c.get("displayNameOverride", "") or "").strip()
                if ov:
                    display_name = ov
    except Exception:
        pass
    hostname = socket.gethostname()
    return display_name, uname, hostname


def load_cfg():
    os.makedirs(STATE_DIR, exist_ok=True)
    if os.path.isfile(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, "r", encoding="utf-8") as f:
                data = json.load(f)
                out = dict(DEFAULT_CFG)
                out.update(data)
                return out
        except Exception:
            pass
    return dict(DEFAULT_CFG)


def save_cfg(cfg):
    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = CONFIG_FILE + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(cfg, f)
    os.replace(tmp, CONFIG_FILE)


def resolve_special_folder(name):
    display_name, uname, _ = get_real_user_info()
    if name in (display_name, uname, "Inicio", "Home"):
        return HOME_DIR
    if name in ("Papelera", "Papelera de reciclaje", "Trash"):
        trash_dir = os.path.join(HOME_DIR, ".local", "share", "Trash", "files")
        os.makedirs(trash_dir, exist_ok=True)
        return trash_dir
    mapping = {
        "Escritorio": ["Escritorio", "Desktop"],
        "Descargas": ["Descargas", "Downloads"],
        "Documentos": ["Documentos", "Documents"],
        "Imágenes": ["Imágenes", "Imagenes", "Pictures"],
        "Música": ["Música", "Musica", "Music"],
        "Vídeos": ["Vídeos", "Videos"],
        "Proyectos": ["Proyectos", "Projects"],
        "X64 LIOS (C:)": ["/"],
    }
    if name in mapping:
        for cand in mapping[name]:
            if cand == "/":
                return "/"
            p = os.path.join(HOME_DIR, cand)
            if os.path.isdir(p):
                return p
        return os.path.join(HOME_DIR, mapping[name][0])
    if os.path.isdir(name):
        return name
    return HOME_DIR


def get_battery_status():
    bats = sorted(glob.glob("/sys/class/power_supply/BAT*"))
    if not bats:
        return {
            "hasBattery": False,
            "batteryPct": 100,
            "batteryCharging": True,
            "batteryText": "Conectado a CA (PC de Escritorio)"
        }
    bat = bats[0]
    try:
        with open(os.path.join(bat, "capacity"), "r", encoding="utf-8") as f:
            pct = max(0, min(100, int(f.read().strip())))
    except Exception:
        pct = 100
    try:
        with open(os.path.join(bat, "status"), "r", encoding="utf-8") as f:
            st = f.read().strip()
    except Exception:
        st = "Full"
    charging = st in ("Charging", "Full", "Not charging", "Unknown")
    if pct <= 0 and charging:
        return {
            "hasBattery": False,
            "batteryPct": 100,
            "batteryCharging": True,
            "batteryText": "Conectado a CA (Alimentación directa)"
        }
    st_es = "Cargando (CA)" if st == "Charging" else ("Carga completa (CA)" if charging else "En batería")
    return {
        "hasBattery": True,
        "batteryPct": pct,
        "batteryCharging": charging,
        "batteryText": f"{pct}% • {st_es}"
    }


def get_live_hardware_controls():
    # 1. Wi-Fi state & active SSID + nearby networks (--rescan no is <15ms)
    wifi_enabled = True
    wifi_ssid = "Wi-Fi"
    wifi_networks = []
    try:
        env = dict(os.environ, LC_ALL="C")
        out_g = subprocess.check_output(
            ["nmcli", "-t", "-f", "WIFI", "g"],
            text=True, timeout=1.2, env=env, stderr=subprocess.DEVNULL
        ).strip().lower()
        wifi_enabled = (out_g == "enabled")
        if wifi_enabled:
            out_w = subprocess.check_output(
                ["nmcli", "-t", "-f", "ACTIVE,SSID,SIGNAL,SECURITY,FREQ", "dev", "wifi", "list", "--rescan", "no"],
                text=True, timeout=1.5, env=env, stderr=subprocess.DEVNULL
            ).splitlines()
            by_ssid = {}
            for line in out_w:
                parts = re.split(r"(?<!\\):", line)
                if len(parts) < 4:
                    continue
                act = (parts[0].strip().lower() == "yes")
                ssid = parts[1].replace("\\:", ":").strip()
                if not ssid:
                    continue
                try:
                    sig = int(parts[2].strip())
                except Exception:
                    sig = 50
                sec = parts[3].replace("\\:", ":").strip() or "Abierta"
                freq_raw = parts[4].strip() if len(parts) > 4 else ""
                band = ""
                m_f = re.search(r"(\d+)", freq_raw)
                if m_f:
                    mhz = int(m_f.group(1))
                    if mhz >= 5900:
                        band = "6 GHz"
                    elif mhz >= 4900:
                        band = "5 GHz"
                    elif mhz >= 2400:
                        band = "2.4 GHz"
                if act:
                    wifi_ssid = ssid
                prev = by_ssid.get(ssid)
                if prev is None:
                    by_ssid[ssid] = {
                        "ssid": ssid,
                        "signal": sig,
                        "security": sec,
                        "band": band,
                        "bands": [band] if band else [],
                        "active": act
                    }
                else:
                    if band and band not in prev["bands"]:
                        prev["bands"].append(band)
                    if act or (not prev["active"] and sig > prev["signal"]):
                        prev["signal"] = sig
                        prev["security"] = sec
                        if band:
                            prev["band"] = band
                        if act:
                            prev["active"] = True
            wifi_networks = list(by_ssid.values())
            wifi_networks.sort(key=lambda x: (not x["active"], -x["signal"]))
        else:
            wifi_ssid = "Desactivado"
    except Exception:
        pass

    # 2. Bluetooth state via rfkill
    bt_enabled = True
    try:
        out_bt = subprocess.check_output(
            ["rfkill", "list", "bluetooth"],
            text=True, timeout=1.0, stderr=subprocess.DEVNULL
        ).lower()
        if "soft blocked: yes" in out_bt or "hard blocked: yes" in out_bt:
            bt_enabled = False
    except Exception:
        pass

    # 3. Universal Brightness: hardware backlight if present, else saved overlay cfg.brightnessPct
    brightness_pct = int(round(float(load_cfg().get("brightnessPct", 100))))
    if glob.glob("/sys/class/backlight/*/brightness"):
        try:
            out_br = subprocess.check_output(
                ["brightnessctl", "-m"],
                text=True, timeout=1.0, stderr=subprocess.DEVNULL
            ).strip()
            for field in out_br.split(","):
                if field.endswith("%"):
                    brightness_pct = max(10, min(100, int(field[:-1])))
                    break
        except Exception:
            pass
    brightness_pct = max(10, min(100, brightness_pct))

    # 4. Real 3-State Hardware Power Profile (performance | balanced | power-saver)
    # Fast D-Bus read via busctl (~4ms) instead of spawning Python powerprofilesctl (~178ms)!
    power_profile = "balanced"
    ppd_ok = False
    try:
        out_bus = subprocess.check_output(
            ["busctl", "get-property", "net.hadess.PowerProfiles", "/net/hadess/PowerProfiles",
             "net.hadess.PowerProfiles", "ActiveProfile"],
            text=True, timeout=0.6, stderr=subprocess.DEVNULL
        ).strip()
        if '"' in out_bus:
            val_pp = out_bus.split('"')[1].strip().lower()
            if val_pp in ("performance", "balanced", "power-saver"):
                power_profile = val_pp
                ppd_ok = True
    except Exception:
        pass
    if not ppd_ok and shutil.which("powerprofilesctl"):
        try:
            out_pp = subprocess.check_output(
                ["powerprofilesctl", "get"],
                text=True, timeout=1.2, stderr=subprocess.DEVNULL
            ).strip().lower()
            if out_pp in ("performance", "balanced", "power-saver"):
                power_profile = out_pp
                ppd_ok = True
        except Exception:
            pass

    if not ppd_ok:
        try:
            epp_path = "/sys/devices/system/cpu/cpu0/cpufreq/energy_performance_preference"
            gov_path = "/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor"
            if os.path.isfile(epp_path):
                with open(epp_path, "r", encoding="utf-8") as f:
                    epp = f.read().strip().lower()
                if epp == "performance":
                    power_profile = "performance"
                elif epp in ("power", "balance_power"):
                    power_profile = "power-saver"
                else:
                    power_profile = "balanced"
            elif os.path.isfile(gov_path):
                with open(gov_path, "r", encoding="utf-8") as f:
                    gov = f.read().strip().lower()
                power_profile = "performance" if gov == "performance" else "power-saver"
        except Exception:
            pass

    profile_labels = {
        "performance": "Gaming X64",
        "balanced": "Equilibrado",
        "power-saver": "Ahorro energía",
    }

    return {
        "wifiEnabled": wifi_enabled,
        "wifiSsid": wifi_ssid,
        "wifiNetworks": wifi_networks[:8],
        "btEnabled": bt_enabled,
        "brightnessPct": brightness_pct,
        "powerProfile": power_profile,
        "cpuGovernor": profile_labels.get(power_profile, "Equilibrado"),
        "gamingActive": (power_profile == "performance"),
        "powerSaverActive": (power_profile == "power-saver")
    }


