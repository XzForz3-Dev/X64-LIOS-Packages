        @pyqtSlot(str, result=bool)
        def applyAppearanceSetting(self, json_str):
            """Apply real accent color, GTK Dark/Light mode, and Cursor Theme/Size across gsettings, GTK3/4 & labwc."""
            try:
                d = json.loads(json_str)
            except Exception:
                return False
            try:
                def _upd_ini(path, kv_map):
                    os.makedirs(os.path.dirname(path), exist_ok=True)
                    lines = open(path, "r", encoding="utf-8", errors="ignore").read().splitlines() if os.path.isfile(path) else ["[Settings]"]
                    if not any(ln.strip() == "[Settings]" for ln in lines):
                        lines.insert(0, "[Settings]")
                    seen = set()
                    out = []
                    for ln in lines:
                        if "=" in ln and not ln.strip().startswith("#"):
                            k = ln.split("=", 1)[0].strip()
                            if k in kv_map:
                                out.append(f"{k}={kv_map[k]}")
                                seen.add(k)
                                continue
                        out.append(ln)
                    for k, v in kv_map.items():
                        if k not in seen:
                            out.append(f"{k}={v}")
                    tmp = path + ".tmp"
                    with open(tmp, "w", encoding="utf-8") as f:
                        f.write("\n".join(out) + "\n")
                    os.replace(tmp, path)

                def _upd_env(path, kv_map):
                    os.makedirs(os.path.dirname(path), exist_ok=True)
                    lines = open(path, "r", encoding="utf-8", errors="ignore").read().splitlines() if os.path.isfile(path) else []
                    seen = set()
                    out = []
                    for ln in lines:
                        if "=" in ln and not ln.strip().startswith("#"):
                            k = ln.split("=", 1)[0].strip()
                            if k in kv_map:
                                out.append(f"{k}={kv_map[k]}")
                                seen.add(k)
                                continue
                        out.append(ln)
                    for k, v in kv_map.items():
                        if k not in seen:
                            out.append(f"{k}={v}")
                    tmp = path + ".tmp"
                    with open(tmp, "w", encoding="utf-8") as f:
                        f.write("\n".join(out) + "\n")
                    os.replace(tmp, path)

                ini_updates = {}
                env_updates = {}
                need_labwc_reconf = False
                has_gs = shutil.which("gsettings") is not None

                if "accentColor" in d or "accentOnBorders" in d:
                    cfg = load_cfg()
                    ac = str(d.get("accentColor", cfg.get("accentColor", "#4cc2ff")) or "#4cc2ff").strip()
                    if not re.match(r"^#[0-9a-fA-F]{6}$", ac):
                        ac = "#4cc2ff"
                    on_borders = bool(d.get("accentOnBorders", cfg.get("accentOnBorders", True)))
                    cfg["accentColor"] = ac
                    cfg["accentOnBorders"] = on_borders
                    self._cfg_rev += 1
                    save_cfg(cfg)

                    # 1. Live labwc Window Borders, Active Menus & Alt+Tab OSD (~/.config/labwc/themerc-override)
                    ovr_dir = os.path.join(HOME_DIR, ".config", "labwc")
                    os.makedirs(ovr_dir, exist_ok=True)
                    ovr_p = os.path.join(ovr_dir, "themerc-override")
                    border_col = ac if on_borders else "#38ffffff"
                    ovr_txt = (
                        "# X64 Windows 11 Live Accent Override\n"
                        f"window.active.border.color: {border_col}\n"
                        f"osd.border.color: {ac}\n"
                        f"menu.items.active.bg.color: {ac}\n"
                        "menu.items.active.text.color: #000000\n"
                    )
                    with open(ovr_p + ".tmp", "w", encoding="utf-8") as f:
                        f.write(ovr_txt)
                    os.replace(ovr_p + ".tmp", ovr_p)
                    need_labwc_reconf = True

                    # 2. Live GTK3 & GTK4 Accent CSS (~/.config/gtk-{3,4}.0/gtk.css)
                    gtk_css = (
                        "/* X64-WIN11-ACCENT */\n"
                        f"@define-color accent_bg_color {ac};\n"
                        f"@define-color accent_color {ac};\n"
                        "@define-color accent_fg_color #000000;\n"
                    )
                    for gver in ("gtk-3.0", "gtk-4.0"):
                        gdir = os.path.join(HOME_DIR, ".config", gver)
                        os.makedirs(gdir, exist_ok=True)
                        gp = os.path.join(gdir, "gtk.css")
                        with open(gp + ".tmp", "w", encoding="utf-8") as f:
                            f.write(gtk_css)
                        os.replace(gp + ".tmp", gp)

                    # 3. GNOME / Libadwaita gsettings accent-color
                    gn_map = {
                        "#4cc2ff": "blue", "#60a5fa": "blue", "#a78bfa": "purple",
                        "#ff6b6b": "red", "#ff4d4d": "red", "#34d399": "green",
                        "#fbbf24": "orange", "#2dd4bf": "teal", "#f472b6": "pink"
                    }
                    if has_gs:
                        subprocess.run(
                            ["gsettings", "set", "org.gnome.desktop.interface", "accent-color", gn_map.get(ac.lower(), "blue")],
                            timeout=1.5, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
                        )

                if "gtkDark" in d:
                    dark = bool(d["gtkDark"])
                    gtk_th = "adw-gtk3-dark" if dark else "adw-gtk3"
                    cscheme = "prefer-dark" if dark else "default"
                    ini_updates["gtk-application-prefer-dark-theme"] = "1" if dark else "0"
                    ini_updates["gtk-theme-name"] = gtk_th
                    env_updates["GTK_THEME"] = gtk_th
                    if has_gs:
                        subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "color-scheme", cscheme], timeout=1.5, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                        subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "gtk-theme", gtk_th], timeout=1.5, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

                if "cursorTheme" in d:
                    ct = str(d["cursorTheme"] or "breeze_cursors").strip()
                    if ct and re.match(r"^[A-Za-z0-9_.-]+$", ct):
                        ini_updates["gtk-cursor-theme-name"] = ct
                        env_updates["XCURSOR_THEME"] = ct
                        # Write standard XDG/X11 default cursor index.theme for Wayland/XWayland clients
                        for ic_def in (
                            os.path.join(HOME_DIR, ".icons", "default", "index.theme"),
                            os.path.join(HOME_DIR, ".local", "share", "icons", "default", "index.theme"),
                        ):
                            os.makedirs(os.path.dirname(ic_def), exist_ok=True)
                            with open(ic_def + ".tmp", "w", encoding="utf-8") as f:
                                f.write(f"[Icon Theme]\nInherits={ct}\n")
                            os.replace(ic_def + ".tmp", ic_def)
                        if has_gs:
                            subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "cursor-theme", ct], timeout=1.5, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

                if "cursorSize" in d:
                    cs = max(16, min(64, int(d["cursorSize"])))
                    ini_updates["gtk-cursor-theme-size"] = str(cs)
                    env_updates["XCURSOR_SIZE"] = str(cs)
                    if has_gs:
                        subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "cursor-size", str(cs)], timeout=1.5, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

                if ini_updates:
                    for gver in ("gtk-3.0", "gtk-4.0"):
                        _upd_ini(os.path.join(HOME_DIR, ".config", gver, "settings.ini"), ini_updates)
                if env_updates:
                    _upd_env(os.path.join(HOME_DIR, ".config", "labwc", "environment"), env_updates)
                    # Propagate XCURSOR/GTK env to systemd user & DBus so newly launched apps inherit live changes!
                    exp_pairs = [f"{k}={v}" for k, v in env_updates.items()]
                    if shutil.which("dbus-update-activation-environment"):
                        subprocess.run(["dbus-update-activation-environment", "--systemd"] + exp_pairs, timeout=1.5, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                    elif shutil.which("systemctl"):
                        subprocess.run(["systemctl", "--user", "set-environment"] + exp_pairs, timeout=1.5, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                    need_labwc_reconf = True
                if need_labwc_reconf:
                    # Send SIGHUP directly to labwc (works even if LABWC_PID is not inherited!)
                    subprocess.run(["pkill", "-HUP", "-x", "labwc"], timeout=1.2, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                return True
            except Exception:
                return False

