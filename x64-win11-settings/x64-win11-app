            caffeine_on = False
            caf_pid_p = os.path.join(STATE_DIR, "caffeine.pid")
            if os.path.isfile(caf_pid_p):
                try:
                    cpid = int(open(caf_pid_p, "r", encoding="utf-8").read().strip())
                    if cpid > 1 and os.path.isdir(f"/proc/{cpid}"):
                        caffeine_on = True
                except Exception:
