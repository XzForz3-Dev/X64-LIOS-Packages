        @pyqtSlot(bool)
        def requestAsyncRefresh(self, force_slow=False):
            if self._refresh_worker is not None and self._refresh_worker.isRunning():
                self._refresh_pending = True
                if force_slow:
                    self._refresh_pending_slow = True
                return
            w = _SettingsRefreshWorker(self, force_slow=bool(force_slow))
            def _on_done(payload):
                self.liveStateReady.emit(payload)
                if self._refresh_pending:
                    fs = self._refresh_pending_slow
                    self._refresh_pending = False
                    self._refresh_pending_slow = False
                    self.requestAsyncRefresh(fs)
            w.done.connect(_on_done)
            self._refresh_worker = w
            w.start()

