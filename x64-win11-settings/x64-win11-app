#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
x64-win11-app: Native Windows 11 26H2 Applications for X64 LIOS
Modes:
  - explorer [initial_section]  (Win + E — Windows 11 26H2 Tabbed File Explorer)
  - settings [initial_page]     (Win + I — Windows 11 26H2 6-Page Settings App)
  - taskmgr                     (Ctrl + Shift + Esc — Windows 11 26H2 Live Task Manager)
Synchronizes live desktop preferences via ~/.local/state/x64-win11/config.json.
"""

import sys
import os
import json
import shutil
import subprocess
from datetime import datetime
from PyQt6.QtCore import QObject, pyqtSlot, pyqtSignal, QUrl
from PyQt6.QtGui import QGuiApplication, QColor, QIcon
from PyQt6.QtQuick import QQuickView

HOME_DIR = os.path.expanduser("~")
STATE_DIR = os.path.join(HOME_DIR, ".local", "state", "x64-win11")
CONFIG_FILE = os.path.join(STATE_DIR, "config.json")
ASSET_DIR = "/usr/share/x64-win11/assets/icons/"
WP_DIR = "/usr/share/x64-win11/assets/wallpapers/"
if not os.path.isdir(ASSET_DIR):
    ASSET_DIR = "/home/qqqq/Proyectos/X64-LIOS-Packages/x64-win11-settings/assets/icons/"
    WP_DIR = "/home/qqqq/Proyectos/X64-LIOS-Packages/x64-win11-settings/assets/wallpapers/"

DEFAULT_CFG = {
    "taskbarCompact": False,
    "taskbarLeftAlign": False,
    "showRecommended": False,
    "showPhoneLink": True,
    "showBatteryPct": True,
    "wallpaperMode": 0
}

def load_cfg():
    os.makedirs(STATE_DIR, exist_ok=True)
    if os.path.isfile(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, "r", encoding="utf-8") as f:
                data = json.load(f)
                out = dict(DEFAULT_CFG)
                out.update(data)
                return out
        except Exception:
            pass
    return dict(DEFAULT_CFG)

def save_cfg(cfg):
    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = CONFIG_FILE + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(cfg, f)
    os.replace(tmp, CONFIG_FILE)

def resolve_special_folder(name):
    mapping = {
        "Escritorio": ["Escritorio", "Desktop"],
        "Descargas": ["Descargas", "Downloads"],
        "Documentos": ["Documentos", "Documents"],
        "Imágenes": ["Imágenes", "Imagenes", "Pictures"],
        "Música": ["Música", "Musica", "Music"],
        "Vídeos": ["Vídeos", "Videos"],
        "Proyectos": ["Proyectos", "Projects"],
        "Cristian": [""],
        "Inicio": [""],
        "X64 LIOS (C:)": ["/"],
        "X64 LIOS NVMe (C:)": ["/"],
    }
    if name in mapping:
        for cand in mapping[name]:
            if cand == "/":
                return "/"
            if cand == "":
                return HOME_DIR
            p = os.path.join(HOME_DIR, cand)
            if os.path.isdir(p):
                return p
        return os.path.join(HOME_DIR, mapping[name][0])
    if os.path.isdir(name):
        return name
    return HOME_DIR


class AppBridge(QObject):
    def __init__(self, view):
        super().__init__()
        self.view = view
        self._prev_cpu_total = 0
        self._prev_cpu_idle = 0

    @pyqtSlot(result=str)
    def getConfigJson(self):
        return json.dumps(load_cfg())

    @pyqtSlot(str, str)
    def setConfigValue(self, key, val_json):
        cfg = load_cfg()
        try:
            cfg[key] = json.loads(val_json)
        except Exception:
            cfg[key] = val_json
        save_cfg(cfg)

    @pyqtSlot(str)
    def launchRealApp(self, cmd):
        try:
            subprocess.Popen(cmd, shell=True, start_new_session=True)
        except Exception:
            pass

    @pyqtSlot(str)
    def openFileOrUrl(self, path):
        try:
            subprocess.Popen(["xdg-open", path], start_new_session=True)
        except Exception:
            pass

    @pyqtSlot()
    def closeWindow(self):
        QGuiApplication.quit()

    @pyqtSlot(str, str, result=bool)
    def createNewItem(self, folder_key, item_type):
        base = resolve_special_folder(folder_key)
        if not os.path.isdir(base) or not os.access(base, os.W_OK):
            base = HOME_DIR
        try:
            if item_type == "folder":
                name = "Nueva carpeta"
                target = os.path.join(base, name)
                idx = 2
                while os.path.exists(target):
                    target = os.path.join(base, f"{name} ({idx})")
                    idx += 1
                os.makedirs(target, exist_ok=True)
            else:
                name = "Nuevo documento de texto"
                target = os.path.join(base, f"{name}.txt")
                idx = 2
                while os.path.exists(target):
                    target = os.path.join(base, f"{name} ({idx}).txt")
                    idx += 1
                with open(target, "w", encoding="utf-8") as f:
                    f.write("")
            return True
        except Exception:
            return False

    @pyqtSlot(result=str)
    def getDrivesJson(self):
        drives = []
        try:
            usage = shutil.disk_usage("/")
            total_gb = usage.total / (1024 ** 3)
            free_gb = usage.free / (1024 ** 3)
            used_ratio = max(0.04, min(1.0, (usage.total - usage.free) / max(1, usage.total)))
            drives.append({
                "name": "X64 LIOS NVMe (C:)",
                "path": "/",
                "icon": "drive-c.svg",
                "usedRatio": round(used_ratio, 3),
                "isCritical": used_ratio >= 0.90,
                "info": f"{free_gb:.1f} GB disponibles de {total_gb:.1f} GB"
            })
        except Exception:
            pass

        proj_dir = os.path.join(HOME_DIR, "Proyectos")
        if os.path.isdir(proj_dir):
            try:
                usage = shutil.disk_usage(proj_dir)
                free_gb = usage.free / (1024 ** 3)
                used_ratio = max(0.04, min(1.0, (usage.total - usage.free) / max(1, usage.total)))
                drives.append({
                    "name": "Proyectos X64 Studios (D:)",
                    "path": proj_dir,
                    "icon": "drive.svg",
                    "usedRatio": round(used_ratio, 3),
                    "isCritical": used_ratio >= 0.90,
                    "info": f"Volumen Btrfs ZSTD • {free_gb:.1f} GB libres"
                })
            except Exception:
                pass
        return json.dumps(drives)

    @pyqtSlot(str, str, result=str)
    def listDirectoryJson(self, section_or_path, sort_by="name"):
        if section_or_path in ("Este equipo", "This PC"):
            return json.dumps({"mode": "thispc", "path": "Este equipo", "items": [], "count": 8})

        real_path = resolve_special_folder(section_or_path)
        items = []
        try:
            entries = list(os.scandir(real_path))
        except Exception:
            entries = []

        for e in entries:
            if e.name.startswith("."):
                continue
            try:
                st = e.stat(follow_symlinks=True)
                is_dir = e.is_dir(follow_symlinks=True)
                mtime = datetime.fromtimestamp(st.st_mtime).strftime("%d/%m/%Y %H:%M")
                if is_dir:
                    low = e.name.lower()
                    if "descarg" in low or "download" in low:
                        icon = "folder-download.svg"
                    elif "doc" in low:
                        icon = "folder-documents.svg"
                    elif "imág" in low or "imag" in low or "pict" in low or "foto" in low:
                        icon = "folder-images.svg"
                    elif "músic" in low or "music" in low:
                        icon = "folder-music.svg"
                    elif "vídeo" in low or "video" in low:
                        icon = "folder-videos.svg"
                    elif "escritorio" in low or "desktop" in low:
                        icon = "folder-desktop.svg"
                    elif "juego" in low or "game" in low or "steam" in low:
                        icon = "folder-games.svg"
                    else:
                        icon = "folder.svg"
                    size_str = "Carpeta de archivos"
                    size_bytes = -1
                else:
                    ext = os.path.splitext(e.name)[1].lower()
                    if ext in (".png", ".jpg", ".jpeg", ".webp", ".svg", ".gif"):
                        icon = "folder-images.svg"
                        size_str = "Imagen"
                    elif ext in (".mp4", ".mkv", ".webm", ".avi"):
                        icon = "folder-videos.svg"
                        size_str = "Vídeo"
                    elif ext in (".mp3", ".flac", ".ogg", ".wav"):
                        icon = "folder-music.svg"
                        size_str = "Audio"
                    elif ext in (".sh", ".py", ".qml", ".js", ".ts", ".rs", ".c", ".cpp", ".md"):
                        icon = "terminal.svg"
                        size_str = f"Código ({ext})"
                    else:
                        icon = "folder-documents.svg"
                        size_str = "Archivo"
                    sb = st.st_size
                    size_bytes = sb
                    if sb < 1024:
                        size_val = f"{sb} B"
                    elif sb < 1024 ** 2:
                        size_val = f"{sb / 1024:.1f} KB"
                    elif sb < 1024 ** 3:
                        size_val = f"{sb / (1024 ** 2):.1f} MB"
                    else:
                        size_val = f"{sb / (1024 ** 3):.2f} GB"
                    size_str = f"{size_val} • {size_str}"

                items.append({
                    "name": e.name,
                    "path": e.path,
                    "isDir": is_dir,
                    "icon": icon,
                    "sub": size_str,
                    "mtime": mtime,
                    "mtimeTs": st.st_mtime,
                    "sizeBytes": size_bytes
                })
            except Exception:
                continue

        items.sort(key=lambda x: (not x["isDir"], x["name"].lower()))
        return json.dumps({
            "mode": "dir",
            "path": real_path,
            "items": items[:150],
            "count": len(items)
        })

    @pyqtSlot(str, result=str)
    def getParentDir(self, current_path):
        if current_path in ("Este equipo", "/", ""):
            return "Este equipo"
        real = resolve_special_folder(current_path)
        if real == "/" or real == HOME_DIR:
            return "Este equipo"
        return os.path.dirname(real)

    @pyqtSlot(result=str)
    def getSystemTelemetryJson(self):
        cpu_model = "AMD Ryzen / Intel Core"
        try:
            with open("/proc/cpuinfo", "r", encoding="utf-8") as f:
                for line in f:
                    if "model name" in line:
                        cpu_model = line.split(":", 1)[1].strip()
                        break
        except Exception:
            pass

        mem_total_gb = 64.0
        mem_used_gb = 11.0
        mem_pct = 17
        try:
            mem = {}
            with open("/proc/meminfo", "r", encoding="utf-8") as f:
                for line in f:
                    parts = line.split(":")
                    if len(parts) == 2:
                        mem[parts[0].strip()] = int(parts[1].strip().split()[0])
            mem_total_gb = mem.get("MemTotal", 65536000) / (1024 ** 2)
            mem_avail_gb = mem.get("MemAvailable", 54000000) / (1024 ** 2)
            mem_used_gb = mem_total_gb - mem_avail_gb
            mem_pct = int(round((mem_used_gb / max(1.0, mem_total_gb)) * 100))
        except Exception:
            pass

        cpu_pct = 6
        try:
            with open("/proc/stat", "r", encoding="utf-8") as f:
                fields = [int(x) for x in f.readline().split()[1:8]]
            idle = fields[3] + fields[4]
            total = sum(fields)
            if self._prev_cpu_total > 0 and total > self._prev_cpu_total:
                cpu_pct = int(round((1.0 - (idle - self._prev_cpu_idle) / (total - self._prev_cpu_total)) * 100))
            self._prev_cpu_total = total
            self._prev_cpu_idle = idle
        except Exception:
            pass

        kernel = os.uname().release
        sched = "BORE (Nativo)"
        try:
            if os.path.exists("/sys/kernel/sched_ext/state"):
                with open("/sys/kernel/sched_ext/state") as f:
                    if f.read().strip() == "enabled":
                        with open("/sys/kernel/sched_ext/root/ops") as f2:
                            sched = "scx_" + f2.read().strip().split("_")[0]
        except Exception:
            pass

        procs = []
        try:
            out = subprocess.check_output(
                ["ps", "-eo", "pid,comm,%cpu,rss", "--sort=-%cpu"],
                text=True, timeout=1.5
            ).splitlines()[1:16]
            for line in out:
                parts = line.split()
                if len(parts) >= 4:
                    pid, comm, pcpu, rss_kb = parts[0], parts[1], parts[2], int(parts[3])
                    procs.append({
                        "pid": pid,
                        "name": comm,
                        "cpu": f"{float(pcpu):.1f}%",
                        "mem": f"{rss_kb / 1024:.1f} MB"
                    })
        except Exception:
            pass

        return json.dumps({
            "user": "Cristian",
            "hostname": os.uname().nodename,
            "cpu": cpu_model,
            "cpuPct": max(1, min(100, cpu_pct)),
            "ram": f"{mem_used_gb:.1f} / {mem_total_gb:.1f} GB ({mem_pct}%)",
            "ramPct": mem_pct,
            "kernel": kernel,
            "sched": sched,
            "procs": procs
        })


def main():
    mode = sys.argv[1] if len(sys.argv) > 1 else "explorer"
    arg2 = sys.argv[2] if len(sys.argv) > 2 else ""

    app = QGuiApplication(sys.argv)
    if mode == "settings":
        app.setApplicationName("x64-win11-settings-app")
        app.setDesktopFileName("x64-win11-settings-app")
        title = "Configuración — Windows 11 26H2"
        qml_file = "Win11SettingsWindow.qml"
        w, h = 960, 650
    elif mode == "taskmgr":
        app.setApplicationName("x64-win11-taskmgr")
        app.setDesktopFileName("x64-win11-taskmgr")
        title = "Administrador de tareas — Windows 11 26H2"
        qml_file = "Win11TaskMgrWindow.qml"
        w, h = 780, 560
    else:
        app.setApplicationName("x64-win11-explorer")
        app.setDesktopFileName("x64-win11-explorer")
        title = "Explorador de archivos — Windows 11 26H2"
        qml_file = "Win11ExplorerWindow.qml"
        w, h = 1080, 680

    qml_dir = "/usr/share/x64-win11/shell"
    if not os.path.isdir(qml_dir):
        qml_dir = "/home/qqqq/Proyectos/X64-LIOS-Packages/x64-win11-settings/shell"

    view = QQuickView()
    view.setColor(QColor("#191919"))
    view.setTitle(title)
    view.setResizeMode(QQuickView.ResizeMode.SizeRootObjectToView)
    view.resize(w, h)

    bridge = AppBridge(view)
    view.rootContext().setContextProperty("bridge", bridge)
    view.rootContext().setContextProperty("initialArg", arg2)
    view.rootContext().setContextProperty("assetDirUrl", f"file://{ASSET_DIR}")
    view.rootContext().setContextProperty("wpDirUrl", f"file://{WP_DIR}")
    view.setSource(QUrl.fromLocalFile(os.path.join(qml_dir, qml_file)))
    view.show()

    sys.exit(app.exec())

if __name__ == "__main__":
    main()
