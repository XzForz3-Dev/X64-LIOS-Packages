def _get_tz_offset_mins(tz_id=""):
    try:
        from zoneinfo import ZoneInfo
        tid = (tz_id or "").strip()
        if not tid or tid == "Local":
            if os.path.islink("/etc/localtime"):
                rp = os.path.realpath("/etc/localtime")
                if "/zoneinfo/" in rp:
                    tid = rp.split("/zoneinfo/", 1)[1]
        if tid:
            now_z = datetime.now(ZoneInfo(tid))
            off = now_z.utcoffset()
            if off is not None:
                return int(round(off.total_seconds() / 60.0))
    except Exception:
        pass
    try:
        return int(round(datetime.now().astimezone().utcoffset().total_seconds() / 60.0))
    except Exception:
        return 0


def _build_timelang_info(cfg=None):
    if cfg is None:
        cfg = load_cfg()
    tz_full = "Local"
    tz_id = "UTC"
    ntp_on = True
    synced = True
    local_rtc = False
    try:
        tout = subprocess.check_output(
            ["timedatectl", "status"], text=True, timeout=1.2,
            stderr=subprocess.DEVNULL, env=dict(os.environ, LC_ALL="C")
        )
        for ln in tout.splitlines():
            if "Time zone:" in ln:
                tz_full = ln.split(":", 1)[1].strip()
                tz_id = tz_full.split()[0].strip() if tz_full else "UTC"
            elif "NTP service:" in ln:
                ntp_on = ("active" in ln.lower() and "inactive" not in ln.lower())
            elif "synchronized:" in ln:
                synced = ("yes" in ln.lower())
            elif "RTC in local TZ:" in ln:
                local_rtc = ("yes" in ln.lower())
    except Exception:
        pass

    locale_str = os.environ.get("LANG", "es_ES.UTF-8")
    try:
        if os.path.isfile("/etc/locale.conf"):
            for ln in open("/etc/locale.conf", "r", encoding="utf-8", errors="ignore"):
                s = ln.strip()
                if s.startswith("LANG="):
                    val = s.split("=", 1)[1].strip().strip("\"'")
                    if val:
                        locale_str = val
                        break
    except Exception:
        pass

    installed_locales = []
    try:
        lout = subprocess.check_output(["locale", "-a"], text=True, timeout=1.0, stderr=subprocess.DEVNULL)
        for ln in lout.splitlines():
            s = ln.strip()
            if s.lower().endswith(".utf8") or s.lower().endswith(".utf-8"):
                norm = re.sub(r"\.utf8$", ".UTF-8", s, flags=re.I)
                if norm not in installed_locales:
                    installed_locales.append(norm)
    except Exception:
        pass

    kb_primary = "es"
    kb_secondary = "us"
    kb_toggle_opt = "grp:alt_shift_toggle"
    try:
        env_p = os.path.join(HOME_DIR, ".config", "labwc", "environment")
        if os.path.isfile(env_p):
            for ln in open(env_p, "r", encoding="utf-8", errors="ignore"):
                s = ln.strip()
                if s.startswith("XKB_DEFAULT_LAYOUT="):
                    parts = [p.strip().split("(")[0].lower() for p in s.split("=", 1)[1].split(",") if p.strip()]
                    if parts:
                        kb_primary = parts[0]
                        kb_secondary = parts[1] if len(parts) > 1 else "none"
                elif s.startswith("XKB_DEFAULT_OPTIONS="):
                    opt_v = s.split("=", 1)[1].strip()
                    if "ctrl_shift_toggle" in opt_v:
                        kb_toggle_opt = "grp:ctrl_shift_toggle"
                    elif "alt_shift_toggle" in opt_v:
                        kb_toggle_opt = "grp:alt_shift_toggle"
                    elif not opt_v:
                        kb_toggle_opt = "none"
    except Exception:
        pass

    tag_map = {"es": "ES", "latam": "LATAM", "us": "US", "br": "BR", "fr": "FR", "de": "DE"}
    cur_kb = tag_map.get(kb_primary, kb_primary.upper() or "ES")

    repeat_rate = 25
    repeat_delay = 600
    numlock_on = False
    try:
        rc_p = os.path.join(HOME_DIR, ".config", "labwc", "rc.xml")
        if os.path.isfile(rc_p):
            rc_t = open(rc_p, "r", encoding="utf-8", errors="ignore").read()
            m_rr = re.search(r"<repeatRate>(\d+)</repeatRate>", rc_t)
            if m_rr:
                repeat_rate = max(10, min(80, int(m_rr.group(1))))
            m_rd = re.search(r"<repeatDelay>(\d+)</repeatDelay>", rc_t)
            if m_rd:
                repeat_delay = max(150, min(1200, int(m_rd.group(1))))
            m_nl = re.search(r"<numlock>\s*(on|off)\s*</numlock>", rc_t, re.I)
            if m_nl:
                numlock_on = (m_nl.group(1).lower() == "on")
    except Exception:
        pass

    return {
        "timezone": tz_full,
        "timezoneId": tz_id,
        "tzOffsetMins": _get_tz_offset_mins(tz_id),
        "ntpActive": ntp_on,
        "synced": synced,
        "localRtc": local_rtc,
        "locale": locale_str,
        "installedLocales": installed_locales,
        "kbLayout": cur_kb,
        "kbPrimary": kb_primary,
        "kbSecondary": kb_secondary,
        "kbToggleOpt": kb_toggle_opt,
        "repeatRate": repeat_rate,
        "repeatDelay": repeat_delay,
        "numlock": numlock_on,
    }


