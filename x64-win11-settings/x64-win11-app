        @pyqtSlot(result=str)
        def getSettingsExtendedJson(self):
            import grp
            display_name, uname, hostname = get_real_user_info()
            cfg = load_cfg()
            # 1. Monitors via wlr-randr --json (exact current mode + Hz precision)
            monitors_list = []
            try:
                wraw = subprocess.check_output(["wlr-randr", "--json"], text=True, timeout=1.5, stderr=subprocess.DEVNULL)
                wdata = json.loads(wraw)
                for mon in (wdata if isinstance(wdata, list) else []):
                    mname = str(mon.get("name", "")).strip()
                    if not mname:
                        continue
                    desc = str(mon.get("description") or mname).strip()
                    enabled = bool(mon.get("enabled", True))
                    sc_val = mon.get("scale", 1.0)
                    try:
                        scale_s = f"{float(sc_val):.2f}".rstrip("0").rstrip(".") or "1"
                    except Exception:
                        scale_s = "1"
                    pos = mon.get("position") or {}
                    pos_s = f"{pos.get('x', 0)},{pos.get('y', 0)}" if isinstance(pos, dict) else "0,0"
                    cur_mode_lbl = ""
                    modes_by_lbl = {}
                    modes_order = []
                    for m in (mon.get("modes") or []):
                        w = int(m.get("width", 0))
                        h = int(m.get("height", 0))
                        if w <= 0 or h <= 0:
                            continue
                        ref = float(m.get("refresh", 60.0))
                        is_cur = bool(m.get("current", False))
                        lbl = f"{w}x{h} ({round(ref)} Hz)"
                        arg = f"{w}x{h}@{ref:.6f}Hz"
                        if is_cur:
                            cur_mode_lbl = lbl
                        if lbl not in modes_by_lbl:
                            modes_by_lbl[lbl] = {"label": lbl, "arg": arg, "current": is_cur}
                            modes_order.append(lbl)
                        elif is_cur:
                            modes_by_lbl[lbl] = {"label": lbl, "arg": arg, "current": True}
                    final_modes = [modes_by_lbl[k] for k in modes_order[:8]]
                    if cur_mode_lbl and not any(x["current"] for x in final_modes) and cur_mode_lbl in modes_by_lbl:
                        final_modes = [modes_by_lbl[cur_mode_lbl]] + final_modes[:7]
                    monitors_list.append({
                        "name": mname,
                        "desc": desc,
                        "enabled": enabled,
                        "currentMode": cur_mode_lbl,
                        "modes": final_modes,
                        "scale": scale_s,
                        "position": pos_s,
                    })
            except Exception:
                pass

            # 2. Audio Sinks & Sources via wpctl status
            sinks = []
            sources = []
            mic_vol = 50
            mic_muted = False
            try:
                sout = subprocess.check_output(["wpctl", "status"], text=True, timeout=1.2, stderr=subprocess.DEVNULL)
                sec = ""
                in_audio = False
                for ln in sout.splitlines():
                    if ln.startswith("Audio"):
                        in_audio = True
                        continue
                    if in_audio and ln and not ln[0].isspace() and not ln.startswith("├") and not ln.startswith("└") and not ln.startswith("│"):
                        in_audio = False
                    if not in_audio:
                        continue
                    if "Sinks:" in ln:
                        sec = "sinks"
                        continue
                    elif "Sources:" in ln:
                        sec = "sources"
                        continue
                    elif "Devices:" in ln or "Filters:" in ln or "Streams:" in ln:
                        sec = ""
                        continue
                    if sec in ("sinks", "sources") and "." in ln:
                        is_act = "*" in ln.split(".", 1)[0]
                        cleaned = ln.replace("│", "").replace("├", "").replace("└", "").replace("─", "").replace("*", "").strip()
                        if "." in cleaned:
                            did, rest = cleaned.split(".", 1)
                            did = did.strip()
                            if did.isdigit():
                                name_only = rest.split("[vol:", 1)[0].strip()
                                item = {"id": did, "name": name_only, "active": is_act}
                                if sec == "sinks":
                                    sinks.append(item)
                                else:
                                    sources.append(item)
                mout = subprocess.check_output(["wpctl", "get-volume", "@DEFAULT_AUDIO_SOURCE@"], text=True, timeout=1.0, stderr=subprocess.DEVNULL).strip()
                mic_muted = "MUTED" in mout
                for tok in mout.split():
                    try:
                        mic_vol = int(round(float(tok) * 100))
                        break
                    except ValueError:
                        continue
            except Exception:
                pass

            # 3. Bluetooth Paired Devices
            bt_devices = []
            try:
                bout = subprocess.check_output(["bluetoothctl", "devices"], text=True, timeout=1.2, stderr=subprocess.DEVNULL)
                for ln in bout.splitlines()[:10]:
                    toks = ln.split(" ", 2)
                    if len(toks) == 3 and toks[0] == "Device":
                        mac, bname = toks[1], toks[2].strip()
                        conn = False
                        try:
                            iout = subprocess.check_output(["bluetoothctl", "info", mac], text=True, timeout=0.8, stderr=subprocess.DEVNULL)
                            conn = "Connected: yes" in iout
                        except Exception:
                            pass
                        bt_devices.append({"mac": mac, "name": bname, "connected": conn})
            except Exception:
                pass

            # 4. Network Extra Info
            net_gw = "—"
            net_dns = "—"
            net_iface = "—"
            try:
                rout = subprocess.check_output(["ip", "route", "show", "default"], text=True, timeout=0.8, stderr=subprocess.DEVNULL).splitlines()
                if rout:
                    rt = rout[0].split()
                    if "via" in rt:
                        net_gw = rt[rt.index("via") + 1]
                    if "dev" in rt:
                        net_iface = rt[rt.index("dev") + 1]
                if os.path.isfile("/etc/resolv.conf"):
                    dns_l = [l.split()[1] for l in open("/etc/resolv.conf") if l.strip().startswith("nameserver")]
                    if dns_l:
                        net_dns = ", ".join(dns_l[:2])
            except Exception:
                pass

            # 5. Account Info
            groups = []
            try:
                groups = [g.gr_name for g in grp.getgrall() if uname in g.gr_mem]
            except Exception:
                pass
            try:
                user_shell = pwd.getpwuid(os.getuid()).pw_shell
            except Exception:
                user_shell = "/usr/bin/fish"

            # 6. Time & Language
            tz_str = "Local"
            ntp_on = True
            synced = True
            try:
                tout = subprocess.check_output(["timedatectl", "status"], text=True, timeout=1.0, stderr=subprocess.DEVNULL)
                for ln in tout.splitlines():
                    if "Time zone:" in ln:
                        tz_str = ln.split(":", 1)[1].strip()
                    elif "NTP service:" in ln:
                        ntp_on = ("active" in ln.lower() and "inactive" not in ln.lower())
                    elif "synchronized:" in ln:
                        synced = ("yes" in ln.lower())
            except Exception:
                pass
            locale_str = os.environ.get("LANG", "es_ES.UTF-8")

            # 7. Default Apps via xdg-mime + Real Installed Candidates per Role!
            friendly_map = {
                "chromium.desktop": "Chromium",
                "firefox.desktop": "Firefox",
                "brave-browser.desktop": "Brave",
                "org.gnome.TextEditor.desktop": "Editor de texto",
                "antigravity-ide.desktop": "Antigravity IDE",
                "org.gnome.Loupe.desktop": "Visor de imágenes (Loupe)",
                "org.gnome.Papers.desktop": "Documentos PDF (Papers)",
                "org.gnome.FileRoller.desktop": "Gestor de archivadores",
                "mpv.desktop": "Reproductor multimedia mpv",
                "vlc.desktop": "VLC Media Player",
                "x64-win11-explorer.desktop": "Explorador de archivos",
                "org.gnome.Nautilus.desktop": "Nautilus",
                "thunar.desktop": "Thunar",
                "org.kde.dolphin.desktop": "Dolphin",
            }
            def qmime_raw(m):
                try:
                    return subprocess.check_output(["xdg-mime", "query", "default", m], text=True, timeout=0.8, stderr=subprocess.DEVNULL).strip()
                except Exception:
                    return ""
            def scan_role_candidates(mime_key, cur_df):
                cands = []
                seen_df = set()
                for df in sorted(os.listdir("/usr/share/applications")) if os.path.isdir("/usr/share/applications") else []:
                    if not df.endswith(".desktop"):
                        continue
                    fp = os.path.join("/usr/share/applications", df)
                    try:
                        txt = open(fp, "r", encoding="utf-8", errors="ignore").read()
                        if "NoDisplay=true" in txt or "Terminal=true" in txt:
                            continue
                        if mime_key in txt or df == cur_df:
                            nm = friendly_map.get(df, "")
                            if not nm:
                                for ln in txt.splitlines():
                                    if ln.startswith("Name[es]="):
                                        nm = ln.split("=", 1)[1].strip(); break
                                    elif ln.startswith("Name=") and not nm:
                                        nm = ln.split("=", 1)[1].strip()
                            if df not in seen_df:
                                seen_df.add(df)
                                cands.append({"desktop": df, "label": nm or df[:-8], "active": df == cur_df})
                    except Exception:
                        continue
                return cands[:8]

            role_defs = [
                ("web",     "Navegador web",          "x-scheme-handler/https", "chromium.png"),
                ("text",    "Editor de texto (.txt)", "text/plain",             "fluent-document.svg"),
                ("image",   "Visor de fotos",         "image/png",              "folder-images.svg"),
                ("pdf",     "Documentos PDF",         "application/pdf",        "folder-documents.svg"),
                ("video",   "Reproductor de vídeo",   "video/mp4",              "folder-videos.svg"),
                ("archive", "Archivos comprimidos",   "application/zip",        "fluent-folder-zip.svg"),
                ("files",   "Explorador de archivos", "inode/directory",        "explorer.svg"),
            ]
            defaults_list = []
            for rid, rtitle, rmime, ricon in role_defs:
                cur_d = qmime_raw(rmime)
                cands = scan_role_candidates(rmime, cur_d)
                defaults_list.append({
                    "id": rid,
                    "role": rtitle,
                    "desktop": cur_d,
                    "app": friendly_map.get(cur_d, cur_d.replace(".desktop", "") or "Predeterminada"),
                    "icon": ricon,
                    "candidates": cands
                })

            # Detect active keyboard layout from ~/.config/labwc/environment
            cur_kb = str(cfg.get("kbLayout", "") or "").upper()
            if not cur_kb:
                try:
                    env_p = os.path.join(HOME_DIR, ".config", "labwc", "environment")
                    if os.path.isfile(env_p):
                        for ln in open(env_p, "r", encoding="utf-8", errors="ignore"):
                            if ln.startswith("XKB_DEFAULT_LAYOUT="):
                                first_l = ln.split("=", 1)[1].strip().split(",")[0].split("(")[0].upper()
                                if first_l:
                                    cur_kb = first_l
                                break
                except Exception:
                    pass
            if not cur_kb:
                cur_kb = "ES"

            # 8. Gaming Stack Telemetry + Tool Availability Flags (zero dead buttons!)
            def svc_active(svc, user=False):
                try:
                    cmd = ["systemctl"] + (["--user"] if user else []) + ["is-active", "--quiet", svc]
                    return subprocess.run(cmd, timeout=0.6).returncode == 0
                except Exception:
                    return False

            gaming_stack = {
                "falcond": svc_active("falcond.service"),
                "dmemcg": svc_active("dmemcg-booster-system.service"),
                "ananicy": svc_active("ananicy-cpp.service"),
                "ntsync": os.path.exists("/dev/ntsync") or os.environ.get("PROTON_USE_NTSYNC") == "1",
                "hasSteam": shutil.which("steam") is not None,
                "hasHeroic": shutil.which("heroic") is not None,
                "hasLutris": shutil.which("lutris") is not None,
            }
            tool_flags = {
                "hasKdeConnect": (shutil.which("kdeconnect-app") is not None) or (shutil.which("kdeconnect-settings") is not None),
                "hasBlueman": shutil.which("blueman-manager") is not None,
                "hasPrinterGui": shutil.which("system-config-printer") is not None,
                "hasNmEditor": shutil.which("nm-connection-editor") is not None,
                "hasGnomeDisks": shutil.which("gnome-disks") is not None,
            }

            # 9. Recent System Updates from /var/log/pacman.log & installed pkg count
            recent_upg = []
            try:
                if os.path.isfile("/var/log/pacman.log"):
                    lines = open("/var/log/pacman.log", "r", encoding="utf-8", errors="ignore").readlines()[-400:]
                    for ln in reversed(lines):
                        if "[ALPM] upgraded " in ln:
                            dt = ln[1:17].replace("T", " ")
                            body = ln.split("[ALPM] upgraded ", 1)[1].strip()
                            recent_upg.append({"date": dt, "entry": body})
                            if len(recent_upg) >= 10:
                                break
            except Exception:
                pass
            try:
                pkg_count = len(os.listdir("/var/lib/pacman/local")) - 1
            except Exception:
                pkg_count = 0

            return json.dumps({
                "monitors": monitors_list,
                "sinks": sinks,
                "sources": sources,
                "micVol": mic_vol,
                "micMuted": mic_muted,
                "btDevices": bt_devices,
                "netGateway": net_gw,
                "netDns": net_dns,
                "netIface": net_iface,
                "account": {
                    "displayName": display_name,
                    "username": uname,
                    "hostname": hostname,
                    "homeDir": HOME_DIR,
                    "shell": user_shell,
                    "groups": ", ".join(groups[:8]) if groups else "usuario",
                    "isAdmin": "wheel" in groups,
                    "avatarUrl": str(cfg.get("userAvatarUrl", "") or "")
                },
                "timeLang": {
                    "timezone": tz_str,
                    "ntpActive": ntp_on,
                    "synced": synced,
                    "locale": locale_str,
                    "kbLayout": cur_kb
                },
                "defaultApps": defaults_list,
                "gamingStack": gaming_stack,
                "tools": tool_flags,
                "recentUpgrades": recent_upg,
                "pkgCount": max(0, pkg_count)
            })

