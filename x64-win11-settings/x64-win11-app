                lst = os.lstat(target_path)
                st = os.stat(target_path)
                is_dir = os.path.isdir(target_path)
                is_link = os.path.islink(target_path)
                total_bytes = st.st_size if not is_dir else 0
                file_cnt = 0
                dir_cnt = 0
                if is_dir:
                    walked = 0
                    for rdir, dirs, files in os.walk(target_path):
                        dir_cnt += len(dirs)
                        file_cnt += len(files)
                        for fn in files:
                            walked += 1
                            if walked > 4000:
                                break
                            try:
                                total_bytes += os.path.getsize(os.path.join(rdir, fn))
                            except Exception:
                                pass
                        if walked > 4000:
                            break
                if total_bytes < 1024:
                    sz_str = f"{total_bytes} B"
                elif total_bytes < 1024 ** 2:
                    sz_str = f"{total_bytes / 1024:.1f} KB"
                elif total_bytes < 1024 ** 3:
                    sz_str = f"{total_bytes / (1024 ** 2):.2f} MB"
                else:
                    sz_str = f"{total_bytes / (1024 ** 3):.2f} GB"
                try:
                    owner = pwd.getpwuid(st.st_uid).pw_name
                except Exception:
                    owner = str(st.st_uid)
                import stat as statmod
                perms = statmod.filemode(st.st_mode)
                is_exec = bool(st.st_mode & 0o111) and not is_dir
                mtime_s = datetime.fromtimestamp(st.st_mtime).strftime("%d/%m/%Y %H:%M:%S")
                atime_s = datetime.fromtimestamp(st.st_atime).strftime("%d/%m/%Y %H:%M:%S")
                mime_s = "Carpeta de archivos" if is_dir else "Archivo"
