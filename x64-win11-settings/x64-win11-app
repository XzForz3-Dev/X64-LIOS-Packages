        @pyqtSlot(str, result=str)
        def setMultiMonitorMode(self, mode_str):
            try:
                wdata = json.loads(subprocess.check_output(["wlr-randr", "--json"], text=True, timeout=1.8, stderr=subprocess.DEVNULL))
                mons = [m for m in (wdata if isinstance(wdata, list) else []) if m.get("name")]
                if len(mons) < 2:
                    return "error:Solo hay una pantalla conectada"
                mode_str = (mode_str or "").strip()
                if mode_str == "extend":
                    cmd = ["wlr-randr"]
                    patches = {}
                    for m in mons:
                        nm = str(m["name"])
                        cmd += ["--output", nm, "--on"]
                        patches[nm] = {"enabled": True}
                    r = subprocess.run(cmd, capture_output=True, text=True, timeout=2.5)
                    if r.returncode != 0:
                        return f"error:{(r.stderr or 'Error al extender').strip()[:80]}"
                    self._save_monitors_patch(patches)
                    self._repack_monitors_contiguous()
                    return "ok"
                elif mode_str.startswith("only:"):
                    target = mode_str.split(":", 1)[1].strip()
                    if not any(str(m["name"]) == target for m in mons):
                        return "error:Pantalla no encontrada"
                    cmd = ["wlr-randr", "--output", target, "--on", "--pos", "0,0"]
                    patches = {target: {"enabled": True, "pos": "0,0"}}
                    for m in mons:
                        nm = str(m["name"])
                        if nm != target:
                            cmd += ["--output", nm, "--off"]
                            patches[nm] = {"enabled": False}
                    r = subprocess.run(cmd, capture_output=True, text=True, timeout=2.5)
                    if r.returncode != 0:
                        return f"error:{(r.stderr or 'Error al cambiar pantalla').strip()[:80]}"
                    self._save_monitors_patch(patches)
                    return "ok"
                return "error:Modo desconocido"
            except Exception as ex:
                return f"error:{str(ex)[:80]}"

