        @pyqtSlot(str, result=bool)
        def saveInputConfigJson(self, json_str):
            """Apply real Mouse & Touchpad libinput settings into ~/.config/labwc/rc.xml + SIGHUP!"""
            try:
                d = json.loads(json_str)
            except Exception:
                return False
            rc_p = os.path.join(HOME_DIR, ".config", "labwc", "rc.xml")
            if not os.path.isfile(rc_p):
                return False
            try:
                m_spd = max(-1.0, min(1.0, float(d.get("mouseSpeed", 0.0))))
                m_acc = "flat" if str(d.get("mouseAccel", "adaptive")) == "flat" else "adaptive"
                m_lh = "yes" if bool(d.get("mouseLeftHanded", False)) else "no"
                m_ns = "yes" if bool(d.get("mouseNaturalScroll", False)) else "no"
                m_sf = max(0.3, min(3.0, float(d.get("mouseScrollFactor", 1.0))))
                m_me = "yes" if bool(d.get("mouseMiddleEmulation", False)) else "no"
                t_tap = "yes" if bool(d.get("tpTap", True)) else "no"
                t_tad = "yes" if bool(d.get("tpTapAndDrag", True)) else "no"
                t_3fd = "yes" if bool(d.get("tpThreeFingerDrag", False)) else "no"
                t_ns = "yes" if bool(d.get("tpNaturalScroll", True)) else "no"
                t_dwt = "yes" if bool(d.get("tpDisableTyping", True)) else "no"
                t_spd = max(-1.0, min(1.0, float(d.get("tpSpeed", 0.0))))
                raw_se = str(d.get("tpSendEvents", "yes"))
                t_se = raw_se if raw_se in ("yes", "no", "disabledOnExternalMouse") else "yes"
                raw_cm = str(d.get("tpClickMethod", "clickfinger"))
                t_cm = raw_cm if raw_cm in ("clickfinger", "buttonAreas") else "clickfinger"

                blk = (
                    "  <libinput>\n"
                    "    <device category=\"non-touch\">\n"
                    f"      <pointerSpeed>{m_spd:.2f}</pointerSpeed>\n"
                    f"      <accelProfile>{m_acc}</accelProfile>\n"
                    f"      <leftHanded>{m_lh}</leftHanded>\n"
                    f"      <naturalScroll>{m_ns}</naturalScroll>\n"
                    f"      <scrollFactor>{m_sf:.2f}</scrollFactor>\n"
                    f"      <middleEmulation>{m_me}</middleEmulation>\n"
                    "    </device>\n"
                    "    <device category=\"touchpad\">\n"
                    f"      <sendEventsMode>{t_se}</sendEventsMode>\n"
                    f"      <tap>{t_tap}</tap>\n"
                    f"      <tapAndDrag>{t_tad}</tapAndDrag>\n"
                    f"      <threeFingerDrag>{t_3fd}</threeFingerDrag>\n"
                    f"      <naturalScroll>{t_ns}</naturalScroll>\n"
                    f"      <disableWhileTyping>{t_dwt}</disableWhileTyping>\n"
                    f"      <clickMethod>{t_cm}</clickMethod>\n"
                    f"      <pointerSpeed>{t_spd:.2f}</pointerSpeed>\n"
                    "    </device>\n"
                    "  </libinput>"
                )
                txt = open(rc_p, "r", encoding="utf-8").read()
                if re.search(r"<libinput\b[^>]*>.*?</libinput>", txt, flags=re.S):
                    new_txt = re.sub(r"[ \t]*<libinput\b[^>]*>.*?</libinput>", blk, txt, count=1, flags=re.S)
                elif "</labwc_config>" in txt:
                    new_txt = txt.replace("</labwc_config>", "\n" + blk + "\n</labwc_config>", 1)
                else:
                    return False
                tmp = rc_p + ".tmp"
                with open(tmp, "w", encoding="utf-8") as f:
                    f.write(new_txt)
                os.replace(tmp, rc_p)
                subprocess.run(["pkill", "-HUP", "-x", "labwc"], timeout=1.0, stderr=subprocess.DEVNULL)
                return True
            except Exception:
                return False

