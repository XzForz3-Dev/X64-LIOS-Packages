        @pyqtSlot(str, str, bool, result=bool)
        def pasteClipboardItem(self, src_path, dest_folder_key, is_cut):
            if not src_path or not os.path.exists(src_path):
                return False
            dest_dir = resolve_special_folder(dest_folder_key)
            if not os.path.isdir(dest_dir) or not os.access(dest_dir, os.W_OK):
                return False
            src_real = os.path.realpath(src_path)
            dest_real = os.path.realpath(dest_dir)
            if src_real == dest_real or dest_real.startswith(src_real + os.sep):
                return False
            base_name = os.path.basename(src_path.rstrip("/"))
            target = os.path.join(dest_dir, base_name)
            if os.path.abspath(src_path) == os.path.abspath(target) and is_cut:
                return True
            idx = 2
            stem, ext = os.path.splitext(base_name)
            while os.path.exists(target):
                suffix = " - copia" if idx == 2 else f" - copia ({idx})"
                target = os.path.join(dest_dir, f"{stem}{suffix}{ext}")
                idx += 1
            try:
                if is_cut:
                    shutil.move(src_path, target)
                elif os.path.isdir(src_path):
                    shutil.copytree(src_path, target)
                else:
                    shutil.copy2(src_path, target)
                dump_sysinfo_file()
                return True
            except Exception:
                return False

        @pyqtSlot(str, str, result=int)
        def moveItemsToDirJson(self, paths_json, dest_folder_key):
            try:
                paths = [p for p in json.loads(paths_json or "[]") if p and os.path.exists(p)]
            except Exception:
                paths = []
            if not paths:
                return 0
            if dest_folder_key in ("Papelera", "Papelera de reciclaje", "Trash") or str(dest_folder_key).endswith("/Trash/files"):
                moved = 0
                for p in paths:
                    if self.trashItem(p):
                        moved += 1
                return moved
            dest_dir = resolve_special_folder(dest_folder_key)
            if not os.path.isdir(dest_dir) or not os.access(dest_dir, os.W_OK):
                return 0
            dest_real = os.path.realpath(dest_dir)
            moved = 0
            for src in paths:
                src_real = os.path.realpath(src)
                if src_real == dest_real or dest_real.startswith(src_real + os.sep):
                    continue
                if os.path.realpath(os.path.dirname(src.rstrip("/"))) == dest_real:
                    continue
                base = os.path.basename(src.rstrip("/"))
                target = os.path.join(dest_dir, base)
                idx = 2
                stem, ext = os.path.splitext(base)
                while os.path.exists(target):
