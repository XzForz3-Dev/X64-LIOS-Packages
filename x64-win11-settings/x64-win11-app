def _sync_kitty_shell(new_shell):
    """Sync ~/.config/kitty/kitty.conf shell directive so Kitty immediately opens the selected interpreter."""
    try:
        kdir = os.path.join(HOME_DIR, ".config", "kitty")
        os.makedirs(kdir, exist_ok=True)
        kconf = os.path.join(kdir, "kitty.conf")
        if not os.path.isfile(kconf) and os.path.isfile("/etc/xdg/kitty/kitty.conf"):
            shutil.copy2("/etc/xdg/kitty/kitty.conf", kconf)
        lines = open(kconf, "r", encoding="utf-8", errors="ignore").read().splitlines() if os.path.isfile(kconf) else []
        out = []
        replaced = False
        for ln in lines:
            if re.match(r"^\s*shell\s+", ln):
                if not replaced:
                    out.append(f"shell {new_shell}")
                    replaced = True
                continue
            out.append(ln)
        if not replaced:
            out.insert(0, f"shell {new_shell}")
        with open(kconf + ".tmp", "w", encoding="utf-8") as f:
            f.write("\n".join(out) + "\n")
        os.replace(kconf + ".tmp", kconf)
    except Exception:
        pass


