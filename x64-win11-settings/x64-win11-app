        @pyqtSlot(result=str)
        def cleanPacmanCache(self):
            def _dir_bytes(path):
                tot = 0
                try:
                    if os.path.isdir(path):
                        for e in os.scandir(path):
                            if e.is_file(follow_symlinks=False):
                                tot += e.stat(follow_symlinks=False).st_size
                except Exception:
                    pass
                return tot
            def _fmt_sz(nb):
                if nb < 1024: return f"{nb} B"
                if nb < 1024**2: return f"{nb / 1024:.1f} KB"
                if nb < 1024**3: return f"{nb / (1024**2):.1f} MB"
                return f"{nb / (1024**3):.2f} GB"
            pac_dir = "/var/cache/pacman/pkg"
            before = _dir_bytes(pac_dir)
            try:
                r = subprocess.run(
                    ["pkexec", "sh", "-c",
                     "if command -v paccache >/dev/null 2>&1; then paccache -rk1 && paccache -ruk0; else pacman -Sc --noconfirm; fi"],
                    capture_output=True, text=True, timeout=120.0
                )
                if r.returncode != 0:
                    return "error:Limpieza cancelada o sin permisos"
                after = _dir_bytes(pac_dir)
                freed = max(0, before - after)
                self._cache_storage_ts = 0.0
                dump_sysinfo_file()
                return f"ok:{_fmt_sz(freed)}"
            except Exception as ex:
                return f"error:{str(ex)[:80]}"

        @pyqtSlot(result=str)
        def cleanUserCache(self):
            cache_dir = os.path.join(HOME_DIR, ".cache")
            if not os.path.isdir(cache_dir):
                return "ok:0 B"
            protected = {
                "dconf", "gvfs", "gvfs-burn", "keyring", "antigravity",
                "quickshell", "fontconfig", "mesa_shader_cache", "mesa_shader_cache_db",
                "nvidia", "x64-win11", "systemd", "dbus-1", "ibus"
            }
            def _path_bytes(p):
                tot = 0
                try:
                    if os.path.isfile(p) or os.path.islink(p):
                        return os.lstat(p).st_size
                    for rdir, _, fls in os.walk(p):
                        for fn in fls:
                            try:
                                tot += os.lstat(os.path.join(rdir, fn)).st_size
                            except Exception:
                                pass
                except Exception:
                    pass
                return tot
            def _fmt_sz(nb):
                if nb < 1024: return f"{nb} B"
                if nb < 1024**2: return f"{nb / 1024:.1f} KB"
                if nb < 1024**3: return f"{nb / (1024**2):.1f} MB"
                return f"{nb / (1024**3):.2f} GB"
            freed = 0
            try:
                for entry in list(os.scandir(cache_dir)):
                    if entry.name in protected or entry.name.startswith("."):
                        continue
                    p = entry.path
                    try:
                        if entry.is_symlink():
                            continue
                        sz = _path_bytes(p)
                        if entry.is_dir(follow_symlinks=False):
                            shutil.rmtree(p, ignore_errors=True)
                            after_sz = _path_bytes(p) if os.path.exists(p) else 0
                            freed += max(0, sz - after_sz)
                        elif entry.is_file(follow_symlinks=False):
                            os.remove(p)
                            freed += sz
                    except Exception:
                        pass
                self._cache_storage_ts = 0.0
                dump_sysinfo_file()
                return f"ok:{_fmt_sz(freed)}"
            except Exception as ex:
                return f"error:{str(ex)[:80]}"

