        def _save_avatar_qimage(self, src_img):
            if src_img.isNull():
                return ""
            os.makedirs(STATE_DIR, exist_ok=True)
            side = min(src_img.width(), src_img.height())
            x0 = (src_img.width() - side) // 2
            y0 = (src_img.height() - side) // 2
            sq = src_img.copy(x0, y0, side, side).scaled(
                256, 256, Qt.AspectRatioMode.IgnoreAspectRatio, Qt.TransformationMode.SmoothTransformation
            )
            # Save square ~/.face & ~/.face.icon for SDDM / system login screens
            for fp in (os.path.join(HOME_DIR, ".face"), os.path.join(HOME_DIR, ".face.icon")):
                try:
                    sq.save(fp, "PNG")
                except Exception:
                    pass
            # Render razor-sharp anti-aliased circular RGBA PNG for Win11 Settings, Start & Lock Screen
            circ = QImage(256, 256, QImage.Format.Format_ARGB32_Premultiplied)
            circ.fill(Qt.GlobalColor.transparent)
            painter = QPainter(circ)
            painter.setRenderHint(QPainter.RenderHint.Antialiasing, True)
            painter.setRenderHint(QPainter.RenderHint.SmoothPixmapTransform, True)
            path = QPainterPath()
            path.addEllipse(QRectF(0, 0, 256, 256))
            painter.setClipPath(path)
            painter.drawImage(0, 0, sq)
            painter.end()
            out_p = os.path.join(STATE_DIR, "avatar.png")
            circ.save(out_p, "PNG")
            url = f"file://{out_p}?v={int(time.time() * 1000)}"
            cfg = load_cfg()
            cfg["userAvatarUrl"] = url
            self._cfg_rev += 1
            save_cfg(cfg)
            dump_sysinfo_file()
            return url

