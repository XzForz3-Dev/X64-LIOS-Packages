pkgname=x64-xfce4-settings
pkgver=1.0.0
pkgrel=8
pkgdesc="Configuracion oficial de X64 LIOS para escritorio Xfce 4.20 (X11 & Wayland), Kitty/Xfce4-Terminal y LightDM Slick Greeter"
arch=('any')
license=('GPL')
install='x64-xfce4-settings.install'
depends=(
    'xfce4-session'
    'labwc'
    'xorg-xwayland'
    'lightdm'
    'lightdm-slick-greeter'
    'papirus-icon-theme'
    'noto-fonts'
    'xfce4-whiskermenu-plugin'
    'xfce4-pulseaudio-plugin'
    'kitty'
)
source=(
    '01-monolith.jpg'
    '07-slick-greeter-dock.jpg'
    '60-slick-greeter.conf'
    'slick-greeter.conf'
    '10-wlroots.conf'
    '20-xkb.conf'
    'x64-logo.png'
    'xsettings.xml'
    'xfce4-terminal.xml'
    'helpers.rc'
    'themerc-override'
    'xfwm4.xml'
    'keyboard-layout.xml'
    'xfce4-panel.xml'
    'xfce4-desktop.xml'
    'rc.xml'
    'gtk.css'
    'environment'
    'screenshot.png'
)
sha256sums=(
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
)

package() {
    # 1. Fondos oficiales X64 LIOS (Monolith para escritorio, Slick dock para greeter)
    install -d "${pkgdir}/usr/share/backgrounds/x64-lios"
    install -m644 "${srcdir}/01-monolith.jpg" "${pkgdir}/usr/share/backgrounds/x64-lios/01-monolith.jpg"
    install -m644 "${srcdir}/07-slick-greeter-dock.jpg" "${pkgdir}/usr/share/backgrounds/x64-lios/07-slick-greeter-dock.jpg"

    # 2. Icono oficial X64 para Menu Whisker (la X oficial de KDE/Cinnamon)
    install -d "${pkgdir}/usr/share/pixmaps"
    install -m644 "${srcdir}/x64-logo.png" "${pkgdir}/usr/share/pixmaps/x64-logo.png"
    install -d "${pkgdir}/usr/share/icons/hicolor/512x512/apps"
    install -m644 "${srcdir}/x64-logo.png" "${pkgdir}/usr/share/icons/hicolor/512x512/apps/x64-logo.png"

    # 3. Drop-in de LightDM para forzar slick-greeter (evita pantalla negra en boot)
    install -d "${pkgdir}/etc/lightdm/lightdm.conf.d"
    install -m644 "${srcdir}/60-slick-greeter.conf" "${pkgdir}/etc/lightdm/lightdm.conf.d/60-slick-greeter.conf"

    # 4. Configuracion de Slick Greeter (fondo docking pad y tema oscuro)
    install -d "${pkgdir}/etc/lightdm"
    install -m644 "${srcdir}/slick-greeter.conf" "${pkgdir}/etc/lightdm/slick-greeter.conf"

    # 5. Forzar cursor por software y teclado español en compositores wlroots/labwc
    install -d "${pkgdir}/etc/environment.d"
    install -m644 "${srcdir}/10-wlroots.conf" "${pkgdir}/etc/environment.d/10-wlroots.conf"
    install -m644 "${srcdir}/20-xkb.conf" "${pkgdir}/etc/environment.d/20-xkb.conf"

    # 6. Configuracion de usuario por defecto en /etc/skel (tema oscuro, Monolith, Whisker mejorado, panel inferior, Papirus-Dark y layout es)
    install -d "${pkgdir}/etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml"
    for conf in xsettings.xml xfce4-terminal.xml xfwm4.xml keyboard-layout.xml xfce4-panel.xml xfce4-desktop.xml; do
        install -m644 "${srcdir}/${conf}" "${pkgdir}/etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/${conf}"
    done

    # 6.1. Estilos GTK para Whisker Menu Dark Glass
    install -d "${pkgdir}/etc/skel/.config/gtk-3.0"
    install -m644 "${srcdir}/gtk.css" "${pkgdir}/etc/skel/.config/gtk-3.0/gtk.css"

    # 7. Aplicaciones preferidas (Kitty como terminal predeterminada) en /etc/skel
    install -d "${pkgdir}/etc/skel/.config/xfce4"
    install -m644 "${srcdir}/helpers.rc" "${pkgdir}/etc/skel/.config/xfce4/helpers.rc"

    # 8. Tema oscuro y atajos para Labwc (themerc-override y rc.xml con Super -> Whisker)
    install -d "${pkgdir}/etc/skel/.config/xfce4/labwc"
    install -d "${pkgdir}/etc/skel/.config/labwc"
    install -d "${pkgdir}/etc/xdg/xfce4/labwc"
    install -m644 "${srcdir}/themerc-override" "${pkgdir}/etc/skel/.config/xfce4/labwc/themerc-override"
    install -m644 "${srcdir}/themerc-override" "${pkgdir}/etc/skel/.config/labwc/themerc-override"
    install -m644 "${srcdir}/rc.xml" "${pkgdir}/etc/skel/.config/xfce4/labwc/rc.xml"
    install -m644 "${srcdir}/rc.xml" "${pkgdir}/etc/xdg/xfce4/labwc/rc.xml"

    # 9. Entorno inicial para labwc en skeleton de nuevos usuarios (soporte español Wayland + cursor)
    install -m644 "${srcdir}/environment" "${pkgdir}/etc/skel/.config/xfce4/labwc/environment"
    install -m644 "${srcdir}/environment" "${pkgdir}/etc/xdg/xfce4/labwc/environment"

    # 10. Screenshot oficial de referencia
    install -d "${pkgdir}/usr/share/x64-xfce4-settings"
    install -m644 "${srcdir}/screenshot.png" "${pkgdir}/usr/share/x64-xfce4-settings/screenshot.png"
}
