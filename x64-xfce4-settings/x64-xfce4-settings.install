post_install() {
    # 1. Ocultar sesión plana de labwc para mostrar solo sesiones oficiales Xfce
    if [ -f /usr/share/wayland-sessions/labwc.desktop ]; then
        if ! grep -q "NoDisplay=" /usr/share/wayland-sessions/labwc.desktop; then
            echo "NoDisplay=true" >> /usr/share/wayland-sessions/labwc.desktop
        else
            sed -i "s/NoDisplay=.*/NoDisplay=true/" /usr/share/wayland-sessions/labwc.desktop
        fi
    fi

    # 2. Detectar distribución de teclado del sistema (localectl / vconsole)
    sys_layout="es"
    sys_variant="winkeys"
    sys_model="pc105"
    if command -v localectl >/dev/null 2>&1; then
        _l=$(localectl status 2>/dev/null | awk -F': ' '/X11 Layout/{print $2}' | tr -d ' ')
        [ -n "$_l" ] && sys_layout="$_l"
        _v=$(localectl status 2>/dev/null | awk -F': ' '/X11 Variant/{print $2}' | tr -d ' ')
        [ -n "$_v" ] && sys_variant="$_v"
        _m=$(localectl status 2>/dev/null | awk -F': ' '/X11 Model/{print $2}' | tr -d ' ')
        [ -n "$_m" ] && sys_model="$_m"
    fi

    # 3. Parchear plantilla de entorno labwc si existe
    if [ -f /usr/share/xfce4/labwc/labwc-environment ]; then
        if ! grep -q "WLR_NO_HARDWARE_CURSORS" /usr/share/xfce4/labwc/labwc-environment; then
            echo "WLR_NO_HARDWARE_CURSORS=1" >> /usr/share/xfce4/labwc/labwc-environment
        fi
        sed -i -e "s|^XKB_DEFAULT_LAYOUT=.*|XKB_DEFAULT_LAYOUT=${sys_layout}|g" /usr/share/xfce4/labwc/labwc-environment 2>/dev/null || true
        sed -i -e "s|^XKB_DEFAULT_MODEL=.*|XKB_DEFAULT_MODEL=${sys_model}|g" /usr/share/xfce4/labwc/labwc-environment 2>/dev/null || true
        sed -i -e "s|^XKB_DEFAULT_VARIANT=.*|XKB_DEFAULT_VARIANT=${sys_variant}|g" /usr/share/xfce4/labwc/labwc-environment 2>/dev/null || true
    fi

    # 4. Parchear helpers globales del sistema de forma segura
    if [ -f /etc/xdg/xfce4/helpers.rc ]; then
        sed -i 's/^TerminalEmulator=.*/TerminalEmulator=kitty/' /etc/xdg/xfce4/helpers.rc 2>/dev/null || true
        sed -i 's/^WebBrowser=.*/WebBrowser=chromium/' /etc/xdg/xfce4/helpers.rc 2>/dev/null || true
    fi

    # 5. Sincronizar skeleton con el layout detectado
    skel_env="/etc/skel/.config/xfce4/labwc/environment"
    if [ -f "$skel_env" ]; then
        sed -i -e "s|^XKB_DEFAULT_LAYOUT=.*|XKB_DEFAULT_LAYOUT=${sys_layout}|g" "$skel_env"
        sed -i -e "s|^XKB_DEFAULT_MODEL=.*|XKB_DEFAULT_MODEL=${sys_model}|g" "$skel_env"
        sed -i -e "s|^XKB_DEFAULT_VARIANT=.*|XKB_DEFAULT_VARIANT=${sys_variant}|g" "$skel_env"
    fi

    skel_kb="/etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/keyboard-layout.xml"
    if [ -f "$skel_kb" ]; then
        sed -i -e "s|value=\"[^\"]*\"\(.*name=\"XkbLayout\"\)|value=\"${sys_layout}\"\1|" "$skel_kb" 2>/dev/null || true
        sed -i -e "s|value=\"[^\"]*\"\(.*name=\"XkbVariant\"\)|value=\"${sys_variant}\"\1|" "$skel_kb" 2>/dev/null || true
        sed -i -e "s|value=\"[^\"]*\"\(.*name=\"XkbModel\"\)|value=\"${sys_model}\"\1|" "$skel_kb" 2>/dev/null || true
    fi

    # 6. Propagar configuraciones soberanas a usuarios existentes en /home/*
    for user_dir in /home/*; do
        if [ -d "$user_dir" ]; then
            u=$(basename "$user_dir")
            g=$(id -gn "$u" 2>/dev/null || echo "$u")

            # Xfconf configs (tema, terminal, panel inferior, fondo Monolith, Whisker)
            target_xfconf="$user_dir/.config/xfce4/xfconf/xfce-perchannel-xml"
            mkdir -p "$target_xfconf"
            for xconf in xsettings.xml xfce4-terminal.xml xfwm4.xml keyboard-layout.xml xfce4-panel.xml xfce4-desktop.xml xfce4-keyboard-shortcuts.xml; do
                [ -f "/etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/${xconf}" ] && cp -f "/etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/${xconf}" "$target_xfconf/"
            done

            # Preferred applications (Kitty default)
            [ -f /etc/skel/.config/xfce4/helpers.rc ] && cp -f /etc/skel/.config/xfce4/helpers.rc "$user_dir/.config/xfce4/helpers.rc"

            # Flags de compatibilidad Ozone híbrida (Wayland y X11) para navegadores
            for f in chromium-flags.conf chrome-flags.conf; do
                if [ -f "/etc/skel/.config/${f}" ]; then
                    cp -f "/etc/skel/.config/${f}" "$user_dir/.config/${f}"
                    chown "$u:$g" "$user_dir/.config/${f}" 2>/dev/null || true
                fi
            done

            # GTK 3 CSS styles for Whisker Menu
            mkdir -p "$user_dir/.config/gtk-3.0"
            [ -f /etc/skel/.config/gtk-3.0/gtk.css ] && cp -f /etc/skel/.config/gtk-3.0/gtk.css "$user_dir/.config/gtk-3.0/gtk.css"

            # Avatar neutral oficial si no existe uno personalizado o si aún tiene el logo x64 redundante
            if [ -f "$user_dir/.face" ] && cmp -s "$user_dir/.face" /usr/share/pixmaps/x64-logo.png; then
                cp -f /etc/skel/.face "$user_dir/.face"
                cp -f /etc/skel/.face.icon "$user_dir/.face.icon"
            elif [ ! -f "$user_dir/.face" ] && [ -f /etc/skel/.face ]; then
                cp -f /etc/skel/.face "$user_dir/.face"
                cp -f /etc/skel/.face.icon "$user_dir/.face.icon"
            fi
            chown "$u:$g" "$user_dir/.face" "$user_dir/.face.icon" 2>/dev/null || true

            # Sincronizar AccountsService para icono de perfil
            if [ -d "/var/lib/AccountsService/users" ]; then
                mkdir -p /var/lib/AccountsService/icons
                cp -f /usr/share/pixmaps/default-avatar.png /var/lib/AccountsService/icons/"$u" 2>/dev/null || true
                cat << ACC_EOF > /var/lib/AccountsService/users/"$u" 2>/dev/null || true
[User]
Icon=/var/lib/AccountsService/icons/${u}
Session=
XSession=
ACC_EOF
            fi

            # Labwc dark themerc override y rc.xml (Super abre Whisker)
            mkdir -p "$user_dir/.config/xfce4/labwc" "$user_dir/.config/labwc"
            [ -f /etc/skel/.config/xfce4/labwc/themerc-override ] && cp -f /etc/skel/.config/xfce4/labwc/themerc-override "$user_dir/.config/xfce4/labwc/"
            [ -f /etc/skel/.config/xfce4/labwc/themerc-override ] && cp -f /etc/skel/.config/xfce4/labwc/themerc-override "$user_dir/.config/labwc/"
            [ -f /etc/skel/.config/xfce4/labwc/rc.xml ] && cp -f /etc/skel/.config/xfce4/labwc/rc.xml "$user_dir/.config/xfce4/labwc/"

            # Labwc cursor workaround + teclado español
            [ -f /etc/skel/.config/xfce4/labwc/environment ] && cp -f /etc/skel/.config/xfce4/labwc/environment "$user_dir/.config/xfce4/labwc/"

            chown -R "$u:$g" "$user_dir/.config/xfce4" "$user_dir/.config/labwc" "$user_dir/.config/gtk-3.0" 2>/dev/null || true

            # Aplicar configuracion xfconf en caliente si hay xfconfd activo
            uid=$(id -u "$u" 2>/dev/null || true)
            if [ -n "$uid" ] && [ -d "/run/user/$uid" ]; then
                su - "$u" -c "
                    export XDG_RUNTIME_DIR=/run/user/$uid
                    xfconf-query -c keyboard-layout -p '/Default/XkbDisable' -n -t bool -s false 2>/dev/null || true
                    xfconf-query -c keyboard-layout -p '/Default/XkbLayout' -n -t string -s '${sys_layout}' 2>/dev/null || true
                    xfconf-query -c keyboard-layout -p '/Default/XkbVariant' -n -t string -s '${sys_variant}' 2>/dev/null || true
                    xfconf-query -c keyboard-layout -p '/Default/XkbModel' -n -t string -s '${sys_model}' 2>/dev/null || true
                " 2>/dev/null || true
            fi

            # Recargar componentes Xfce y Labwc en vivo si están activos
            pid=$(pgrep -u "$u" -x labwc 2>/dev/null | head -n1 || true)
            if [ -n "$pid" ] && [ -n "$uid" ] && [ -d "/run/user/$uid" ]; then
                su - "$u" -c "
                    export LABWC_PID=$pid
                    export WAYLAND_DISPLAY=\$(ls /run/user/$uid/wayland-* 2>/dev/null | head -n1 | xargs -r basename || echo 'wayland-0')
                    export XDG_RUNTIME_DIR=/run/user/$uid
                    labwc --reconfigure 2>/dev/null || true
                    kill -SIGHUP $pid 2>/dev/null || true
                    xfdesktop --reload 2>/dev/null || true
                    systemctl --user daemon-reload 2>/dev/null || true
                    systemctl --user restart xfce4-panel.service 2>/dev/null || xfce4-panel -r 2>/dev/null || true
                " 2>/dev/null || true
            fi

            # Recargar componentes Xfce en vivo si la sesión activa es X11 (xfwm4)
            xpid=$(pgrep -u "$u" -x xfwm4 2>/dev/null | head -n1 || true)
            if [ -n "$xpid" ] && [ -n "$uid" ] && [ -d "/run/user/$uid" ]; then
                su - "$u" -c "
                    export DISPLAY=\$(ls /tmp/.X11-unix/X* 2>/dev/null | head -n1 | sed 's|.*X|:|' || echo ':0')
                    export XDG_RUNTIME_DIR=/run/user/$uid
                    xfdesktop --reload 2>/dev/null || true
                    systemctl --user daemon-reload 2>/dev/null || true
                    systemctl --user restart xfce4-panel.service 2>/dev/null || xfce4-panel -r 2>/dev/null || true
                    pkill -x xcape 2>/dev/null || true
                    xcape -e 'Super_L=Control_L|Escape;Super_R=Control_L|Escape' 2>/dev/null || true
                " 2>/dev/null || true
            fi
        fi
    done
}

post_upgrade() {
    post_install
}
