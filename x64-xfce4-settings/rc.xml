<?xml version="1.0"?>
<!--
  This is a very simple config file with many options missing. For a
  complete set of options with comments, see Labwc docs/rc.xml.all
-->
<labwc_config>

  <placement>
    <policy>automatic</policy>
  </placement>

  <theme>
    <name>Adwaita</name>
    <cornerRadius>8</cornerRadius>
    <font name="Noto Sans" size="10"/>
  </theme>

  <desktops number="4" />

  <keyboard>
    <default/>
    <!-- Super and fallback keys to toggle Whisker Menu -->
    <keybind key="Super_L" onRelease="yes">
      <action name="Execute" command="/usr/bin/xfce4-popup-whiskermenu"/>
    </keybind>
    <keybind key="Super_R" onRelease="yes">
      <action name="Execute" command="/usr/bin/xfce4-popup-whiskermenu"/>
    </keybind>
    <keybind key="C-Escape">
      <action name="Execute" command="/usr/bin/xfce4-popup-whiskermenu"/>
    </keybind>
    <keybind key="W-space">
      <action name="Execute" command="/usr/bin/xfce4-popup-whiskermenu"/>
    </keybind>

    <!-- Screenshots (Full, Region Snipping, Active Window, Interactive) -->
    <keybind key="Print" overrideInhibition="yes">
      <action name="Execute" command="/usr/bin/x64-screenshot full"/>
    </keybind>
    <keybind key="S-Print" overrideInhibition="yes">
      <action name="Execute" command="/usr/bin/x64-screenshot region"/>
    </keybind>
    <keybind key="W-S-s" overrideInhibition="yes">
      <action name="Execute" command="/usr/bin/x64-screenshot region"/>
    </keybind>
    <keybind key="W-S-S" overrideInhibition="yes">
      <action name="Execute" command="/usr/bin/x64-screenshot region"/>
    </keybind>
    <keybind key="C-S-s" overrideInhibition="yes">
      <action name="Execute" command="/usr/bin/x64-screenshot region"/>
    </keybind>
    <keybind key="C-S-S" overrideInhibition="yes">
      <action name="Execute" command="/usr/bin/x64-screenshot region"/>
    </keybind>
    <keybind key="A-Print" overrideInhibition="yes">
      <action name="Execute" command="/usr/bin/x64-screenshot region"/>
    </keybind>
    <keybind key="C-Print" overrideInhibition="yes">
      <action name="Execute" command="/usr/bin/x64-screenshot gui"/>
    </keybind>

    <!-- Official X64 Kitty terminal emulator -->
    <keybind key="W-Return">
      <action name="Execute" command="/usr/bin/kitty"/>
    </keybind>
    <!--
      Remove a previously defined keybind
      A shorter alternative is <keybind key="W-F4" />
    -->
    <keybind key="W-F4">
      <action name="None"/>
    </keybind>

    <numlock>on</numlock>

    <!--
       Suggested Xfce key bindings.
    -->
    <keybind key="XF86_AudioLowerVolume">
      <action name="Execute" command="amixer sset Master 5%-" />
    </keybind>
    <keybind key="XF86_AudioRaiseVolume">
      <action name="Execute" command="amixer sset Master 5%+" />
    </keybind>
    <keybind key="XF86_AudioMute">
      <action name="Execute" command="amixer sset Master toggle" />
    </keybind>
    <keybind key="W-q">
      <action name="Close" />
    </keybind>
    <keybind key="A-Tab">
      <action name="NextWindow" />
    </keybind>
    <keybind key="W-Tab">
      <action name="ToggleMaximize" />
    </keybind>
    <keybind key="W-1">
      <action name="GoToDesktop" to="1" />
    </keybind>
    <keybind key="W-2">
      <action name="GoToDesktop" to="2" />
    </keybind>
    <keybind key="W-3">
      <action name="GoToDesktop" to="3" />
    </keybind>
    <keybind key="W-4">
      <action name="GoToDesktop" to="4" />
    </keybind>
  </keyboard>

  <snapping>
    <range inner="10" outer="10" />
  </snapping>

</labwc_config>
