#!/bin/bash
# ==============================================================================
# X64 LIOS - Official Smart Waydroid Launcher (On-Demand Zero-RAM Idle Mode)
# ==============================================================================

if ! command -v waydroid >/dev/null 2>&1; then
    if command -v notify-send >/dev/null 2>&1; then
        notify-send "X64 LIOS" "Waydroid no está instalado en el sistema." -i android
    fi
    exit 1
fi

# Función para aplicar el perfil X64 On-Demand (cierra el contenedor al cerrar la ventana)
apply_x64_ondemand_config() {
    if [ -f /var/lib/waydroid/waydroid.cfg ]; then
        sudo sed -i 's/^suspend_action = .*/suspend_action = stop/' /var/lib/waydroid/waydroid.cfg 2>/dev/null || true
        if ! grep -q "^persist.waydroid.suspend" /var/lib/waydroid/waydroid.cfg 2>/dev/null; then
            sudo sed -i '/^\[properties\]/a persist.waydroid.suspend = true' /var/lib/waydroid/waydroid.cfg 2>/dev/null || true
        fi
    fi
    if [ -f /var/lib/waydroid/waydroid_base.prop ]; then
        if ! grep -q "^persist.waydroid.suspend=" /var/lib/waydroid/waydroid_base.prop 2>/dev/null; then
            echo "persist.waydroid.suspend=true" | sudo tee -a /var/lib/waydroid/waydroid_base.prop >/dev/null 2>&1 || true
        fi
    fi
}

if [ "$1" = "--configure-only" ]; then
    apply_x64_ondemand_config
    exit 0
fi

if [ "$1" = "--stop" ]; then
    waydroid session stop 2>/dev/null || true
    exit 0
fi

# Seleccionar emulador de terminal disponible
TERM_CMD=""
if command -v kitty >/dev/null 2>&1; then
    TERM_CMD="kitty --title 'X64 Android Gaming - Waydroid'"
elif command -v konsole >/dev/null 2>&1; then
    TERM_CMD="konsole --title 'X64 Android Gaming - Waydroid' -e"
elif command -v gnome-terminal >/dev/null 2>&1; then
    TERM_CMD="gnome-terminal --title 'X64 Android Gaming - Waydroid' --"
elif command -v xterm >/dev/null 2>&1; then
    TERM_CMD="xterm -title 'X64 Android Gaming - Waydroid' -e"
fi

# Comprobar si Waydroid está inicializado
if waydroid status 2>&1 | grep -qi "not initialized"; then
    if [ -n "$TERM_CMD" ]; then
        eval "$TERM_CMD bash -c '
            printf \"\\033[1;31m============================================================\\033[0m\\n\"
            printf \"\\033[1;37m   X64 LIOS — INICIALIZADOR DE ANDROID (WAYDROID)\\033[0m\\n\"
            printf \"\\033[1;31m============================================================\\033[0m\\n\\n\"
            printf \"Waydroid está instalado en el sistema, pero requiere descargar\\n\"
            printf \"e inicializar la imagen del sistema Android (LineageOS) por primera vez.\\n\\n\"
            printf \"\\033[1;33mDetalles de la descarga:\\033[0m\\n\"
            printf \"  • Tamaño: ~800 MB (LineageOS Android Image)\\n\"
            printf \"  • Ubicación: /var/lib/waydroid\\n\"
            printf \"  • Modo X64: Bajo Demanda (se apaga solo al cerrar la ventana)\\n\\n\"
            printf \"Presione \\033[1;32m[Enter]\\033[0m para iniciar la descarga con sudo\\n\"
            printf \"o cierre esta ventana para cancelar...\\n\"
            read -r _
            sudo waydroid init
            if [ \$? -eq 0 ]; then
                /usr/bin/x64-waydroid-launcher --configure-only
                printf \"\\n\\033[1;32m[✓] ¡Waydroid inicializado con éxito en modo Bajo Demanda!\\033[0m\\n\"
                printf \"Iniciando contenedor y lanzando interfaz gráfica...\\n\"
                sudo systemctl enable --now waydroid-container.service 2>/dev/null || true
                sleep 2
                waydroid show-full-ui &
                sleep 2
            else
                printf \"\\n\\033[1;31m[X] Error o cancelación durante la inicialización de Waydroid.\\033[0m\\n\"
                printf \"Presione [Enter] para salir...\"; read -r _
            fi
        '" &
    fi
    exit 0
fi

# Si ya está inicializado: garantizar que el demonio D-Bus ligero esté activo
if ! systemctl is-active --quiet waydroid-container.service; then
    pkexec systemctl start waydroid-container.service 2>/dev/null || sudo systemctl start waydroid-container.service 2>/dev/null || true
fi

# Lanzar la interfaz gráfica completa y asegurar propiedad de auto-suspensión/parada al cerrar ventana
waydroid show-full-ui &
(
    for _ in $(seq 1 20); do
        sleep 2
        if waydroid status 2>/dev/null | grep -q "RUNNING"; then
            waydroid prop set persist.waydroid.suspend true >/dev/null 2>&1 || true
            break
        fi
    done
) &
