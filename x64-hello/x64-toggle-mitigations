#!/usr/bin/env python3
"""
X64 LIOS Kernel Mitigations Toggle Tool
Manages 'mitigations=off' kernel parameter across GRUB, Limine, systemd-boot, and rEFInd.
"""
import sys
import os
import re
import subprocess


def is_running_disabled():
    try:
        with open("/proc/cmdline", "r") as f:
            return "mitigations=off" in f.read().split()
    except Exception:
        return False


def check_configured_disabled():
    # GRUB (only when GRUB is actually installed/configured)
    if os.path.exists("/etc/default/grub") and os.path.exists("/boot/grub/grub.cfg"):
        try:
            with open("/etc/default/grub", "r") as f:
                for line in f:
                    if line.strip().startswith("GRUB_CMDLINE_LINUX_DEFAULT"):
                        if re.search(r'(?<!\S)mitigations=off(?!\S)', line):
                            return True
        except Exception:
            pass
    # Limine (prefer /etc/default/limine managed by limine-entry-tool over snapshots in limine.conf)
    if os.path.exists("/etc/default/limine"):
        try:
            with open("/etc/default/limine", "r") as f:
                for line in f:
                    if "KERNEL_CMDLINE[default]" in line and not line.strip().startswith("#"):
                        if re.search(r'(?<!\S)mitigations=off(?!\S)', line):
                            return True
        except Exception:
            pass
    else:
        for lp in ["/boot/limine.conf", "/boot/efi/limine.conf"]:
            if os.path.exists(lp):
                try:
                    with open(lp, "r") as f:
                        if re.search(r'(?<!\S)mitigations=off(?!\S)', f.read()):
                            return True
                except Exception:
                    pass
    # systemd-boot (/etc/kernel/cmdline + /boot/efi/loader/entries + /boot/loader/entries)
    if os.path.exists("/etc/kernel/cmdline"):
        try:
            with open("/etc/kernel/cmdline", "r") as f:
                if "mitigations=off" in f.read().split():
                    return True
        except Exception:
            pass
    for entries_dir in ["/boot/efi/loader/entries", "/boot/loader/entries"]:
        if os.path.isdir(entries_dir):
            try:
                for fname in os.listdir(entries_dir):
                    if fname.endswith(".conf"):
                        try:
                            with open(os.path.join(entries_dir, fname), "r") as f:
                                for line in f:
                                    if line.strip().startswith("options") and "mitigations=off" in line.split():
                                        return True
                        except Exception:
                            pass
            except Exception:
                pass
    # rEFInd
    if os.path.exists("/boot/refind_linux.conf"):
        try:
            with open("/boot/refind_linux.conf", "r") as f:
                if re.search(r'(?<!\S)mitigations=off(?!\S)', f.read()):
                    return True
        except Exception:
            pass
    return False


def get_status():
    running = is_running_disabled()
    configured = check_configured_disabled()
    if running and configured:
        print("disabled")
    elif configured and not running:
        print("disabled_pending_reboot")
    elif not configured and running:
        print("enabled_pending_reboot")
    else:
        print("enabled")


def update_grub(enable_off=True):
    path = "/etc/default/grub"
    if not (os.path.exists(path) and os.path.exists("/boot/grub/grub.cfg")):
        return False
    with open(path, "r") as f:
        content = f.read()

    lines = content.splitlines()
    new_lines = []
    modified = False
    for line in lines:
        if line.strip().startswith("GRUB_CMDLINE_LINUX_DEFAULT="):
            m = re.match(r'^(GRUB_CMDLINE_LINUX_DEFAULT=)(["\'])(.*)(["\'])$', line.strip())
            if m:
                prefix, quote_open, val, quote_close = m.groups()
                tokens = val.split()
                if enable_off:
                    if "mitigations=off" not in tokens:
                        tokens.append("mitigations=off")
                        modified = True
                else:
                    if "mitigations=off" in tokens:
                        tokens = [t for t in tokens if t != "mitigations=off"]
                        modified = True
                new_val = " ".join(tokens)
                line = f"{prefix}{quote_open}{new_val}{quote_close}"
        new_lines.append(line)

    if modified:
        with open(path, "w") as f:
            f.write("\n".join(new_lines) + "\n")
        if subprocess.run(["which", "grub-mkconfig"], capture_output=True).returncode == 0:
            subprocess.run(["grub-mkconfig", "-o", "/boot/grub/grub.cfg"], check=False)
        return True
    return False


def update_limine(enable_off=True):
    modified = False
    lp = "/etc/default/limine"
    if os.path.exists(lp):
        with open(lp, "r") as f:
            lines = f.readlines()
        new_lines = []
        for line in lines:
            stripped = line.strip()
            if "KERNEL_CMDLINE[default]" in stripped and not stripped.startswith("#"):
                m = re.match(r'^(\s*KERNEL_CMDLINE\[default\]\+?=\s*)(["\'])(.*)(["\'])\s*$', line)
                if m:
                    prefix, q_open, val, q_close = m.groups()
                    tokens = val.split()
                    if enable_off and "mitigations=off" not in tokens:
                        tokens.append("mitigations=off")
                        modified = True
                    elif not enable_off and "mitigations=off" in tokens:
                        tokens = [t for t in tokens if t != "mitigations=off"]
                        modified = True
                    line = f"{prefix}{q_open}{' '.join(tokens)}{q_close}\n"
            new_lines.append(line)
        if modified:
            with open(lp, "w") as f:
                f.writelines(new_lines)
            if subprocess.run(["which", "limine-update"], capture_output=True).returncode == 0:
                subprocess.run(["limine-update"], check=False)
        return modified

    # Fallback for manual Limine setups without /etc/default/limine
    for cf in ["/boot/limine.conf", "/boot/efi/limine.conf"]:
        if os.path.exists(cf):
            with open(cf, "r") as f:
                lines = f.readlines()
            new_lines = []
            file_modified = False
            for line in lines:
                m = re.match(r'^(\s*cmdline:\s*)(.*)$', line)
                if m:
                    prefix, val = m.groups()
                    tokens = val.split()
                    if enable_off and "mitigations=off" not in tokens:
                        tokens.append("mitigations=off")
                        file_modified = True
                    elif not enable_off and "mitigations=off" in tokens:
                        tokens = [t for t in tokens if t != "mitigations=off"]
                        file_modified = True
                    line = f"{prefix}{' '.join(tokens)}\n"
                new_lines.append(line)
            if file_modified:
                with open(cf, "w") as f:
                    f.writelines(new_lines)
                modified = True
    return modified


def update_systemd_boot(enable_off=True):
    modified = False
    # 1. Update /etc/kernel/cmdline (source of truth for kernel-install / Calamares systemd-boot)
    cmdline_path = "/etc/kernel/cmdline"
    if os.path.exists(cmdline_path):
        with open(cmdline_path, "r") as f:
            raw = f.read().strip()
        tokens = raw.split()
        file_modified = False
        if enable_off and "mitigations=off" not in tokens:
            tokens.append("mitigations=off")
            file_modified = True
        elif not enable_off and "mitigations=off" in tokens:
            tokens = [t for t in tokens if t != "mitigations=off"]
            file_modified = True
        if file_modified:
            with open(cmdline_path, "w") as f:
                f.write(" ".join(tokens) + "\n")
            modified = True

    # 2. Update live loader entries in both /boot/efi/loader/entries and /boot/loader/entries
    for entries_dir in ["/boot/efi/loader/entries", "/boot/loader/entries"]:
        if os.path.isdir(entries_dir):
            for fname in os.listdir(entries_dir):
                if fname.endswith(".conf"):
                    p = os.path.join(entries_dir, fname)
                    with open(p, "r") as f:
                        lines = f.readlines()
                    new_lines = []
                    file_modified = False
                    for line in lines:
                        if line.startswith("options"):
                            tokens = line.strip().split()
                            if enable_off and "mitigations=off" not in tokens:
                                tokens.append("mitigations=off")
                                line = " ".join(tokens) + "\n"
                                file_modified = True
                            elif not enable_off and "mitigations=off" in tokens:
                                tokens = [t for t in tokens if t != "mitigations=off"]
                                line = " ".join(tokens) + "\n"
                                file_modified = True
                        new_lines.append(line)
                    if file_modified:
                        with open(p, "w") as f:
                            f.writelines(new_lines)
                        modified = True
    return modified


def update_refind(enable_off=True):
    modified = False
    path = "/boot/refind_linux.conf"
    if os.path.exists(path):
        with open(path, "r") as f:
            lines = f.readlines()
        new_lines = []
        for line in lines:
            m = re.match(r'^(\s*"[^"]*"\s*")([^"]*)("\s*)$', line)
            if m:
                prefix, val, suffix = m.groups()
                tokens = val.split()
                if enable_off and "mitigations=off" not in tokens:
                    tokens.append("mitigations=off")
                    modified = True
                elif not enable_off and "mitigations=off" in tokens:
                    tokens = [t for t in tokens if t != "mitigations=off"]
                    modified = True
                line = f"{prefix}{' '.join(tokens)}{suffix.rstrip()}\n"
            new_lines.append(line)
        if modified:
            with open(path, "w") as f:
                f.writelines(new_lines)
    return modified


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-s", "--status", "status"):
        get_status()
        return

    cmd = sys.argv[1].lower()
    if cmd in ("off", "disable"):
        if os.geteuid() != 0:
            print("Error: Root privileges required to modify bootloader config.", file=sys.stderr)
            sys.exit(1)
        update_grub(enable_off=True)
        update_limine(enable_off=True)
        update_systemd_boot(enable_off=True)
        update_refind(enable_off=True)
        print("SUCCESS: mitigations=off configured. System reboot required.")
    elif cmd in ("on", "enable", "restore"):
        if os.geteuid() != 0:
            print("Error: Root privileges required to modify bootloader config.", file=sys.stderr)
            sys.exit(1)
        update_grub(enable_off=False)
        update_limine(enable_off=False)
        update_systemd_boot(enable_off=False)
        update_refind(enable_off=False)
        print("SUCCESS: Mitigations restored to default secure state. System reboot required.")
    else:
        print(f"Usage: {sys.argv[0]} [status|off|on]")
        sys.exit(1)


if __name__ == "__main__":
    main()

