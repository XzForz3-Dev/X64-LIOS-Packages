pkgname=x64-hello
pkgver=1.0.0
pkgrel=25
pkgdesc="X64 LIOS Official Post-Installation Welcome, System Tweaks & Gaming Center"
arch=('any')
license=('GPL')
depends=('python' 'python-pyqt6' 'qt6-svg')
source=('x64-hello'
        'x64-toggle-mitigations'
        'x64-waydroid-launcher'
        'x64-sunshine-launcher'
        'x64-sunshine.svg'
        'x64-hello.desktop'
        'x64-hello-icon.png'
        'x64-hello-icon.svg'
        'x64-cube.png')
sha256sums=('9691d3e4ac2094e75c2f4694b381eb8ea0d45cc6b931002248f5d357d043200f'
            'd6f0f20f5c76e4bc97ebe9c32fa9c802372d71c4c561b9e73af63acca24e9fca'
            '4557155a893a22a904d03abd98118bc30103b39e735d2cfee594a1848799857c'
            '5120a98c44bd073895f60e9a0dcfd83c1f6ee562d4a4b996dfd632b2e865bfe4'
            '3c2755ca907b77d12d900a255488424c0a8059bfb556556866d64348ae56e71b'
            '77bc0a482b7dc076f0f7f3872c6febb527ec19698020df683400e5a086715acf'
            '4ee93bf93ac94f77442a26e56e350d73ace7d76cc63f99ec7a6ac9946d2e9ee2'
            '79ae5596c485ea265b0d63ddbece520361e8558fe11ed90d34d759dcb0c0a397'
            '4ee93bf93ac94f77442a26e56e350d73ace7d76cc63f99ec7a6ac9946d2e9ee2')

package() {
    # Instalar el ejecutable principal y utilidades
    install -Dm755 "${srcdir}/x64-hello" "${pkgdir}/usr/bin/x64-hello"
    install -Dm755 "${srcdir}/x64-toggle-mitigations" "${pkgdir}/usr/bin/x64-toggle-mitigations"
    install -Dm755 "${srcdir}/x64-waydroid-launcher" "${pkgdir}/usr/bin/x64-waydroid-launcher"
    install -Dm755 "${srcdir}/x64-sunshine-launcher" "${pkgdir}/usr/bin/x64-sunshine-launcher"
    
    # Instalar acceso directo en menú de aplicaciones
    install -Dm644 "${srcdir}/x64-hello.desktop" "${pkgdir}/usr/share/applications/x64-hello.desktop"
    
    # Instalar autostart en /etc/skel para que inicie en el primer arranque del usuario instalado
    install -Dm644 "${srcdir}/x64-hello.desktop" "${pkgdir}/etc/skel/.config/autostart/x64-hello.desktop"
    
    # Instalar los iconos (PNG pixmap y SVG vectorial para temas de escritorio)
    install -Dm644 "${srcdir}/x64-hello-icon.png" "${pkgdir}/usr/share/pixmaps/x64-hello-icon.png"
    install -Dm644 "${srcdir}/x64-hello-icon.svg" "${pkgdir}/usr/share/icons/hicolor/scalable/apps/x64-hello-icon.svg"
    install -Dm644 "${srcdir}/x64-sunshine.svg" "${pkgdir}/usr/share/pixmaps/x64-sunshine.svg"
    install -Dm644 "${srcdir}/x64-sunshine.svg" "${pkgdir}/usr/share/icons/hicolor/scalable/apps/dev.lizardbyte.app.Sunshine.svg"
    
    # Instalar el logo del cubo 3D
    install -Dm644 "${srcdir}/x64-cube.png" "${pkgdir}/usr/share/pixmaps/x64-cube.png"
}

