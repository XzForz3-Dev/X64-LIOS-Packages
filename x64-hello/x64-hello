    def _run_dns_pkexec(self, sh_cmd, pending_msg, success_msg):
        self.status_lbl.setStyleSheet("color: #f39c12; font-size: 12px; font-weight: bold; background: transparent; border: none;")
        self.status_lbl.setText(f"⟳ {pending_msg}")
        proc = QProcess(self)

        def _on_done(exit_code, _exit_status):
            if exit_code == 0:
                self.status_lbl.setStyleSheet("color: #2ecc71; font-size: 12px; font-weight: bold; background: transparent; border: none;")
                self.status_lbl.setText(f"✓ {success_msg}")
            else:
                self.status_lbl.setStyleSheet("color: #ff4d4d; font-size: 12px; font-weight: bold; background: transparent; border: none;")
                self.status_lbl.setText(f"✕ {tr('Operation canceled or authentication failed.')}")
            proc.deleteLater()

        proc.finished.connect(_on_done)
        proc.start("pkexec", ["sh", "-c", sh_cmd])

    def apply_dns(self):
        conn = self.conn_combo.currentText().strip()
        if not conn:
            return
        p = DNS_PROVIDERS[self.selected_idx]
        dot_val = "2" if self.chk_dot.isChecked() else "0"
        sh_cmd = (
            f"nmcli connection modify '{conn}' "
            f"ipv4.ignore-auto-dns yes ipv4.dns '{p['ipv4']}' "
            f"ipv6.ignore-auto-dns yes ipv6.dns '{p['ipv6']}' "
            f"connection.dns-over-tls {dot_val} && "
            f"nmcli connection up '{conn}'"
        )
        self._run_dns_pkexec(
            sh_cmd,
            tr("Applying DNS configuration..."),
            f"{tr('DNS successfully applied to connection:')} {conn} ({p['name']})"
        )

    def reset_dns(self):
        conn = self.conn_combo.currentText().strip()
        if not conn:
            return
        sh_cmd = (
            f"nmcli connection modify '{conn}' "
            f"ipv4.ignore-auto-dns no ipv4.dns '' "
            f"ipv6.ignore-auto-dns no ipv6.dns '' "
            f"connection.dns-over-tls -1 && "
            f"nmcli connection up '{conn}'"
