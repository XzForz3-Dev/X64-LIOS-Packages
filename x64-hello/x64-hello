class X64Hello(QWidget):
    def __init__(self):
        super().__init__()
        self.nav_buttons = []
        self.service_cards = []
        self.gaming_cards = []
        self._svc_worker = None
        self._prev_cpu_Idle = 0
        self._prev_cpu_Total = 0
        self.initUI()

        self.pacman_watcher = QFileSystemWatcher(["/var/lib/pacman/local"], self)
        self.pacman_watcher.directoryChanged.connect(self.on_pacman_db_changed)

        self.hw_timer = QTimer(self)
        self.hw_timer.timeout.connect(self.update_hardware_telemetry)
        self.hw_timer.start(1500)
        self.update_hardware_telemetry(force=True)

        self.refresh_services_async()

    def update_hardware_telemetry(self, force=False):
        if not force and self.stacked_widget.currentIndex() != 0:
            return
        try:
            with open("/proc/stat", "r") as f:
                fields = [int(x) for x in f.readline().split()[1:]]
            idle = fields[3] + (fields[4] if len(fields) > 4 else 0)
            total = sum(fields)
            diff_total = total - self._prev_cpu_Total
            diff_idle = idle - self._prev_cpu_Idle
            self._prev_cpu_Total = total
            self._prev_cpu_Idle = idle
            cpu_pct = 0.0
            if diff_total > 0:
                cpu_pct = max(0.0, min(100.0, 100.0 * (diff_total - diff_idle) / diff_total))
            active_sched = get_active_cpu_scheduler()
            kernel_rel = platform.release().replace('-cachyos', '')
            self.card_cpu.update_telemetry(
                f"{cpu_pct:.1f}%  •  {STATIC_HW['cpu_cores']} {tr('Threads')}",
                cpu_pct,
                f"Kernel: {kernel_rel}"
            )
            self.card_cpu.set_sched_badge(active_sched)
        except Exception:
            pass

        try:
            mem = {}
            with open("/proc/meminfo", "r") as f:
                for line in f:
                    parts = line.split(":")
                    if len(parts) == 2:
                        mem[parts[0].strip()] = int(parts[1].split()[0])
            total_kb = mem.get("MemTotal", 1)
            avail_kb = mem.get("MemAvailable", total_kb)
            used_kb = max(0, total_kb - avail_kb)
            ram_pct = (used_kb / total_kb) * 100.0
            used_gb = used_kb / (1024 * 1024)
            total_gb = total_kb / (1024 * 1024)
            self.card_ram.update_telemetry(
                f"{used_gb:.1f} / {total_gb:.1f} GB ({ram_pct:.0f}%)",
                ram_pct
            )
        except Exception:
            pass

        try:
            st = os.statvfs("/")
            total_b = st.f_blocks * st.f_frsize
            free_b = st.f_bavail * st.f_frsize
            used_b = max(0, total_b - free_b)
            disk_pct = (used_b / total_b) * 100.0 if total_b > 0 else 0
            used_d_gb = used_b / (1024 ** 3)
            total_d_gb = total_b / (1024 ** 3)

            uptime_str = "0m"
            with open("/proc/uptime", "r") as f:
                up_sec = int(float(f.read().split()[0]))
                hrs = up_sec // 3600
                mins = (up_sec % 3600) // 60
                uptime_str = f"{hrs}h {mins}m" if hrs > 0 else f"{mins}m"

            self.card_disk.update_telemetry(
                f"{used_d_gb:.1f} / {total_d_gb:.1f} GB ({disk_pct:.0f}%)",
                disk_pct,
                f"{tr('Filesystem')} {STATIC_HW['root_fs']}  •  {tr('Uptime')}: {uptime_str}"
            )
        except Exception:
            pass

    def refresh_services_async(self):
        if self._svc_worker and self._svc_worker.isRunning():
            return
        sys_units = list(dict.fromkeys(c.unit_name for c in self.service_cards if not c.is_user))
        user_units = list(dict.fromkeys(c.unit_name for c in self.service_cards if c.is_user))
        worker = ServiceStatusWorker(sys_units, user_units)
        self._svc_worker = worker
        _BG_WORKERS.add(worker)
        worker.status_ready.connect(self.on_services_status)
        worker.finished.connect(lambda w=worker: _BG_WORKERS.discard(w))
        worker.start()

