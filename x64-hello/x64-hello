        for path in ["/etc/default/grub", "/etc/default/limine", "/boot/limine.conf"]:
            if os.path.exists(path):
                try:
                    with open(path, "r") as f:
                        if "mitigations=off" in f.read():
                            return True
                except Exception:
                    pass
        return False

