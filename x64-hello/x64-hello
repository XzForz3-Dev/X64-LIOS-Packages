                    background-color: rgba(0, 180, 90, 0.28);
                }
            """)
        else:
            self.status_pill.setText(f"● {tr('MITIGATIONS ACTIVE (SECURE)')}")
            self.status_pill.setStyleSheet("""
                color: #2ecc71;
                background-color: rgba(0, 180, 90, 0.15);
                border: 1px solid rgba(46, 204, 113, 0.45);
                border-radius: 6px;
                padding: 0 10px;
                font-weight: bold;
                font-size: 10px;
            """)
            self.toggle_btn.setText(tr("DISABLE (+FPS)"))
            self.toggle_btn.setStyleSheet("""
                QPushButton {
                    background-color: rgba(255, 255, 255, 0.05);
                    color: #e0e0e0;
                    border: 1px solid #44444c;
                    border-radius: 7px;
                    padding: 0 12px;
                    font-weight: bold;
                    font-size: 10.5px;
                }
                QPushButton:hover {
                    background-color: rgba(204, 0, 0, 0.2);
                    border: 1px solid #cc0000;
                    color: #ffffff;
                }
            """)

    def toggle_action(self):
        if not self._disabled_state:
            dialog = MitigationsConfirmDialog(self)
            if dialog.exec() != QDialog.DialogCode.Accepted:
                return

        action_arg = "off" if not self._disabled_state else "on"
        self.toggle_btn.setEnabled(False)
        self.toggle_btn.setText(tr("APPLYING..."))

        tool_cmd = "/usr/bin/x64-toggle-mitigations"
        if not os.path.exists(tool_cmd):
            local_tool = os.path.join(os.path.dirname(os.path.abspath(__file__)), "x64-toggle-mitigations")
            if os.path.exists(local_tool):
                tool_cmd = local_tool

        proc = QProcess(self)
        def _on_done(exit_code, _exit_status):
            self.toggle_btn.setEnabled(True)
            self.refresh_state()
            if exit_code == 0:
                self.lbl_desc.setText(f"✓ {tr('Bootloader updated. Please restart your PC to apply kernel changes.')}")
                self.lbl_desc.setStyleSheet("color: #2ecc71; font-size: 10.5px; font-weight: bold; border: none; background: transparent;")
            else:
                self.lbl_desc.setText(tr("Operation cancelled."))
                self.lbl_desc.setStyleSheet("color: #ff9999; font-size: 10.5px; border: none; background: transparent;")
            proc.deleteLater()

        proc.finished.connect(_on_done)
        proc.start("pkexec", [tool_cmd, action_arg])


