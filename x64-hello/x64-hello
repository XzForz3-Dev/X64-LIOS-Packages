class FitLabel(QLabel):
    """Single-line QLabel that shrinks its font (down to min_ratio) and finally
    elides with '…' so text never gets hard-clipped in narrow grid cards."""

    def __init__(self, text="", parent=None, min_ratio=0.82):
        super().__init__(text, parent)
        self._min_ratio = min_ratio
        self.setMinimumWidth(0)

    def minimumSizeHint(self):
        return QSize(0, super().minimumSizeHint().height())

    def paintEvent(self, event):
        text = self.text()
        if not text or self.textFormat() == Qt.TextFormat.RichText or self.wordWrap():
            return super().paintEvent(event)
        rect = self.contentsRect()
        font = QFont(self.font())
        use_px = font.pixelSize() > 0
        base = float(font.pixelSize()) if use_px else font.pointSizeF()
        size = base
        fm = QFontMetrics(font)
        while fm.horizontalAdvance(text) > rect.width() and size > base * self._min_ratio:
            size -= 0.5
            if use_px:
                font.setPixelSize(max(1, int(round(size))))
            else:
                font.setPointSizeF(size)
            fm = QFontMetrics(font)
        if fm.horizontalAdvance(text) > rect.width():
            text = fm.elidedText(text, Qt.TextElideMode.ElideRight, rect.width())
        painter = QPainter(self)
        painter.setFont(font)
        painter.setPen(self.palette().color(QPalette.ColorRole.WindowText))
        painter.drawText(rect, int(self.alignment()), text)
        painter.end()


