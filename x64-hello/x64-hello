    def _build_persist_cmd(self, sched_id, mode_id):
        mode_toml = "Auto"
        for m_id, _m_lbl, m_t in SCX_MODES:
            if m_id == mode_id:
                mode_toml = m_t
                break
        if sched_id == "bore":
            header_lines = (
                "# Default scheduler at boot (BORE kernel default active; managed dynamically by FalconD)\n"
                "# default_sched = \"scx_bpfland\"\n"
                "# default_mode = \"Auto\"\n"
            )
        else:
            header_lines = (
                f"default_sched = \"scx_{sched_id}\"\n"
                f"default_mode = \"{mode_toml}\"\n"
            )
        toml_body = (
            "# ==============================================================================\n"
            "# X64 LIOS Linux - sched_ext (scx_loader) Low-Latency Gaming Profile\n"
            "# ==============================================================================\n"
            + header_lines + "\n"
            "[scheds.scx_bpfland]\n"
            "auto_mode = [\"-s\", \"20000\", \"-S\", \"1000\"]\n"
            "gaming_mode = [\"-m\", \"performance\", \"-s\", \"20000\", \"-S\", \"500\"]\n"
            "lowlatency_mode = [\"-s\", \"5000\", \"-S\", \"500\", \"-l\", \"5000\", \"-m\", \"performance\"]\n"
            "powersave_mode = [\"-m\", \"powersave\", \"-s\", \"20000\", \"-S\", \"5000\"]\n\n"
            "[scheds.scx_lavd]\n"
            "auto_mode = [\"--autopilot\"]\n"
            "gaming_mode = [\"--performance\"]\n"
            "lowlatency_mode = [\"--performance\"]\n"
            "powersave_mode = [\"--powersave\"]\n\n"
            "[scheds.scx_flash]\n"
            "auto_mode = []\n"
            "gaming_mode = [\"-m\", \"all\", \"-s\", \"20000\", \"-S\", \"500\"]\n"
            "lowlatency_mode = [\"-m\", \"all\", \"-s\", \"5000\", \"-S\", \"500\", \"-L\"]\n"
            "powersave_mode = [\"-m\", \"powersave\"]\n\n"
            "[scheds.scx_rusty]\n"
            "auto_mode = []\n"
        )
        return f"printf %s {shlex.quote(toml_body)} > /etc/scx_loader/config.toml"

    def _execute_scx_change(self, sched_id, mode_id):
        self.status_lbl.setStyleSheet("color: #f39c12; font-size: 12px; font-weight: bold; background: transparent; border: none;")
        self.status_lbl.setText(f"⟳ {tr('Applying CPU scheduler...')}")

        if sched_id == "bore":
            scx_cmd = "scxctl stop >/dev/null 2>&1 || true"
            target_cache = "BORE"
            success_msg = tr("Returned to native BORE kernel scheduler.")
        else:
            scx_cmd = f"scxctl switch -s {sched_id} -m {mode_id} >/dev/null 2>&1 || scxctl start -s {sched_id} -m {mode_id}"
            target_cache = f"scx_{sched_id}"
            success_msg = f"{tr('CPU scheduler switched to:')} scx_{sched_id} ({mode_id.capitalize()})"

        persist = self.chk_persist.isChecked()
        proc = QProcess(self)

        def _on_done(exit_code, _exit_status):
            if exit_code == 0:
                _SCX_OVERRIDE_CACHE["sched"] = target_cache
                _SCX_OVERRIDE_CACHE["mode"] = mode_id
                _SCX_OVERRIDE_CACHE["until"] = time.monotonic() + 3.5
                self.status_lbl.setStyleSheet("color: #2ecc71; font-size: 12px; font-weight: bold; background: transparent; border: none;")
                self.status_lbl.setText(f"✓ {success_msg}")
                self.refresh_runtime_state(select_active=False)
                QTimer.singleShot(1800, lambda: self.refresh_runtime_state(select_active=False))
            else:
                self.status_lbl.setStyleSheet("color: #ff4d4d; font-size: 12px; font-weight: bold; background: transparent; border: none;")
                self.status_lbl.setText(f"✕ {tr('Operation canceled or authentication failed.')}")
            proc.deleteLater()

        proc.finished.connect(_on_done)
        if persist:
            persist_cmd = self._build_persist_cmd(sched_id, mode_id)
            proc.start("pkexec", ["sh", "-c", f"({scx_cmd}) && {persist_cmd}"])
        else:
            proc.start("sh", ["-c", scx_cmd])

    def apply_scheduler(self):
        chosen = SCX_SCHEDULERS[self.selected_idx]
        self._execute_scx_change(chosen["id"], self.selected_mode)

    def reset_to_bore(self):
        self.select_scheduler(0, auto_mode=True)
        self._execute_scx_change("bore", "auto")


