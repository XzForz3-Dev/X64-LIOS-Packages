    def _detect_sb_state(self):
        if not os.path.exists('/sys/firmware/efi'):
            return tr("LEGACY BIOS"), "#888899", "rgba(136, 136, 153, 0.15)", "rgba(136, 136, 153, 0.4)"

        import glob
        setup_files = glob.glob('/sys/firmware/efi/efivars/SetupMode-*')
        if setup_files:
            try:
                with open(setup_files[0], 'rb') as f:
                    d = f.read()
                    if len(d) >= 5 and d[4] == 1:
                        return tr("SETUP MODE"), "#f59e0b", "rgba(245, 158, 11, 0.15)", "rgba(245, 158, 11, 0.4)"
            except Exception:
                pass

        sb_files = glob.glob('/sys/firmware/efi/efivars/SecureBoot-*')
        if sb_files:
            try:
                with open(sb_files[0], 'rb') as f:
                    d = f.read()
                    if len(d) >= 5 and d[4] == 1:
                        return tr("ACTIVE"), "#10b981", "rgba(16, 185, 129, 0.15)", "rgba(16, 185, 129, 0.4)"
            except Exception:
                pass

        return tr("DISABLED"), "#ef4444", "rgba(239, 68, 68, 0.15)", "rgba(239, 68, 68, 0.4)"

    def _launch(self):
        try:
            import subprocess
            cmd = ["x64-secureboot"]
            if _lang_code:
                cmd.extend(["--lang", _lang_code])
            subprocess.Popen(cmd, preexec_fn=os.setsid)
        except Exception:
            pass

    def mousePressEvent(self, event):
        if event.button() == Qt.MouseButton.LeftButton:
            self._launch()
        super().mousePressEvent(event)


