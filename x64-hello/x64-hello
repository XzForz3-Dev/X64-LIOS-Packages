    def toggle_service(self):
        if not self._active and self.req_pkg and self.req_pkg not in INSTALLED_PKGS_CACHE:
            if self.is_user:
                act_part = f"systemctl --user enable --now {self.unit_name}"
                if self.unit_name == "psd.service":
                    act_part = f"psd p >/dev/null 2>&1 || true; {act_part}"
                elif self.unit_name in ["x64-update.timer", "arch-update.timer"]:
                    act_part += "; cp -f /usr/share/applications/x64-update-tray.desktop ~/.config/autostart/ 2>/dev/null || true; (x64-update-tray >/dev/null 2>&1 &)"
            elif self.unit_name == "ufw.service":
                act_part = "if systemctl is-active --quiet sshd; then sudo ufw allow 22/tcp >/dev/null 2>&1 || true; fi && sudo ufw --force enable && sudo systemctl enable --now ufw.service"
            else:
                act_part = f"sudo systemctl enable --now {self.unit_name}"

            body = (
                f"printf '\033[1;31m==> [X64 SERVICE MANAGER]\033[0m El servicio \033[1;37m{self.title}\033[0m requiere instalar el paquete \033[1;33m{self.req_pkg}\033[0m.\n\n'; "
                f"sudo pacman -Sy --needed --overwrite '*' {self.req_pkg} && {act_part}"
            )
            cmd = build_x64_term_cmd(
                f"X64 Service Installer - {self.req_pkg}",
                f"INSTALACIÓN Y ACTIVACIÓN DE SERVICIO ({self.req_pkg})",
                body
            )
            os.system(f"{cmd} &")
            return

        action = "disable --now" if self._active else "enable --now"
        self.toggle_btn.setEnabled(False)
        proc = QProcess(self)

        def _on_svc_done(_exit_code, _exit_status):
            self.toggle_btn.setEnabled(True)
            if self.parent_app:
                self.parent_app.refresh_services_async()
            proc.deleteLater()

        proc.finished.connect(_on_svc_done)

        if self.is_user:
            if self.unit_name == "psd.service" and not self._active:
                subprocess.run(["sh", "-c", "psd p >/dev/null 2>&1 || true"], timeout=2)
            proc.start("systemctl", ["--user", *action.split(), self.unit_name])
            if self.unit_name in ["x64-update.timer", "arch-update.timer"]:
                if not self._active:
                    subprocess.Popen(["sh", "-c", "cp -f /usr/share/applications/x64-update-tray.desktop ~/.config/autostart/ 2>/dev/null || true; x64-update-tray &"])
                else:
                    subprocess.Popen(["sh", "-c", "rm -f ~/.config/autostart/x64-update-tray.desktop 2>/dev/null || true; killall x64-update-tray 2>/dev/null || true"])
        elif self.unit_name == "ufw.service":
            ufw_cmd = (
                "ufw disable && systemctl disable --now ufw.service"
                if self._active else "if systemctl is-active --quiet sshd; then ufw allow 22/tcp >/dev/null 2>&1 || true; fi && ufw --force enable && systemctl enable --now ufw.service"
            )
            proc.start("pkexec", ["sh", "-c", ufw_cmd])
        else:
            proc.start("pkexec", ["systemctl", *action.split(), self.unit_name])


def get_gaming_gpu_support_pkgs():
    """Detecta los drivers 64-bit instalados y devuelve sus pares 32-bit exactos para gaming."""
    support = ["lib32-mesa", "ttf-liberation"]
    vk_map = {
        "nvidia-utils": "lib32-nvidia-utils",
        "vulkan-radeon": "lib32-vulkan-radeon",
        "vulkan-intel": "lib32-vulkan-intel",
        "vulkan-virtio": "lib32-vulkan-virtio",
        "vulkan-nouveau": "lib32-vulkan-nouveau",
        "vulkan-swrast": "lib32-vulkan-swrast",
    }
    found_vk = False
    for pkg64, pkg32 in vk_map.items():
        if pkg64 in INSTALLED_PKGS_CACHE:
            support.append(pkg32)
            found_vk = True
    if not found_vk:
        gpu_up = STATIC_HW.get("gpu_model", "").upper()
        if "NVIDIA" in gpu_up:
            support.extend(["nvidia-utils", "lib32-nvidia-utils"])
        elif "AMD" in gpu_up or "RADEON" in gpu_up or "ATI" in gpu_up:
            support.extend(["vulkan-radeon", "lib32-vulkan-radeon"])
        elif "INTEL" in gpu_up:
            support.extend(["vulkan-intel", "lib32-vulkan-intel"])
        elif "VIRTIO" in gpu_up or "QEMU" in gpu_up or "RED HAT" in gpu_up:
            support.extend(["vulkan-virtio", "lib32-vulkan-virtio"])
        else:
            support.extend(["vulkan-swrast", "lib32-vulkan-swrast"])
    return " ".join(dict.fromkeys(support))


