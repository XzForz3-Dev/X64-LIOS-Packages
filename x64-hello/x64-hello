INSTALLED_PKGS_CACHE = set()

def reload_installed_pkgs_cache():
    global INSTALLED_PKGS_CACHE
    pkgs = set()
    local_db = "/var/lib/pacman/local"
    try:
        for entry in os.listdir(local_db):
            parts = entry.rsplit("-", 2)
            if len(parts) == 3:
                pkgs.add(parts[0])
    except Exception:
        pass
    INSTALLED_PKGS_CACHE = pkgs

reload_installed_pkgs_cache()


import shlex
import unicodedata

def _term_cell_width(text):
    return sum(2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1 for ch in text)


def build_x64_term_cmd(title, banner_title, shell_body):
    prefix_plain = "  ⚡ X64 LIOS COMMAND CENTER  •  "
    vis_len = _term_cell_width(prefix_plain) + _term_cell_width(banner_title)
    inner_width = max(76, vis_len + 3)
    horiz = "═" * inner_width
    pad = " " * (inner_width - vis_len)
    script = (
        f"printf '\\033[1;31m╔{horiz}╗\\033[0m\\n'; "
        f"printf '\\033[1;31m║\\033[0m  \\033[1;37m⚡ X64 LIOS COMMAND CENTER\\033[0m  \\033[1;31m•\\033[0m  \\033[1;33m{banner_title}\\033[0m{pad}\\033[1;31m║\\033[0m\\n'; "
        f"printf '\\033[1;31m╚{horiz}╝\\033[0m\\n\\n'; "
        f"( {shell_body} ); "
        f"status=$?; "
        f"echo ''; "
        f"if [ $status -eq 0 ]; then "
        f"  printf '\\033[1;32m✓ Operación completada con éxito.\\033[0m '; "
        f"else "
        f"  printf '\\033[1;31m✕ La operación no se pudo completar (código: %d).\\033[0m ' $status; "
        f"fi; "
        f"read -p 'Presiona Enter para cerrar esta ventana...'"
    )
    return (
        f"kitty -o remember_window_size=no -o background_opacity=1.0 -o initial_window_width=108c -o initial_window_height=30c "
        f"--title {shlex.quote(title)} bash -c {shlex.quote(script)}"
    )


