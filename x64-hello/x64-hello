LANG_CONF_PATH = os.path.expanduser("~/.config/x64-hello/lang.conf")

def _detect_initial_lang():
    if "X64_LANG" in os.environ:
        return os.environ["X64_LANG"]
    try:
        if os.path.exists(LANG_CONF_PATH):
            with open(LANG_CONF_PATH, "r") as f:
                saved = f.read().strip()
                if saved in ("en", "es", "fr", "de", "it", "pt", "ru"):
                    return saved
    except Exception:
        pass
    try:
        _locale_tup = locale.getlocale()
        if not _locale_tup or not _locale_tup[0]:
            _env_lang = os.environ.get("LANG", "es_ES")
            code = _env_lang.split('_')[0].split('.')[0]
        else:
            code = _locale_tup[0].split('_')[0]
        return code if code in ("en", "es", "fr", "de", "it", "pt", "ru") else "es"
