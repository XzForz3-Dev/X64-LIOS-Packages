]

_SCX_OVERRIDE_CACHE = {"sched": None, "mode": None, "until": 0.0}


def get_active_cpu_scheduler():
    now = time.monotonic()
    if _SCX_OVERRIDE_CACHE["sched"] and now < _SCX_OVERRIDE_CACHE["until"]:
        return _SCX_OVERRIDE_CACHE["sched"]
    try:
        if os.path.exists("/sys/kernel/sched_ext/state"):
            with open("/sys/kernel/sched_ext/state", "r") as f:
                st = f.read().strip()
            if st == "enabled" and os.path.exists("/sys/kernel/sched_ext/root/ops"):
                with open("/sys/kernel/sched_ext/root/ops", "r") as f:
                    ops = f.read().strip()
                if ops:
                    short = ops.split("_")[0].strip().lower()
                    return f"scx_{short}"
    except Exception:
        pass
    return "BORE"


def query_scxctl_runtime():
    """Returns (active_sched_id, active_mode_id, pretty_label)"""
    try:
        res = subprocess.run(
            ["scxctl", "get"],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=1.5
        )
        out = res.stdout.strip()
        if out.lower().startswith("running "):
            parts = out.split()
            sched_raw = parts[1].lower() if len(parts) > 1 else "lavd"
            mode_raw = parts[3].lower() if len(parts) > 3 else "auto"
            mode_pretty = parts[3] if len(parts) > 3 else "Auto"
            return sched_raw, mode_raw, f"scx_{sched_raw} ({mode_pretty})"
    except Exception:
        pass
    cur = get_active_cpu_scheduler()
    if cur.startswith("scx_"):
        s_id = cur.replace("scx_", "").split()[0].strip().lower()
        return s_id, "auto", cur
    return "bore", "auto", tr("BORE (Kernel Default)")


