class DnsPingWorker(QThread):
    results_ready = pyqtSignal(dict)

    @staticmethod
    def _probe_dns_ms(ip):
        dns_query = b"\x12\x34\x01\x00\x00\x01\x00\x00\x00\x00\x00\x00\x06google\x03com\x00\x00\x01\x00\x01"
        sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        sock.settimeout(1.2)
        t0 = time.perf_counter()
        try:
            sock.sendto(dns_query, (ip, 53))
            sock.recvfrom(512)
            return (time.perf_counter() - t0) * 1000.0
        except Exception:
            pass
        finally:
            sock.close()

        t1 = time.perf_counter()
        try:
            s_tcp = socket.create_connection((ip, 53), timeout=1.2)
            s_tcp.close()
            return (time.perf_counter() - t1) * 1000.0
        except Exception:
            return None

    def run(self):
        latencies = {}
        for p in DNS_PROVIDERS:
            ip = p["ping_ip"]
            latencies[ip] = self._probe_dns_ms(ip)
        self.results_ready.emit(latencies)


