    def change_language(self, lang_id):
        if lang_id != _lang_code:
            QTimer.singleShot(0, lambda: self._apply_language(lang_id))

    def _apply_language(self, lang_id):
        global _lang_code
        _lang_code = lang_id
        os.environ["X64_LANG"] = lang_id
        try:
            os.makedirs(os.path.dirname(LANG_CONF_PATH), exist_ok=True)
            with open(LANG_CONF_PATH, "w") as f:
                f.write(lang_id + "\n")
        except Exception:
            pass
        current_idx = self.stacked_widget.currentIndex() if hasattr(self, "stacked_widget") else 0
        self._svc_worker = None
        self.build_ui(initial_page=current_idx)
        self.update_hardware_telemetry(force=True)
        self.refresh_services_async()

    def change_page(self, index):
        for i, btn in enumerate(self.nav_buttons):
            if i == index:
                btn.set_active_style()
            else:
                btn.set_inactive_style()
        self.stacked_widget.setCurrentIndex(index)
        if index == 0:
            self.update_hardware_telemetry(force=True)
            self.refresh_services_async()
        elif index == 1:
            if hasattr(self, "scx_panel"):
                self.scx_panel.refresh_runtime_state(select_active=True)
            self.refresh_services_async()
        elif index == 2:
            if hasattr(self, "dns_panel"):
                self.dns_panel.populate_connections()
                if not self.dns_panel._has_benchmarked:
                    QTimer.singleShot(120, self.dns_panel.run_ping_benchmark)
            self.refresh_services_async()
        elif index == 3:
            self.refresh_services_async()


