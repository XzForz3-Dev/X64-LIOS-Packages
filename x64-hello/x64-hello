def get_static_hw_info():
    cpu_model = "Generic x86_64 Processor"
    cpu_cores = os.cpu_count() or 1
    try:
        with open("/proc/cpuinfo", "r") as f:
            for line in f:
                if line.startswith("model name"):
                    raw = line.split(":", 1)[1].strip()
                    for token in ["(R)", "(TM)", "(tm)", "CPU", "Processor"]:
                        raw = raw.replace(token, "")
                    cpu_model = " ".join(raw.split())
                    break
    except Exception:
        pass

    gpu_model = "VGA / DRM Graphics"
    try:
        res = subprocess.run(
            ["lspci"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=1.5
        )
        for line in res.stdout.splitlines():
            if "VGA compatible controller:" in line or "3D controller:" in line or "Display controller:" in line:
                part = line.split(":", 2)[-1].strip()
                part = part.split("(rev")[0].strip()
                for token in ["Corporation", "Incorporated"]:
                    part = part.replace(token, "")
                part = " ".join(part.split())
                if len(part) > 40:
                    part = part[:37] + "..."
                gpu_model = part
                break
    except Exception:
        pass

    root_fs = "Linux FS"
    try:
        with open("/proc/mounts", "r") as f:
            for line in f:
                parts = line.split()
                if len(parts) >= 3 and parts[1] == "/":
                    root_fs = parts[2].upper()
                    break
    except Exception:
        pass

    zram_active = False
    try:
        with open("/proc/swaps", "r") as f:
            zram_active = ("zram" in f.read())
    except Exception:
        pass

    return {
        "cpu_model": cpu_model,
        "cpu_cores": cpu_cores,
        "gpu_model": gpu_model,
        "root_fs": root_fs,
        "zram_active": zram_active
    }

STATIC_HW = get_static_hw_info()


class ServiceStatusWorker(QThread):
    status_ready = pyqtSignal(dict)

    def __init__(self, sys_units, user_units=None, parent=None):
        super().__init__(parent)
        self.sys_units = sys_units or []
        self.user_units = user_units or []

    def _check_group(self, units, is_user=False):
        out = {}
        if not units:
            return out
        base_cmd = ["systemctl", "--user"] if is_user else ["systemctl"]
        try:
            res_act = subprocess.run(
                [*base_cmd, "is-active", *units],
                stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=3
            )
            act_lines = res_act.stdout.splitlines()
            res_en = subprocess.run(
                [*base_cmd, "is-enabled", *units],
                stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=3
            )
            en_lines = res_en.stdout.splitlines()
            for i, u in enumerate(units):
                is_act = (i < len(act_lines) and act_lines[i].strip() == "active")
                is_en = (i < len(en_lines) and en_lines[i].strip() == "enabled")
                active_val = (is_act or is_en)
                if u == "ufw.service" and active_val and os.path.exists("/etc/ufw/ufw.conf"):
                    try:
                        with open("/etc/ufw/ufw.conf", "r") as uf:
                            active_val = any(line.strip().startswith("ENABLED=yes") for line in uf)
                    except Exception:
                        pass
                out[u] = active_val
        except Exception:
            for u in units:
                out[u] = False
        return out

    def run(self):
        result = {}
        result.update(self._check_group(self.sys_units, is_user=False))
        result.update(self._check_group(self.user_units, is_user=True))
        self.status_ready.emit(result)


