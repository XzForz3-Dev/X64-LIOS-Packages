pkgname=x64-gnome-settings
pkgver=1.0.0
pkgrel=13
pkgdesc="Official X64 LIOS GNOME Desktop & GDM Lock Screen Configuration"
arch=('any')
license=('GPL')
install='x64-gnome-settings.install'
depends=('glib2' 'glib2-devel' 'python' 'python-pillow' 'adw-gtk-theme' 'gnome-backgrounds' 'gnome-shell-extension-appindicator' 'papirus-icon-theme')
source=('gdm-stealth-chassis.jpg'
        '01-monolith.jpg'
        'x64-lios-cube-160.png'
        'zzz_x64.org.gnome.login-screen.gschema.override'
        'zzz_x64.org.gnome.desktop.interface.gschema.override'
        '00-x64-logo'
        'apply-gdm-theme.py'
        '90-x64-gdm-theme.hook'
        'x64-gdm-theme.service'
        'org.fcitx.Fcitx5.desktop'
        'x64-monolith.xml')
sha256sums=('SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP')

package() {
    # 1. Fondo oficial de GDM y Escritorio GNOME (Monolith y Stealth Chassis)
    mkdir -p "${pkgdir}/usr/share/backgrounds/x64-lios"
    install -m644 "${srcdir}/01-monolith.jpg" "${pkgdir}/usr/share/backgrounds/x64-lios/01-monolith.jpg"
    install -m644 "${srcdir}/gdm-stealth-chassis.jpg" "${pkgdir}/usr/share/backgrounds/x64-lios/gdm-stealth-chassis.jpg"

    # 2. Logotipo oficial del Cubo 3D de X64 LIOS (160px)
    mkdir -p "${pkgdir}/usr/share/pixmaps"
    install -m644 "${srcdir}/x64-lios-cube-160.png" "${pkgdir}/usr/share/pixmaps/x64-lios-cube-160.png"

    # 3. GSettings Override para GDM y GNOME Desktop (Modo Oscuro Puro por defecto)
    mkdir -p "${pkgdir}/usr/share/glib-2.0/schemas"
    install -m644 "${srcdir}/zzz_x64.org.gnome.login-screen.gschema.override" \
        "${pkgdir}/usr/share/glib-2.0/schemas/zzz_x64.org.gnome.login-screen.gschema.override"
    install -m644 "${srcdir}/zzz_x64.org.gnome.desktop.interface.gschema.override" \
        "${pkgdir}/usr/share/glib-2.0/schemas/zzz_x64.org.gnome.desktop.interface.gschema.override"

    # 4. dconf override de respaldo para GDM
    mkdir -p "${pkgdir}/etc/dconf/db/gdm.d"
    install -m644 "${srcdir}/00-x64-logo" "${pkgdir}/etc/dconf/db/gdm.d/00-x64-logo"

    # 5. Script aplicador dinámico de gresource para GDM
    mkdir -p "${pkgdir}/usr/lib/x64-lios"
    install -m755 "${srcdir}/apply-gdm-theme.py" "${pkgdir}/usr/lib/x64-lios/apply-gdm-theme.py"

    # 6. Hook ALPM para persistencia en actualizaciones de gnome-shell
    mkdir -p "${pkgdir}/usr/share/libalpm/hooks"
    install -m644 "${srcdir}/90-x64-gdm-theme.hook" "${pkgdir}/usr/share/libalpm/hooks/90-x64-gdm-theme.hook"

    # 7. Servicio Systemd para optimización dinámica multi-monitor antes de GDM
    mkdir -p "${pkgdir}/usr/lib/systemd/system/gdm.service.wants"
    install -m644 "${srcdir}/x64-gdm-theme.service" "${pkgdir}/usr/lib/systemd/system/x64-gdm-theme.service"
    ln -sf ../x64-gdm-theme.service "${pkgdir}/usr/lib/systemd/system/gdm.service.wants/x64-gdm-theme.service"

    # 8. Desactivar Fcitx5 en GNOME para suprimir notificaciones de Wayland Diagnose
    mkdir -p "${pkgdir}/etc/skel/.config/autostart"
    install -m644 "${srcdir}/org.fcitx.Fcitx5.desktop" "${pkgdir}/etc/skel/.config/autostart/org.fcitx.Fcitx5.desktop"

    # 9. Enlaces de icono de alta fidelidad transparente para Antigravity IDE
    for theme in Papirus Papirus-Dark; do
        for size in 16x16 22x22 24x24 32x32 48x48 64x64; do
            mkdir -p "${pkgdir}/usr/share/icons/${theme}/${size}/apps"
            ln -sf antigravity.svg "${pkgdir}/usr/share/icons/${theme}/${size}/apps/antigravity-ide.svg"
        done
    done
    mkdir -p "${pkgdir}/usr/share/icons/hicolor/scalable/apps"
    ln -sf /usr/share/icons/Papirus/64x64/apps/antigravity.svg "${pkgdir}/usr/share/icons/hicolor/scalable/apps/antigravity-ide.svg"

    # 10. Propiedad oficial de fondo de pantalla para GNOME Settings
    mkdir -p "${pkgdir}/usr/share/gnome-background-properties"
    install -m644 "${srcdir}/x64-monolith.xml" "${pkgdir}/usr/share/gnome-background-properties/x64-monolith.xml"
}
