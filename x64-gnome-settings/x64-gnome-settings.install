post_install() {
    echo ":: Aplicando tema y configuración de X64 LIOS para GDM..."
    glib-compile-schemas /usr/share/glib-2.0/schemas 2>/dev/null || true
    systemctl daemon-reload 2>/dev/null || true
    systemctl enable x64-gdm-theme.service 2>/dev/null || true
    if [ -x /usr/lib/x64-lios/apply-gdm-theme.py ]; then
        /usr/lib/x64-lios/apply-gdm-theme.py 2>/dev/null || true
    fi

    # Desactivar Fcitx5 en GNOME y actualizar favoritos para todos los usuarios
    for user_home in /home/*; do
        if [ -d "$user_home" ]; then
            username=$(basename "$user_home")
            mkdir -p "$user_home/.config/autostart" 2>/dev/null || true
            cp -f /etc/skel/.config/autostart/org.fcitx.Fcitx5.desktop "$user_home/.config/autostart/" 2>/dev/null || true
            chown -R "$username:$username" "$user_home/.config/autostart/org.fcitx.Fcitx5.desktop" 2>/dev/null || true
            su - "$username" -c "gsettings set org.gnome.shell favorite-apps \"['x64-hello.desktop', 'chromium.desktop', 'kitty.desktop', 'org.gnome.Nautilus.desktop']\"" 2>/dev/null || true
            # Respetar personalizaciones del usuario: solo fijar Monolith si está en blanco o con el fondo stock de Adwaita
            current_bg=$(su - "$username" -c "gsettings get org.gnome.desktop.background picture-uri" 2>/dev/null || true)
            if [ -z "$current_bg" ] || echo "$current_bg" | grep -q "adwaita"; then
                su - "$username" -c "gsettings set org.gnome.desktop.background picture-uri 'file:///usr/share/backgrounds/x64-lios/01-monolith.jpg' && gsettings set org.gnome.desktop.background picture-uri-dark 'file:///usr/share/backgrounds/x64-lios/01-monolith.jpg' && gsettings set org.gnome.desktop.background picture-options 'zoom' && gsettings set org.gnome.desktop.screensaver picture-uri 'file:///usr/share/backgrounds/x64-lios/01-monolith.jpg' && gsettings set org.gnome.desktop.screensaver picture-options 'zoom'" 2>/dev/null || true
            fi
        fi
    done

    # Actualizar caché de iconos para Papirus y Papirus-Dark
    gtk-update-icon-cache -f /usr/share/icons/Papirus 2>/dev/null || true
    gtk-update-icon-cache -f /usr/share/icons/Papirus-Dark 2>/dev/null || true
    if [ -f /usr/share/icons/Papirus/64x64/apps/antigravity.svg ] && which rsvg-convert >/dev/null 2>&1; then
        rsvg-convert -w 1024 -h 1024 /usr/share/icons/Papirus/64x64/apps/antigravity.svg -o /usr/share/pixmaps/antigravity-ide.png 2>/dev/null || true
    fi

    # Ocultar utilidades redundantes o residuales en GNOME
    if [ -f /usr/share/applications/nm-connection-editor.desktop ]; then
        if ! grep -q "NotShowIn" /usr/share/applications/nm-connection-editor.desktop; then
            echo "NotShowIn=GNOME;" >> /usr/share/applications/nm-connection-editor.desktop
        fi
    fi
    if [ -f /usr/share/applications/fcitx5-configtool.desktop ]; then
        sed -i 's/^NotShowIn=.*/NotShowIn=KDE;GNOME;/' /usr/share/applications/fcitx5-configtool.desktop 2>/dev/null || true
    fi
    for qt_app in assistant designer linguist qdbusviewer qv4l2 qvidcap; do
        if [ -f "/usr/share/applications/${qt_app}.desktop" ]; then
            if ! grep -q "NoDisplay" "/usr/share/applications/${qt_app}.desktop"; then
                echo "NoDisplay=true" >> "/usr/share/applications/${qt_app}.desktop"
            fi
        fi
    done
}

post_upgrade() {
    post_install
}

post_remove() {
    glib-compile-schemas /usr/share/glib-2.0/schemas 2>/dev/null || true
    if [ -f /usr/share/gnome-shell/gnome-shell-theme.gresource.stock ]; then
        if pacman -Q gnome-shell >/dev/null 2>&1; then
            mv -f /usr/share/gnome-shell/gnome-shell-theme.gresource.stock /usr/share/gnome-shell/gnome-shell-theme.gresource 2>/dev/null || true
        else
            rm -f /usr/share/gnome-shell/gnome-shell-theme.gresource.stock /usr/share/gnome-shell/gnome-shell-theme.gresource 2>/dev/null || true
        fi
    fi
}

