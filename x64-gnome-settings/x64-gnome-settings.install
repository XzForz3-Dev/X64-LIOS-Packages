post_install() {
    echo ":: Aplicando tema y configuración de X64 LIOS para GDM..."
    glib-compile-schemas /usr/share/glib-2.0/schemas 2>/dev/null || true
    systemctl daemon-reload 2>/dev/null || true
    systemctl enable x64-gdm-theme.service 2>/dev/null || true
    if [ -x /usr/lib/x64-lios/apply-gdm-theme.py ]; then
        /usr/lib/x64-lios/apply-gdm-theme.py 2>/dev/null || true
    fi

    # Desactivar Fcitx5 en GNOME para todos los usuarios
    for user_home in /home/*; do
        if [ -d "$user_home" ]; then
            username=$(basename "$user_home")
            mkdir -p "$user_home/.config/autostart" 2>/dev/null || true
            cp -f /etc/skel/.config/autostart/org.fcitx.Fcitx5.desktop "$user_home/.config/autostart/" 2>/dev/null || true
            chown -R "$username:$username" "$user_home/.config/autostart/org.fcitx.Fcitx5.desktop" 2>/dev/null || true
        fi
    done
}

post_upgrade() {
    post_install
}

post_remove() {
    glib-compile-schemas /usr/share/glib-2.0/schemas 2>/dev/null || true
    if [ -f /usr/share/gnome-shell/gnome-shell-theme.gresource.stock ]; then
        if pacman -Q gnome-shell >/dev/null 2>&1; then
            mv -f /usr/share/gnome-shell/gnome-shell-theme.gresource.stock /usr/share/gnome-shell/gnome-shell-theme.gresource 2>/dev/null || true
        else
            rm -f /usr/share/gnome-shell/gnome-shell-theme.gresource.stock /usr/share/gnome-shell/gnome-shell-theme.gresource 2>/dev/null || true
        fi
    fi
}

