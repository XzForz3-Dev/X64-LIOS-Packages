[Trigger]
Operation = Install
Operation = Upgrade
Type = Path
Target = usr/share/gnome-shell/gnome-shell-theme.gresource
Target = usr/share/backgrounds/x64-lios/gdm-stealth-chassis.jpg

[Action]
Description = Applying X64 LIOS GDM & Lock Screen Theme...
When = PostTransaction
Exec = /usr/lib/x64-lios/apply-gdm-theme.py
